---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTASection from '../components/CTASection.astro';
import { BUSINESS, SERVICES, CASE_STUDIES, COUNTIES } from '../data/site';

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'Organization'],
  '@id': 'https://crst.net/#organization',
  name: 'Cornerstone Services, Inc.',
  alternateName: 'CRST',
  url: 'https://crst.net',
  logo: 'https://crst.net/images/crst-logo.webp',
  image: 'https://crst.net/images/crst-logo.webp',
  description: 'Full-service direct mail, printing, and mailing company serving the Hudson Valley since 1998. In-house data lists, graphic design, commercial printing, and USPS postal prep.',
  foundingDate: '1998',
  telephone: '+18452555722',
  email: 'info@crst.net',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '31 South Ohioville Road',
    addressLocality: 'New Paltz',
    addressRegion: 'NY',
    postalCode: '12561',
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 41.7476,
    longitude: -74.0871,
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Ulster County, NY' },
    { '@type': 'AdministrativeArea', name: 'Dutchess County, NY' },
    { '@type': 'AdministrativeArea', name: 'Orange County, NY' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Direct Mail & Printing Services',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Direct Mail Campaigns', url: 'https://crst.net/services/direct-mail' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Data Lists', url: 'https://crst.net/services/data-lists' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Printing Services', url: 'https://crst.net/services/printing' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Mailing Services', url: 'https://crst.net/services/mailing' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Graphic Design', url: 'https://crst.net/services/graphic-design' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Every Door Direct Mail (EDDM)', url: 'https://crst.net/services/eddm' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Non-Profit Mailing', url: 'https://crst.net/services/non-profit-mailing' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Web Design', url: 'https://crst.net/services/web-design' } },
    ],
  },
  sameAs: [
    'https://www.bbb.org/us/ny/new-paltz/profile/direct-mail-advertising/cornerstone-services-inc-0121-87170789',
  ],
};
---

<BaseLayout
  title="Direct Mail & Printing Services | New Paltz, NY"
  description="Direct mail, printing, and mailing services from New Paltz, NY. Design, print, and mail under one roof since 1998. Serving the Hudson Valley."
  schema={localBusinessSchema}
>
  <Hero />

  <!-- Services Section -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="container-wide">
      <div class="text-center mb-12">
        <div class="section-divider mx-auto mb-4"></div>
        <h2 class="text-3xl sm:text-4xl font-display text-crst-primary mb-3">
          Direct Mail, Printing, and Mailing Services
        </h2>
        <p class="text-navy-600/70 font-heading text-lg max-w-2xl mx-auto">
          Since 1998, Cornerstone has been Hudson Valley's full-service partner for <a href="/services/direct-mail" class="text-crst-accent hover:text-crst-primary underline underline-offset-2">professional direct mail campaigns</a>, <a href="/services/eddm" class="text-crst-accent hover:text-crst-primary underline underline-offset-2">Every Door Direct Mail services</a>, <a href="/services/non-profit-mailing" class="text-crst-accent hover:text-crst-primary underline underline-offset-2">nonprofit fundraising and membership mailing</a>, <a href="/services/mailing" class="text-crst-accent hover:text-crst-primary underline underline-offset-2">USPS-compliant high-volume mailing services</a>, <a href="/services/data-lists" class="text-crst-accent hover:text-crst-primary underline underline-offset-2">targeted direct mail data lists</a>, <a href="/services/printing" class="text-crst-accent hover:text-crst-primary underline underline-offset-2">commercial direct mail printing</a>, and <a href="/services/union-printing" class="text-crst-accent hover:text-crst-primary underline underline-offset-2">union printing for political and labor organizations</a>.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {SERVICES.slice(0, 8).map((service) => (
          <ServiceCard
            title={service.title}
            slug={service.slug}
            summary={service.summary}
            icon={service.icon}
          />
        ))}
      </div>

      <div class="text-center mt-8">
        <a href="/services" title="View All Services" class="btn-secondary text-sm">
          View All Services
          <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-16 lg:py-20 bg-navy-50/50 bg-grid">
    <div class="container-wide">
      <div class="text-center mb-12">
        <div class="section-divider mx-auto mb-4"></div>
        <h2 class="text-3xl sm:text-4xl font-display text-crst-primary mb-3">
          How It Works
        </h2>
        <p class="text-navy-600/70 font-heading text-lg max-w-2xl mx-auto">
          Cornerstone uses a Project Management approach for all projects. Nothing is left to chance because we used rehearsed and reliable S.O.P. processes for printing and mail fulfillment. From your initial quote to the CRST Project Management desk, here are four straightforward steps that you could expect with your mailing.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { step: '01', title: 'Target', desc: 'Our process starts uniquely with reverse-engineering. "What is the result you want to achieve?" and then we engage the data, design & mailing tools necessary to achieve that result.' },
          { step: '02', title: 'Data', desc: 'Good data = good results. Bad data = well… you don\'t have to guess. Many of our mailings amortize multiple data sets so that your mailings are not an "all chips on black" roulette wheel gamble. You also get free Data Quality Reports with in-house lists that you provide.' },
          { step: '03', title: 'Design', desc: 'We create simple, compelling and USPS-compliant mail pieces optimized for both visual impact and postal automation. We know that we only have 1 to 2 seconds to capture recipient attention.' },
          { step: '04', title: 'Mail', desc: 'There is no "one size fits all" approach. We generally work with automation mail due to integrity of process and statistical likelihood of on-time delivery, yet we also have unique strategies for EDDM mailings.' },
        ].map((item) => (
          <div class="animate-on-scroll">
            <div class="text-5xl font-display text-crst-gold/30 mb-2">{item.step}</div>
            <h3 class="font-heading font-bold text-navy-800 text-lg mb-2">{item.title}</h3>
            <p class="text-sm text-navy-600/70 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who We Work With -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="container-wide">
      <div class="text-center mb-12">
        <div class="section-divider mx-auto mb-4"></div>
        <h2 class="text-3xl sm:text-4xl font-display text-crst-primary mb-3">
          Who We Work With
        </h2>
        <p class="text-navy-600/70 font-heading text-lg max-w-2xl mx-auto">
          Local businesses, nonprofits, political campaigns, municipal governments, schools, fire departments, and PBA organizations. If you need something printed and mailed, we've probably done it for someone in your industry.
        </p>
      </div>
      <div class="flex flex-wrap justify-center gap-3 max-w-3xl mx-auto">
        {['Local Businesses', 'Restaurants', 'Real Estate', 'Healthcare', 'Nonprofits', 'Political Campaigns', 'Municipalities', 'Schools', 'Fire Departments', 'PBA Organizations', 'Churches', 'Contractors'].map((type) => (
          <span class="inline-block px-4 py-2 text-sm font-heading font-medium bg-navy-50 text-navy-600 rounded-full border border-navy-100">
            {type}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Case Studies Teaser -->
  <section class="py-16 lg:py-20 bg-navy-50/50 bg-grid">
    <div class="container-wide">
      <div class="text-center mb-12">
        <div class="section-divider mx-auto mb-4"></div>
        <h2 class="text-3xl sm:text-4xl font-display text-crst-primary mb-3">
          Proven Results
        </h2>
        <p class="text-navy-600/70 font-heading text-lg max-w-2xl mx-auto">
          Real campaigns. Real outcomes. See how we've helped businesses and organizations grow through direct mail.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {CASE_STUDIES.slice(0, 6).map((study) => (
          <a href={`/case-studies/${study.slug}`} title={study.title} class="card group block">
            <div class="flex items-center gap-2 mb-3">
              <span class="inline-block px-2 py-0.5 text-xs font-heading font-medium bg-navy-50 text-navy-600 rounded">
                {study.industry}
              </span>
            </div>
            <h3 class="font-heading font-semibold text-navy-800 group-hover:text-crst-primary transition-colors mb-2">
              {study.title}
            </h3>
            <p class="text-sm text-navy-600/60">
              {study.client} — {study.location}
            </p>
            <span class="inline-flex items-center gap-1 mt-3 text-xs font-heading font-semibold text-crst-accent group-hover:text-crst-primary transition-colors">
              Read case study
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </span>
          </a>
        ))}
      </div>

      <div class="text-center mt-8">
        <a href="/case-studies" title="View All Case Studies" class="btn-secondary text-sm">
          View All Case Studies
        </a>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="py-16 lg:py-20 bg-navy-50/50">
    <div class="container-wide">
      <div class="text-center mb-12">
        <div class="section-divider mx-auto mb-4"></div>
        <h2 class="text-3xl sm:text-4xl font-display text-crst-primary mb-3">
          Serving the Hudson Valley Since 1998
        </h2>
        <p class="text-navy-600/70 font-heading text-lg max-w-2xl mx-auto">
          Our facility is in New Paltz. We serve businesses and organizations across Ulster, Dutchess, and Orange Counties — {BUSINESS.stats.municipalities} municipalities total. Local means same-day pickups and face-to-face meetings when you need them.
        </p>
      </div>

      <div class="grid sm:grid-cols-3 gap-5">
        {Object.values(COUNTIES).map((county) => (
          <a href={`/service-areas/${county.slug}`} title={county.name} class="card group text-center block">
            <div class="w-14 h-14 rounded-full bg-crst-primary/10 flex items-center justify-center mx-auto mb-4 group-hover:bg-crst-primary transition-colors duration-300">
              <svg class="w-6 h-6 text-crst-primary group-hover:text-white transition-colors duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <h3 class="font-heading font-bold text-navy-800 text-lg mb-2 group-hover:text-crst-primary transition-colors">
              {county.name}
            </h3>
            <p class="text-sm text-navy-600/60 leading-relaxed">
              {county.description}
            </p>
          </a>
        ))}
      </div>

      <div class="text-center mt-8">
        <a href="/service-areas" title="View All Service Areas" class="btn-secondary text-sm">
          View All Service Areas
        </a>
      </div>
    </div>
  </section>

  <!-- What Our Clients Say -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="container-wide">
      <div class="text-center mb-12">
        <div class="section-divider mx-auto mb-4"></div>
        <h2 class="text-3xl sm:text-4xl font-display text-crst-primary mb-3">
          What Our Clients Say
        </h2>
      </div>
      <div class="grid sm:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {[
          { text: 'Our agency uses Cornerstone for all our direct mail projects. They are super-responsive and meticulous in their work. Highly recommend.', name: 'Marlene McTigue', role: 'Marketing Agency Owner', image: '/images/testimonial-marlene.png', title: 'Marlene McTigue — Marketing Agency Owner' },
          { text: "I'm always impressed with Sean and his team. They stay on top of the latest technology in mailing and data management. True professionals.", name: 'James Yaston', role: 'Business Owner', image: '/images/testimonial-james.png', title: 'James Yaston — Business Owner' },
          { text: 'I needed postcards printed and mailed fast. Cornerstone was knowledgeable, friendly, reliable, and delivered on time. Will use again.', name: 'Sapna Moudgil-Shah', role: 'Small Business Owner', image: '/images/testimonial-sapna.png', title: 'Sapna Moudgil-Shah — Small Business Owner' },
        ].map((testimonial) => (
          <div class="bg-navy-50/60 rounded-xl p-6 border border-navy-100">
            <div class="flex gap-0.5 mb-3">
              {[...Array(5)].map(() => (
                <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <svg class="w-8 h-8 text-crst-gold/40 mb-3" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
            <p class="text-sm text-navy-700 leading-relaxed mb-4 italic">"{testimonial.text}"</p>
            <div class="flex items-center gap-3">
              <img src={testimonial.image} alt={testimonial.name} title={testimonial.title} class="w-10 h-10 rounded-full object-cover" loading="lazy" />
              <div>
                <div class="font-heading font-semibold text-navy-800 text-sm">{testimonial.name}</div>
                <div class="text-xs text-navy-500">{testimonial.role}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- From the Blog -->
  <section class="py-14 lg:py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <div class="section-divider mx-auto mb-6"></div>
        <div class="flex items-center justify-center gap-4">
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary">Latest Articles</h2>
        </div>
        <p class="text-gray-600 mt-2">Insights and guides for smarter direct mail campaigns. <a href="https://blog.crst.net/" title="Cornerstone Services Blog" class="text-crst-accent hover:text-crst-primary underline text-sm">View all &rarr;</a></p>
      </div>
      <div id="latest-posts" class="grid md:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 animate-pulse">
          <div class="h-5 w-3/4 bg-gray-200 rounded mb-3"></div>
          <div class="h-3 w-1/3 bg-gray-200 rounded"></div>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 animate-pulse">
          <div class="h-5 w-3/4 bg-gray-200 rounded mb-3"></div>
          <div class="h-3 w-1/3 bg-gray-200 rounded"></div>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 animate-pulse">
          <div class="h-5 w-3/4 bg-gray-200 rounded mb-3"></div>
          <div class="h-3 w-1/3 bg-gray-200 rounded"></div>
        </div>
      </div>
      <script is:inline>
        (async function () {
          var root = document.getElementById('latest-posts');
          if (!root) return;
          try {
            var res = await fetch('/api/latest-posts.json');
            var data = await res.json();
            if (!data || !data.ok || !Array.isArray(data.posts) || data.posts.length === 0) {
              root.innerHTML = '<div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 text-sm text-gray-600">No recent posts found. <a class="text-crst-accent hover:underline" href="https://blog.crst.net/">Visit the blog</a>.</div>';
              return;
            }
            root.innerHTML = data.posts.slice(0, 3).map(function (p) {
              var date = p.date ? new Date(p.date).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : '';
              var title = (p.title || '').replace(/</g, '&lt;').replace(/>/g, '&gt;');
              var url = (p.url || '').replace(/"/g, '&quot;');
              return '<a href="' + url + '" class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow group" target="_blank" rel="noopener">' +
                '<h3 class="text-lg font-display font-bold text-crst-primary group-hover:text-crst-accent transition-colors mb-2">' + title + '</h3>' +
                '<div class="text-xs text-gray-500">' + date + '</div>' +
                '</a>';
            }).join('');
          } catch (e) {
            root.innerHTML = '<div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 text-sm text-gray-600">Unable to load posts right now. <a class="text-crst-accent hover:underline" href="https://blog.crst.net/">Visit the blog</a>.</div>';
          }
        })();
      </script>
    </div>
  </section>

  <CTASection />
</BaseLayout>
