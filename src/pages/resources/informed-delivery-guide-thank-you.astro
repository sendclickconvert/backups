---
export const prerender = true;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>You're In — Your Informed Delivery Guide Is On Its Way | Cornerstone Services</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192.png" />
  <link rel="apple-touch-icon" href="/images/favicon-192.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Source+Sans+3:wght@400;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --navy:   #0F1B2D;
      --navy-2: #16273d;
      --gold:   #B8893A;
      --gold-l: #d3a556;
      --cream:  #FAF6EE;
      --ink:    #1a2230;
      --muted:  #5f6b7a;
      --line:   #e6ddcd;
      --red:    #C0392B;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
    body {
      background: var(--cream);
      color: var(--ink);
      font-family: 'Source Sans 3', system-ui, sans-serif;
      font-size: clamp(15px, 1vw + 11px, 17px);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }
    *:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
    .f-display { font-family: 'Playfair Display', Georgia, serif; }
    .f-mono    { font-family: 'JetBrains Mono', monospace; }
    .eyebrow {
      font-family: 'JetBrains Mono', monospace;
      font-size: .7rem;
      letter-spacing: .18em;
      text-transform: uppercase;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .5rem;
      background: var(--gold);
      color: #fff;
      font-family: 'Source Sans 3', sans-serif;
      font-size: .95rem;
      font-weight: 700;
      padding: .9rem 2.2rem;
      border-radius: 6px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      letter-spacing: .015em;
      transition: background .18s, transform .1s;
    }
    .btn:hover  { background: var(--gold-l); }
    .btn:active { transform: scale(.98); }

    /* upsell grid */
    .upsell-grid {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 0;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 16px 56px rgba(0,0,0,.13), 0 2px 8px rgba(0,0,0,.06);
    }
    @media (max-width: 800px) {
      .upsell-grid { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body>

<!-- ══════════════════════════════════════════════════════════════════
     1) RED ALERT BAR
     ══════════════════════════════════════════════════════════════════ -->
<div style="background:var(--red); color:#fff; text-align:center; padding:.75rem 1.5rem">
  <p style="font-weight:700; font-size:clamp(.9rem, 1.5vw + .5rem, 1.05rem); line-height:1.4">
    ✅ Your Informed Delivery guide is on its way to your inbox.
  </p>
  <p style="font-size:.82rem; margin-top:.25rem; opacity:.9">
    Give it a few minutes to arrive — and check your spam folder if you don't see it.
  </p>
</div>

<!-- ══════════════════════════════════════════════════════════════════
     2) BLACK BAR
     ══════════════════════════════════════════════════════════════════ -->
<div style="background:#111; color:rgba(255,255,255,.8); text-align:center; padding:.55rem 1.5rem; font-size:.82rem">
  Add <strong style="color:#fff">info@crst.net</strong> to your contacts so the guide lands straight in your inbox.
</div>

<!-- ══════════════════════════════════════════════════════════════════
     3) CONFIRMATION HERO
     ══════════════════════════════════════════════════════════════════ -->
<section style="position:relative; background:linear-gradient(160deg, var(--navy) 0%, var(--navy-2) 100%); padding:4rem 1.5rem 4.5rem; text-align:center; overflow:hidden">
  <!-- dotted texture -->
  <div aria-hidden="true" style="position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,.06) 1px,transparent 1px);background-size:22px 22px;pointer-events:none"></div>
  <div style="position:relative; max-width:760px; margin:0 auto">
    <!-- Green circle checkmark -->
    <div style="display:inline-flex; align-items:center; justify-content:center; width:72px; height:72px; border-radius:50%; background:#22c55e; margin:0 auto 1.5rem; box-shadow:0 0 0 8px rgba(34,197,94,.15)" aria-hidden="true">
      <svg style="width:36px;height:36px;color:#fff" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
      </svg>
    </div>

    <p class="eyebrow" style="color:var(--gold); margin-bottom:.75rem">You're In</p>
    <h1 class="f-display" style="font-size:clamp(2rem, 4vw + 1rem, 2.9rem); color:#fff; line-height:1.15; margin-bottom:1.1rem">
      Your guide is on the way.
    </h1>
    <p style="color:rgba(255,255,255,.75); font-size:1.05rem; line-height:1.6; max-width:500px; margin:0 auto 1rem">
      Check your inbox for the <em>USPS Informed Delivery for Direct Mailers</em> guide. If it's not there in a few minutes, search "Cornerstone" or check your spam folder.
    </p>
    <p style="color:rgba(255,255,255,.45); font-size:.82rem; margin-bottom:2.5rem">
      Didn't arrive? <a href="mailto:info@crst.net" style="color:var(--gold-l); text-decoration:underline; text-underline-offset:3px">info@crst.net</a> &nbsp;·&nbsp;
      <a href="tel:8452555722" style="color:var(--gold-l); text-decoration:underline; text-underline-offset:3px">(845) 255-5722</a>
    </p>

    <!-- Video -->
    <div id="ty-video-slot" style="position:relative; aspect-ratio:16/9; border-radius:12px; overflow:hidden; background:#000">
      <iframe
        src="https://player.vimeo.com/video/1210894679?badge=0&autopause=0&player_id=0&app_id=58479"
        style="position:absolute;inset:0;width:100%;height:100%;border:0"
        allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
        allowfullscreen
        title="USPS Informed Delivery — Watch Before You Go">
      </iframe>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════════════════
     5) UPSELL CARD
     ══════════════════════════════════════════════════════════════════ -->
<section style="padding:4rem 1.5rem 5rem; background:var(--cream)">
  <div style="max-width:900px; margin:0 auto">
    <div class="upsell-grid">

      <!-- LEFT: offer copy -->
      <div style="background:#fff; padding:clamp(2rem,4vw,3rem)">
        <p class="eyebrow" style="color:var(--muted); margin-bottom:.85rem">While You're Here</p>
        <h2 class="f-display" style="font-size:clamp(1.5rem,2.5vw + .75rem,2rem); color:var(--navy); line-height:1.2; margin-bottom:1rem">
          Want us to just set it up for you?
        </h2>
        <p style="color:var(--muted); line-height:1.7; margin-bottom:1.5rem">
          You've got the guide. But if you'd rather skip the mailer IDs, USPS portal, and image specs — that's what we handle every day for Hudson Valley businesses.
        </p>

        <!-- Checklist -->
        <ul style="list-style:none; display:flex; flex-direction:column; gap:.75rem; margin-bottom:2rem">
          {[
            'We design the ride-along image to match your mail piece',
            'We wire up the clickable link and tracking URL',
            'We time it to go live before your mail drops',
            'You just approve it, then watch the numbers',
          ].map(item => (
            <li style="display:flex; align-items:flex-start; gap:.7rem">
              <span style="display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;min-width:20px;border-radius:50%;background:#22c55e;margin-top:.15rem" aria-hidden="true">
                <svg style="width:11px;height:11px;color:#fff" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
              </span>
              <span style="color:var(--ink); line-height:1.5">{item}</span>
            </li>
          ))}
        </ul>

        <a href="/contact" class="btn" style="width:100%; text-align:center">
          Get my Informed Delivery setup done
          <svg style="width:16px;height:16px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <p style="margin-top:.75rem; font-size:.78rem; color:var(--muted); text-align:center">No obligation — just a quick conversation.</p>
      </div>

      <!-- RIGHT: Sean panel (navy) -->
      <div style="background:var(--navy); padding:clamp(2rem,4vw,3rem); display:flex; flex-direction:column; align-items:center; text-align:center; gap:1.25rem">
        <img
          src="/images/wp/sean2.png"
          alt="Sean H. Griffin, President of Cornerstone Services"
          width="120" height="120"
          style="width:120px;height:120px;border-radius:50%;object-fit:cover;object-position:top;border:3px solid var(--gold);flex-shrink:0"
          loading="eager"
        />
        <div>
          <p class="f-display" style="color:#fff; font-size:1.05rem; font-weight:600; line-height:1.2">Sean H. Griffin</p>
          <p class="f-mono" style="color:var(--gold); font-size:.68rem; letter-spacing:.1em; margin-top:.3rem">President · USPS® MDP</p>
        </div>

        <blockquote style="color:rgba(255,255,255,.72); font-style:italic; font-size:.92rem; line-height:1.65; border-left:2px solid var(--gold); padding-left:1rem; text-align:left; margin:0">
          "Honestly, most people who download this guide end up calling us to run it anyway — because the setup is fiddly the first time. We're happy to do it."
        </blockquote>

        <!-- Stats -->
        <div style="width:100%; display:flex; flex-direction:column; gap:.6rem; margin-top:.25rem">
          {[
            { stat: '1998', label: 'Mailing for Hudson Valley businesses since' },
            { stat: '2.3M+', label: 'Pieces mailed and counting' },
            { stat: 'USPS®', label: 'Certified · Printer Directory · BBB A+' },
          ].map(({ stat, label }) => (
            <div style="display:flex; align-items:center; gap:.85rem; border-top:1px solid rgba(255,255,255,.1); padding-top:.6rem">
              <span class="f-mono" style="color:var(--gold); font-size:1rem; font-weight:500; min-width:3.5rem; text-align:right; flex-shrink:0">{stat}</span>
              <span style="color:rgba(255,255,255,.55); font-size:.78rem; line-height:1.3; text-align:left">{label}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════════════════
     6) MINIMAL FOOTER
     ══════════════════════════════════════════════════════════════════ -->
<footer style="background:var(--navy); padding:1.5rem; text-align:center">
  <p class="f-mono" style="color:rgba(255,255,255,.35); font-size:.7rem; letter-spacing:.06em; line-height:1.8">
    Cornerstone Services, Inc. · 387 Malden Turnpike, Saugerties, NY 12477 ·
    <a href="tel:8452555722" style="color:rgba(255,255,255,.4); text-decoration:none">(845) 255-5722</a> ·
    © 2026
  </p>
</footer>

</body>
</html>
