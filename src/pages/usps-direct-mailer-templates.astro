---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import { BUSINESS } from '../data/site';
const STAGING = "https://bhgr11gfrh.wpdns.site/wp-content/uploads";
const postcardTemplates = [
  { size: '3 1/2" x 5"', pdf: `${STAGING}/2023/10/3.5-x-5-Postcard-Template.pdf`, jpg: `${STAGING}/2023/10/3.5-x-5-Postcard-Template-Image.jpg` },
  { size: '4" x 6"', pdf: `${STAGING}/2023/10/4-x-6-Postcard-Template.pdf`, jpg: `${STAGING}/2023/10/4-x-6-Postcard-Template-Image.jpg` },
  { size: '4 1/4" x 6"', pdf: `${STAGING}/2023/10/4.25-x-6-Postcard-Template.pdf`, jpg: `${STAGING}/2023/10/4.25-x-6-Postcard-Template-Image.jpg` },
  { size: '5" x 7"', pdf: `${STAGING}/2023/10/5-x-7-Postcard-Template.pdf`, jpg: `${STAGING}/2023/10/5-x-7-Postcard-Template-Image.jpg` },
  { size: '5" x 10"', pdf: `${STAGING}/2023/10/5-x-10-Postcard-Template.pdf`, jpg: `${STAGING}/2023/10/5-x-10-Postcard-Template-Image-scaled.jpg` },
  { size: '5 1/2" x 8 1/2"', pdf: `${STAGING}/2023/10/5.5-x-8.5-Postcard-Template.pdf`, jpg: `${STAGING}/2023/10/5.5-x-8.5-Postcard-Template-Image-scaled.jpg` },
  { size: '6" x 9"', pdf: `${STAGING}/2023/10/6-x-9-Postcard-Template.pdf`, jpg: `${STAGING}/2023/10/6-x-9-Postcard-Template-Image-scaled.jpg` },
  { size: '6" x 11"', pdf: `${STAGING}/2023/10/6-x-11-Postcard-Template.pdf`, jpg: `${STAGING}/2023/10/6-x-11-Postcard-Template-Image-scaled.jpg` },
];
const eddmTemplates = [
  { size: '3 1/2" x 11"', pdf: `${STAGING}/2023/10/3.5-x-11-EDDM-Flat-Card-Template.pdf`, jpg: `${STAGING}/2023/10/3.5-x-11-EDDM-Flat-Card-Template-Image-scaled.jpg` },
  { size: '4 1/4" x 11"', pdf: `${STAGING}/2023/10/4.25-x-11-EDDM-Flat-Card-Template.pdf`, jpg: `${STAGING}/2023/10/4.25-x-11-EDDM-Flat-Card-Template-Image-scaled.jpg` },
  { size: '6" x 11"', pdf: `${STAGING}/2023/10/6-x-11-EDDM-Flat-Card-Template.pdf`, jpg: `${STAGING}/2023/10/6-x-11-EDDM-Flat-Card-Template-Image-scaled.jpg` },
  { size: '6 1/2" x 9"', pdf: `${STAGING}/2023/10/6.5-x-9-EDDM-Flat-Card-Template.pdf`, jpg: `${STAGING}/2023/10/6.5-x-9-EDDM-Flat-Card-Template-Image-scaled.jpg` },
  { size: '8" x 8"', pdf: `${STAGING}/2023/10/8-x-8-EDDM-Flat-Card-Template.pdf`, jpg: `${STAGING}/2023/10/8-x-8-EDDM-Flat-Card-Template-Image-scaled.jpg` },
  { size: '8 1/2" x 11"', pdf: `${STAGING}/2023/10/8.5-x-11-EDDM-Flat-Card-Template.pdf`, jpg: `${STAGING}/2023/10/8.5-x-11-EDDM-Flat-Card-Template-Image-scaled.jpg` },
  { size: '8 1/2" x 14"', pdf: `${STAGING}/2023/10/8.5-x-14-half-size-8.5-x7-EDDM-Flat-Card-Template.pdf`, jpg: `${STAGING}/2023/10/8.5-x-14-half-size-8.5-x7-EDDM-Flat-Card-Template-Image-scaled.jpg` },
  { size: '9" x 9"', pdf: `${STAGING}/2023/10/9-x-9-EDDM-Flat-Card-Template.pdf`, jpg: `${STAGING}/2023/10/9-x-9-EDDM-Flat-Card-Template-Image-scaled.jpg` },
  { size: '11" x 17"', pdf: `${STAGING}/2023/10/11-x-17-half-size-8.5-x11-EDDM-Flat-Card-Template.pdf`, jpg: `${STAGING}/2023/10/11-x-17-half-size-8.5-x11-EDDM-Flat-Card-Template-Image-scaled.jpg` },
];
const doorHangerTemplates = [
  { size: '3 1/2" x 8 1/2"', pdf: `${STAGING}/2023/10/3.5-x-8.5-Door-Hanger-Tear-Off-Template.pdf`, jpg: `${STAGING}/2023/10/3.5-x-8.5-Door-Hanger-Tear-Off-Template-Image-scaled.jpg` },
  { size: '4 1/4" x 11"', pdf: `${STAGING}/2023/10/4.25-x-11-DoorHanger-Tear-Off-Template.pdf`, jpg: `${STAGING}/2023/10/4.25-x-11-DoorHanger-Tear-Off-Template-Image-scaled.jpg` },
];
const envelopeTemplates = [
  { size: 'A2 Mailing Envelope', pdf: `${STAGING}/2023/11/A2-Mailing-Envelope-Template.pdf`, jpg: `${STAGING}/2023/11/A2-Mailing-Envelope-Template.jpg` },
  { size: 'A2 CRE (Courtesy Reply Envelope)', pdf: `${STAGING}/2023/11/A2-CRE-Template.pdf`, jpg: `${STAGING}/2023/11/A2-CRE-Template.jpg` },
  { size: 'A6 Mailing Envelope', pdf: `${STAGING}/2023/11/A6-Mailing-Envelope-Template.pdf`, jpg: `${STAGING}/2023/11/A6-Mailing-Envelope-Template.jpg` },
  { size: 'A6 CRE (Courtesy Reply Envelope)', pdf: `${STAGING}/2023/11/A6-CRE-Template.pdf`, jpg: `${STAGING}/2023/11/A6-CRE-Template.jpg` },
  { size: 'A8 Mailing Envelope', pdf: `${STAGING}/2023/11/A8-Mailing-Envelope-Template.pdf`, jpg: `${STAGING}/2023/11/A8-Mailing-Envelope-Template.jpg` },
  { size: 'A9 Mailing Envelope', pdf: `${STAGING}/2023/11/A9-Mailing-Envelope-Template.pdf`, jpg: `${STAGING}/2023/11/A9-Mailing-Envelope-Template.jpg` },
  { size: '#9 CRE (Courtesy Reply Envelope)', pdf: `${STAGING}/2023/11/9-CRE-Template.pdf`, jpg: `${STAGING}/2023/11/9-CRE-Template-scaled.jpg` },
  { size: '#10 Regular Envelope', pdf: `${STAGING}/2023/11/10-Envelope-Template.pdf`, jpg: `${STAGING}/2023/11/10-Envelope-Template-scaled.jpg` },
  { size: '#10 Window Envelope', pdf: `${STAGING}/2023/11/10-Window-Envelope-Template.pdf`, jpg: `${STAGING}/2023/11/10-Window-Envelope-Template-scaled.jpg` },
  { size: '#11 Regular Envelope', pdf: `${STAGING}/2023/11/11-Envelope-Template.pdf`, jpg: `${STAGING}/2023/11/11-Envelope-Template-scaled.jpg` },
  { size: '#14 Regular Envelope', pdf: `${STAGING}/2023/11/14-Envelope-Template.pdf`, jpg: `${STAGING}/2023/11/14-Envelope-Template-scaled.jpg` },
];
const brochureTemplates = [
  { size: '8 1/2" x 11"', note: 'tri-fold to 8 1/2" x 3 2/3"', pdf: `${STAGING}/2023/10/8.5-X-11-Tri-fold-Brochure-Letter-Rate-Template.pdf`, jpg: `${STAGING}/2023/10/8.5-X-11-Tri-fold-Brochure-Letter-Rate-Template-Image.jpg` },
  { size: '8 1/2" x 11"', note: 'half fold to 8 1/2" x 5 1/2"', pdf: `${STAGING}/2023/10/8.5-X-11-Half-Fold-Brochure-Letter-Rate-Template-Image.jpg`, jpg: `${STAGING}/2023/10/8.5-X-11-Half-Fold-Brochure-Letter-Rate-Template.pdf` },
  { size: '8 1/2" x 14"', note: 'double parallel fold to 8 1/2" x 3 1/2"', pdf: `${STAGING}/2023/10/8.5-x-14-Double-Parallel-Fold-Brochure-Letter-Rate-Template.pdf`, jpg: `${STAGING}/2023/10/8.5-x-14-Double-Parallel-Fold-Brochure-Letter-Rate-Template-Image.jpg` },
  { size: '8 1/2" x 14"', note: 'tri-fold to 8 1/2" x 4 2/3"', pdf: `${STAGING}/2023/10/8.5-x-14-Tri-Fold-Brochure-Letter-Rate-Template.pdf`, jpg: `${STAGING}/2023/10/8.5-x-14-Tri-Fold-Brochure-Letter-Rate-Template-Image.jpg` },
  { size: '11" x 17"', note: 'French Fold Brochure', pdf: `${STAGING}/2023/10/11-x-17-French-Fold-Brochure-Letter-Rate-Template.pdf`, jpg: `${STAGING}/2023/10/11-x-17-French-Fold-Brochure-Letter-Rate-Template-Image-scaled.jpg` },
];
const otherTools = [
  { label: 'Mailing Permits', href: '/direct-mail-tools/cornerstone-mailing-permits' },
  { label: 'Postage Rates', href: '/direct-mail-tools/postage-rates' },
  { label: 'Envelope Sizes', href: '/direct-mail-tools/envelope-sizes' },
  { label: 'Postal Dictionary', href: '/direct-mail-tools/postal-dictionary' },
  { label: 'Mail Forwarding', href: '/direct-mail-tools/address-change' },
  { label: 'Mail Automation', href: '/direct-mail-tools/mailing-letter-rates' },
  { label: 'Non-Profit Mailing', href: '/direct-mail-tools/non-profit-organization' },
  { label: 'EDDM Guide', href: '/direct-mail-tools/eddm-guide' },
];
interface TemplateItem {
  size: string;
  pdf: string;
  jpg: string;
  note?: string;
}
const sections: { title: string; icon: string; templates: TemplateItem[]; intro?: string }[] = [
  { title: 'Standard Letter Rate Postcards', icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z', templates: postcardTemplates },
  { title: 'Standard EDDM Size Flat Cards', icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7', templates: eddmTemplates },
  { title: 'Door Hangers', icon: 'M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z', templates: doorHangerTemplates },
  { title: 'Envelopes', icon: 'M3 19V5a2 2 0 012-2h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2z', templates: envelopeTemplates },
  { title: 'Brochures (Letter Rate)', icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2', templates: brochureTemplates },
];
---
<BaseLayout
  title="Free USPS Direct Mail Templates — Postcards, EDDM Flats, Envelopes & Brochures (PDF)"
  description="Download free press-ready USPS direct mail templates for postcards, EDDM flats, envelopes, door hangers, and brochures. Pre-built with bleed areas, barcode clear zones, and address block positioning to USPS automation specs."
>
  <PageHero
    title="USPS® Direct Mail Templates"
    subtitle="Press-ready PDF templates for postcards, EDDM flats, envelopes, and brochures — pre-built to USPS automation specs with bleed areas, barcode clear zones, and address block positioning."
    breadcrumbs={[
      { label: 'Direct Mail Tools', href: '/direct-mail-tools' },
      { label: 'USPS Templates' },
    ]}
  />
  <section class="py-14 lg:py-20">
    <div class="container-wide">
      <div class="grid lg:grid-cols-[280px_1fr] gap-10 items-start">
        <aside class="hidden lg:flex flex-col gap-6 sticky top-6">
          <a href="/direct-mail-tools" class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-crst-primary border-2 border-crst-primary rounded-lg px-4 py-2.5 hover:bg-crst-primary hover:text-white transition-colors text-center justify-center">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
            View All Resources
          </a>
          <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
            <h3 class="font-heading font-bold text-crst-primary text-sm uppercase tracking-wider mb-1">Let's Talk Goals!</h3>
            <div class="w-10 h-0.5 bg-crst-gold mb-3"></div>
            <p class="text-sm text-navy-600/70 mb-4">Describe success in a sentence; we'll map the campaign to get you there.</p>
            <div class="space-y-3">
              <a href="/estimate" class="block w-full text-center text-sm font-heading font-semibold text-white bg-crst-primary rounded-lg px-4 py-2.5 hover:bg-navy-700 transition-colors">
                Get Free Estimate
              </a>
              <a href={`tel:${BUSINESS.phoneClean}`} class="block w-full text-center text-sm font-heading font-semibold text-crst-primary border border-crst-primary/30 rounded-lg px-4 py-2.5 hover:bg-crst-primary/5 transition-colors">
                Call {BUSINESS.phone}
              </a>
            </div>
          </div>
          <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
            <h3 class="font-heading font-bold text-crst-primary text-sm uppercase tracking-wider mb-3">Other Resources</h3>
            <nav class="flex flex-col gap-2">
              {otherTools.map(tool => (
                <a href={tool.href} class="text-sm font-heading font-medium text-navy-700 px-3 py-2 bg-gray-50 rounded-md border-l-3 border-crst-gold hover:bg-crst-primary hover:text-white hover:border-crst-gold transition-colors">
                  {tool.label}
                </a>
              ))}
            </nav>
          </div>
        </aside>
        <main>
          <div class="bg-white border border-gray-200 rounded-xl p-6 sm:p-8 shadow-sm">
            <h2 class="text-2xl font-display text-crst-primary mb-2 pb-3 border-b-3 border-crst-gold">
              USPS® Direct Mail Templates
            </h2>
            <p class="text-sm text-navy-600/70 mb-4">
              Download print-ready templates pre-formatted to <a href="/direct-mail-tools/postal-dictionary" class="text-crst-primary underline hover:text-crst-gold">USPS automation specifications</a>. Each template includes proper barcode clear zones, address block positioning, and bleed areas.
            </p>
            <p class="text-sm text-navy-600/70 mb-6">
              These templates are used by businesses of all sizes running <a href="/direct-mail-marketing" class="text-crst-primary underline hover:text-crst-gold">direct mail campaigns</a> — from local retailers to nonprofits qualifying for <a href="/non-profit-mailing-application" class="text-crst-primary underline hover:text-crst-gold">reduced nonprofit postage rates</a>. If you're not sure which size fits your budget, check our <a href="/direct-mail-tools/postage-rates" class="text-crst-primary underline hover:text-crst-gold">letter automation rates guide</a> before you design.
            </p>

            <div class="bg-navy-50 border border-navy-100 rounded-xl p-5 mb-6">
              <h3 class="text-sm font-heading font-bold text-navy-800 mb-2">What's included in every template</h3>
              <p class="text-sm text-navy-600/80 leading-relaxed">
                Every template is built to USPS automation specifications and exported in press-ready PDF format with CMYK color mode, proper bleed areas, and designated zones for <a href="/direct-mail-tools/postal-dictionary" class="text-crst-primary underline hover:text-crst-gold">barcode placement</a> and address block positioning. Files are compatible with Adobe Illustrator, InDesign, and Photoshop. Postcard and flat templates are sized to meet USPS aspect ratio requirements, keeping your piece machinable and avoiding the <a href="/direct-mail-tools/envelope-sizes" class="text-crst-primary underline hover:text-crst-gold">nonmachinable surcharge</a>. Need help with layout or artwork? Our <a href="/services/graphic-design" class="text-crst-primary underline hover:text-crst-gold">graphic design team</a> can customize any template for your campaign, and our <a href="/services/printing" class="text-crst-primary underline hover:text-crst-gold">commercial printing services</a> produce press-ready pieces on the stock and finish you need.
              </p>
            </div>

            <div class="flex items-start gap-4 bg-white border border-gray-200 rounded-xl p-5 mb-6">
              <div class="shrink-0 w-10 h-10 rounded-full bg-crst-primary/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-crst-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
              </div>
              <div>
                <p class="text-sm font-heading font-semibold text-navy-800">Maintained by Sean Griffen, Owner — Cornerstone Services, Inc.</p>
                <p class="text-xs text-navy-500 mt-1">Sean has produced USPS-compliant direct mail for Hudson Valley businesses since 1998. These templates reflect the exact specifications Cornerstone applies to every print job — First-Class letters, Marketing Mail postcards, and EDDM flats processed through the USPS Business Mail Entry Unit (BMEU) in New Paltz, NY.</p>
              </div>
            </div>

            {sections.map((section, sIdx) => (
              <div class={sIdx > 0 ? 'mt-8 pt-8 border-t border-gray-200' : ''}>
                <div class="flex items-center gap-3 mb-4">
                  <div class="w-9 h-9 rounded-lg bg-crst-primary/10 flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-crst-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d={section.icon} />
                    </svg>
                  </div>
                  <h3 class="text-sm font-heading font-bold uppercase tracking-wider text-crst-primary">{section.title}</h3>
                </div>
                <div class="space-y-2">
                  {section.templates.map((t: TemplateItem, i: number) => (
                    <div class={`flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 sm:gap-4 px-4 py-3 rounded-lg border border-gray-100 ${i % 2 === 0 ? 'bg-gray-50/80' : 'bg-white'}`}>
                      <div class="flex-1 min-w-0">
                        <span class="font-heading font-bold text-sm text-navy-800">{t.size}</span>
                        {t.note && <span class="block text-xs text-navy-500 mt-0.5">({t.note})</span>}
                      </div>
                      <div class="flex gap-2 flex-shrink-0">
                        <a href={t.pdf} download class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-heading font-semibold text-white bg-crst-primary rounded hover:bg-navy-700 transition-colors">
                          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                          PDF
                        </a>
                        <a href={t.jpg} download class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-heading font-semibold text-white bg-crst-primary rounded hover:bg-navy-700 transition-colors">
                          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                          JPG
                        </a>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))}
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-10 pt-6 border-t border-gray-200">
              {[
                { icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z', title: 'Call Us', desc: 'We are here to help!', href: `tel:${BUSINESS.phoneClean}` },
                { icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z', title: 'Latest Info', desc: 'Up-to-date templates', href: '/direct-mail-tools/postage-rates' },
                { icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z', title: '100% Secure', desc: 'Safe downloads', href: '/about' },
                { icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z', title: 'Free Estimate', desc: 'Get a free estimate', href: '/estimate' },
              ].map(badge => (
                <a href={badge.href} class="text-center p-4 bg-gray-50 rounded-lg hover:bg-crst-primary/5 transition-colors block">
                  <svg class="w-5 h-5 text-crst-primary mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d={badge.icon} />
                  </svg>
                  <div class="font-heading font-bold text-xs text-navy-800">{badge.title}</div>
                  <div class="text-xs text-navy-500 mt-0.5">{badge.desc}</div>
                </a>
              ))}
            </div>
          </div>
          <div class="lg:hidden mt-8 bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
            <h3 class="font-heading font-bold text-crst-primary text-sm uppercase tracking-wider mb-3">Other Resources</h3>
            <div class="grid grid-cols-2 gap-2">
              {otherTools.map(tool => (
                <a href={tool.href} class="text-sm font-heading font-medium text-navy-700 px-3 py-2 bg-gray-50 rounded-md border-l-3 border-crst-gold hover:bg-crst-primary hover:text-white transition-colors">
                  {tool.label}
                </a>
              ))}
            </div>
          </div>
        </main>
      </div>
    </div>
  </section>
  <CTASection
    headline="Show Us the Goal, We'll Build the Path"
    text="Practical tips, trends, and case studies to grow visibility and response, online and in the mailbox."
  />
</BaseLayout>
