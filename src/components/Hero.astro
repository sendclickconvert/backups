---
import { BUSINESS } from '../data/site';
---

<section class="hero-video-section relative w-full min-h-[90vh] md:min-h-screen flex items-center overflow-hidden">

  <video
    id="hero-video"
    class="absolute inset-0 w-full h-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="/images/hero-poster.jpg"
  >
    <source src="/videos/hero-video.mp4" type="video/mp4" />
  </video>

  <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/55 to-black/40 z-10"></div>

  <div class="absolute inset-0 opacity-[0.03] z-10 pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>

  <div class="relative z-20 container mx-auto px-6 md:px-12 lg:px-16 py-20 md:py-0">
    <div class="max-w-3xl">

      <p class="hero-tagline text-crst-accent font-semibold text-sm md:text-base tracking-[0.2em] uppercase mb-4 opacity-0">
        Hudson Valley's Trusted Print & Mail Partner
      </p>

      <h1 class="hero-headline font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-white leading-[1.1] mb-6 opacity-0">
        Direct Mail That<br />
        <span class="text-crst-accent">Delivers Results</span>
      </h1>

      <p class="hero-sub text-white/85 text-lg md:text-xl leading-relaxed mb-8 max-w-xl opacity-0">
        From design to delivery — printing, mailing, and data services trusted by businesses across Ulster, Dutchess, and Orange counties since {BUSINESS.founded}.
      </p>

      <div class="hero-ctas flex flex-col sm:flex-row gap-4 opacity-0">
        <a
          href="/estimate/"
          class="inline-flex items-center justify-center px-8 py-4 bg-crst-accent hover:bg-crst-accent/90 text-white font-bold rounded-lg text-lg transition-all duration-300 hover:shadow-xl hover:shadow-crst-accent/25 hover:-translate-y-0.5"
        >
          Get a Free Estimate
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href={`tel:${BUSINESS.phoneClean}`}
          class="inline-flex items-center justify-center px-8 py-4 border-2 border-white/30 hover:border-white/60 text-white font-semibold rounded-lg text-lg transition-all duration-300 hover:bg-white/10"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {BUSINESS.phone}
        </a>
      </div>

    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 hidden md:flex flex-col items-center gap-2 opacity-0 hero-scroll-hint">
    <span class="text-white/50 text-xs tracking-widest uppercase">Scroll</span>
    <div class="w-[1px] h-8 bg-gradient-to-b from-white/50 to-transparent animate-pulse"></div>
  </div>

</section>

<style>
  .hero-tagline  { animation: heroFadeUp 0.8s ease-out 0.3s forwards; }
  .hero-headline { animation: heroFadeUp 0.8s ease-out 0.5s forwards; }
  .hero-sub      { animation: heroFadeUp 0.8s ease-out 0.7s forwards; }
  .hero-ctas     { animation: heroFadeUp 0.8s ease-out 0.9s forwards; }
  .hero-scroll-hint { animation: heroFadeUp 0.8s ease-out 1.2s forwards; }

  @keyframes heroFadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  #hero-video {
    animation: heroVideoZoom 25s ease-in-out infinite alternate;
  }

  @keyframes heroVideoZoom {
    from { transform: scale(1); }
    to   { transform: scale(1.06); }
  }

  .hero-video-section video {
    min-width: 100%;
    min-height: 100%;
  }
</style>

<script>
  const video = document.getElementById('hero-video') as HTMLVideoElement;
  if (video) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (prefersReducedMotion.matches) {
      video.pause();
      video.style.animation = 'none';
    }

    video.play().catch(() => {});
  }
</script>
