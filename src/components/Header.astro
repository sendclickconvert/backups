---
import { BUSINESS, NAV_ITEMS } from '../data/site';
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-navy-100/60" id="site-header">
  <!-- Top bar -->
  <div class="bg-crst-primary text-white/90 text-xs font-heading">
    <div class="container-wide flex items-center justify-between py-1.5">
      <div class="flex items-center gap-4">
        <a href={`tel:${BUSINESS.phoneClean}`} class="flex items-center gap-1.5 hover:text-white transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          {BUSINESS.phone}
        </a>
        <a href={`mailto:${BUSINESS.email}`} class="hidden sm:flex items-center gap-1.5 hover:text-white transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          {BUSINESS.email}
        </a>
      </div>
      <div class="hidden sm:flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        {BUSINESS.address.city}, {BUSINESS.address.state}
      </div>
    </div>
  </div>

  <!-- Main nav -->
  <div class="container-wide">
    <nav class="flex items-center justify-between h-16 lg:h-18" aria-label="Primary navigation">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0" aria-label={`${BUSINESS.name} — Home`}>
        <img
          src="/images/crst-logo.png"
          alt={`${BUSINESS.name} logo`}
          class="h-10 w-auto"
          width="160"
          height="40"
        />
      </a>

      <!-- Desktop nav -->
      <div class="hidden lg:flex items-center gap-1">
        {NAV_ITEMS.map((item) => (
          <div class="relative group">
            <a
              href={item.href}
              class="flex items-center gap-1 px-3 py-2 text-sm font-heading font-medium text-navy-700 
                     rounded-md hover:text-crst-primary hover:bg-navy-50 transition-colors"
            >
              {item.label}
              {item.children && (
                <svg class="w-3.5 h-3.5 opacity-50 group-hover:opacity-80 transition-all group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              )}
            </a>
            {item.children && (
              <div class="absolute top-full left-0 pt-1 opacity-0 invisible 
                          group-hover:opacity-100 group-hover:visible 
                          transition-all duration-200 z-50">
                <div class="bg-white rounded-xl shadow-xl shadow-navy-900/10 border border-navy-100 
                            py-2 min-w-[220px]">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="block px-4 py-2 text-sm font-heading text-navy-700 
                             hover:text-crst-primary hover:bg-navy-50 transition-colors"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- CTA + mobile toggle -->
      <div class="flex items-center gap-3">
        <a href="/resources/payments/" class="p-2 rounded-md text-navy-600 hover:text-crst-primary hover:bg-navy-50 transition-colors" aria-label="Order Form" title="Order Form">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/></svg>
        </a>
        <a href="/estimate/" class="btn-primary hidden sm:inline-flex text-xs px-4 py-2.5">
          Get Estimate
        </a>
        <button
          type="button"
          class="lg:hidden p-2 rounded-md text-navy-600 hover:bg-navy-50 transition-colors"
          aria-label="Open menu"
          id="mobile-menu-toggle"
        >
          <svg class="w-6 h-6" id="menu-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg class="w-6 h-6 hidden" id="menu-icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div class="hidden lg:hidden border-t border-navy-100" id="mobile-menu">
    <div class="container-wide py-4 space-y-1">
      {NAV_ITEMS.map((item) => (
        <div>
          <a
            href={item.href}
            class="block px-3 py-2.5 text-sm font-heading font-medium text-navy-700 
                   rounded-md hover:bg-navy-50 transition-colors"
          >
            {item.label}
          </a>
          {item.children && (
            <div class="ml-4 border-l-2 border-navy-100 pl-3 mt-1 space-y-0.5">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class="block px-3 py-1.5 text-sm text-navy-600 
                         rounded-md hover:bg-navy-50 hover:text-crst-primary transition-colors"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <div class="pt-3 border-t border-navy-100">
        <a href="/estimate/" class="btn-primary w-full text-center text-sm">
          Get Free Estimate
        </a>
        <div class="flex items-center justify-center gap-4 mt-3 text-sm text-navy-600">
          <a href={`tel:${BUSINESS.phoneClean}`} class="flex items-center gap-1.5 hover:text-crst-primary">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            {BUSINESS.phone}
          </a>
          <a href={`mailto:${BUSINESS.email}`} class="flex items-center gap-1.5 hover:text-crst-primary">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Email
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
  });
</script>
