---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import { BUSINESS } from '../../data/site';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Mailing List Processing Services',
  provider: { '@id': 'https://crst.net/#organization' },
  areaServed: [
    { '@type': 'County', name: 'Ulster County, New York' },
    { '@type': 'County', name: 'Dutchess County, New York' },
    { '@type': 'County', name: 'Orange County, New York' },
  ],
  url: 'https://crst.net/services/mailing-list-services',
};
---

<BaseLayout
  title="Mailing List Services — Data Processing & Hygiene"
  description="Full-service mailing list processing: NCOA, CASS certification, deduplication, merge/purge, and presort for direct mail campaigns."
  canonical="https://crst.net/services/data-lists"
  schema={null}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>
  <PageHero
    title="Mailing List Services"
    subtitle="Raw data doesn't mail. We handle all the processing so you get a clean, verified, mail-ready file."
    breadcrumbs={[
      { label: 'Services', href: '/services' },
      { label: 'Mailing List Services' },
    ]}
    noSchema={true}
  />

  <section class="py-14 lg:py-20">
    <div class="container-wide">
      <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">
        <div class="lg:col-span-2 prose prose-lg max-w-none">
          <div class="section-divider mb-6"></div>

          <p class="text-lg text-navy-700 leading-relaxed font-semibold mb-6">
            You buy a mailing list and assume it's ready to go. It's not. It needs processing — NCOA updates, address verification, deduplication, and formatting for presort.
          </p>

          <p class="text-navy-600/80 leading-relaxed mb-8">
            Most list vendors hand you raw data and call it done. You're left figuring out the rest. Or worse, you mail it unprocessed and watch 25% of your pieces bounce because addresses are outdated, duplicated, or undeliverable.
          </p>

          <p class="text-navy-600/80 leading-relaxed mb-8">
            We don't sell you raw data. We build, process, and deliver a mail-ready file. NCOA-processed. CASS-certified. Deduplicated. Presorted. Ready to print and mail the same day.
          </p>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-6">What We Process</h2>

          <div class="space-y-6 mb-8">
            <div>
              <h3 class="font-heading font-bold text-navy-800 mb-2">NCOA Processing (National Change of Address)</h3>
              <p class="text-navy-600/70 leading-relaxed mb-3">Catches anyone who moved in the last 48 months and updates their address. The USPS requires NCOA processing for presorted mail. If you skip it, your mailing either gets rejected or you pay full postage.</p>
              <p class="text-sm text-navy-600/60"><strong>What it does:</strong> Checks every address against the USPS move database and updates records for anyone who filed a change of address.</p>
              <p class="text-sm text-navy-600/60"><strong>What it doesn't fix:</strong> Vacant homes, bad source data, people who didn't file official paperwork with USPS.</p>
            </div>

            <div>
              <h3 class="font-heading font-bold text-navy-800 mb-2">CASS Certification (Coding Accuracy Support System)</h3>
              <p class="text-navy-600/70 leading-relaxed mb-3">CASS is USPS software that verifies every address exists and formats it to postal standards. If an address doesn't match the USPS database, it gets flagged. If it's formatted wrong, we fix it.</p>
              <p class="text-sm text-navy-600/60"><strong>Why it matters:</strong> This is how you qualify for automation postage discounts — which can reduce postage by 30–50%. Without CASS certification, you pay retail rates on every piece.</p>
            </div>

            <div>
              <h3 class="font-heading font-bold text-navy-800 mb-2">Deduplication</h3>
              <p class="text-navy-600/70 leading-relaxed mb-3">Identifying and removing duplicate records so you don't mail the same person twice. Sounds simple. It's not — names and addresses aren't always formatted the same way.</p>
              <p class="text-sm text-navy-600/60">Bob Smith at 123 Main St and Robert Smith at 123 Main Street are the same person. Good deduplication software catches variations in names, abbreviations, and formatting.</p>
            </div>

            <div>
              <h3 class="font-heading font-bold text-navy-800 mb-2">Merge/Purge (Suppression)</h3>
              <p class="text-navy-600/70 leading-relaxed mb-3">If you have an existing customer list, we scrub it against the purchased list and remove matches. This keeps you from mailing current customers with prospect offers — which is both wasteful and annoying.</p>
              <p class="text-sm text-navy-600/60"><strong>Example:</strong> You're mailing a "new customer discount" offer. We suppress your existing customers so they don't receive an offer meant for prospects.</p>
            </div>

            <div>
              <h3 class="font-heading font-bold text-navy-800 mb-2">Presort by ZIP Code</h3>
              <p class="text-navy-600/70 leading-relaxed mb-3">Sorting your list by ZIP code to qualify for bulk postage rates. On a 5,000-piece mailing, presort saves $400–$600 compared to retail postage. On larger mailings, it's thousands.</p>
            </div>

            <div>
              <h3 class="font-heading font-bold text-navy-800 mb-2">File Formatting</h3>
              <p class="text-navy-600/70 leading-relaxed mb-3">We deliver mail-ready files in Excel, CSV, or inkjet-ready format. If you're printing and mailing with us, we skip the file delivery and go straight to production.</p>
            </div>
          </div>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-4">Processing Your Own Customer List</h2>

          <p class="text-navy-600/80 leading-relaxed mb-6">
            You've been collecting customer emails and addresses for five years. You assume it's clean because it came from your own business. It's not.
          </p>

          <p class="text-navy-600/80 leading-relaxed mb-6">
            People move. Businesses close. Email addresses change. Addresses get entered wrong. Over time, every list decays — even house files.
          </p>

          <p class="text-navy-600/80 leading-relaxed mb-8">
            We run your customer list through NCOA and CASS before every mailing. Remove duplicates. Suppress unsubscribes and bounce-backs. Clean data drives better response and costs less to mail.
          </p>

          <p class="text-navy-600/80 leading-relaxed mb-8">
            If you're only processing a list (not mailing), we charge $75 per 1,000 records. If you're printing and mailing with us, list processing is included.
          </p>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-4">What You Get Back</h2>

          <p class="text-navy-600/80 leading-relaxed mb-6">
            A spreadsheet (Excel or CSV) with these fields:
          </p>

          <ul class="list-disc list-inside text-navy-600/80 space-y-2 mb-8">
            <li>Full name</li>
            <li>Street address (standardized to USPS format)</li>
            <li>City, State, ZIP+4</li>
            <li>Barcode assignment (for automation discounts)</li>
            <li>NCOA move status (if applicable)</li>
            <li>Deliverability score</li>
          </ul>

          <p class="text-navy-600/80 leading-relaxed mb-8">
            If you're printing and mailing with us, we take that file and run it directly through our inkjet addressing system. You don't touch it. We just need your approval on the design and we're mailing.
          </p>

          <p class="text-navy-600/80 leading-relaxed mb-8">
            If you're using the list elsewhere, we send you the file and you're done.
          </p>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-6">How Long Does Processing Take?</h2>

          <ul class="list-none text-navy-600/80 space-y-4 mb-8">
            <li>
              <strong class="text-navy-800">List counts & quotes:</strong> Same day (usually within a few hours)
            </li>
            <li>
              <strong class="text-navy-800">Processing & file delivery:</strong> 24–48 hours after approval
            </li>
            <li>
              <strong class="text-navy-800">For print-and-mail campaigns:</strong> Goes straight to production (no separate file delivery)
            </li>
          </ul>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-6">Processing Pricing</h2>

          <div class="space-y-4 mb-8">
            <div class="p-4 bg-navy-50/40 rounded-lg border border-navy-100">
              <h4 class="font-heading font-bold text-navy-800 mb-2">List Processing Only (No Mailing)</h4>
              <p class="text-sm text-navy-600/70">$75 per 1,000 records. Includes NCOA, CASS, deduplication, and file formatting.</p>
            </div>

            <div class="p-4 bg-navy-50/40 rounded-lg border border-navy-100">
              <h4 class="font-heading font-bold text-navy-800 mb-2">Processing with Print & Mail</h4>
              <p class="text-sm text-navy-600/70">Included at no extra charge. All processing happens as part of the mailing workflow.</p>
            </div>

            <div class="p-4 bg-navy-50/40 rounded-lg border border-navy-100">
              <h4 class="font-heading font-bold text-navy-800 mb-2">Merge/Purge Services</h4>
              <p class="text-sm text-navy-600/70">Combining multiple lists while removing duplicates. Pricing based on list sizes and complexity.</p>
            </div>
          </div>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-6">Why Professional Processing Matters</h2>

          <p class="text-navy-600/80 leading-relaxed mb-6">
            The most common budgeting mistake we see: skipping processing to save $40 per thousand, then losing $200 per thousand in wasted postage on undeliverable mail.
          </p>

          <div class="bg-navy-50/40 border border-navy-100 rounded-lg p-6 mb-8">
            <h4 class="font-heading font-bold text-navy-800 mb-2">Real Example</h4>
            <p class="text-navy-600/70 leading-relaxed">A client bought a 10,000-piece consumer list for $800 and mailed it unprocessed. No NCOA. No CASS. No deduplication. 25% bounced. They spent $3,000 on printing and postage, and $750 of it never arrived. A processed list would have cost $400 extra but saved them $750 in waste. The "expensive" list just paid for itself five times over.</p>
          </div>

          <p class="text-navy-600/80 leading-relaxed mb-8">
            Professional processing does three things: it improves deliverability (fewer bounces), qualifies you for postage discounts (presort), and removes waste (deduplication). Most campaigns pay for themselves through postage savings alone.
          </p>

          <p class="text-navy-600/80 leading-relaxed mb-8">
            List processing is part of our complete <a href="/services/data-lists" class="text-crst-primary font-semibold hover:underline">mailing list and data services</a>. We process <a href="/services/consumer-mailing-lists" class="text-crst-primary hover:underline">consumer mailing lists</a>, <a href="/services/business-mailing-lists" class="text-crst-primary hover:underline">business mailing lists</a>, and <a href="/services/new-mover-mailing-lists" class="text-crst-primary hover:underline">new mover mailing lists</a> for campaigns throughout the Hudson Valley. For an overview of what makes a good list file, see our <a href="/services/direct-mail-lists" class="text-crst-primary hover:underline">direct mail lists guide</a>. All of these feed into our full-service <a href="/services/direct-mail" class="text-crst-primary font-semibold hover:underline">direct mail campaigns</a> — from list to mailbox.
          </p>

          <div class="bg-crst-primary/5 border border-crst-primary/15 rounded-xl p-6 mt-10 text-center">
            <p class="font-heading font-bold text-crst-primary text-lg mb-2">Ready to Process Your List?</p>
            <p class="text-navy-600/70 text-sm mb-4">Send us your file and we'll handle the rest. Clean, verified, mail-ready.</p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
              <a href="/estimate" class="btn-primary text-sm">Request List Processing</a>
              <a href={`tel:${BUSINESS.phoneClean}`} class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-crst-primary hover:text-crst-accent transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Call {BUSINESS.phone}
              </a>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="sticky top-24 space-y-5">
            <div class="bg-crst-primary rounded-xl p-6 text-white">
              <h3 class="font-display text-lg mb-2">Process Your List</h3>
              <p class="text-white/60 text-sm leading-relaxed mb-4">Send us your file. We'll clean it, verify it, and return a mail-ready spreadsheet.</p>
              <a href="/estimate" class="btn-accent w-full text-center text-sm">Get a Processing Quote</a>
              <div class="mt-4 pt-4 border-t border-white/10 text-center">
                <a href={`tel:${BUSINESS.phoneClean}`} class="text-white/70 text-sm font-heading hover:text-white transition-colors">
                  or call {BUSINESS.phone}
                </a>
              </div>
            </div>

            <div class="bg-navy-50/50 rounded-xl p-5 border border-navy-100">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-3">Mailing List Services</h3>
              <div class="space-y-2">
                {[
                  { label: 'Mailing Lists & Data Services', href: '/services/data-lists' },
                  { label: 'Direct Mail Lists', href: '/services/direct-mail-lists' },
                  { label: 'Business Mailing Lists', href: '/services/business-mailing-lists' },
                  { label: 'Consumer Mailing Lists', href: '/services/consumer-mailing-lists' },
                  { label: 'New Mover Lists', href: '/services/new-mover-mailing-lists' },
                ].map((link) => (
                  <a href={link.href} class="flex items-center justify-between px-3 py-2 text-sm text-navy-700 hover:text-crst-primary hover:bg-white rounded-md transition-colors font-heading">
                    {link.label}
                    <svg class="w-3.5 h-3.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </div>

            <div class="bg-navy-50/50 rounded-xl p-5 border border-navy-100">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-3">Processing Includes</h3>
              <div class="space-y-3 text-sm text-navy-600/70">
                <p><strong class="text-navy-800">NCOA processing</strong> — catch moved addresses</p>
                <p><strong class="text-navy-800">CASS certification</strong> — verify deliverability</p>
                <p><strong class="text-navy-800">Deduplication</strong> — remove duplicates</p>
                <p><strong class="text-navy-800">Presort</strong> — qualify for bulk postage discounts</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
