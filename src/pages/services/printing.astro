---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { BUSINESS, COUNTIES } from '../../data/site';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Commercial Printing Services',
  provider: {
    '@type': 'LocalBusiness',
    '@id': 'https://crst.net/#organization',
    name: BUSINESS.name,
    telephone: BUSINESS.phone,
  },
  areaServed: [
    { '@type': 'County', name: 'Ulster County, New York' },
    { '@type': 'County', name: 'Dutchess County, New York' },
    { '@type': 'County', name: 'Orange County, New York' },
  ],
  url: 'https://crst.net/services/printing',
};
---

<BaseLayout
  title="Commercial Printing Services — Postcards, Brochures & Direct Mail | New Paltz, NY"
  description="Commercial printing for direct mail campaigns — postcards, brochures, newsletters, letters, and variable data printing. USPS-compliant, press-to-post-office under one roof in New Paltz, NY."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>
  <PageHero
    title="Printing Services"
    subtitle="Commercial-quality printing for direct mail, marketing materials, and business communications."
    breadcrumbs={[
      { label: 'Services', href: '/services' },
      { label: 'Printing Services' },
    ]}
  />

  <section class="py-14 lg:py-20">
    <div class="container-wide">
      <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">
        <!-- Main content -->
        <div class="lg:col-span-2">
          <div class="section-divider mb-6"></div>
          <h2 class="text-2xl font-display text-crst-primary mb-4">Print Quality That Represents Your Brand</h2>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            The quality of your printed materials says something about your organization. Cornerstone Services delivers commercial-grade printing that makes a strong impression — whether it's a postcard campaign, a multi-page newsletter, or business stationery. We handle everything from short-run digital jobs to high-volume offset production.
          </p>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            Because we're a full-service direct mail house, your print job flows seamlessly into mailing preparation. There's no shipping printed materials between vendors, no coordination headaches, and no wasted time. Your project moves from press to post office under one roof.
          </p>

          <h3 class="text-xl font-display text-crst-primary mt-10 mb-4">What We Print</h3>
          <div class="grid sm:grid-cols-2 gap-3">
            {[
              { title: 'Postcards', desc: '4×6, 6×9, 6×11, and jumbo formats on heavy cardstock with UV coating options' },
              { title: 'Self-Mailers', desc: 'Bi-fold and tri-fold pieces that mail without an envelope — cost-effective and eye-catching' },
              { title: 'Letters & Envelopes', desc: 'Personalized letters with variable data, matching envelopes, and reply inserts' },
              { title: 'Newsletters', desc: 'Multi-page saddle-stitched or folded newsletters for municipalities, churches, and organizations' },
              { title: 'Brochures & Flyers', desc: 'Full-color marketing collateral in various fold configurations' },
              { title: 'Business Stationery', desc: 'Letterheads, envelopes, business cards, and notepads with consistent branding' },
            ].map((item) => (
              <div class="flex items-start gap-3 p-4 bg-navy-50/40 rounded-lg">
                <svg class="w-5 h-5 text-crst-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <div>
                  <div class="font-heading font-semibold text-navy-800 text-sm">{item.title}</div>
                  <div class="text-xs text-navy-600/60">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>

          <h3 class="text-xl font-display text-crst-primary mt-10 mb-4">Variable Data Printing</h3>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            Variable data printing (VDP) lets you personalize each piece in a print run with unique text, images, or offers. A restaurant can address each postcard by name. A real estate agent can show different property listings based on neighborhood. A municipality can include account-specific information in utility mailings. Personalized mail gets higher response rates — and we make it simple.
          </p>

          <h3 class="text-xl font-display text-crst-primary mt-10 mb-4">Our Print Process</h3>
          <div class="space-y-6">
            {[
              { step: '1', title: 'File Review & Preflight', desc: 'We review your artwork files for resolution, color accuracy, bleed, and USPS compliance before anything goes to press. If you need design help, our graphic design team can create or refine your piece.' },
              { step: '2', title: 'Proof Approval', desc: 'You receive a digital proof showing exactly how your piece will look. We do not print until you approve.' },
              { step: '3', title: 'Production', desc: 'Your job runs on commercial digital or offset equipment matched to quantity and quality requirements. We use full CMYK color with options for UV coating, aqueous coating, or matte finish.' },
              { step: '4', title: 'Mail Prep or Pickup', desc: 'Printed pieces flow directly into our mailing department for addressing, presorting, and postal induction — or we prepare them for pickup/delivery if you are not mailing.' },
            ].map((item) => (
              <div class="flex items-start gap-4">
                <div class="shrink-0 w-9 h-9 rounded-full bg-crst-primary flex items-center justify-center text-white font-heading font-bold text-sm">
                  {item.step}
                </div>
                <div>
                  <h4 class="font-heading font-bold text-navy-800 mb-1">{item.title}</h4>
                  <p class="text-sm text-navy-600/70 leading-relaxed">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="bg-crst-primary/5 border border-crst-primary/15 rounded-xl p-6 mt-10 text-center">
            <p class="font-heading font-bold text-crst-primary text-lg mb-2">Need a Print Quote?</p>
            <p class="text-navy-600/70 text-sm mb-4">Tell us what you need — quantity, size, and paper — and we'll send a detailed quote.</p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
              <a href="/estimate" class="btn-primary text-sm">Get a Free Estimate</a>
              <a href={`tel:${BUSINESS.phoneClean}`} class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-crst-primary hover:text-crst-accent transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Call {BUSINESS.phone}
              </a>
            </div>
          </div>

          <h3 class="text-xl font-display text-crst-primary mt-10 mb-4">Print Specifications</h3>
          <p class="text-navy-600/80 leading-relaxed mb-4">
            We accept print-ready files in PDF, AI, InDesign, and PSD formats. Files should be set to CMYK color mode at 300 DPI with 0.125" bleed on all sides. Don't have print-ready files? No problem — our design team can prepare your artwork. See our <a href="/services/graphic-design" class="text-crst-accent hover:text-crst-primary underline">graphic design services</a> for details.
          </p>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="sticky top-24 space-y-5">
            <div class="bg-crst-primary rounded-xl p-6 text-white">
              <h3 class="font-display text-lg mb-2">Get a Print Quote</h3>
              <p class="text-white/60 text-sm leading-relaxed mb-4">
                Tell us what you need printed — quantity, size, and paper — and we'll send a detailed quote.
              </p>
              <a href="/estimate" class="btn-accent w-full text-center text-sm">
                Request Quote
              </a>
              <div class="mt-4 pt-4 border-t border-white/10 text-center">
                <a href={`tel:${BUSINESS.phoneClean}`} class="text-white/70 text-sm font-heading hover:text-white transition-colors">
                  or call {BUSINESS.phone}
                </a>
              </div>
            </div>

            <div class="bg-navy-50/50 rounded-xl p-5 border border-navy-100">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-3">Related Services</h3>
              <div class="space-y-2">
                {[
                  { label: 'Direct Mail Campaigns', href: '/services/direct-mail' },
                  { label: 'Graphic Design', href: '/services/graphic-design' },
                  { label: 'Mailing Services', href: '/services/mailing' },
                  { label: 'EDDM', href: '/services/eddm' },
                ].map((link) => (
                  <a href={link.href} class="flex items-center justify-between px-3 py-2 text-sm text-navy-700 hover:text-crst-primary hover:bg-white rounded-md transition-colors font-heading">
                    {link.label}
                    <svg class="w-3.5 h-3.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </div>

            <div class="bg-navy-50/50 rounded-xl p-5 border border-navy-100">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-3">Popular Formats</h3>
              <div class="space-y-2 text-sm">
                {[
                  { format: '6×9 Postcard', use: 'Most popular for direct mail' },
                  { format: '8.5×11 Self-Mailer', use: 'Newsletters & menus' },
                  { format: '#10 Letter Package', use: 'Formal communications' },
                  { format: '6×11 Jumbo Postcard', use: 'Maximum impact' },
                ].map((item) => (
                  <div class="flex justify-between items-baseline">
                    <span class="font-heading font-semibold text-navy-800">{item.format}</span>
                    <span class="text-xs text-navy-600/50">{item.use}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
    <AuthorByline compact />
  </div>

  <section class="py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-display font-bold text-crst-primary mb-3">Postcard Printing Guides</h2>
        <p class="text-navy-600/80 text-sm leading-relaxed mb-6">From design to delivery, here's everything you need to know about postcard printing for your next campaign:</p>

        <h3 class="text-lg font-heading font-bold text-navy-800 mb-4">Postcard Printing Basics</h3>
        <div class="space-y-4 mb-8">
          {[
            { title: 'How Much Does Postcard Printing Cost?', url: 'https://blog.crst.net/how-much-does-postcard-printing-cost/', desc: 'Pricing breakdown by size, quantity, and finish' },
            { title: 'Postcard Printing & Mailing Services', url: 'https://blog.crst.net/postcard-printing-and-mailing-services/', desc: 'Full-service print and mail in one order' },
            { title: 'Best Postcard Size for Direct Mail', url: 'https://blog.crst.net/best-postcard-size-for-direct-mail/', desc: 'Choose the right format for your campaign' },
            { title: 'Postcard Design Mistakes to Avoid', url: 'https://blog.crst.net/postcard-design-mistakes-to-avoid/', desc: 'Common errors that kill response rates' },
            { title: 'Postcard Printing ROI for Local Business', url: 'https://blog.crst.net/postcard-printing-roi-for-local-business/', desc: 'How to measure what your postcards actually return' },
            { title: 'Thick Postcard Printing for Durability', url: 'https://blog.crst.net/thick-postcard-printing-for-durability/', desc: 'Premium stock options that stand out' },
            { title: 'Postcard Printing Software & Tools', url: 'https://blog.crst.net/postcard-printing-software-and-tools/', desc: 'Design and production tools overview' },
          ].map((item) => (
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="flex items-start gap-4 p-4 bg-navy-50 rounded-lg border border-navy-100 hover:border-crst-primary/30 hover:shadow-sm transition-all group">
              <svg class="w-5 h-5 text-crst-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              <div>
                <span class="font-heading font-semibold text-gray-800 group-hover:text-crst-primary transition-colors text-sm">{item.title}</span>
                <p class="text-xs text-navy-600/60 mt-0.5">{item.desc}</p>
              </div>
            </a>
          ))}
        </div>

        <h3 class="text-lg font-heading font-bold text-navy-800 mb-4">Postcard Printing by Industry</h3>
        <div class="grid sm:grid-cols-2 gap-4">
          {[
            { title: 'Postcard Printing for Dental Offices', url: 'https://blog.crst.net/postcard-printing-for-dental-offices/', desc: 'New patient campaigns that work' },
            { title: 'Postcard Printing for Restaurant Marketing', url: 'https://blog.crst.net/postcard-printing-for-restaurant-marketing/', desc: 'Menu mailers, seasonal promos, grand openings' },
            { title: 'Postcard Printing for Real Estate Agents', url: 'https://blog.crst.net/postcard-printing-for-real-estate-agents-design/', desc: 'Just-listed cards, farming, and open house mailers' },
            { title: 'Real Estate Farming Postcard Printing', url: 'https://blog.crst.net/real-estate-farming-postcard-printing/', desc: 'Neighborhood farming strategy with print' },
            { title: 'Postcard Printing for Event Invitations', url: 'https://blog.crst.net/postcard-printing-for-event-invitations/', desc: 'Printed invitations that outperform email' },
            { title: 'Postcard Printing for Product Launches', url: 'https://blog.crst.net/postcard-printing-for-product-launches/', desc: 'Announce new products with direct mail impact' },
            { title: 'Affordable Postcard Printing for Startups', url: 'https://blog.crst.net/affordable-postcard-printing-for-startups/', desc: 'Budget-friendly options for new businesses' },
            { title: 'Postcard Printing for Nonprofits', url: 'https://blog.crst.net/cheap-postcard-printing-for-nonprofits/', desc: 'Cost-effective donor outreach and event promotion' },
          ].map((item) => (
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="flex items-start gap-3 p-4 bg-navy-50 rounded-lg border border-navy-100 hover:border-crst-primary/30 hover:shadow-sm transition-all group">
              <svg class="w-5 h-5 text-crst-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
              <div>
                <span class="font-heading font-semibold text-gray-800 group-hover:text-crst-primary transition-colors text-sm">{item.title}</span>
                <p class="text-xs text-navy-600/60 mt-0.5">{item.desc}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-10 bg-crst-primary/5 border-y border-crst-primary/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h3 class="text-xl font-display font-bold text-crst-primary mb-3">Need a Print Quote?</h3>
      <p class="text-gray-600 mb-6 max-w-2xl mx-auto">Tell us what you need — quantity, size, and paper — and we'll send a detailed quote.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-primary inline-flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call {BUSINESS.phone}
        </a>
        <a href="/estimate" class="btn-accent inline-flex items-center gap-2">
          Get a Free Estimate
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 bg-navy-50/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-display font-bold text-crst-primary">Service Areas</h2>
        <p class="text-gray-600 mt-2">We serve businesses and organizations across three Hudson Valley counties.</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-4 max-w-3xl mx-auto">
        {Object.values(COUNTIES).map((county) => (
          <a href={`/service-areas/${county.slug}`} class="flex items-center justify-center gap-2 p-4 bg-white rounded-lg border border-gray-200 hover:border-crst-primary/30 hover:shadow-sm transition-all group">
            <svg class="w-5 h-5 text-crst-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="font-heading font-semibold text-gray-800 group-hover:text-crst-primary transition-colors">{county.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
