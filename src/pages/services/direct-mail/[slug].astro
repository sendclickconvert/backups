---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AuthorByline from '../../../components/AuthorByline.astro';
import { BUSINESS } from '../../../data/site';

export async function getStaticPaths() {
  const articles = await getCollection('dm-articles');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'dm-articles'>;
}

const { article } = Astro.props;
const { Content, headings } = await article.render();
const { title, description, author, authorTitle, authorLocation, pillar, schemaFAQ, schemaHowTo, schemaItemList } = article.data;
const pubDateISO = article.data.pubDate.toISOString().split('T')[0];
const updatedDateISO = article.data.updatedDate.toISOString().split('T')[0];

const canonical = `https://crst.net/services/direct-mail/${article.slug}`;
const allArticles = await getCollection('dm-articles');
const related = allArticles.filter((a) => a.slug !== article.slug).slice(0, 3);
const tocHeadings = headings.filter((h) => h.depth === 2);

const graphItems: any[] = [
  {
    '@type': 'Article',
    headline: title,
    description,
    author: {
      '@type': 'Person',
      name: author,
      jobTitle: 'Owner',
      worksFor: { '@type': 'Organization', name: 'Cornerstone Services' },
      image: 'https://crst.net/images/sean-griffin.png',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Cornerstone Services',
      url: 'https://crst.net',
      logo: { '@type': 'ImageObject', url: 'https://crst.net/images/crst-logo.png' },
    },
    datePublished: pubDateISO,
    dateModified: updatedDateISO,
    mainEntityOfPage: canonical,
    isPartOf: { '@type': 'WebPage', '@id': pillar },
    url: canonical,
  },
];

if (schemaFAQ && schemaFAQ.length > 0) {
  graphItems.push({
    '@type': 'FAQPage',
    mainEntity: schemaFAQ.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  });
}

if (schemaHowTo) {
  graphItems.push({
    '@type': 'HowTo',
    name: schemaHowTo.name,
    step: schemaHowTo.steps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.name,
      text: s.text,
    })),
  });
}

if (schemaItemList && schemaItemList.length > 0) {
  graphItems.push({
    '@type': 'ItemList',
    itemListElement: schemaItemList.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: item.name,
    })),
  });
}

const graphSchema = { '@context': 'https://schema.org', '@graph': graphItems };
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(graphSchema)} />
  </Fragment>

  <section class="bg-crst-primary text-white py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-white/50 mb-4">
        <a href="/" class="hover:text-white/80 transition-colors">Home</a>
        <span class="mx-2">›</span>
        <a href="/services" class="hover:text-white/80 transition-colors">Services</a>
        <span class="mx-2">›</span>
        <a href="/services/direct-mail" class="hover:text-white/80 transition-colors">Direct Mail</a>
        <span class="mx-2">›</span>
        <span class="text-white/70">{title}</span>
      </nav>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold leading-tight text-white">{title}</h1>
    </div>
  </section>

  <section class="py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">
        <div class="lg:col-span-2">

          {tocHeadings.length > 0 && (
            <nav class="bg-navy-50/40 rounded-xl border border-navy-100 p-5 mb-10">
              <p class="font-heading font-bold text-navy-800 text-sm mb-3">In This Article</p>
              <ul class="space-y-2">
                {tocHeadings.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} class="text-sm text-crst-accent hover:text-crst-primary transition-colors hover:underline">{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          <div class="prose prose-navy max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent hover:prose-a:text-crst-primary prose-strong:text-navy-800 prose-p:text-navy-600/80 prose-li:text-navy-600/80 prose-td:text-navy-600/80 prose-th:text-navy-800 prose-th:font-heading">
            <Content />
          </div>

          <AuthorByline />

          {schemaFAQ && schemaFAQ.length > 0 && (
            <div class="mt-12">
              <div class="section-divider mb-6"></div>
              <h2 class="text-2xl font-display text-crst-primary mb-6">Frequently Asked Questions</h2>
              <div class="space-y-4">
                {schemaFAQ.map((item) => (
                  <div class="bg-navy-50/40 rounded-xl border border-navy-100 p-5">
                    <h3 class="font-heading font-semibold text-navy-800 text-sm mb-2">{item.q}</h3>
                    <p class="text-sm text-navy-600/70 leading-relaxed">{item.a}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <div class="bg-crst-primary/5 border border-crst-primary/15 rounded-xl p-6 text-center mt-10">
            <p class="font-heading font-bold text-crst-primary text-lg mb-2">Start Your Direct Mail Campaign</p>
            <p class="text-navy-600/70 text-sm mb-4">Get a free estimate — we'll have a quote back in one business day.</p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
              <a href="/estimate" class="btn-primary text-sm">Get a Free Estimate →</a>
              <a href={`tel:${BUSINESS.phoneClean}`} class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-crst-primary hover:text-crst-accent transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Call {BUSINESS.phone}
              </a>
            </div>
          </div>

          <div class="mt-14">
            <div class="section-divider mb-6"></div>
            <h2 class="text-xl font-display text-crst-primary mb-6">Related Articles</h2>
            <div class="grid sm:grid-cols-3 gap-4">
              {related.map((r) => (
                <a href={`/services/direct-mail/${r.slug}`} class="block p-4 bg-navy-50/40 rounded-xl border border-navy-100 hover:border-crst-primary/30 hover:shadow-sm transition-all group">
                  <h3 class="font-heading font-semibold text-navy-800 text-sm group-hover:text-crst-primary transition-colors leading-snug">{r.data.title}</h3>
                  <p class="text-xs text-navy-600/60 mt-2 line-clamp-2">{r.data.description}</p>
                </a>
              ))}
            </div>
          </div>
        </div>

        <aside class="lg:col-span-1">
          <div class="sticky top-28 space-y-6">
            <div class="bg-crst-primary rounded-xl p-6 text-white">
              <h3 class="font-display text-lg mb-2">Get a Free Estimate</h3>
              <p class="text-white/60 text-sm leading-relaxed mb-4">
                Tell us about your campaign and we'll provide a detailed quote — usually within one business day.
              </p>
              <a href="/estimate" class="btn-accent w-full text-center text-sm">
                Request Estimate
              </a>
              <div class="mt-4 pt-4 border-t border-white/10 text-center">
                <a href={`tel:${BUSINESS.phoneClean}`} class="text-white/70 text-sm font-heading hover:text-white transition-colors">
                  or call {BUSINESS.phone}
                </a>
              </div>
            </div>

            <div class="bg-navy-50/50 rounded-xl p-5 border border-navy-100">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-3">Direct Mail Resources</h3>
              <div class="space-y-2">
                {allArticles.map((a) => (
                  <a href={`/services/direct-mail/${a.slug}`} class={`flex items-center justify-between px-3 py-2 text-sm rounded-md transition-colors font-heading ${a.slug === article.slug ? 'text-crst-primary bg-white font-semibold' : 'text-navy-700 hover:text-crst-primary hover:bg-white'}`}>
                    <span class="truncate mr-2">{a.data.title.replace(/ — .*$/, '').replace(/ in the Hudson Valley$/, '').replace(/ for Direct Mail$/, '')}</span>
                    <svg class="w-3.5 h-3.5 opacity-40 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </div>

            <a href="/services/direct-mail" class="block p-4 bg-crst-primary/5 rounded-xl border border-crst-primary/15 hover:border-crst-primary/30 transition-all group">
              <p class="font-heading font-semibold text-crst-primary text-sm group-hover:text-crst-accent transition-colors">← Back to Direct Mail Services</p>
              <p class="text-xs text-navy-600/60 mt-1">Full-service campaigns from list to mailbox</p>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
