---
export const prerender = true;
const FORM_ENDPOINT = import.meta.env.FORM_ENDPOINT ?? '/api/submit-guide';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>USPS Informed Delivery for Direct Mail — Free 22-Page Guide</title>
  <meta name="description" content="Free 22-page guide: add a color image and clickable link to your mail piece inside the USPS Daily Digest email — at no extra postage. 72.9M subscribers. Written by a USPS-certified mailer." />
  <meta name="robots" content="noindex, follow" />
  <link rel="canonical" href="https://crst.net/resources/informed-delivery-guide" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Source+Sans+3:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <style>
    /* ── Brand tokens ─────────────────────────────────────────────────── */
    :root {
      --navy:      #0F1B2D;
      --navy-2:    #16273d;
      --gold:      #B8893A;
      --gold-l:    #d3a556;
      --cream:     #FAF6EE;
      --ink:       #1a2230;
      --muted:     #5f6b7a;
      --line:      #e6ddcd;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0 }
    html  { scroll-behavior: smooth; -webkit-text-size-adjust: 100% }
    body  {
      background: var(--cream);
      color: var(--ink);
      font-family: 'Source Sans 3', system-ui, sans-serif;
      font-size: clamp(15px, 1vw + 11px, 17px);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    :focus-visible { outline: 2px solid var(--gold); outline-offset: 3px }

    /* ── Type helpers ────────────────────────────────────────────────── */
    .f-display { font-family: 'Playfair Display', Georgia, serif }
    .f-mono    { font-family: 'JetBrains Mono', monospace }

    .eyebrow {
      font-family: 'JetBrains Mono', monospace;
      font-size: .72rem;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--gold);
    }

    /* ── Button ──────────────────────────────────────────────────────── */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .5rem;
      background: var(--gold);
      color: #fff;
      font-family: 'Source Sans 3', sans-serif;
      font-size: .95rem;
      font-weight: 600;
      padding: .85rem 2rem;
      border-radius: 6px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      letter-spacing: .015em;
      transition: background .18s, transform .1s;
    }
    .btn:hover  { background: var(--gold-l) }
    .btn:active { transform: scale(.98) }
    .btn-full   { width: 100% }

    /* ── Form fields ─────────────────────────────────────────────────── */
    .field {
      display: block;
      width: 100%;
      padding: .72rem 1rem;
      font-family: 'Source Sans 3', sans-serif;
      font-size: .95rem;
      border: 1.5px solid var(--line);
      border-radius: 6px;
      background: #fff;
      color: var(--ink);
      transition: border-color .15s, box-shadow .15s;
      -webkit-appearance: none;
      appearance: none;
    }
    .field:focus {
      outline: none;
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(184,137,58,.13);
    }
    .field::placeholder { color: #a8b2bc }

    label {
      display: block;
      font-size: .82rem;
      font-weight: 600;
      color: var(--ink);
      margin-bottom: .35rem;
    }

    /* ── Dotted texture ──────────────────────────────────────────────── */
    .texture::after {
      content: "";
      position: absolute; inset: 0;
      background-image: radial-gradient(circle, rgba(255,255,255,.07) 1px, transparent 1px);
      background-size: 22px 22px;
      pointer-events: none;
    }

    /* ── Responsive grid helpers ─────────────────────────────────────── */
    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 400px;
      gap: 3rem;
      align-items: start;
    }
    .proof-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      text-align: center;
      gap: 1rem;
    }
    .compare-grid {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 1.5rem;
      align-items: center;
      max-width: 800px;
      margin: 0 auto;
    }
    .inside-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
    .author-grid {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 2.5rem;
      align-items: start;
    }

    /* ── Responsive overrides ────────────────────────────────────────── */
    @media (max-width: 900px) {
      .hero-grid { grid-template-columns: 1fr }
      .hero-form-col { order: -1 }
    }
    @media (max-width: 680px) {
      .proof-grid  { grid-template-columns: repeat(2, 1fr) }
      .inside-grid { grid-template-columns: 1fr }
    }
    @media (max-width: 600px) {
      .compare-grid {
        grid-template-columns: 1fr;
      }
      .compare-arrow { transform: rotate(90deg) }
    }
    @media (max-width: 560px) {
      .author-grid { grid-template-columns: 1fr }
      .author-photo { justify-self: center }
    }

    @keyframes spin { to { transform: rotate(360deg) } }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto }
      *, *::before, *::after {
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
      }
    }
  </style>

  <script type="application/ld+json">{JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "USPS Informed Delivery for Direct Mail — Free 22-Page Guide",
    "url": "https://crst.net/resources/informed-delivery-guide",
    "publisher": { "@id": "https://crst.net/#organization" }
  })}</script>
</head>
<body>

<!-- ════════════════════════════════════════════════════════════════════
     1. TOP BAR
     ════════════════════════════════════════════════════════════════════ -->
<header style="background:var(--navy); border-bottom:1px solid rgba(255,255,255,.07)">
  <div style="max-width:1180px; margin:0 auto; padding:.9rem 1.5rem; display:flex; align-items:center; justify-content:space-between; gap:1rem">
    <a href="/" style="display:flex; align-items:center; gap:.75rem; text-decoration:none; flex-shrink:0" aria-label="Cornerstone Services home">
      <img src="/images/crst-logo-white.png" alt="Cornerstone Services, Inc." style="height:30px; width:auto; display:block" />
    </a>
    <a href="tel:8452555722"
       class="f-mono"
       style="font-size:.78rem; color:rgba(255,255,255,.65); text-decoration:none; letter-spacing:.04em; white-space:nowrap; transition:color .15s"
       onmouseover="this.style.color='var(--gold)'" onmouseout="this.style.color='rgba(255,255,255,.65)'"
       aria-label="Call us at (845) 255-5722">
      (845) 255-5722
    </a>
  </div>
</header>


<!-- ════════════════════════════════════════════════════════════════════
     2. HERO
     ════════════════════════════════════════════════════════════════════ -->
<section class="texture" style="position:relative; background:linear-gradient(140deg, var(--navy) 0%, var(--navy-2) 55%, #0c1924 100%); padding:4.5rem 1.5rem 5.5rem; overflow:hidden">
  <div style="position:absolute; top:-20%; right:-8%; width:60%; height:140%; background:radial-gradient(ellipse, rgba(184,137,58,.07) 0%, transparent 60%); pointer-events:none; z-index:0"></div>

  <div style="max-width:1180px; margin:0 auto; position:relative; z-index:1">
    <div class="hero-grid">

      <!-- LEFT: Copy + video -->
      <div>
        <span class="eyebrow" style="display:block; margin-bottom:.85rem">Free 22-Page Guide</span>

        <h1 class="f-display" style="font-size:clamp(2rem,3.8vw,3rem); font-weight:500; color:#fff; line-height:1.1; letter-spacing:-.025em; margin-bottom:1.3rem">
          Give every mail piece a<br>
          <em style="font-style:italic; color:var(--gold)">second impression</em>&thinsp;—<br>
          in the inbox.
        </h1>

        <p style="color:rgba(255,255,255,.78); font-size:1.05rem; line-height:1.72; max-width:520px; margin-bottom:.9rem">
          USPS emails a daily preview of incoming mail to <strong style="color:#fff">72.9 million subscribers</strong>. As a mailer, you can ride alongside that email with a <strong style="color:#fff">full-color image and a clickable link</strong> — at no extra postage cost. This free guide shows you exactly how to set it up.
        </p>
        <p class="f-mono" style="font-size:.72rem; color:rgba(255,255,255,.4); letter-spacing:.05em; margin-bottom:2.75rem">
          Based on USPS primary documentation · Includes official USPS case studies
        </p>

        <!-- ── VIDEO EMBED SLOT ──────────────────────────────────────
             Replace the div below with your Vimeo / Wistia / HeyGen embed.
             Example:
             <iframe src="https://player.vimeo.com/video/YOUR_ID?title=0&byline=0"
               style="position:absolute;inset:0;width:100%;height:100%;border:0"
               allow="autoplay; fullscreen; picture-in-picture" allowfullscreen>
             </iframe>
        ─────────────────────────────────────────────────────────────── -->
        <div style="position:relative; aspect-ratio:16/10; background:rgba(255,255,255,.04); border:1.5px dashed rgba(255,255,255,.18); border-radius:10px; overflow:hidden" id="video-slot">
          <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.9rem;color:rgba(255,255,255,.35);text-align:center;padding:2rem">
            <svg style="width:52px;height:52px;opacity:.3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <div>
              <p class="f-mono" style="font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;margin-bottom:.3rem">Video embed slot</p>
              <p style="font-size:.82rem;line-height:1.5;color:rgba(255,255,255,.28)">Drop your Vimeo · Wistia · HeyGen embed<br>inside <code style="font-size:.75em;opacity:.7">#video-slot</code> in the Astro source</p>
            </div>
          </div>
        </div>
        <!-- ── END VIDEO SLOT ──────────────────────────────────────── -->
      </div>

      <!-- RIGHT: Form card -->
      <div class="hero-form-col" style="background:var(--cream); border-radius:14px; padding:2rem; box-shadow:0 4px 6px rgba(0,0,0,.25), 0 24px 60px rgba(0,0,0,.45)">
        <!-- Guide cover + title -->
        <div style="display:flex; align-items:center; gap:1rem; padding-bottom:1.3rem; margin-bottom:1.4rem; border-bottom:1px solid var(--line)">
          <img src="/images/informed-delivery-cover.jpg"
               alt="USPS Informed Delivery Guide cover"
               style="width:62px; flex-shrink:0; border-radius:5px; box-shadow:0 2px 10px rgba(0,0,0,.22)"
               loading="eager" width="124" height="161" />
          <div>
            <p class="f-display" style="font-size:1.08rem; font-weight:600; color:var(--navy); line-height:1.25; margin-bottom:.2rem">Get the free guide</p>
            <p class="f-mono" style="font-size:.72rem; color:var(--muted); letter-spacing:.05em">Instant PDF &nbsp;·&nbsp; 22 pages</p>
          </div>
        </div>

        <!-- Form -->
        <form id="guide-form" novalidate style="display:flex; flex-direction:column; gap:.95rem">
          <!-- Honeypot fields (hidden) -->
          <div style="display:none" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
            <input type="text" name="_loadtime" id="guide-loadtime" tabindex="-1" autocomplete="off" />
          </div>

          <div>
            <label for="g-first-name">First Name <span style="color:var(--gold)">*</span></label>
            <input class="field" type="text" id="g-first-name" name="first_name" required
                   placeholder="Jane" autocomplete="given-name" />
          </div>
          <div>
            <label for="g-email">Email <span style="color:var(--gold)">*</span></label>
            <input class="field" type="email" id="g-email" name="email" required
                   placeholder="jane@company.com" autocomplete="email" />
          </div>
          <div>
            <label for="g-company">
              Company / Organization
              <span style="color:var(--muted); font-weight:400">(optional)</span>
            </label>
            <input class="field" type="text" id="g-company" name="company"
                   placeholder="Acme Corp" autocomplete="organization" />
          </div>

          <button type="submit" class="btn btn-full" id="guide-submit" style="margin-top:.25rem">
            <span id="guide-submit-text">Send me the guide</span>
            <svg id="guide-spinner" style="display:none; width:16px; height:16px; animation:spin .75s linear infinite; flex-shrink:0"
                 fill="none" viewBox="0 0 24 24">
              <circle style="opacity:.25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path style="opacity:.75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
            </svg>
          </button>

          <p style="font-size:.75rem; color:var(--muted); text-align:center; line-height:1.5">
            Free &nbsp;·&nbsp; No obligation. We don't sell your information.
          </p>
        </form>

        <!-- Success state (replaces form on submit) -->
        <div id="guide-success" style="display:none; text-align:center; padding:1.75rem 0">
          <div style="width:52px; height:52px; background:var(--gold); border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 1.1rem">
            <svg style="width:26px;height:26px;color:#fff" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <p class="f-display" style="font-size:1.2rem; font-weight:500; color:var(--navy); margin-bottom:.5rem">Check your inbox.</p>
          <p style="font-size:.88rem; color:var(--muted); line-height:1.55">
            The guide is on its way. If you don't see it in a few minutes, check your spam folder.
          </p>
        </div>

        <div id="guide-error" style="display:none; margin-top:.8rem; padding:.75rem 1rem; background:#fef2f2; border:1px solid #fecaca; border-radius:6px; font-size:.82rem; color:#b91c1c; line-height:1.5">
          Something went wrong. Try again or call
          <a href="tel:8452555722" style="font-weight:600; color:#b91c1c">(845) 255-5722</a>.
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════════
     3. PROOF BAR
     ════════════════════════════════════════════════════════════════════ -->
<div style="background:#fff; border-bottom:1px solid var(--line)">
  <div style="max-width:1180px; margin:0 auto; padding:1.8rem 1.5rem">
    <div class="proof-grid">
      {[
        { n: '72.9M',  label: 'USPS subscribers' },
        { n: '60.1%',  label: 'Daily Digest open rate' },
        { n: '+39%',   label: 'Response lift (case study)' },
        { n: 'Since 1998', label: 'Cornerstone Services' },
      ].map(s => (
        <div style="padding:.5rem 1rem">
          <div class="f-display" style="font-size:1.65rem; font-weight:700; color:var(--navy); line-height:1">{s.n}</div>
          <div class="f-mono" style="font-size:.68rem; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); margin-top:.35rem">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</div>


<!-- ════════════════════════════════════════════════════════════════════
     4. THE OPPORTUNITY
     ════════════════════════════════════════════════════════════════════ -->
<section style="background:var(--cream); padding:5.5rem 1.5rem">
  <div style="max-width:1020px; margin:0 auto">
    <span class="eyebrow" style="display:block; text-align:center; margin-bottom:.8rem">The Opportunity</span>
    <h2 class="f-display" style="font-size:clamp(1.7rem,3vw,2.4rem); font-weight:500; color:var(--navy); text-align:center; margin:0 auto 1.1rem; max-width:580px; letter-spacing:-.025em; line-height:1.2">
      Right now, your mail shows up<br>as a gray blur.
    </h2>
    <p style="text-align:center; color:var(--muted); max-width:480px; margin:0 auto 3.5rem; font-size:1rem; line-height:1.7">
      Every subscriber sees a grayscale scan by default. You can appear alongside it — full color, with a button — for free.
    </p>

    <!-- Side-by-side comparison -->
    <div class="compare-grid">

      <!-- Default: grayscale scan -->
      <div style="background:#fff; border:1px solid var(--line); border-radius:10px; overflow:hidden; box-shadow:0 1px 4px rgba(0,0,0,.05)">
        <div style="background:#f3f4f6; padding:.6rem 1rem; border-bottom:1px solid #e5e7eb; display:flex; align-items:center; gap:.5rem">
          <div style="width:7px;height:7px;border-radius:50%;background:#d1d5db"></div>
          <span class="f-mono" style="font-size:.65rem; color:#9ca3af; letter-spacing:.08em">Default USPS scan</span>
        </div>
        <div style="padding:1.25rem; filter:grayscale(1) contrast(.85)">
          <div style="background:#e5e7eb; height:78px; border-radius:6px; margin-bottom:.85rem; display:flex; align-items:center; justify-content:center">
            <svg style="width:30px;height:30px;color:#9ca3af" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor"/><path d="M3 10h18" stroke="currentColor"/></svg>
          </div>
          <div style="background:#d1d5db;height:9px;border-radius:3px;width:80%;margin-bottom:.4rem"></div>
          <div style="background:#d1d5db;height:8px;border-radius:3px;width:55%"></div>
        </div>
        <div style="padding:.55rem 1rem;background:#fafafa;border-top:1px solid #f0f0f0;text-align:center;font-size:.72rem;color:#9ca3af">
          Grayscale scan only
        </div>
      </div>

      <!-- Arrow -->
      <div class="compare-arrow" style="flex-shrink:0; text-align:center">
        <span class="f-mono" style="display:block; font-size:.62rem; letter-spacing:.12em; color:var(--gold); text-transform:uppercase; white-space:nowrap; margin-bottom:.45rem">Same mail piece</span>
        <svg style="width:38px;height:18px;color:var(--gold)" fill="none" viewBox="0 0 38 18">
          <path d="M2 9h30m0 0l-6-5.5M32 9l-6 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <!-- With ride-along: color -->
      <div style="background:#fff; border:2px solid var(--gold); border-radius:10px; overflow:hidden; box-shadow:0 4px 24px rgba(184,137,58,.14)">
        <div style="background:var(--navy); padding:.6rem 1rem; display:flex; align-items:center; gap:.5rem">
          <div style="width:7px;height:7px;border-radius:50%;background:var(--gold)"></div>
          <span class="f-mono" style="font-size:.65rem; color:rgba(255,255,255,.65); letter-spacing:.08em">With ride-along image</span>
        </div>
        <div style="padding:1.25rem">
          <div style="background:linear-gradient(135deg,#dbeafe,#eff6ff); height:78px; border-radius:6px; margin-bottom:.85rem; display:flex; align-items:center; justify-content:center; border:1px solid #bfdbfe">
            <svg style="width:30px;height:30px;color:#3b82f6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <div style="background:#1e40af;height:9px;border-radius:3px;width:80%;margin-bottom:.4rem"></div>
          <div style="background:#dbeafe;height:8px;border-radius:3px;width:55%;margin-bottom:.85rem"></div>
          <span style="display:inline-flex;align-items:center;gap:.4rem;background:var(--gold);color:#fff;padding:.3rem .8rem;border-radius:4px;font-size:.72rem;font-weight:600;letter-spacing:.02em">
            <svg style="width:9px;height:9px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            Learn More
          </span>
        </div>
        <div style="padding:.55rem 1rem;background:#fffbf5;border-top:1px solid var(--line);text-align:center;font-size:.72rem;color:var(--gold);font-weight:600">
          Color image + clickable link &nbsp;·&nbsp; No extra postage
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════════
     5. WHAT'S INSIDE
     ════════════════════════════════════════════════════════════════════ -->
<section style="background:#fff; padding:5.5rem 1.5rem; border-top:1px solid var(--line)">
  <div style="max-width:960px; margin:0 auto">
    <span class="eyebrow" style="display:block; text-align:center; margin-bottom:.8rem">What's Inside</span>
    <h2 class="f-display" style="font-size:clamp(1.6rem,2.8vw,2.2rem); font-weight:500; color:var(--navy); text-align:center; margin:0 auto 3rem; max-width:580px; letter-spacing:-.02em; line-height:1.2">
      22 pages. No filler.<br>Sourced from USPS documentation.
    </h2>

    <div class="inside-grid">
      {[
        { n: '01', title: 'How the USPS Daily Digest works',         body: 'The mechanics behind the email — what 72.9M subscribers see, how scans are processed, and when your piece appears.' },
        { n: '02', title: 'Setting up a ride-along campaign',        body: 'Step-by-step walkthrough of the USPS Mailer Campaign Portal: uploading creative, scheduling, and linking to your mailing.' },
        { n: '03', title: 'Which mail classes qualify',              body: 'First-Class Mail, Marketing Mail, and Nonprofit Mail qualify. EDDM Retail does not — and we explain exactly why.' },
        { n: '04', title: 'Image specs',                             body: '200×200px minimum, JPEG or PNG, under 200KB. Plus safe zones, color best practices, and what USPS rejects.' },
        { n: '05', title: 'Measuring ROI with UTM tracking',         body: 'How to set up UTM parameters, unique landing pages per campaign, and the three-group test design to isolate lift.' },
