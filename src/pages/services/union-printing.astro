---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { BUSINESS, COUNTIES } from '../../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Union Printing Services',
  provider: {
    '@type': 'LocalBusiness',
    '@id': 'https://crst.net/#organization',
    name: BUSINESS.name,
    telephone: BUSINESS.phone,
  },
  areaServed: [
    { '@type': 'County', name: 'Ulster County, New York' },
    { '@type': 'County', name: 'Dutchess County, New York' },
    { '@type': 'County', name: 'Orange County, New York' },
  ],
  url: 'https://crst.net/services/union-printing',
};
---

<BaseLayout
  title="Union Printing Services — CWA Union Label on Every Piece | Cornerstone Services"
  description="High-quality union printing by Cornerstone Services — CWA Printing Sector union bug on postcards, letterhead, envelopes, brochures, and campaign materials. Fair labor, ethical printing, Hudson Valley."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <PageHero
    title="Union Printing Services"
    subtitle="Allied Printing Trades Council label on every piece."
    breadcrumbs={[
      { label: 'Services', href: '/services' },
      { label: 'Union Printing' },
    ]}
  />

  <section class="py-14 lg:py-20">
    <div class="container-narrow">
      <div class="section-divider mb-6"></div>
      <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">High-Quality, Budget-Friendly Union Printing</h2>
      <p class="text-navy-600/80 leading-relaxed mb-6">
        At Cornerstone Services, Inc., we proudly stand with workers by supporting fair labor practices and promoting ethical printing solutions. By choosing our union printing services, you not only receive top-tier print materials but also contribute to strengthening the local workforce. We offer a variety of paper stocks, coatings, finishes, inks, and sizes, allowing you to create eye-catching mail pieces while simultaneously showing your commitment to union support.
      </p>
      <p class="text-navy-600/80 leading-relaxed mb-6">
        Union printing isn't just a label — it's a commitment. It signals to voters, members, and stakeholders that your materials were produced by skilled union workers under fair labor conditions. In politically active regions like the Hudson Valley, that distinction matters. Every piece we produce under our union label meets the quality and compliance standards your organization expects.
      </p>

      <div class="bg-navy-50/60 rounded-xl border border-navy-100 p-6 lg:p-8 my-10">
        <div class="flex flex-col sm:flex-row items-center gap-6">
          <img src="/images/communications-workers-of-america.webp" alt="Communications Workers of America (CWA) logo — Cornerstone's partner union for union label printing" width="1407" height="614" loading="lazy" class="w-full sm:w-64 h-auto rounded-lg" />
          <div>
            <h3 class="font-heading font-bold text-navy-800 text-lg mb-2">Partner Union</h3>
            <p class="text-sm text-navy-600/80 leading-relaxed">
              Cornerstone Services is proud to partner with the <strong>Communications Workers of America (CWA) — Printing Sector</strong>. The CWA union label on your printed materials certifies they were produced under fair labor conditions by skilled workers.
            </p>
          </div>
        </div>
      </div>

      <div class="bg-amber-50 border border-amber-200 rounded-xl p-6 my-10 text-center">
        <img src="/images/union-bug.webp" alt="Look for the Union Bug — CWA Printing Sector Union Label" width="768" height="167" loading="lazy" class="mx-auto w-full max-w-sm h-auto mb-3" />
        <p class="text-sm text-navy-600/80">Every piece we print under our union label carries the official CWA Printing Sector union bug — your guarantee of ethical, union-made materials.</p>
      </div>

      <div class="section-divider mb-6 mt-14"></div>
      <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">Union-Printed Direct Mail Materials</h2>

      <div class="space-y-8 mb-8">
        <div>
          <h3 class="text-xl font-display text-crst-primary mb-3">Letterhead</h3>
          <p class="text-navy-600/80 leading-relaxed mb-2">
            Letterhead includes a printed heading at the top of a sheet of stationery, featuring a company's name, logo, and contact details. A well-crafted letterhead not only enhances brand recognition but also strengthens credibility and trust. It ensures consistency across all official communications, reinforcing your organization's professional image.
          </p>
          <p class="text-sm text-navy-600/60"><strong>Size:</strong> 8.5" × 11" (standard paper size)</p>
        </div>

        <div>
          <h3 class="text-xl font-display text-crst-primary mb-3">Postcards</h3>
          <p class="text-navy-600/80 leading-relaxed mb-2">
            Postcards are one of the most efficient and budget-friendly marketing tools available. They provide a great return on investment and deliver quick, concise messages to your audience. Postcards are easy to distribute, highly effective in capturing attention, and often generate high response rates — making them a go-to solution for political campaigns, labor organizations, and businesses looking to increase engagement.
          </p>
          <p class="text-sm text-navy-600/60"><strong>Sizes:</strong> 5.5" × 8.5" | 4" × 6" | 4" × 9" | 6" × 9" | 6" × 11"</p>
        </div>

        <div>
          <h3 class="text-xl font-display text-crst-primary mb-3">Envelopes</h3>
          <p class="text-navy-600/80 leading-relaxed mb-2">
            Envelopes play a vital role in making a strong first impression. They tell recipients who you are before they even open the mail and set the tone for your message. Using high-quality envelopes with bold colors, custom designs, or screened images helps increase visibility and grab attention. Well-designed envelopes reinforce professionalism, credibility, and recipient trust, making them an essential part of any successful mailing campaign.
          </p>
          <p class="text-sm text-navy-600/60"><strong>Size:</strong> #10 Regular Envelope (4⅛" × 9½"). See our full <a href="/direct-mail-tools/envelope-sizes" class="text-crst-primary underline hover:text-crst-gold">envelope sizes reference</a>.</p>
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-3 mb-6">
        {[
          'Political campaign postcards and palm cards',
          'Campaign literature and brochures',
          'Fundraising letters and appeal envelopes',
          'Caucus and electoral notification cards',
          'Labor union newsletters and flyers',
          'Government notification letters',
          'Municipal meeting notices',
          'Committee and organization stationery',
        ].map((item) => (
          <div class="flex items-start gap-3 p-3 bg-navy-50/40 rounded-lg">
            <svg class="w-4 h-4 text-crst-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span class="text-sm text-navy-700">{item}</span>
          </div>
        ))}
      </div>

      <p class="text-navy-600/80 leading-relaxed mb-6">
        At Cornerstone, our expertise goes beyond standard union-printed materials. In addition to our high-quality <a href="/services/direct-mail" class="text-crst-primary underline hover:text-crst-gold">direct mail printing services</a>, we specialize in producing custom print jobs that meet USPS standards. We work closely with you to ensure your printed pieces align with your branding, messaging, and marketing objectives. If you have a specific printing request, simply let us know, and we will take care of everything.
      </p>

      <p class="text-navy-600/80 leading-relaxed mb-6">
        Need help with <a href="/services/graphic-design" class="text-crst-primary underline hover:text-crst-gold">graphic design</a> for direct mail pieces or branding your company? Creating visually appealing designs is crucial for effective marketing. At Cornerstone, we offer expert design services to enhance your branding and direct mail materials. Whether you want a fresh new look or a design that reflects your company's identity, we're here to help.
      </p>

      <div class="bg-crst-primary/5 border border-crst-primary/15 rounded-xl p-6 mt-10 text-center">
        <p class="font-heading font-bold text-crst-primary text-lg mb-2">Need Union-Printed Materials?</p>
        <p class="text-navy-600/70 text-sm mb-4">Get a free estimate for your next political campaign, labor organization, or government mailing.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/estimate" class="btn-primary text-sm">Get a Free Estimate</a>
          <a href={`tel:${BUSINESS.phoneClean}`} class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-crst-primary hover:text-crst-accent transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call {BUSINESS.phone}
          </a>
        </div>
      </div>

      <div class="section-divider mb-6 mt-14"></div>
      <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">Political Campaign Printing & Mailing</h2>
      <p class="text-navy-600/80 leading-relaxed mb-6">
        Cornerstone has printed and mailed materials for Republican and Democratic campaigns, town committees, county legislatures, and independent candidates throughout the Hudson Valley. We understand the tight timelines, compliance requirements, and targeting precision that political mail demands.
      </p>
      <p class="text-navy-600/80 leading-relaxed mb-6">
        Our political mailing services include voter file targeting, district-level saturation mailing, <a href="/services/eddm" class="text-crst-primary underline hover:text-crst-gold">EDDM</a> for local races, and personalized variable data printing. Every piece carries the union bug and meets USPS automation requirements for maximum <a href="/direct-mail-tools/postage-rates" class="text-crst-primary underline hover:text-crst-gold">postage</a> savings.
      </p>

      <div class="bg-navy-50/60 rounded-xl border border-navy-100 p-6 lg:p-8 my-10">
        <h3 class="font-heading font-bold text-navy-800 text-lg mb-4">Full-Service Union Print + Mail</h3>
        <p class="text-sm text-navy-600/70 leading-relaxed mb-4">
          Cornerstone handles your entire campaign under one roof — no need to coordinate between a printer, a mail house, and a data vendor. We provide:
        </p>
        <div class="grid sm:grid-cols-2 gap-3">
          {[
            { title: 'Voter Data & Targeting', desc: 'District-level voter files, party affiliation filtering, turnout modeling' },
            { title: 'Design & Layout', desc: 'USPS-compliant mail piece design with union bug placement' },
            { title: 'Commercial Printing', desc: 'Offset and digital printing on premium stock' },
            { title: 'Presort & Delivery', desc: 'CASS/DPV processing, presort, and USPS drop with tracking' },
          ].map((item) => (
            <div class="p-3 bg-white rounded-lg border border-navy-100">
              <div class="font-heading font-semibold text-navy-800 text-sm mb-1">{item.title}</div>
              <div class="text-xs text-navy-600/60">{item.desc}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
    <AuthorByline compact />
  </div>

  <section class="py-10 bg-crst-primary/5 border-y border-crst-primary/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h3 class="text-xl font-display font-bold text-crst-primary mb-3">Need Union-Printed Materials?</h3>
      <p class="text-gray-600 mb-6 max-w-2xl mx-auto">Get a free estimate for your next political campaign, labor organization, or government mailing.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-primary inline-flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call {BUSINESS.phone}
        </a>
        <a href="/estimate" class="btn-accent inline-flex items-center gap-2">
          Get a Free Estimate
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 bg-navy-50/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-display font-bold text-crst-primary">Service Areas</h2>
        <p class="text-gray-600 mt-2">We serve businesses and organizations across three Hudson Valley counties.</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-4 max-w-3xl mx-auto">
        {Object.values(COUNTIES).map((county) => (
          <a href={`/service-areas/${county.slug}`} class="flex items-center justify-center gap-2 p-4 bg-white rounded-lg border border-gray-200 hover:border-crst-primary/30 hover:shadow-sm transition-all group">
            <svg class="w-5 h-5 text-crst-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="font-heading font-semibold text-gray-800 group-hover:text-crst-primary transition-colors">{county.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    headline="Need Union-Printed Materials?"
    text="Get a free estimate for your next political campaign, labor organization, or government mailing."
  />
</BaseLayout>
