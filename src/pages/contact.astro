---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EstimateForm from '../components/EstimateForm.astro';
import { BUSINESS } from '../data/site';
---

<BaseLayout
  title="Contact Us"
  description={`Contact ${BUSINESS.name} for direct mail, printing, and data services. Call ${BUSINESS.phone} or visit us at ${BUSINESS.address.full}.`}
>
  <PageHero
    title="Contact Us"
    subtitle="Get in touch — we're here to help with your next mailing project."
    breadcrumbs={[{ label: 'Contact' }]}
  />

  <section class="py-14 lg:py-20">
    <div class="container-wide">
      <div class="grid lg:grid-cols-5 gap-10 lg:gap-14">
        <!-- Contact info -->
        <div class="lg:col-span-2">
          <h2 class="text-xl font-display text-crst-primary mb-6">Get In Touch</h2>

          <div class="space-y-5">
            <div>
              <div class="text-xs font-heading font-semibold text-navy-500 uppercase tracking-wider mb-1.5">Phone</div>
              <a href={`tel:${BUSINESS.phoneClean}`} class="text-lg font-heading font-semibold text-navy-800 hover:text-crst-primary transition-colors">
                {BUSINESS.phone}
              </a>
              <div class="text-sm text-navy-500 mt-0.5">
                Alt: <a href={`tel:${BUSINESS.altPhoneClean}`} class="hover:text-crst-primary transition-colors">{BUSINESS.altPhone}</a>
              </div>
            </div>

            <div>
              <div class="text-xs font-heading font-semibold text-navy-500 uppercase tracking-wider mb-1.5">Email</div>
              <a href={`mailto:${BUSINESS.email}`} class="text-lg font-heading font-semibold text-navy-800 hover:text-crst-primary transition-colors">
                {BUSINESS.email}
              </a>
            </div>

            <div>
              <div class="text-xs font-heading font-semibold text-navy-500 uppercase tracking-wider mb-1.5">Address</div>
              <address class="not-italic text-navy-700 font-heading leading-relaxed">
                {BUSINESS.address.street}<br />
                {BUSINESS.address.city}, {BUSINESS.address.state} {BUSINESS.address.zip}
              </address>
            </div>

            <div>
              <div class="text-xs font-heading font-semibold text-navy-500 uppercase tracking-wider mb-1.5">Hours</div>
              <p class="text-navy-700 font-heading">Monday – Friday: 8:30 AM – 5:00 PM</p>
              <p class="text-navy-500 text-sm font-heading">Saturday & Sunday: Closed</p>
            </div>
          </div>

          <!-- Map -->
          <div class="mt-8 rounded-xl overflow-hidden border border-navy-100 aspect-[4/3]">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2975.5!2d-74.0871!3d41.7476!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2s31+South+Ohioville+Road+New+Paltz+NY+12561!5e0!3m2!1sen!2sus!4v1"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={`${BUSINESS.name} location map`}
            ></iframe>
          </div>
        </div>

        <!-- Form -->
        <div class="lg:col-span-3">
          <div class="bg-navy-50/40 rounded-xl p-6 lg:p-8 border border-navy-100">
            <h2 class="text-xl font-display text-crst-primary mb-2">Send Us a Message</h2>
            <p class="text-sm text-navy-600/60 font-heading mb-6">
              Fill out the form below and we'll get back to you within one business day.
            </p>
            <EstimateForm />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
