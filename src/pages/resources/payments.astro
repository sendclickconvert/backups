---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { BUSINESS } from '../../data/site';
---

<BaseLayout
  title="Make a Payment | Cornerstone Services"
  description="Pay your Cornerstone Services invoice online. Secure credit card payments accepted with a 3% processing convenience fee."
>
  <PageHero
    title="Make a Payment"
    subtitle="Pay your Cornerstone Services invoice quickly and securely online."
    breadcrumbs={[
      { label: 'Resources', href: '/resources/' },
      { label: 'Payments' },
    ]}
  />

  <section class="py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto">
        <div class="section-divider mb-6"></div>
        <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-6">
          Online Invoice Payment
        </h2>
        <p class="text-navy-600/80 leading-relaxed mb-6">
          Use the form below to pay your Cornerstone Services invoice by credit or debit card. Please have your invoice number ready. All major credit cards are accepted.
        </p>

        <div class="bg-crst-gold/10 border border-crst-gold/30 rounded-lg p-4 mb-8">
          <div class="flex gap-3">
            <svg class="w-5 h-5 text-crst-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <p class="text-sm font-semibold text-gray-800">3% Convenience Fee</p>
              <p class="text-sm text-gray-600">A 3% convenience fee is applied to all credit/debit card payments to cover processing costs. To avoid this fee, you may pay by check mailed to our office or by ACH bank transfer — contact us for ACH details.</p>
            </div>
          </div>
        </div>

        <div class="mb-8">
          <div class="space-y-4 mb-4">
            <div>
              <label class="block text-sm font-heading font-semibold text-navy-800 mb-1">Invoice Number</label>
              <input type="text" id="invoice-number" placeholder="e.g. INV-2026-0142"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg text-sm focus:outline-none focus:border-crst-primary" />
            </div>
            <div>
              <label class="block text-sm font-heading font-semibold text-navy-800 mb-1">Invoice Amount</label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm">$</span>
                <input type="number" id="invoice-amount" placeholder="0.00" min="1" step="0.01"
                  oninput="updateFeeBreakdown()"
                  class="w-full pl-8 pr-4 py-3 border border-gray-300 rounded-lg text-sm focus:outline-none focus:border-crst-primary" />
              </div>
            </div>
          </div>

          <div id="fee-breakdown" class="hidden bg-navy-50 rounded-lg p-4 mb-4 text-sm">
            <div class="flex justify-between text-navy-600 py-1"><span>Invoice amount</span><span id="display-invoice">$0.00</span></div>
            <div class="flex justify-between text-navy-600 py-1"><span>Convenience fee (3%)</span><span id="display-fee">$0.00</span></div>
            <div class="flex justify-between font-bold text-navy-800 pt-2 mt-1 border-t border-navy-200"><span>Total charged</span><span id="display-total">$0.00</span></div>
          </div>

          <div class="mb-4">
            <label class="block text-sm font-heading font-semibold text-navy-800 mb-1">Card Details</label>
            <div id="card-element" class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-white"></div>
            <div id="card-errors" class="text-red-600 text-xs mt-2 min-h-[18px]"></div>
          </div>

          <button id="submit-btn" onclick="handlePayment(event)"
            class="btn-primary w-full text-center py-4 text-base">
            <span id="btn-text">Pay Now</span>
            <span id="btn-amount" class="font-normal text-sm opacity-80 ml-2"></span>
          </button>

          <p class="text-xs text-center text-gray-400 mt-3">Secured by Stripe. Card details are never stored on our servers.</p>

          <div id="success-panel" class="hidden text-center py-8">
            <div class="w-12 h-12 bg-green-600 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </div>
            <h3 class="text-xl font-display text-crst-primary mb-2">Payment Received</h3>
            <p class="text-sm text-navy-600/80">Thank you. A receipt has been sent via Stripe.</p>
            <div id="receipt-detail" class="bg-navy-50 rounded-lg p-4 mt-4 text-sm text-left"></div>
          </div>
        </div>

        <script is:inline src="https://js.stripe.com/v3/"></script>
        <script is:inline>
          const stripe = Stripe('pk_live_51O7KqZK2qDuroGqaYn5XZGX6w0Uv8XmRXG5xi1tJbLxN0AYS6ozN2rAvRViSzEwpyhF2fJbPIZAZtUybBiUkDkJ600IHbruLNY');
          const elements = stripe.elements();
          const cardElement = elements.create('card', {
            style: {
              base: { fontFamily: 'sans-serif', fontSize: '15px', color: '#1a2744', '::placeholder': { color: '#aab' } },
              invalid: { color: '#c0392b' }
            }
          });
          cardElement.mount('#card-element');
          cardElement.on('change', ({ error }) => {
            document.getElementById('card-errors').textContent = error ? error.message : '';
          });

          function fmt(n) { return '$' + n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }

          function updateFeeBreakdown() {
            const raw = parseFloat(document.getElementById('invoice-amount').value);
            const breakdown = document.getElementById('fee-breakdown');
            if (!raw || raw <= 0) { breakdown.classList.add('hidden'); document.getElementById('btn-amount').textContent = ''; return; }
            const fee = raw * 0.03;
            const total = raw + fee;
            document.getElementById('display-invoice').textContent = fmt(raw);
            document.getElementById('display-fee').textContent = fmt(fee);
            document.getElementById('display-total').textContent = fmt(total);
            breakdown.classList.remove('hidden');
            document.getElementById('btn-amount').textContent = '— ' + fmt(total);
          }

          async function handlePayment(e) {
            e.preventDefault();
            const invoiceNumber = document.getElementById('invoice-number').value.trim();
            const invoiceAmount = parseFloat(document.getElementById('invoice-amount').value);
            if (!invoiceNumber) { alert('Please enter your invoice number.'); return; }
            if (!invoiceAmount || invoiceAmount <= 0) { alert('Please enter a valid invoice amount.'); return; }
            const fee = invoiceAmount * 0.03;
            const total = invoiceAmount + fee;
            const btn = document.getElementById('submit-btn');
            btn.disabled = true;
            document.getElementById('btn-text').textContent = 'Processing...';
            try {
              const res = await fetch('/api/create-payment-intent', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ amount: Math.round(total * 100), currency: 'usd', metadata: { invoice_number: invoiceNumber, invoice_amount: invoiceAmount.toFixed(2), convenience_fee: fee.toFixed(2) } })
              });
              const { clientSecret, error: serverError } = await res.json();
              if (serverError) { document.getElementById('card-errors').textContent = serverError; btn.disabled = false; document.getElementById('btn-text').textContent = 'Pay Now'; return; }
              const { error, paymentIntent } = await stripe.confirmCardPayment(clientSecret, { payment_method: { card: cardElement } });
              if (error) {
                document.getElementById('card-errors').textContent = error.message;
                btn.disabled = false;
                document.getElementById('btn-text').textContent = 'Pay Now';
              } else if (paymentIntent.status === 'succeeded') {
                document.getElementById('submit-btn').classList.add('hidden');
                document.getElementById('fee-breakdown').classList.add('hidden');
                document.getElementById('success-panel').classList.remove('hidden');
                document.getElementById('receipt-detail').innerHTML = '<div class="flex justify-between py-1"><span class="text-navy-600">Invoice</span><span class="font-medium">' + invoiceNumber + '</span></div><div class="flex justify-between py-1"><span class="text-navy-600">Invoice amount</span><span>' + fmt(invoiceAmount) + '</span></div><div class="flex justify-between py-1"><span class="text-navy-600">Convenience fee</span><span>' + fmt(fee) + '</span></div><div class="flex justify-between pt-2 mt-1 border-t border-navy-200 font-bold"><span>Total charged</span><span>' + fmt(total) + '</span></div>';
              }
            } catch (err) {
              document.getElementById('card-errors').textContent = 'Something went wrong. Please call (845) 255-5722.';
              btn.disabled = false;
              document.getElementById('btn-text').textContent = 'Pay Now';
            }
          }
        </script>

        <h3 class="text-xl font-display text-crst-primary mb-4">Other Payment Methods</h3>
        <div class="space-y-4 mb-10">
          <div class="bg-navy-50 rounded-lg p-5">
            <h4 class="font-heading font-bold text-navy-800 mb-2">Check (No Fee)</h4>
            <p class="text-sm text-navy-600/80">
              Mail checks payable to <strong>{BUSINESS.name}</strong> to:<br />
              {BUSINESS.address.street}<br />
              {BUSINESS.address.city}, {BUSINESS.address.state} {BUSINESS.address.zip}
            </p>
          </div>
          <div class="bg-navy-50 rounded-lg p-5">
            <h4 class="font-heading font-bold text-navy-800 mb-2">ACH Bank Transfer (No Fee)</h4>
            <p class="text-sm text-navy-600/80">
              Contact us at <a href={`tel:${BUSINESS.phoneClean}`} class="text-crst-accent hover:underline">{BUSINESS.phone}</a> or <a href={`mailto:${BUSINESS.email}`} class="text-crst-accent hover:underline">{BUSINESS.email}</a> for ACH transfer details.
            </p>
          </div>
          <div class="bg-navy-50 rounded-lg p-5">
            <h4 class="font-heading font-bold text-navy-800 mb-2">In Person</h4>
            <p class="text-sm text-navy-600/80">
              Visit our office at {BUSINESS.address.street}, {BUSINESS.address.city} during business hours (Monday–Friday, 8:30 AM – 5:00 PM). We accept cash and check only for in-person payments — no credit or debit cards at the office.
            </p>
          </div>
        </div>

        <div class="bg-crst-primary/5 border border-crst-primary/20 rounded-xl p-6">
          <h4 class="font-heading font-bold text-crst-primary mb-2">Questions About Your Invoice?</h4>
          <p class="text-navy-600/80 text-sm leading-relaxed mb-4">
            If you have questions about a charge or need a copy of your invoice, contact us directly. We're happy to help.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={`tel:${BUSINESS.phoneClean}`} class="btn-primary text-sm">Call {BUSINESS.phone}</a>
            <a href={`mailto:${BUSINESS.email}`} class="btn-secondary text-sm">Email Us</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
