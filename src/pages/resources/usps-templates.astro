---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import { BUSINESS } from '../../data/site';

const templates = [
  {
    name: '4×6 Postcard',
    dimensions: '4.25" × 6.125" (with bleed)',
    format: 'PDF / AI / PSD',
    description: 'Standard postcard with barcode clear zone, return address area, and stamp/indicia placeholder. Includes crop marks and 0.125" bleed.',
    useCases: ['Local promotions', 'Event invitations', 'Sale announcements', 'Appointment reminders'],
    specs: { bleed: '0.125"', safe: '0.25" from trim', colorMode: 'CMYK', resolution: '300 DPI' },
  },
  {
    name: '6×9 Jumbo Postcard',
    dimensions: '6.25" × 9.25" (with bleed)',
    format: 'PDF / AI / PSD',
    description: 'Oversized postcard for maximum visual impact. Still qualifies for letter-rate postage. Includes barcode clear zone and address block positioning.',
    useCases: ['Real estate', 'Restaurant menus', 'Nonprofit fundraising', 'Grand openings'],
    specs: { bleed: '0.125"', safe: '0.25" from trim', colorMode: 'CMYK', resolution: '300 DPI' },
  },
  {
    name: '6×11 EDDM Postcard',
    dimensions: '6.25" × 11.25" (with bleed)',
    format: 'PDF / AI / PSD',
    description: 'Maximum-size postcard designed for Every Door Direct Mail. Includes EDDM indicia area, carrier route endorsement, and residential customer addressing.',
    useCases: ['EDDM campaigns', 'New business saturation', 'Political mailers', 'Coupon mailers'],
    specs: { bleed: '0.125"', safe: '0.25" from trim', colorMode: 'CMYK', resolution: '300 DPI' },
  },
  {
    name: '#10 Letter Template',
    dimensions: '8.5" × 11" (letter) + 4.125" × 9.5" (envelope)',
    format: 'PDF / DOCX',
    description: 'Business letter with properly positioned address window alignment for #10 window envelopes. Includes fold marks for automated insertion.',
    useCases: ['Invoices', 'Formal correspondence', 'Fundraising appeals', 'Official notices'],
    specs: { bleed: 'N/A (cut-to-size)', safe: '0.5" margins', colorMode: 'CMYK or K-only', resolution: '300 DPI' },
  },
  {
    name: '8.5×11 Self-Mailer (Tri-fold)',
    dimensions: '8.5" × 11" flat (3.67" × 8.5" folded)',
    format: 'PDF / AI / PSD',
    description: 'Three-panel self-mailer with tab positioning marks, address panel, and barcode zone. Folds to letter size for automation-rate postage.',
    useCases: ['Newsletters', 'Program brochures', 'Product catalogs', 'Nonprofit updates'],
    specs: { bleed: '0.125"', safe: '0.25" from trim', colorMode: 'CMYK', resolution: '300 DPI' },
  },
  {
    name: '11×17 Self-Mailer (Bi-fold)',
    dimensions: '11" × 17" flat (8.5" × 11" folded)',
    format: 'PDF / AI',
    description: 'Large bi-fold self-mailer. Folds to 8.5×11 and mails as a flat. Includes tab marks and address panel positioning for flat-rate automation.',
    useCases: ['Catalogs', 'Event programs', 'Real estate flyers', 'Campaign literature'],
    specs: { bleed: '0.125"', safe: '0.25" from trim', colorMode: 'CMYK', resolution: '300 DPI' },
  },
  {
    name: '9×12 Envelope Template',
    dimensions: '9" × 12"',
    format: 'PDF / AI',
    description: 'Large envelope template with return address, postage area, and address window positioning. Designed for flat-size mailings.',
    useCases: ['Catalog mailings', 'Large document mailings', 'Nonprofit packages', 'Welcome kits'],
    specs: { bleed: 'N/A', safe: '0.375" from edge', colorMode: 'CMYK', resolution: '300 DPI' },
  },
];
---

<BaseLayout
  title="Free USPS Mail Templates — Download Print-Ready Files"
  description="Free downloadable direct mail templates for postcards, letters, self-mailers, and envelopes. Pre-formatted to USPS automation specs with bleed, safe zones, and barcode areas."
>
  <PageHero
    title="USPS Mail Templates"
    subtitle="Free print-ready templates pre-formatted to USPS automation specifications — just add your design."
    breadcrumbs={[
      { label: 'Resources', href: '/resources/' },
      { label: 'USPS Templates' },
    ]}
  />

  <section class="py-14 lg:py-20">
    <div class="container-wide">
      <div class="max-w-4xl mx-auto">
        <div class="section-divider mb-6"></div>
        <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">
          Print-Ready Mail Templates
        </h2>
        <p class="text-navy-600/80 leading-relaxed mb-4">
          Every mail piece has strict USPS requirements for barcode placement, address block positioning, and clear zones. Our templates have these zones pre-marked so your designer can focus on the creative — and your mail qualifies for the lowest automation postage rates.
        </p>
        <p class="text-navy-600/80 leading-relaxed mb-10">
          To request any template below, contact us at <a href={`mailto:${BUSINESS.email}`} class="text-crst-accent font-semibold hover:underline">{BUSINESS.email}</a> or call <a href={`tel:${BUSINESS.phoneClean}`} class="text-crst-accent font-semibold hover:underline">{BUSINESS.phone}</a>. We'll send the file format you need and can help with design if you need it.
        </p>

        <!-- Template Cards -->
        <div class="space-y-8 mb-12">
          {templates.map((template, i) => (
            <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
              <div class="p-6 sm:p-8">
                <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                  <div>
                    <h3 class="text-lg font-display font-bold text-crst-primary">{template.name}</h3>
                    <p class="text-xs font-mono text-navy-600/60 mt-1">{template.dimensions}</p>
                  </div>
                  <span class="text-xs bg-crst-primary/10 text-crst-primary font-heading font-semibold px-3 py-1 rounded-full">
                    {template.format}
                  </span>
                </div>

                <p class="text-sm text-navy-600/80 leading-relaxed mb-5">{template.description}</p>

                <div class="grid sm:grid-cols-2 gap-4 mb-5">
                  <div>
                    <h4 class="text-xs font-heading font-bold text-navy-800 uppercase tracking-wider mb-2">Ideal For</h4>
                    <div class="flex flex-wrap gap-2">
                      {template.useCases.map((use) => (
                        <span class="text-xs bg-gray-100 text-navy-600/80 px-2.5 py-1 rounded-full">{use}</span>
                      ))}
                    </div>
                  </div>
                  <div>
                    <h4 class="text-xs font-heading font-bold text-navy-800 uppercase tracking-wider mb-2">File Specs</h4>
                    <div class="text-xs text-navy-600/70 space-y-1">
                      <div>Bleed: <span class="font-semibold text-navy-800">{template.specs.bleed}</span></div>
                      <div>Safe zone: <span class="font-semibold text-navy-800">{template.specs.safe}</span></div>
                      <div>Color: <span class="font-semibold text-navy-800">{template.specs.colorMode}</span></div>
                      <div>Resolution: <span class="font-semibold text-navy-800">{template.specs.resolution}</span></div>
                    </div>
                  </div>
                </div>

                <a
                  href={`mailto:${BUSINESS.email}?subject=Template Request: ${template.name}&body=Hi, I'd like to request the ${template.name} template in the following format: `}
                  class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-crst-accent hover:text-crst-primary transition-colors"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  Request This Template
                </a>
              </div>
            </div>
          ))}
        </div>

        <!-- Design Tips -->
        <div class="bg-navy-50 rounded-xl p-6 sm:p-8 mb-12">
          <h3 class="text-xl font-display font-bold text-crst-primary mb-4">Design Tips for Mail Pieces</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div>
              <h4 class="font-heading font-bold text-navy-800 text-sm mb-2">Keep Text in the Safe Zone</h4>
              <p class="text-sm text-navy-600/80">Important text and logos should be at least 0.25" from the trim edge. Anything closer risks being cut off during production.</p>
            </div>
            <div>
              <h4 class="font-heading font-bold text-navy-800 text-sm mb-2">Respect the Barcode Area</h4>
              <p class="text-sm text-navy-600/80">The bottom 0.625" of the address side is reserved for the Intelligent Mail barcode. Keep this area clear with a white or very light background.</p>
            </div>
            <div>
              <h4 class="font-heading font-bold text-navy-800 text-sm mb-2">Use CMYK Color</h4>
              <p class="text-sm text-navy-600/80">All print files should be in CMYK color mode. RGB files will shift color when converted for press — reds may look muddy and blues may shift purple.</p>
            </div>
            <div>
              <h4 class="font-heading font-bold text-navy-800 text-sm mb-2">300 DPI Minimum</h4>
              <p class="text-sm text-navy-600/80">Images must be 300 DPI at final print size. Web images (72 DPI) will look blurry in print. This is the #1 quality issue we see in client-supplied files.</p>
            </div>
          </div>
        </div>

        <!-- CTA -->
        <div class="bg-crst-primary/5 rounded-xl p-8 text-center">
          <h3 class="text-xl font-display font-bold text-crst-primary mb-3">Need Design Help?</h3>
          <p class="text-navy-600/80 text-sm mb-5 max-w-lg mx-auto">
            Our graphic design team creates USPS-compliant mail pieces from scratch. Tell us about your campaign and we'll handle the design, printing, and mailing.
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            <a href="/services/graphic-design/" class="btn-primary">Design Services</a>
            <a href="/estimate/" class="btn-secondary">Get an Estimate</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
