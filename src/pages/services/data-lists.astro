---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import CaseStudyCallout from '../../components/CaseStudyCallout.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { BUSINESS, COUNTIES } from '../../data/site';

const clusterArticles = await getCollection('data-articles');

const dataListFaqs = [
  { q: 'Can you suppress my existing customers from a purchased list?', a: 'Yes. Send us your customer file (Excel or CSV). We\'ll scrub it against the purchased list and remove any matches. This is included at no extra charge when you print and mail with us.' },
  { q: 'How accurate are the lists?', a: 'After NCOA and CASS processing, deliverability is typically 96–98%. Some addresses will still be undeliverable (vacant homes, business closures, data entry errors), but we\'ve removed the vast majority of bad addresses before you mail.' },
  { q: 'Can I use the list more than once?', a: 'Standard pricing is for one-time use. Multi-use licenses are available — just let us know how many times you plan to mail the list. Pricing adjusts accordingly.' },
  { q: 'What if I only need 200 names?', a: 'Most list vendors have minimums of 1,000–5,000 names. We don\'t. If you need 200 names, we\'ll pull 200 names. You pay for what you use.' },
  { q: 'Do you rent lists or sell them?', a: 'We rent them. You\'re licensing the data for a specific mailing. The list provider embeds seed addresses (decoys) to monitor usage. If you mail the list multiple times without a multi-use license, they\'ll know — and they\'ll charge you.' },
  { q: 'Can you target businesses by how long they\'ve been in operation?', a: 'Yes. Business lists include "years in business" as a selectable field. This is useful if you\'re targeting established companies (5+ years) or startups (0–2 years).' },
  { q: 'Can I get phone numbers or email addresses?', a: 'Consumer lists can include phone numbers (landline and cellular). Business lists include phone, email, and website URL. Email append services are available if you only have mailing addresses and want to add email.' },
];

const graphSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Mailing List & Data Services',
      provider: {
        '@type': 'Organization',
        '@id': 'https://crst.net/#organization',
        name: BUSINESS.name,
        telephone: BUSINESS.phone,
      },
      areaServed: [
        { '@type': 'County', name: 'Ulster County, New York' },
        { '@type': 'County', name: 'Dutchess County, New York' },
        { '@type': 'County', name: 'Orange County, New York' },
      ],
      url: 'https://crst.net/services/data-lists',
    },
    {
      '@type': 'FAQPage',
      mainEntity: dataListFaqs.map(faq => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://crst.net' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://crst.net/services' },
        { '@type': 'ListItem', position: 3, name: 'Mailing Lists & Data Services', item: 'https://crst.net/services/data-lists' },
      ],
    },
    {
      '@type': 'WebPage',
      '@id': 'https://crst.net/services/data-lists',
      name: 'Mailing Lists — Targeted Consumer & Business Data',
      url: 'https://crst.net/services/data-lists',
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', 'h2'],
      },
    },
  ],
};
---

<BaseLayout
  title="Mailing Lists — Targeted Consumer & Business Data"
  description="Targeted mailing lists for direct mail — consumer and business data filtered by geography, demographics, and industry. NCOA-processed and CASS-certified."
  schema={null}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(graphSchema)} />
  </Fragment>
  <PageHero
    title="Mailing Lists & Data Services"
    subtitle="You're not losing customers because your message is wrong. You're losing them because you're mailing the wrong people. We build targeted lists that actually reach people — cleaned, verified, and ready to mail."
    breadcrumbs={[
      { label: 'Services', href: '/services' },
      { label: 'Data Lists' },
    ]}
    noSchema={true}
  />

  <section class="py-14 lg:py-20">
    <div class="container-wide">
      <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">
        <!-- Main content -->
        <div class="lg:col-span-2 prose prose-lg max-w-none">
          <div class="section-divider mb-6"></div>
          
          <p class="text-lg text-navy-700 leading-relaxed font-semibold mb-6">
            Cornerstone provides targeted mailing data lists for Hudson Valley direct mail campaigns — consumer demographics, B2B firmographics, NCOA-cleaned addresses, and custom geographic segmentation. A mailing list is the foundation of any direct mail campaign: it determines who receives your piece and, in turn, what response rate you see. We source from multiple list providers, run NCOA and address verification before delivery, and integrate the list directly into your campaign production workflow.
          </p>

          <p class="text-navy-600/80 leading-relaxed mb-8">
            Hudson Valley businesses have trusted us with 2.3 million pieces since 1998. We don't sell you a list and disappear. We build your list, process it, mail it, and track what worked. Same team, same building, same phone number for 28 years.
          </p>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-4">The Problem with Most Mailing Lists</h2>
          <p class="text-navy-600/80 leading-relaxed mb-4">
            Most list vendors hand you a spreadsheet and call it done. You're left figuring out:
          </p>
          <ul class="list-disc list-inside text-navy-600/80 space-y-2 mb-6">
            <li>How many addresses are outdated</li>
            <li>Who moved in the last four years</li>
            <li>Which records are duplicates</li>
            <li>Whether the addresses are even deliverable</li>
            <li>How to format everything for the post office</li>
            <li>If you're accidentally mailing your own customers</li>
          </ul>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            Then you mail it. Half the pieces bounce. You spent $2,000 on printing and postage, and 40% of it never arrived.
          </p>
          <p class="text-navy-600/80 leading-relaxed mb-8">
            We don't sell you raw data and walk away. We hand you a file that's been NCOA-processed, CASS-certified, deduplicated, and presorted. Every address has been verified. You're not guessing if it will deliver — we already checked.
          </p>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-4">How We Build Your List (The Actual Process)</h2>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            You tell us who you want to reach. We pull the data, clean it, verify every address, and deliver a mail-ready file. Here's what happens behind the scenes:
          </p>

          <div class="space-y-8">
            {[
              {
                step: '1',
                title: 'We Pull From National Databases',
                desc: 'Consumer lists filter by geography, income, age, homeowner status, buying behavior, and 40+ other demographics. Business lists filter by SIC/NAICS code, employee count, revenue, and location. You want every dentist in Dutchess County? Done. Homeowners in a 5-mile radius making $75K+? We\'ll have the count in two hours.'
              },
              {
                step: '2',
                title: 'We Run NCOA (National Change of Address)',
                desc: 'This catches anyone who moved in the last 48 months and updates their address. The USPS requires this for presorted mail. If you skip it, your mailing gets rejected or charges full postage. We don\'t skip it. Every list we deliver has been NCOA-processed.'
              },
              {
                step: '3',
                title: 'CASS Certification (Address Verification)',
                desc: 'CASS stands for Coding Accuracy Support System. It\'s USPS software that checks every address against their master database. If an address doesn\'t exist, it gets flagged. If it\'s formatted wrong, we fix it. This is how you qualify for automation discounts — which can cut your postage by 30–50%. Without CASS, you pay retail rates on every piece.'
              },
              {
                step: '4',
                title: 'Deduplication',
                desc: 'We identify duplicate records and remove them. You\'re not paying to mail the same person twice. If you have an existing customer list, we\'ll merge/purge it against the purchased list. This keeps you from accidentally mailing people who already buy from you — which is both expensive and annoying.'
              },
              {
                step: '5',
                title: 'Presort by ZIP Code',
                desc: 'We sort your list by ZIP code to qualify for bulk postage rates. This alone saves most campaigns 30–40% on postage. On a 5,000-piece mailing, that\'s $400–$600 you keep instead of giving to the post office.'
              }
            ].map((item) => (
              <div class="flex items-start gap-4">
                <div class="shrink-0 w-10 h-10 rounded-full bg-crst-primary flex items-center justify-center text-white font-heading font-bold">
                  {item.step}
                </div>
                <div>
                  <h3 class="font-heading font-bold text-navy-800 mb-2">{item.title}</h3>
                  <p class="text-navy-600/70 leading-relaxed">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-6">List Types We Provide</h2>
          <div class="space-y-5">
            {[
              {
                title: 'Saturation Lists',
                desc: 'Every deliverable address on selected carrier routes. Ideal for EDDM and hyper-local campaigns. No demographic filters — just blanket coverage of a geographic area.'
              },
              {
                title: 'Direct Mail Lists',
                desc: 'Our comprehensive overview of how mailing lists work — what\'s included in a list file, how data is verified, NCOA processing, CASS certification, and what separates a deliverable list from a wasted one.'
              },
              {
                title: 'Consumer Lists',
                desc: 'Filtered by age, income, homeownership, marital status, presence of children, lifestyle interests, purchase behavior, vehicle ownership, and dozens of other selects. If you need to reach "homeowners aged 45–65 making $100K+ within 10 miles of New Paltz," we can build that.',
                link: '/services/consumer-mailing-lists'
              },
              {
                title: 'Business Lists',
                desc: 'Targeted by SIC/NAICS code (industry classification), employee count, revenue range, and geography. Want every HVAC contractor in Orange County with 5–20 employees? Every pediatric practice in the Hudson Valley? We pull from Dun & Bradstreet, InfoUSA, and Experian Business.',
                link: '/services/business-mailing-lists'
              },
              {
                title: 'New Mover Lists',
                desc: 'Recently relocated households. These are high-value prospects because they\'re actively looking for local services — lawn care, HVAC, dental, auto repair, internet, insurance. New movers convert 3–5x higher than standard consumer lists.',
                link: '/services/new-mover-mailing-lists'
              },
              {
                title: 'Voter Files',
                desc: 'Registered voter data for political mailings, municipal notifications, and advocacy campaigns. Includes voting history, party affiliation, and household composition.'
              },
              {
                title: 'Custom Compiled Lists',
                desc: 'Specialty lists built from multiple sources. If you need something specific that doesn\'t fit a standard category, we compile it manually. Examples: every nonprofit with an annual budget over $500K, every business that filed for a construction permit in the last six months, every household that recently purchased solar panels.'
              }
            ].map((item) => (
              <div class="p-4 bg-navy-50/40 rounded-lg border border-navy-100">
                <h4 class="font-heading font-bold text-navy-800 mb-2">
                  {item.link ? <a href={item.link} class="text-crst-primary hover:underline">{item.title}</a> : item.title}
                </h4>
                <p class="text-sm text-navy-600/70 leading-relaxed">{item.desc}</p>
                {item.link && <a href={item.link} class="text-xs font-heading font-semibold text-crst-primary hover:underline mt-2 inline-block">View {item.title} →</a>}
              </div>
            ))}
          </div>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-4">Already Have a List? We'll Clean It.</h2>
          <p class="text-navy-600/80 leading-relaxed mb-4">
            If you already have a customer list, prospect database, or purchased file from somewhere else, we can process it for direct mail. We accept data in Excel, CSV, Access, or any database export format. We'll:
          </p>
          <ul class="list-disc list-inside text-navy-600/80 space-y-2 mb-6">
            <li>Run NCOA to update moved addresses</li>
            <li>CASS-certify for deliverability</li>
            <li>Remove duplicates</li>
            <li>Standardize formatting</li>
            <li>Presort by ZIP code</li>
            <li>Return a mail-ready file</li>
          </ul>
          <p class="text-navy-600/80 leading-relaxed mb-8">
            This service is included when you print and mail with us. If you're only processing a list (not mailing), we charge $75 per 1,000 records.
          </p>
          <p class="text-navy-600/80 leading-relaxed mb-8">
            We also offer merge/purge — combining multiple lists while removing duplicates. If you have three separate spreadsheets of prospects and customers, we'll combine them into one clean file.
          </p>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-4">What You Actually Get</h2>
          <p class="text-navy-600/80 leading-relaxed mb-4">
            A spreadsheet (Excel or CSV) with these fields:
          </p>
          <ul class="list-disc list-inside text-navy-600/80 space-y-2 mb-6">
            <li>Full name</li>
            <li>Street address (standardized to USPS format)</li>
            <li>City, State, ZIP+4</li>
            <li>Barcode assignment (for automation discounts)</li>
            <li>NCOA move status (if applicable)</li>
            <li>Deliverability score</li>
          </ul>
          <p class="text-navy-600/80 leading-relaxed mb-8">
            If you're printing and mailing with us, we take that file and run it directly through our inkjet addressing system. You don't touch it. We just need your approval on the design and we're mailing. If you're using the list elsewhere, we send you the file and you're done.
          </p>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-4">Pricing (The Real Numbers)</h2>
          <ul class="list-none text-navy-600/80 space-y-2 mb-6">
            <li><strong class="text-navy-800">Consumer Lists:</strong> $75–$125 per 1,000 names, depending on the selects</li>
            <li><strong class="text-navy-800">Business Lists:</strong> $125–$200 per 1,000 names</li>
            <li><strong class="text-navy-800">New Mover Lists:</strong> $150 per 1,000 names</li>
            <li><strong class="text-navy-800">Saturation Lists:</strong> $40–$60 per 1,000 addresses (no demographic filtering)</li>
          </ul>
          <p class="text-navy-600/80 leading-relaxed mb-8">
            Pricing includes one-time use for a single mailing. Multi-use licenses are available.
          </p>
          <p class="text-navy-600/80 leading-relaxed mb-8">
            NCOA processing, CASS certification, deduplication, and presort are included in every list we deliver. You're not paying extra for clean data — that's just how we do it.
          </p>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-4">Why Hudson Valley Businesses Use Us for Data</h2>
          <div class="space-y-6">
            {[
              {
                title: 'We\'ve been doing this since 1998.',
                desc: 'We\'re not a startup. We\'re not a venture-backed tech platform that\'ll disappear in three years. Same ownership, same team, same building for 28 years.'
              },
              {
                title: 'We\'re local.',
                desc: 'You can call us. You can visit. You can walk in with a question and talk to the person who built your list. We\'re located in Saugerties, NY.'
              },
              {
                title: 'We don\'t just sell lists — we mail them.',
                desc: 'Most list brokers hand you a spreadsheet and you\'re on your own. We build your list, design your mailer, print it, address it, sort it, and deliver it to the post office. One vendor, one invoice, one point of contact.'
              },
              {
                title: 'We know the Hudson Valley market.',
                desc: 'We\'ve mailed to every ZIP code between Poughkeepsie and Newburgh. We know which routes deliver on Saturday. We know which towns have seasonal population swings. We know where the new developments are going in before the county updates the maps.'
              },
              {
                title: 'We track what works.',
                desc: 'When you mail with us, we track response. If a campaign underperforms, we\'ll tell you why — and we\'ll adjust the next one. We\'re not trying to sell you a list and disappear. We\'re trying to help you get customers.'
              }
            ].map((item) => (
              <div>
                <h3 class="font-heading font-bold text-navy-800 mb-2">{item.title}</h3>
                <p class="text-navy-600/70 leading-relaxed">{item.desc}</p>
              </div>
            ))}
          </div>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-6">What Our Clients Are Mailing</h2>
          <ul class="list-disc list-inside text-navy-600/80 space-y-3 mb-8">
            <li><strong class="text-navy-800">HVAC contractors</strong> targeting homeowners 10+ years in the same house (older systems = replacement market)</li>
            <li><strong class="text-navy-800">Dental practices</strong> mailing new movers and households with children</li>
            <li><strong class="text-navy-800">Auto repair shops</strong> reaching vehicle owners by make, model, and year</li>
            <li><strong class="text-navy-800">Landscapers</strong> hitting high-income homeowners in specific ZIP codes</li>
            <li><strong class="text-navy-800">Insurance agencies</strong> mailing small businesses by employee count and revenue</li>
            <li><strong class="text-navy-800">Political campaigns</strong> using voter files with turnout history</li>
            <li><strong class="text-navy-800">Nonprofits</strong> reaching donors by giving capacity and affinity</li>
            <li><strong class="text-navy-800">Realtors</strong> targeting pre-movers (equity triggers, life event signals)</li>
          </ul>
          <p class="text-navy-600/80 leading-relaxed mb-8">
            If you're trying to reach a specific audience in the Hudson Valley, we've probably built that list before.
          </p>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-6">Common Questions</h2>
          <div class="space-y-4">
            {dataListFaqs.map((item) => (
              <div class="bg-navy-50/40 rounded-xl border border-navy-100 p-5">
                <h3 class="font-heading font-bold text-navy-800 mb-2 text-sm">{item.q}</h3>
                <p class="text-navy-600/70 leading-relaxed text-sm">{item.a}</p>
              </div>
            ))}
          </div>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-6">Need a List? Here's What Happens Next</h2>
          <div class="space-y-4">
            {[
              {
                num: '1',
                title: 'Tell us who you want to reach.',
                desc: 'Call (845) 255-5722 or fill out the estimate form. Describe your target audience and geography. Examples: "homeowners in New Paltz making $80K+," "all HVAC contractors in Dutchess County," "new movers in Kingston within the last 90 days."'
              },
              {
                num: '2',
                title: 'We send you a count and quote.',
                desc: 'Usually within a few hours. You\'ll see the total record count, pricing per thousand, and total cost.'
              },
              {
                num: '3',
                title: 'You approve it.',
                desc: 'Reply with approval and we pull the list. If the count is higher or lower than expected, we\'ll discuss before pulling.'
              },
              {
                num: '4',
                title: 'We deliver the file (or mail it for you).',
                desc: 'If you\'re just buying the list, we email you a cleaned, mail-ready file within 24 hours. If you\'re printing and mailing with us, we skip the file delivery and go straight to production.'
              }
            ].map((item) => (
              <div class="flex gap-4">
                <div class="shrink-0 w-8 h-8 rounded-full bg-crst-gold flex items-center justify-center text-crst-primary font-heading font-bold text-sm">
                  {item.num}
                </div>
                <div>
                  <h4 class="font-heading font-bold text-navy-800 mb-1">{item.title}</h4>
                  <p class="text-navy-600/70 leading-relaxed">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-4">Related Mailing List Guides</h2>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            Want to go deeper? These guides explain how each type of mailing list works, what filters are available, pricing, and real campaign examples from Hudson Valley businesses:
          </p>
          <div class="space-y-3 mb-8">
            <a href="/services/data-lists/what-is-ncoa-processing" class="flex items-start gap-3 p-4 bg-navy-50/40 rounded-lg border border-navy-100 hover:border-crst-primary/30 transition-colors group">
              <svg class="w-5 h-5 text-crst-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              <div>
                <span class="font-heading font-bold text-navy-800 group-hover:text-crst-primary transition-colors">NCOA &amp; List Processing Guide</span>
                <p class="text-sm text-navy-600/70 mt-1">NCOA processing, CASS certification, deduplication, merge/purge, and presort — everything that turns raw data into a mail-ready file.</p>
              </div>
            </a>
            <a href="/services/business-mailing-lists" class="flex items-start gap-3 p-4 bg-navy-50/40 rounded-lg border border-navy-100 hover:border-crst-primary/30 transition-colors group">
              <svg class="w-5 h-5 text-crst-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              <div>
                <span class="font-heading font-bold text-navy-800 group-hover:text-crst-primary transition-colors">Business Mailing Lists</span>
                <p class="text-sm text-navy-600/70 mt-1">How to target companies by industry, employee count, revenue, and geography for B2B campaigns.</p>
              </div>
            </a>
            <a href="/services/consumer-mailing-lists" class="flex items-start gap-3 p-4 bg-navy-50/40 rounded-lg border border-navy-100 hover:border-crst-primary/30 transition-colors group">
              <svg class="w-5 h-5 text-crst-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              <div>
                <span class="font-heading font-bold text-navy-800 group-hover:text-crst-primary transition-colors">Consumer Mailing Lists</span>
                <p class="text-sm text-navy-600/70 mt-1">Target households by age, income, homeowner status, and demographics with real campaign examples.</p>
              </div>
            </a>
            <a href="/services/new-mover-mailing-lists" class="flex items-start gap-3 p-4 bg-navy-50/40 rounded-lg border border-navy-100 hover:border-crst-primary/30 transition-colors group">
              <svg class="w-5 h-5 text-crst-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              <div>
                <span class="font-heading font-bold text-navy-800 group-hover:text-crst-primary transition-colors">New Mover Mailing Lists</span>
                <p class="text-sm text-navy-600/70 mt-1">Reach recent movers with 3–5x higher response rates — timing, filters, and monthly campaign strategies.</p>
              </div>
            </a>
          </div>
          <p class="text-navy-600/80 leading-relaxed mb-8">
            All mailing list services are part of our full-service <a href="/services/direct-mail" class="text-crst-primary font-semibold hover:underline">direct mail campaigns</a> — from list to mailbox, one vendor, one invoice.
          </p>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-4">Mailing List Guides &amp; Resources</h2>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            In-depth guides on NCOA processing, demographic targeting, list accuracy, saturation vs. targeted mail, list hygiene, voter files, and when to refresh your data — written by Sean Griffin, owner of Cornerstone Services since 1998.
          </p>
          <div class="grid sm:grid-cols-2 gap-4 mb-10">
            {clusterArticles.map((a) => (
              <a href={`/services/data-lists/${a.slug}`} class="block p-4 bg-navy-50/40 rounded-xl border border-navy-100 hover:border-crst-primary/30 hover:shadow-sm transition-all group">
                <h3 class="font-heading font-semibold text-navy-800 text-sm group-hover:text-crst-primary transition-colors leading-snug mb-1">{a.data.title}</h3>
                <p class="text-xs text-navy-600/60 line-clamp-2 leading-relaxed">{a.data.description}</p>
              </a>
            ))}
          </div>

          <div class="bg-crst-primary/5 border border-crst-primary/15 rounded-xl p-6 mt-10 text-center">
