---
// =============================================================================
// TableOfContents.astro — Auto-generated TOC with jump links
// Google shows these as sitelink jump-to results in SERPs.
// AI models use TOC anchors to cite specific sections.
// =============================================================================

interface Props {
  content: string;
}

const { content } = Astro.props;

// Extract H2 and H3 headings with their IDs from HTML content
interface TocItem {
  level: number;
  id: string;
  text: string;
}

const headingRegex = /<h([23])\s+id="([^"]+)"[^>]*>(.*?)<\/h[23]>/gi;
const tocItems: TocItem[] = [];
let match;

while ((match = headingRegex.exec(content)) !== null) {
  tocItems.push({
    level: parseInt(match[1]),
    id: match[2],
    text: match[3].replace(/<[^>]+>/g, ''),
  });
}
---

{tocItems.length > 0 && (
  <nav class="toc-container" aria-label="Table of Contents">
    <details class="toc-details" open>
      <summary class="toc-summary">
        <span class="toc-title">In This Article</span>
        <span class="toc-toggle" aria-hidden="true"></span>
      </summary>
      <ol class="toc-list">
        {tocItems.map((item, index) => (
          <li class={`toc-item toc-level-${item.level}`}>
            <a href={`#${item.id}`} class="toc-link">
              {item.text}
            </a>
          </li>
        ))}
      </ol>
    </details>
  </nav>
)}

<style>
  .toc-container {
    background: #f8f9fa;
    border: 1px solid #e2e8f0;
    border-left: 4px solid var(--color-primary, #1a5276);
    border-radius: 8px;
    margin: 1.5rem 0 2rem;
    overflow: hidden;
  }
  .toc-details { padding: 0; }
  .toc-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
    font-weight: 600;
    color: var(--color-primary, #1a5276);
    transition: background-color 0.2s;
  }
  .toc-summary::-webkit-details-marker { display: none; }
  .toc-summary:hover { background: #edf2f7; }
  .toc-title { font-size: 1rem; letter-spacing: 0.02em; }
  .toc-toggle::after {
    content: "▼";
    font-size: 0.65rem;
    transition: transform 0.2s;
  }
  details:not([open]) .toc-toggle::after { transform: rotate(-90deg); }
  .toc-list {
    list-style: none;
    padding: 0 1.25rem 1rem;
    margin: 0;
    counter-reset: toc-counter;
  }
  .toc-item { counter-increment: toc-counter; }
  .toc-link {
    display: block;
    padding: 0.4rem 0;
    color: #2d3748;
    text-decoration: none;
    font-size: 0.925rem;
    line-height: 1.4;
    transition: color 0.2s, padding-left 0.2s;
  }
  .toc-link::before {
    content: counter(toc-counter) ". ";
    color: #718096;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .toc-link:hover {
    color: var(--color-primary, #1a5276);
    padding-left: 4px;
  }
  .toc-level-3 { padding-left: 1.25rem; }
  .toc-level-3 .toc-link { font-size: 0.875rem; color: #4a5568; }
  :global(html) { scroll-behavior: smooth; }
  :global([id]) { scroll-margin-top: 80px; }
  @media (max-width: 768px) {
    .toc-container { margin: 1rem 0 1.5rem; }
    .toc-summary { padding: 0.85rem 1rem; }
    .toc-list { padding: 0 1rem 0.85rem; }
    .toc-link { padding: 0.35rem 0; font-size: 0.875rem; }
  }
</style>
