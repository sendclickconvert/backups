---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS } from '../data/site';
---

<BaseLayout title="Thank You" noIndex={true}>
  <section class="py-20 lg:py-28">
    <div class="container-narrow text-center">
      <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <h1 class="text-3xl sm:text-4xl font-display text-crst-primary mb-4">Thank You!</h1>
      <p class="text-lg text-navy-600/70 font-heading max-w-lg mx-auto mb-6">
        We've received your message and will be in touch within one business day. If your project is urgent, don't hesitate to call us directly.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/" class="btn-primary text-sm">Back to Home</a>
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-secondary text-sm">
          Call {BUSINESS.phone}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
