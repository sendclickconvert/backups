---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Profiles, Memberships & Resources | Cornerstone Services"
  description="Official profiles, industry memberships, credentials, and direct-mail resources for Cornerstone Services, Inc. (CRST) — Hudson Valley's USPS-certified direct mail partner since 1998."
  canonical="https://crst.net/about/profiles"
  schema={null}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Cornerstone Services, Inc.",
      "alternateName": "CRST",
      "url": "https://crst.net/",
      "logo": "https://crst.net/images/crst-logo.webp",
      "email": "info@crst.net",
      "telephone": "+1-845-255-5722",
      "foundingDate": "1998",
      "description": "USPS-certified full-service direct mail, printing, and mailing company serving Ulster, Dutchess, and Orange counties in New York's Hudson Valley since 1998.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "31 South Ohioville Road",
        "addressLocality": "New Paltz",
        "addressRegion": "NY",
        "postalCode": "12561",
        "addressCountry": "US"
      },
      "areaServed": [
        { "@type": "AdministrativeArea", "name": "Ulster County, NY" },
        { "@type": "AdministrativeArea", "name": "Dutchess County, NY" },
        { "@type": "AdministrativeArea", "name": "Orange County, NY" }
      ],
      "sameAs": [
        "https://www.linkedin.com/company/crstnet/",
        "https://www.youtube.com/@CornerstoneServicesInc",
        "https://www.facebook.com/CornerstoneServicesInc",
        "https://www.instagram.com/cornerstoneservicesinc/",
        "https://x.com/CRSTNET",
        "https://www.yelp.com/biz/cornerstone-services-inc-new-paltz-6",
        "https://www.pinterest.com/CornerstoneServicesInc/",
        "https://www.crunchbase.com/organization/cornerstone-services-inc",
        "https://www.bbb.org/us/ny/new-paltz/profile/direct-mail-advertising/cornerstone-services-inc-0121-87170789",
        "https://www.dnb.com/business-directory/company-profiles.cornerstone_services_inc.bea5b2cca95e0686affe878cd63cb671.html"
      ]
    }
    </script>
  </Fragment>

  <style>
    :root{
      --ink:#15212e;--ink-soft:#48586a;--paper:#fff;--wash:#f5f7f9;
      --line:#e2e8ee;--brand:#e2682c;--brand-deep:#1f3a5f;
      --radius:10px;--maxw:920px;
    }
    .pr-wrap{max-width:var(--maxw);margin:0 auto;padding:0 22px}
    .pr-page-header{border-top:4px solid var(--brand);padding:46px 0 30px;background:linear-gradient(180deg,#fff 0%,var(--wash) 100%);border-bottom:1px solid var(--line)}
    .pr-eyebrow{font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brand);font-weight:700;margin:0 0 10px}
    .pr-page-header h1{font-size:clamp(1.7rem,4.4vw,2.5rem);line-height:1.15;margin:0 0 14px;letter-spacing:-.01em;color:var(--ink)}
    .pr-page-header p.lede{font-size:1.06rem;color:var(--ink-soft);max-width:62ch;margin:0}
    .pr-nap{margin-top:22px;display:flex;flex-wrap:wrap;gap:8px 22px;font-size:.92rem;color:var(--ink-soft)}
    .pr-nap strong{color:var(--ink);font-weight:600}
    .pr-section{padding:38px 0;border-bottom:1px solid var(--line)}
    .pr-section h2{font-size:1.18rem;margin:0 0 4px;letter-spacing:-.01em;display:flex;align-items:baseline;gap:10px;color:var(--ink)}
    .pr-section h2 .idx{font-size:.72rem;font-weight:700;color:var(--brand);letter-spacing:.1em;font-variant-numeric:tabular-nums}
    .pr-section>.pr-wrap>p.sub{margin:.2rem 0 22px;color:var(--ink-soft);font-size:.95rem;max-width:60ch}
    .pr-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px}
    .pr-card{display:block;border:1px solid var(--line);border-radius:var(--radius);padding:14px 16px;background:var(--paper);transition:border-color .15s,box-shadow .15s,transform .15s;text-decoration:none}
    .pr-card:hover{border-color:var(--brand);box-shadow:0 4px 14px rgba(21,33,46,.07);text-decoration:none;transform:translateY(-1px)}
    .pr-card .name{font-weight:600;color:var(--ink);display:flex;align-items:center;justify-content:space-between;gap:8px}
    .pr-card .name .arrow{color:var(--brand);font-size:.9rem;opacity:.7}
    .pr-card .note{font-size:.82rem;color:var(--ink-soft);margin-top:3px}
    .pr-creds{list-style:none;margin:0;padding:0;display:grid;gap:10px}
    .pr-creds li{display:flex;gap:12px;align-items:flex-start;padding:13px 16px;background:var(--wash);border-radius:var(--radius);border:1px solid var(--line)}
    .pr-creds .badge{flex:0 0 auto;width:26px;height:26px;border-radius:6px;background:var(--brand-deep);color:#fff;font-size:.7rem;font-weight:700;display:flex;align-items:center;justify-content:center;margin-top:1px}
    .pr-creds .ctext strong{display:block;color:var(--ink)}
    .pr-creds .ctext span{font-size:.86rem;color:var(--ink-soft)}
    @media (prefers-reduced-motion:reduce){*{transition:none!important}}
  </style>

  <header class="pr-page-header">
    <div class="pr-wrap">
      <p class="pr-eyebrow">Cornerstone Services, Inc. · CRST</p>
      <h1>Profiles, Memberships &amp; Resources</h1>
      <p class="lede">A single reference point for Cornerstone Services' verified business profiles, industry memberships and credentials, and the direct-mail tools we publish for the Hudson Valley. USPS-certified and serving Ulster, Dutchess, and Orange counties since 1998.</p>
      <div class="pr-nap">
        <span><strong>Cornerstone Services, Inc.</strong></span>
        <span>31 South Ohioville Road, New Paltz, NY 12561</span>
        <span><strong>(845) 255-5722</strong></span>
        <span>info@crst.net</span>
      </div>
    </div>
  </header>

  <section class="pr-section">
    <div class="pr-wrap">
      <h2><span class="idx">01</span> Verified business profiles</h2>
      <p class="sub">Where customers and partners can confirm who we are, read reviews, and check our standing.</p>
      <div class="pr-grid">
        <a class="pr-card" href="https://maps.app.goo.gl/LvYnJjMMBfM57KDfA" target="_blank" rel="noopener"><span class="name">Google Business Profile <span class="arrow">↗</span></span><span class="note">Maps listing, hours &amp; reviews</span></a>
        <a class="pr-card" href="https://www.bbb.org/us/ny/new-paltz/profile/direct-mail-advertising/cornerstone-services-inc-0121-87170789" target="_blank" rel="noopener"><span class="name">Better Business Bureau <span class="arrow">↗</span></span><span class="note">A+ rated · Accredited since 2024</span></a>
        <a class="pr-card" href="https://www.crunchbase.com/organization/cornerstone-services-inc" target="_blank" rel="noopener"><span class="name">Crunchbase <span class="arrow">↗</span></span><span class="note">Company entity profile</span></a>
        <a class="pr-card" href="https://www.dnb.com/business-directory/company-profiles.cornerstone_services_inc.bea5b2cca95e0686affe878cd63cb671.html" target="_blank" rel="noopener"><span class="name">Dun &amp; Bradstreet <span class="arrow">↗</span></span><span class="note">Business credit record</span></a>
        <a class="pr-card" href="https://www.yelp.com/biz/cornerstone-services-inc-new-paltz-6" target="_blank" rel="noopener"><span class="name">Yelp <span class="arrow">↗</span></span><span class="note">Customer reviews</span></a>
      </div>
    </div>
  </section>

  <section class="pr-section">
    <div class="pr-wrap">
      <h2><span class="idx">02</span> Brand channels</h2>
      <p class="sub">Where we publish updates, case studies, and direct-mail education.</p>
      <div class="pr-grid">
        <a class="pr-card" href="https://www.linkedin.com/company/crstnet/" target="_blank" rel="noopener"><span class="name">LinkedIn <span class="arrow">↗</span></span><span class="note">Company page &amp; articles</span></a>
        <a class="pr-card" href="https://www.youtube.com/@CornerstoneServicesInc" target="_blank" rel="noopener"><span class="name">YouTube <span class="arrow">↗</span></span><span class="note">Guides &amp; tool walkthroughs</span></a>
        <a class="pr-card" href="https://www.facebook.com/CornerstoneServicesInc" target="_blank" rel="noopener"><span class="name">Facebook <span class="arrow">↗</span></span><span class="note">Community &amp; announcements</span></a>
        <a class="pr-card" href="https://www.instagram.com/cornerstoneservicesinc/" target="_blank" rel="noopener"><span class="name">Instagram <span class="arrow">↗</span></span><span class="note">Work &amp; behind the scenes</span></a>
        <a class="pr-card" href="https://x.com/CRSTNET" target="_blank" rel="noopener"><span class="name">X (Twitter) <span class="arrow">↗</span></span><span class="note">Updates</span></a>
        <a class="pr-card" href="https://www.pinterest.com/CornerstoneServicesInc/" target="_blank" rel="noopener"><span class="name">Pinterest <span class="arrow">↗</span></span><span class="note">Design &amp; mail-piece ideas</span></a>
      </div>
    </div>
  </section>

  <section class="pr-section">
    <div class="pr-wrap">
      <h2><span class="idx">03</span> Memberships &amp; credentials</h2>
      <p class="sub">Certifications and affiliations that establish standing.</p>
      <ul class="pr-creds">
        <li><span class="badge">✓</span><span class="ctext"><strong>USPS-certified direct mail partner</strong><span>Automation, presort, and EDDM preparation handled in-house.</span></span></li>
        <li><span class="badge">A+</span><span class="ctext"><strong>BBB Accredited Business — A+ rating</strong><span>Accredited since January 2024.</span></span></li>
        <li><span class="badge">★</span><span class="ctext"><strong>Orange County Chamber of Commerce — Member</strong><span>Add the public member-directory link once captured.</span></span></li>
        <li><span class="badge">★</span><span class="ctext"><strong>Pawling Chamber of Commerce — Member</strong><span>Add the public member-directory link once captured.</span></span></li>
        <li><span class="badge">⎙</span><span class="ctext"><strong>Union printing</strong><span>Union-label printing for political and labor organizations.</span></span></li>
      </ul>
    </div>
  </section>

  <section class="pr-section">
    <div class="pr-wrap">
      <h2><span class="idx">04</span> Direct-mail tools &amp; resources</h2>
      <p class="sub">Original references we publish and maintain — destinations that earn links on their own merit.</p>
      <div class="pr-grid">
        <a class="pr-card" href="/direct-mail-tools/bmeu"><span class="name">BMEU Locations <span class="arrow">↗</span></span><span class="note">Business Mail Entry Unit finder</span></a>
        <a class="pr-card" href="/direct-mail-tools/postage-rates"><span class="name">Postage Rates <span class="arrow">↗</span></span><span class="note">Current USPS rate reference</span></a>
        <a class="pr-card" href="/direct-mail-tools/cornerstone-mailing-permits"><span class="name">Mailing Permits Guide <span class="arrow">↗</span></span><span class="note">Permit types explained</span></a>
        <a class="pr-card" href="/usps-direct-mailer-templates"><span class="name">USPS Mailer Templates <span class="arrow">↗</span></span><span class="note">Compliant piece templates</span></a>
        <a class="pr-card" href="/guides/envelope-sizes"><span class="name">Envelope Sizes Guide <span class="arrow">↗</span></span><span class="note">Standard dimensions</span></a>
        <a class="pr-card" href="/direct-mail-tools/postal-dictionary"><span class="name">Postal Dictionary <span class="arrow">↗</span></span><span class="note">USPS terminology</span></a>
        <a class="pr-card" href="/non-profit-mailing-application"><span class="name">Non-Profit Mailing Tool <span class="arrow">↗</span></span><span class="note">PS Form 3624 guidance</span></a>
        <a class="pr-card" href="/resources/informed-delivery-guide"><span class="name">Informed Delivery Guide <span class="arrow">↗</span></span><span class="note">USPS Informed Delivery</span></a>
      </div>
    </div>
  </section>

  <section class="pr-section" style="border-bottom:none;padding-bottom:60px">
    <div class="pr-wrap">
      <h2><span class="idx">05</span> Proof &amp; coverage</h2>
      <p class="sub">Real campaign results and ongoing publishing.</p>
      <div class="pr-grid">
        <a class="pr-card" href="/case-studies"><span class="name">Case Studies <span class="arrow">↗</span></span><span class="note">Real campaigns &amp; outcomes</span></a>
        <a class="pr-card" href="https://blog.crst.net/" target="_blank" rel="noopener"><span class="name">Blog <span class="arrow">↗</span></span><span class="note">Direct-mail insights &amp; guides</span></a>
      </div>
    </div>
  </section>

</BaseLayout>
