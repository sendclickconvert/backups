---
// =============================================================================
// Blog Hub Page — Updated for v2.0
// Now shows featured images on cards + pulls author from AUTHORS record
// =============================================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import { BUSINESS } from '../../data/site';
import { BLOG_POSTS, BLOG_CATEGORIES, AUTHORS } from '../../data/blog';

// Sort by date descending
const sortedPosts = [...BLOG_POSTS].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
const featuredPost = sortedPosts[0];
const remainingPosts = sortedPosts.slice(1);

// Get categories with post counts
const categoryCounts = BLOG_CATEGORIES.map((cat) => ({
  name: cat,
  count: BLOG_POSTS.filter((p) => p.category === cat).length,
})).filter((c) => c.count > 0);

function formatDate(dateStr: string): string {
  return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

function getAuthorName(authorKey: string): string {
  const author = AUTHORS[authorKey];
  return author ? author.name : authorKey;
}

// Blog collection schema
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Cornerstone Services Direct Mail Blog',
  description: 'Expert insights on direct mail marketing, USPS regulations, printing, and mailing best practices.',
  url: `${BUSINESS.url}/blog/`,
  publisher: {
    '@type': 'Organization',
    name: BUSINESS.name,
    url: BUSINESS.url,
  },
  blogPost: sortedPosts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title,
    url: `${BUSINESS.url}/blog/${post.slug}/`,
    datePublished: post.date,
    dateModified: post.lastUpdated || post.date,
    author: {
      '@type': 'Person',
      name: getAuthorName(post.authorKey),
    },
  })),
};
---

<BaseLayout
  title="Direct Mail Blog | Tips, Guides & Industry News | Cornerstone Services"
  description="Expert insights on direct mail marketing, USPS regulations, printing, data lists, and mailing best practices from Cornerstone Services in New Paltz, NY."
>
  <PageHero
    title="Direct Mail Blog"
    subtitle="Expert insights, how-to guides, and industry news from 27+ years of direct mail experience."
    breadcrumbs={[
      { label: 'Blog' },
    ]}
  />

  <!-- Blog Collection Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

  <section class="py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Main Content -->
        <div class="lg:col-span-2">
          <!-- Featured Post -->
          {featuredPost && (
            <a href={`/blog/${featuredPost.slug}/`} class="block group mb-12">
              {featuredPost.featuredImage ? (
                <div class="rounded-xl overflow-hidden mb-4 shadow-sm">
                  <img
                    src={featuredPost.featuredImage.src}
                    alt={featuredPost.featuredImage.alt}
                    class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="eager"
                  />
                </div>
              ) : (
                <div class="bg-gradient-to-br from-crst-primary/10 to-crst-accent/10 rounded-xl p-8 mb-4">
                  <span class="text-xs font-semibold text-crst-accent uppercase tracking-wider">Latest Post</span>
                </div>
              )}
              <div class="flex items-center gap-3 text-sm text-gray-500 mb-3">
                <span>{formatDate(featuredPost.date)}</span>
                <span>·</span>
                <span class="text-crst-accent font-medium">{featuredPost.category}</span>
                <span>·</span>
                <span>{getAuthorName(featuredPost.authorKey)}</span>
              </div>
              <h2 class="text-2xl font-display font-bold text-gray-800 group-hover:text-crst-primary transition-colors mb-3">
                {featuredPost.title}
              </h2>
              <p class="text-gray-600 leading-relaxed mb-4">
                {featuredPost.excerpt}
              </p>
              <span class="text-crst-accent font-semibold text-sm group-hover:underline">
                Read Article →
              </span>
            </a>
          )}

          <!-- Post Grid -->
          <div class="space-y-8">
            {remainingPosts.map((post) => (
              <a href={`/blog/${post.slug}/`} class="block group">
                <div class="border-b border-gray-200 pb-8">
                  <div class="flex gap-5">
                    {/* Featured image thumbnail */}
                    {post.featuredImage && (
                      <div class="flex-shrink-0 w-32 h-24 rounded-lg overflow-hidden hidden sm:block">
                        <img
                          src={post.featuredImage.src}
                          alt={post.featuredImage.alt}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                          loading="lazy"
                        />
                      </div>
                    )}
                    <div class="flex-1">
                      <div class="flex items-center gap-3 text-sm text-gray-500 mb-2">
                        <span>{formatDate(post.date)}</span>
                        <span>·</span>
                        <span class="text-crst-accent font-medium">{post.category}</span>
                      </div>
                      <h3 class="text-lg font-display font-bold text-gray-800 group-hover:text-crst-primary transition-colors mb-2">
                        {post.title}
                      </h3>
                      <p class="text-gray-600 text-sm leading-relaxed line-clamp-2">
                        {post.excerpt}
                      </p>
                    </div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-1">
          <!-- Categories -->
          <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6">
            <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wider mb-4">
              Categories
            </h3>
            <ul class="space-y-2">
              {categoryCounts.map((cat) => (
                <li>
                  <span class="text-gray-600 text-sm flex justify-between">
                    <span>{cat.name}</span>
                    <span class="text-gray-400">{cat.count}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>

          <!-- CTA -->
          <div class="bg-gradient-to-br from-crst-primary to-crst-accent text-white rounded-xl p-6">
            <h3 class="font-bold text-lg mb-2">Ready to Get Started?</h3>
            <p class="text-white/90 text-sm mb-4 leading-relaxed">
              27+ years helping Hudson Valley businesses grow through direct mail.
            </p>
            <a
              href={`tel:${BUSINESS.phone.replace(/\D/g, '')}`}
              class="block text-center bg-white text-crst-primary font-semibold py-2.5 px-4 rounded-lg text-sm hover:shadow-md transition-shadow mb-3"
            >
              {BUSINESS.phone}
            </a>
            <a
              href="/contact/"
              class="block text-center border-2 border-white text-white font-semibold py-2.5 px-4 rounded-lg text-sm hover:bg-white/10 transition-colors"
            >
              Request a Quote
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
