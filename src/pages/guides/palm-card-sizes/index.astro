---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import AuthorByline from '../../../components/AuthorByline.astro';
import { BUSINESS } from '../../../data/site';

const canonical = 'https://crst.net/guides/palm-card-sizes';
const title = 'Palm Card Sizes: Dimensions, Stock & Use Cases (2026 Guide)';
const description = 'TODO_COPY — meta description for the palm card sizes guide.';
const lastUpdated = '2026-08-26';

const seanGriffin = {
  '@type': 'Person',
  '@id': 'https://crst.net/about#sean-griffin',
  name: 'Sean Griffin',
  jobTitle: 'Owner & Mailpiece Design Professional',
  description: 'Sean Griffin founded Cornerstone Services in 1998. He holds the USPS Mailpiece Design Professional (MDP) certification and has managed direct mail, printing, and mailing campaigns for businesses across Ulster, Dutchess, and Orange counties for over 28 years.',
  url: 'https://crst.net/about',
  image: 'https://crst.net/images/sean-griffin.png',
  sameAs: ['https://crst.net/about'],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    name: 'Mailpiece Design Professional (MDP)',
    credentialCategory: 'Professional Certification',
    recognizedBy: { '@type': 'Organization', name: 'United States Postal Service' },
  },
  worksFor: {
    '@type': 'Organization',
    '@id': 'https://crst.net/#organization',
    name: 'Cornerstone Services, Inc.',
    url: 'https://crst.net',
    telephone: '+1-845-255-5722',
    foundingDate: '1998',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '387 Malden Turnpike',
      addressLocality: 'Saugerties',
      addressRegion: 'NY',
      postalCode: '12477',
      addressCountry: 'US',
    },
  },
};

const sizes = [
  { size: '4 x 6', stock: '100#, 14pt AQ, 14pt UV' },
  { size: '4.5 x 6.5', stock: '14pt UV' },
  { size: '4 x 8.5', stock: '14pt AQ' },
  { size: '4 x 9', stock: '100#, 14pt AQ, 14pt UV' },
  { size: '4 x 11', stock: '14pt UV' },
  { size: '4.25 x 11', stock: '14pt AQ, 14pt UV' },
  { size: '4.5 x 11', stock: '14pt UV' },
];

const faqs = [
  { q: 'What is the most common palm card size?', a: 'TODO_COPY' },
  { q: 'What stock should I choose for a palm card?', a: 'TODO_COPY' },
  { q: 'How many palm cards do I need for a canvassing campaign?', a: 'TODO_COPY' },
  { q: 'Do palm cards need a union bug for political campaigns?', a: 'TODO_COPY' },
];

const graphItems: object[] = [
  {
    '@type': 'Article',
    headline: title,
    description,
    url: canonical,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    datePublished: lastUpdated,
    dateModified: lastUpdated,
    inLanguage: 'en-US',
    author: seanGriffin,
    publisher: {
      '@type': 'Organization',
      '@id': 'https://crst.net/#organization',
      name: 'Cornerstone Services, Inc.',
      url: 'https://crst.net',
      logo: { '@type': 'ImageObject', url: 'https://crst.net/images/crst-logo.png', width: 200, height: 60 },
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://crst.net' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://crst.net/guides' },
      { '@type': 'ListItem', position: 3, name: 'Palm Card Sizes', item: canonical },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={null}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graphItems })} />
  </Fragment>

  <section class="bg-crst-primary text-white py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-white/50 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white/80 transition-colors">Home</a><span class="mx-2">›</span>
        <a href="/guides" class="hover:text-white/80 transition-colors">Guides</a><span class="mx-2">›</span>
        <span class="text-white/70">Palm Card Sizes</span>
      </nav>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold leading-tight text-white mb-4">
        Palm Card Sizes: Dimensions, Stock & Use Cases
      </h1>
      <p class="article-lead text-white/70 text-lg max-w-2xl leading-relaxed">
        TODO_COPY — hero lead paragraph introducing this guide.
      </p>
    </div>
  </section>

  <section class="py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">

        <div class="lg:col-span-2">

          <div class="bg-navy-50/60 border border-navy-100 rounded-xl p-5 mb-8 text-navy-700 leading-relaxed">
            TODO_COPY — short retrieval-style summary paragraph for search snippets.
          </div>

          <h2 class="text-2xl font-display font-bold text-crst-primary mb-4">Palm Card Sizes at a Glance</h2>
          <div class="overflow-x-auto rounded-xl border border-navy-100 mb-10">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-crst-primary text-white">
                  <th class="px-4 py-3 text-left font-heading font-semibold">Size (inches)</th>
                  <th class="px-4 py-3 text-left font-heading font-semibold">Available Stock</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-navy-100">
                {sizes.map((row, i) => (
                  <tr class={`${i % 2 === 0 ? 'bg-white' : 'bg-navy-50/20'}`}>
                    <td class="px-4 py-3 font-mono text-xs text-navy-700 font-semibold">{row.size}</td>
                    <td class="px-4 py-3 text-navy-600/80 text-xs">{row.stock}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="prose prose-navy max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent hover:prose-a:text-crst-primary prose-strong:text-navy-800 prose-p:text-navy-600/80 prose-li:text-navy-600/80">
            <h2>Choosing the Right Palm Card Size</h2>
            <p>TODO_COPY</p>
            <h2>Palm Card Stock Options Explained</h2>
            <p>TODO_COPY</p>
            <h2>Union-Printed Palm Cards</h2>
            <p>Campaigns and labor organizations that need a union-printed palm card can order our <a href="/shop/up-palm-card">Union Palm Card</a>, produced at a union shop with the official union bug. See our <a href="/guides/union-bug-printing">Union Bug Printing guide</a> for background on when a union label is required.</p>
          </div>

          <div class="not-prose mt-8">
            <AuthorByline />
          </div>

          <div class="mt-12">
            <div class="section-divider mb-6"></div>
            <h2 class="text-2xl font-display text-crst-primary mb-6">Frequently Asked Questions</h2>
            <div class="space-y-4">
              {faqs.map((item) => (
                <div class="bg-navy-50/40 rounded-xl border border-navy-100 p-5">
                  <h3 class="font-heading font-semibold text-navy-800 text-sm mb-2">{item.q}</h3>
                  <p class="text-sm text-navy-600/70 leading-relaxed">{item.a}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="bg-crst-primary/5 border border-crst-primary/15 rounded-xl p-6 text-center mt-10">
            <p class="font-heading font-bold text-crst-primary text-lg mb-2">Ready to order palm cards?</p>
            <p class="text-navy-600/70 text-sm mb-4">Order online in minutes, or talk it through with us first.</p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
              <a href="/shop/palm-card" class="btn-primary text-sm">Shop Palm Cards →</a>
              <a href={`tel:${BUSINESS.phoneClean}`} class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-crst-primary hover:text-crst-accent transition-colors">
                Call {BUSINESS.phone}
              </a>
            </div>
          </div>

        </div>

        <aside class="lg:col-span-1">
          <div class="sticky top-28 space-y-6">
            <div class="bg-crst-primary rounded-xl p-6 text-white">
              <h3 class="font-display text-lg mb-2">Get a Print Quote</h3>
              <p class="text-white/60 text-sm leading-relaxed mb-4">Tell us your size, quantity, and timeline. We'll send a detailed quote within one business day.</p>
              <a href="/estimate" class="btn-accent w-full text-center text-sm">Request a Quote</a>
            </div>
            <div class="bg-navy-50/50 rounded-xl p-5 border border-navy-100">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-3">Related Resources</h3>
              <div class="space-y-2">
                {[
                  { label: 'Shop Palm Cards', href: '/shop/palm-card' },
                  { label: 'Shop Union Palm Cards', href: '/shop/up-palm-card' },
                  { label: 'Union Bug Printing Guide', href: '/guides/union-bug-printing' },
                  { label: 'Printing Services', href: '/services/printing' },
                  { label: 'Union Printing', href: '/services/union-printing' },
                ].map((link) => (
                  <a href={link.href} class="flex items-center justify-between px-3 py-2 text-sm text-navy-700 hover:text-crst-primary hover:bg-white rounded-md transition-colors font-heading">
                    {link.label}
                    <svg class="w-3.5 h-3.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
