---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import { BUSINESS } from '../../data/site';

const bbbUrl = 'https://www.bbb.org/us/ny/new-paltz/profile/direct-mail-advertising/cornerstone-services-inc-0121-87170789';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Direct Mail Associations, Memberships & Affiliations',
  url: 'https://crst.net/about/memberships',
  description: 'Cornerstone Services, Inc. holds memberships in Hudson Valley chambers of commerce, national postal associations, and maintains a BBB A+ rating.',
  publisher: {
    '@type': 'Organization',
    name: 'Cornerstone Services, Inc.',
    url: 'https://crst.net',
    telephone: '+18452555722',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '31 S Ohioville Rd',
      addressLocality: 'New Paltz',
      addressRegion: 'NY',
      postalCode: '12561',
    },
  },
};

const hvChambers = [
  { name: 'Central Catskills Chamber of Commerce', address: '37965 State Highway 28, Margaretville, NY 12455', phone: '(845) 586-3300' },
  { name: 'Delaware County Chamber of Commerce', address: '5 ½ Main Street, Delhi, NY 13753', phone: '(607) 746-2281' },
  { name: 'Red Hook Area Chamber of Commerce', address: 'PO Box 254, Red Hook, NY 12571', phone: '(845) 758-0824' },
  { name: 'Gardiner Chamber of Commerce', address: 'PO Box 452, Gardiner, NY 12525', phone: '' },
  { name: 'Ellenville–Wawarsing Chamber of Commerce', address: '124 Canal Street, Ellenville, NY 12428', phone: '(845) 647-4620' },
  { name: 'Pawling Chamber of Commerce', address: 'PO Box 19, Pawling, NY 12564', phone: '(845) 855-0500' },
  { name: 'Rhinebeck Area Chamber of Commerce', address: 'PO Box 42, Rhinebeck, NY 12572', phone: '(845) 876-5904' },
];

const nationalAssociations = [
  { name: 'Mail Systems Management Association (MSMA)', url: 'https://www.msmanational.org', description: 'National association for mail management professionals. MSMA certification validates expertise in mail operations, postal regulations, and mail center management.' },
  { name: 'Better Business Bureau (BBB)', url: bbbUrl, description: 'Cornerstone holds an A+ rating with the BBB — the highest rating issued. Accredited since 1998 with no unresolved complaints.' },
  { name: 'Greater Hudson Valley Postal Customer Council (GHV PCC)', url: 'https://www.ghvpcc.org', description: 'A partnership between the U.S. Postal Service and the mailing industry. The PCC provides education, networking, and direct access to USPS operational updates for commercial mailers.' },
];

const extendedMemberships = [
  { name: 'Commerce Chenango', address: '15 South Broad Street, Norwich, NY 13815', phone: '(607) 334-1400' },
  { name: 'Greater Afton Area Chamber of Commerce', address: 'PO Box 243, Afton, NY 13730', phone: '(607) 639-1944' },
  { name: 'Greenwood Lake Chamber of Commerce', address: 'PO Box 36, Greenwood Lake, NY 10925', phone: '(845) 477-0739' },
  { name: 'Lake Pleasant–Sacandaga Chamber of Commerce', address: 'PO Box 332, Speculator, NY 12164', phone: '(518) 548-4521' },
  { name: 'Gouverneur Chamber of Commerce', address: '214 East Main Street, Gouverneur, NY 13642', phone: '(315) 287-0331' },
  { name: 'Glen Chamber of Commerce', address: 'Watkins Glen, NY 14891', phone: '' },
  { name: 'New York Solar Energy Society (NYSES)', url: '', description: 'State chapter promoting solar energy education and adoption across New York.' },
  { name: 'New York State Association of Solid Waste Management Professionals (NYSASWM)', url: '', description: 'Professional association for solid waste management officials in New York State.' },
  { name: 'American Concrete Pavement Association (ACPA)', url: '', description: 'National trade association for the concrete pavement industry.' },
  { name: 'New York State Arborists (ISA-NYS)', url: '', description: 'New York chapter of the International Society of Arboriculture.' },
];
---

<BaseLayout
  title="Direct Mail Associations & Memberships"
  description="Cornerstone Services holds memberships in Hudson Valley chambers of commerce, the Greater Hudson Valley PCC, BBB A+ rating, MSMA, and national direct mail associations. New Paltz, NY. Est. 1998."
  canonical="https://crst.net/about/memberships"
  schema={schema}
>

  <PageHero
    title="Direct Mail Associations, Memberships & Affiliations"
    subtitle="Active memberships in Hudson Valley business organizations, national postal associations, and industry groups since 1998."
    breadcrumbs={[
      { label: 'About', href: '/about' },
      { label: 'Memberships' },
    ]}
  />

  <section class="py-14 lg:py-20">
    <div class="container-wide">
      <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">
        <div class="lg:col-span-2">

          <div class="bg-navy-50 border border-navy-100 rounded-lg p-4 mb-10 flex items-start gap-3">
            <img src="/images/sean-griffin.png" alt="Sean Griffin" class="w-12 h-12 rounded-full shrink-0" loading="lazy" />
            <div class="text-sm">
              <p class="font-semibold text-crst-primary">Sean Griffin</p>
              <p class="text-gray-600">President, Cornerstone Services, Inc. · USPS&reg; Mail Design Professional · MSMA&trade; Certified</p>
              <p class="text-gray-500 text-xs mt-1 italic">Cornerstone has maintained active memberships in Hudson Valley business and postal associations since 1998 as part of its commitment to regional community and industry standards.</p>
            </div>
          </div>

          <div class="section-divider mb-6"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">BBB A+ Rating</h2>
          <div class="flex flex-col sm:flex-row gap-6 items-start mb-6">
            <img src="/images/wp/Accredited-BBB-Logo.png" alt="BBB Accredited Business — A+ Rating" width="200" height="76" loading="lazy" class="shrink-0" />
            <div>
              <p class="text-navy-600/80 leading-relaxed mb-4">
                Cornerstone Services, Inc. holds an A+ rating with the Better Business Bureau — the highest rating the BBB issues. We have maintained continuous BBB accreditation since 1998 with no unresolved complaints. The A+ rating reflects our commitment to transparent pricing, responsive service, and ethical business practices across every <a href="/services/direct-mail" class="text-crst-accent hover:underline">direct mail</a> and printing project we handle.
              </p>
              <p class="text-navy-600/80 leading-relaxed mb-4">
                BBB accreditation is not automatic — businesses must meet the BBB's Standards for Trust, which include commitment to making a good faith effort to resolve consumer complaints, honesty in advertising, and transparency in business dealings. Our 27-year track record with the BBB speaks directly to how we operate.
              </p>
              <p class="text-sm">
                <a href={bbbUrl} target="_blank" rel="noopener noreferrer" class="text-crst-accent hover:underline font-semibold">View our BBB profile &rarr;</a>
              </p>
            </div>
          </div>

          <div class="section-divider mb-6 mt-14"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-6">Hudson Valley Chamber of Commerce Memberships</h2>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            Cornerstone maintains memberships in chambers of commerce throughout the Hudson Valley and Catskill regions. These memberships connect us with local businesses, municipalities, and <a href="/services/non-profit-mailing" class="text-crst-accent hover:underline">nonprofits</a> that rely on direct mail for community outreach, fundraising, and public communication.
          </p>
          <div class="space-y-4 mb-8">
            {hvChambers.map((chamber) => (
              <div class="bg-navy-50/40 rounded-lg border border-navy-100 p-4">
                <h3 class="font-heading font-semibold text-navy-800 text-sm mb-1">{chamber.name}</h3>
                <p class="text-xs text-navy-600/60">{chamber.address}</p>
                {chamber.phone && <p class="text-xs text-navy-600/60">{chamber.phone}</p>}
              </div>
            ))}
          </div>

          <div class="section-divider mb-6 mt-14"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-6">National and Industry Associations</h2>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            Beyond local chamber memberships, Cornerstone holds active memberships in national postal and industry organizations. These affiliations provide access to USPS regulatory updates, professional certification programs, and industry best practices that directly benefit our <a href="/services/eddm" class="text-crst-accent hover:underline">EDDM</a>, direct mail, and data services clients.
          </p>
          <div class="space-y-4 mb-8">
            {nationalAssociations.map((assoc) => (
              <div class="bg-navy-50/40 rounded-lg border border-navy-100 p-4">
                <h3 class="font-heading font-semibold text-navy-800 text-sm mb-1">{assoc.name}</h3>
                <p class="text-sm text-navy-600/70 leading-relaxed mb-2">{assoc.description}</p>
                {assoc.url && (
                  <a href={assoc.url} target="_blank" rel="noopener noreferrer" class="text-xs text-crst-accent hover:underline">{assoc.url.replace('https://', '').replace('www.', '')} &rarr;</a>
                )}
              </div>
            ))}
          </div>

          <div class="section-divider mb-6 mt-14"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-6">Extended Regional Memberships</h2>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            Cornerstone's service area extends beyond the immediate Hudson Valley. We maintain memberships in chambers and professional organizations across upstate New York, reflecting the geographic reach of our direct mail and printing services.
          </p>
          <div class="space-y-4 mb-8">
            {extendedMemberships.map((org) => (
              <div class="bg-navy-50/40 rounded-lg border border-navy-100 p-4">
                <h3 class="font-heading font-semibold text-navy-800 text-sm mb-1">{org.name}</h3>
                {'address' in org && <p class="text-xs text-navy-600/60">{org.address}</p>}
                {'phone' in org && org.phone && <p class="text-xs text-navy-600/60">{org.phone}</p>}
                {'description' in org && <p class="text-sm text-navy-600/70 leading-relaxed mt-1">{org.description}</p>}
              </div>
            ))}
          </div>

          <div class="section-divider mb-6 mt-14"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">SUNY New Paltz and Local College Affiliations</h2>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            Cornerstone Services provides internship opportunities to SUNY New Paltz and other local college students in business, marketing, and computer science. Located minutes from the SUNY New Paltz campus, our facility gives students hands-on experience in direct mail production, data processing, and print operations — skills that complement their academic programs and prepare them for careers in marketing and communications.
          </p>

          <div class="bg-navy-50 border border-navy-100 rounded-lg p-4 mt-10 flex items-start gap-3">
            <svg class="w-5 h-5 text-crst-primary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
            <div class="text-sm">
              <p class="font-semibold text-crst-primary">Sean Griffin</p>
              <p class="text-gray-600">Owner, Cornerstone Services · Hudson Valley direct mail since 1998</p>
            </div>
          </div>
        </div>

        <aside class="lg:col-span-1">
          <div class="sticky top-28 space-y-6">
            <div class="bg-crst-primary rounded-xl p-6 text-white">
              <h3 class="font-display text-lg mb-2">Questions?</h3>
              <p class="text-white/60 text-sm leading-relaxed mb-4">
                Questions about our memberships or certifications? We're happy to help.
              </p>
              <a href="/contact" class="btn-accent w-full text-center text-sm">
                Contact Us
              </a>
              <div class="mt-4 pt-4 border-t border-white/10 text-center">
                <a href={`tel:${BUSINESS.phoneClean}`} class="text-white/70 text-sm font-heading hover:text-white transition-colors">
                  Call {BUSINESS.phone}
                </a>
              </div>
            </div>

            <div class="bg-navy-50/50 rounded-xl p-5 border border-navy-100">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-3">About</h3>
              <div class="space-y-2">
                {[
                  { label: 'About Cornerstone', href: '/about' },
                  { label: 'Memberships', href: '/about/memberships', current: true },
                  { label: 'Contact', href: '/contact' },
                ].map((link) => (
                  <a href={link.href} class={`flex items-center justify-between px-3 py-2 text-sm rounded-md transition-colors font-heading ${link.current ? 'text-crst-primary bg-white font-semibold' : 'text-navy-700 hover:text-crst-primary hover:bg-white'}`}>
                    {link.label}
                    <svg class="w-3.5 h-3.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </div>

            <div class="bg-navy-50/50 rounded-xl p-5 border border-navy-100">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-3">Services</h3>
              <div class="space-y-2">
                {[
                  { label: 'Direct Mail', href: '/services/direct-mail' },
                  { label: 'EDDM', href: '/services/eddm' },
                  { label: 'Non-Profit Mailing', href: '/services/non-profit-mailing' },
                ].map((link) => (
                  <a href={link.href} class="flex items-center justify-between px-3 py-2 text-sm text-navy-700 hover:text-crst-primary hover:bg-white rounded-md transition-colors font-heading">
                    {link.label}
                    <svg class="w-3.5 h-3.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CTASection
    headline="Ready to Work With a Trusted Direct Mail Partner?"
    text="Contact Cornerstone Services for your next direct mail, printing, or EDDM project."
  />
</BaseLayout>
