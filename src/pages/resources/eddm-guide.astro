---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import { BUSINESS } from '../../data/site';
---

<BaseLayout
  title="EDDM Strategy Guide | Every Door Direct Mail"
  description="Complete guide to USPS Every Door Direct Mail (EDDM) — how it works, route selection, design requirements, pricing, and strategies for Hudson Valley businesses."
>
  <PageHero
    title="EDDM Strategy Guide"
    subtitle="Everything you need to know about Every Door Direct Mail — the most cost-effective way to reach every home on a mail carrier's route."
    breadcrumbs={[
      { label: 'Resources', href: '/resources' },
      { label: 'EDDM Guide' },
    ]}
  />

  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is EDDM?',
        acceptedAnswer: { '@type': 'Answer', text: 'EDDM (Every Door Direct Mail) is a USPS program that lets you send mail to every address on selected mail carrier routes without purchasing a mailing list. It\'s ideal for local businesses targeting geographic areas.' },
      },
      {
        '@type': 'Question',
        name: 'How much does EDDM cost per piece?',
        acceptedAnswer: { '@type': 'Answer', text: 'EDDM postage is a flat rate per piece — $0.247 for flats through EDDM Retail. This is significantly less than First-Class or standard Marketing Mail rates, and no mailing list purchase is required.' },
      },
      {
        '@type': 'Question',
        name: 'Do I need a mailing list for EDDM?',
        acceptedAnswer: { '@type': 'Answer', text: 'No. That\'s the primary advantage of EDDM — you select carrier routes by geography, and USPS delivers to every residential and/or business address on those routes. No list purchase, no addressing, no data processing.' },
      },
    ],
  })} />

  <section class="py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <div class="section-divider mb-6"></div>
        <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-6">
          What Is EDDM?
        </h2>
        <p class="text-navy-600/80 leading-relaxed mb-6">
          Every Door Direct Mail (EDDM) is a USPS program that lets businesses send promotional mail to every address on selected mail carrier routes — without purchasing a mailing list. You choose the geographic areas you want to reach, and the mail carrier delivers your piece to every door on those routes. No names, no addresses, no data to buy.
        </p>
        <p class="text-navy-600/80 leading-relaxed mb-8">
          EDDM is the most popular entry point for local businesses getting into direct mail for the first time. It's simple, cost-effective, and delivers impressive reach. Cornerstone handles <a href="/services/eddm" class="text-crst-primary underline hover:text-crst-gold">EDDM campaigns</a> from route selection through printing and USPS entry.
        </p>

        <h3 class="text-xl font-display text-crst-primary mb-4">How EDDM Works</h3>
        <div class="space-y-4 mb-10">
          {[
            { step: '1', title: 'Select Your Routes', desc: 'Using the USPS EDDM online tool or our route selection service, you choose carrier routes by ZIP code. Each route typically covers 300–800 addresses. You can view demographics for each route — age ranges, household income, household size.' },
            { step: '2', title: 'Design Your Mailpiece', desc: 'EDDM pieces must meet USPS size requirements (minimum 6.125" x 11.5" or larger). We design eye-catching postcards, menus, and flyers optimized for EDDM — no recipient address needed, just your marketing message.' },
            { step: '3', title: 'Print & Prepare', desc: 'We print your pieces, bundle them in carrier-route order per USPS requirements, and apply the required EDDM facing slip to each bundle.' },
            { step: '4', title: 'USPS Entry & Delivery', desc: 'We deliver your mailing to the USPS Business Mail Entry Unit (BMEU). Mail carriers deliver your piece along with regular mail — typically within 3–14 days depending on USPS scheduling.' },
          ].map((item) => (
            <div class="flex gap-4 p-5 bg-navy-50 rounded-xl">
              <div class="w-10 h-10 rounded-full bg-crst-primary text-white flex items-center justify-center text-lg font-bold shrink-0">{item.step}</div>
              <div>
                <h4 class="font-heading font-bold text-navy-800 mb-1">{item.title}</h4>
                <p class="text-sm text-navy-600/80 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <h3 class="text-xl font-display text-crst-primary mb-4">EDDM Pricing</h3>
        <div class="overflow-x-auto mb-8">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="bg-crst-primary text-white">
                <th class="text-left p-3 rounded-tl-lg">Component</th>
                <th class="text-right p-3 rounded-tr-lg">Approximate Cost*</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-gray-200">
                <td class="p-3 font-semibold text-gray-800">EDDM Retail Postage (per piece)</td>
                <td class="text-right p-3 text-gray-600">$0.247</td>
              </tr>
              <tr class="border-b border-gray-200 bg-gray-50">
                <td class="p-3 font-semibold text-gray-800">EDDM BMEU Postage (per piece)</td>
                <td class="text-right p-3 text-gray-600">$0.242</td>
              </tr>
              <tr class="border-b border-gray-200">
                <td class="p-3 font-semibold text-gray-800">Printing (6.5" x 9" postcard, 2-sided, 14pt)</td>
                <td class="text-right p-3 text-gray-600">$0.04 – $0.12 per piece</td>
              </tr>
              <tr class="border-b border-gray-200 bg-gray-50">
                <td class="p-3 font-semibold text-gray-800">Design (if needed)</td>
                <td class="text-right p-3 text-gray-600">$150 – $350 flat</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-gray-800">Handling & USPS prep</td>
                <td class="text-right p-3 text-gray-600">Included in our service</td>
              </tr>
            </tbody>
          </table>
          <p class="text-xs text-gray-400 mt-2">*Rates approximate. Printing costs depend on size, paper stock, and quantity. Contact us for a detailed quote.</p>
        </div>

        <div class="bg-crst-gold/10 border border-crst-gold/30 rounded-xl p-6 mb-10">
          <h4 class="font-heading font-bold text-crst-primary mb-2">Total Cost Example</h4>
          <p class="text-navy-600/80 text-sm leading-relaxed">
            A typical EDDM campaign of <strong>5,000 postcards</strong> (6.5" x 9", full color, 14pt stock) totals approximately <strong>$0.30–$0.35 per piece all-in</strong> — that's $1,500–$1,750 to reach 5,000 homes. Compare that to a Facebook ad campaign where $1,750 might generate 50,000 impressions but only a fraction of that in actual attention.
          </p>
        </div>

        <h3 class="text-xl font-display text-crst-primary mb-4">EDDM Size Requirements</h3>
        <p class="text-navy-600/80 leading-relaxed mb-4">
          USPS requires EDDM pieces to qualify as "flats" (not letters). This means your mailpiece must meet at least one of these minimum dimensions:
        </p>
        <div class="space-y-3 mb-8">
          <div class="bg-white border border-gray-200 rounded-lg p-4">
            <div class="font-heading font-bold text-gray-800 text-sm">Height exceeds 6.125"</div>
            <div class="text-xs text-gray-500 mt-1">Example: 6.5" × 9" postcard ✓</div>
          </div>
          <div class="bg-white border border-gray-200 rounded-lg p-4">
            <div class="font-heading font-bold text-gray-800 text-sm">Length exceeds 11.5"</div>
            <div class="text-xs text-gray-500 mt-1">Example: 4.25" × 12" panoramic postcard ✓</div>
          </div>
          <div class="bg-white border border-gray-200 rounded-lg p-4">
            <div class="font-heading font-bold text-gray-800 text-sm">Thickness exceeds 0.25"</div>
            <div class="text-xs text-gray-500 mt-1">Example: Folded menu or booklet ✓</div>
          </div>
        </div>
        <p class="text-navy-600/80 leading-relaxed mb-8">
          Maximum dimensions: 12" × 15" × 0.75". Most popular EDDM sizes are 6.5" × 9", 8.5" × 11", and 6.5" × 12". Cornerstone prints and trims to exact USPS specifications.
        </p>

        <h3 class="text-xl font-display text-crst-primary mb-4">EDDM Route Selection Strategy</h3>
        <p class="text-navy-600/80 leading-relaxed mb-4">
          Smart route selection is the difference between a successful EDDM campaign and wasted money. Here's how we help you choose the right routes:
        </p>
        <div class="space-y-4 mb-10">
          <div class="bg-white border border-gray-200 rounded-lg p-5">
            <h4 class="font-heading font-bold text-gray-800 mb-2">Geography First</h4>
            <p class="text-sm text-gray-600">Start with routes within a reasonable drive radius of your business. For most local businesses, this is 5–15 minutes. For restaurants, it may be even tighter.</p>
          </div>
          <div class="bg-white border border-gray-200 rounded-lg p-5">
            <h4 class="font-heading font-bold text-gray-800 mb-2">Demographic Filtering</h4>
            <p class="text-sm text-gray-600">The USPS EDDM tool shows demographic data for each carrier route — age ranges, household income, household size. If you're marketing premium services, you can select routes with higher median incomes. For family-oriented businesses, target routes with larger household sizes.</p>
          </div>
          <div class="bg-white border border-gray-200 rounded-lg p-5">
            <h4 class="font-heading font-bold text-gray-800 mb-2">Residential vs. Business</h4>
            <p class="text-sm text-gray-600">You can choose to deliver to residential addresses only, business addresses only, or both. Most consumer-facing businesses target residential; B2B companies may add business addresses in commercial areas.</p>
          </div>
          <div class="bg-white border border-gray-200 rounded-lg p-5">
            <h4 class="font-heading font-bold text-gray-800 mb-2">Frequency & Saturation</h4>
            <p class="text-sm text-gray-600">The most effective EDDM campaigns hit the same routes multiple times. We recommend at least 3 touches over 6–8 weeks. You can start with a smaller area and expand as you see results.</p>
          </div>
        </div>

        <h3 class="text-xl font-display text-crst-primary mb-4">Best Industries for EDDM</h3>
        <div class="grid sm:grid-cols-2 gap-3 mb-10">
          {[
            'Restaurants & pizza shops',
            'Real estate agents',
            'Home services (HVAC, plumbing, roofing)',
            'Dental & medical practices',
            'Auto repair & detailing',
            'Fitness studios & gyms',
            'Retail stores & boutiques',
            'Political campaigns',
            'Non-profit events & fundraisers',
            'New business grand openings',
          ].map((industry) => (
            <div class="flex items-center gap-3 p-3 bg-crst-light/50 rounded-lg">
              <svg class="w-5 h-5 text-crst-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-sm text-gray-700">{industry}</span>
            </div>
          ))}
        </div>

        <h3 class="text-xl font-display text-crst-primary mb-4">EDDM vs. Targeted Direct Mail</h3>
        <div class="overflow-x-auto mb-10">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="bg-crst-primary text-white">
                <th class="text-left p-3 rounded-tl-lg">Factor</th>
                <th class="text-center p-3">EDDM</th>
                <th class="text-center p-3 rounded-tr-lg">Targeted Mail</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-gray-200">
                <td class="p-3 font-semibold text-gray-800">Mailing List Required?</td>
                <td class="text-center p-3 text-green-600 font-semibold">No</td>
                <td class="text-center p-3 text-gray-600">Yes</td>
              </tr>
              <tr class="border-b border-gray-200 bg-gray-50">
                <td class="p-3 font-semibold text-gray-800">Personalization</td>
                <td class="text-center p-3 text-gray-600">None (no names)</td>
                <td class="text-center p-3 text-green-600 font-semibold">Full (name, variable data)</td>
              </tr>
              <tr class="border-b border-gray-200">
                <td class="p-3 font-semibold text-gray-800">Cost Per Piece</td>
                <td class="text-center p-3 text-green-600 font-semibold">Lower (~$0.22 postage)</td>
                <td class="text-center p-3 text-gray-600">Higher (~$0.25–0.50 postage + list)</td>
              </tr>
              <tr class="border-b border-gray-200 bg-gray-50">
                <td class="p-3 font-semibold text-gray-800">Targeting Precision</td>
                <td class="text-center p-3 text-gray-600">Geographic only</td>
                <td class="text-center p-3 text-green-600 font-semibold">Demographic + behavioral</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-gray-800">Best For</td>
                <td class="text-center p-3 text-gray-600">Local awareness, new openings</td>
                <td class="text-center p-3 text-gray-600">Repeat customers, specific audiences</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3 class="text-xl font-display text-crst-primary mb-6">Frequently Asked Questions</h3>
        <div class="space-y-4 mb-10">
          <details class="group bg-white border border-gray-200 rounded-lg" open>
            <summary class="flex items-center justify-between p-5 cursor-pointer hover:bg-gray-50 transition-colors rounded-lg">
              <h4 class="font-semibold text-gray-800 text-sm pr-4">What is EDDM?</h4>
              <svg class="w-5 h-5 text-gray-400 shrink-0 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-gray-600 leading-relaxed border-t border-gray-100 pt-4">
              EDDM (Every Door Direct Mail) is a USPS program that lets you send mail to every address on selected mail carrier routes without purchasing a mailing list. You select routes by ZIP code and geography, and the mail carrier delivers your piece to every door.
            </div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-lg">
            <summary class="flex items-center justify-between p-5 cursor-pointer hover:bg-gray-50 transition-colors rounded-lg">
              <h4 class="font-semibold text-gray-800 text-sm pr-4">How many pieces can I send with EDDM Retail?</h4>
              <svg class="w-5 h-5 text-gray-400 shrink-0 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-gray-600 leading-relaxed border-t border-gray-100 pt-4">
              EDDM Retail allows up to 5,000 pieces per ZIP code per day. For larger campaigns, Cornerstone uses EDDM through our Bulk Mail Entry Unit (BMEU) permit, which removes this limit.
            </div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-lg">
            <summary class="flex items-center justify-between p-5 cursor-pointer hover:bg-gray-50 transition-colors rounded-lg">
              <h4 class="font-semibold text-gray-800 text-sm pr-4">How long does EDDM delivery take?</h4>
              <svg class="w-5 h-5 text-gray-400 shrink-0 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-gray-600 leading-relaxed border-t border-gray-100 pt-4">
              Once entered into the mail stream, EDDM typically delivers within 3–14 business days. Local routes (especially within the Hudson Valley) tend to deliver faster. USPS does not guarantee specific delivery dates for EDDM.
            </div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-lg">
            <summary class="flex items-center justify-between p-5 cursor-pointer hover:bg-gray-50 transition-colors rounded-lg">
              <h4 class="font-semibold text-gray-800 text-sm pr-4">Can I exclude PO Boxes from EDDM?</h4>
              <svg class="w-5 h-5 text-gray-400 shrink-0 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-gray-600 leading-relaxed border-t border-gray-100 pt-4">
              EDDM only delivers to physical street addresses on selected carrier routes — PO Boxes are not included in EDDM delivery. You can choose to target residential addresses only, business addresses only, or both.
            </div>
          </details>
        </div>

        <div class="bg-crst-primary/5 border border-crst-primary/20 rounded-xl p-6">
          <h4 class="font-heading font-bold text-crst-primary mb-2">Ready to Try EDDM?</h4>
          <p class="text-navy-600/80 text-sm leading-relaxed mb-4">
            Tell us your target area and budget, and we'll pull route options with demographics, estimate your total cost, and design a mailpiece that gets results.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/estimate" class="btn-primary text-sm">Get an EDDM Quote</a>
            <a href="/services/eddm" class="btn-secondary text-sm">EDDM Services →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
