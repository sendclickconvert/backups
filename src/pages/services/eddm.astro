---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { BUSINESS, COUNTIES } from '../../data/site';
import { getCollection } from 'astro:content';

const clusterArticles = await getCollection('eddm-articles');
const eddmFaqs = [
  { q: 'What is Every Door Direct Mail (EDDM) and how does it work?', a: 'Every Door Direct Mail is a USPS program that lets you mail to every address on a carrier route without purchasing a mailing list. You select the postal routes you want to cover, print your mailpieces to USPS-approved dimensions, and drop them at the post office serving those routes. USPS carriers deliver one piece to every door on each route you\'ve selected. There are no individual names or addresses required \u2014 delivery is based entirely on the route.' },
  { q: 'How much does EDDM cost per piece?', a: 'EDDM Retail postage is currently $0.247 per piece for USPS Marketing Mail flats. This is significantly lower than First-Class postage and comparable to bulk Standard Mail rates, but without the permit fees or minimum volume requirements. Your total cost per piece \u2014 including printing and postage \u2014 depends on quantity and mailpiece size. Most clients running 5,000\u201310,000 piece campaigns land between $0.55 and $0.75 all-in.' },
  { q: 'What are the size requirements for EDDM mailpieces?', a: 'EDDM Retail mailpieces must be larger than a standard letter but no larger than a flat. The piece must be between 6.125" and 12" in height, between 11.5" and 15" in length, and no more than 0.75" thick. It must also weigh no more than 3.3 oz. Common formats that meet these specs include 6x9, 6.5x9, 8.5x11, and 9x12 postcards. Pieces outside these dimensions are not eligible for EDDM Retail rates.' },
  { q: 'How do I choose which carrier routes to target?', a: 'USPS provides a free online mapping tool at eddm.usps.com that lets you filter routes by household income, age range, and household size. You can draw a radius around your business or select routes by ZIP code. Each route typically covers 300\u2013600 addresses. For most local service businesses \u2014 HVAC, real estate, restaurants, healthcare \u2014 the best starting point is a 3\u20135 mile radius around the service area, filtered for the income demographic most likely to convert.' },
  { q: 'What is the difference between EDDM Retail and EDDM BMEU?', a: 'EDDM Retail allows you to drop your mail at a single post office serving your target routes, with no permit required and no minimum volume. It\'s ideal for small businesses mailing under 5,000 pieces per drop. EDDM BMEU (Business Mail Entry Unit) requires a postage permit and delivery to a Bulk Mail Entry facility, but it unlocks lower postage rates and removes the 5,000 piece per ZIP per day limit. For campaigns over 10,000 pieces or multi-ZIP saturation drops, BMEU is the more cost-effective option.' },
  { q: 'Can I target apartments and PO boxes with EDDM?', a: 'EDDM routes include all residential and business addresses on a carrier route, including apartments. However, you can opt out of PO boxes and businesses when selecting routes \u2014 the USPS mapping tool lets you filter for residential-only delivery. If your service is consumer-focused, filtering out businesses reduces wasted impressions. If you serve both, keeping businesses in the route can add meaningful coverage at no extra cost.' },
  { q: 'How far in advance do I need to plan an EDDM campaign?', a: 'Allow 10\u201314 business days from proof approval to drop date for standard production. Rush timelines are possible in 5\u20137 business days depending on quantity and finishing. USPS processing typically adds 3\u20135 business days after drop before delivery is complete on all routes. For time-sensitive campaigns \u2014 grand openings, seasonal promotions, election mail \u2014 building in 3 full weeks from design finalization to in-home date is the safest target.' },
  { q: 'Does Cornerstone handle the USPS paperwork and drop for EDDM campaigns?', a: 'Yes. Cornerstone manages the full EDDM fulfillment process \u2014 printing, bundling, completing the USPS facing slips, and dropping at the post office. Bundling requirements are specific: pieces must be banded in stacks of 50\u2013100 with a completed facing slip on top of each bundle. Errors in bundling or paperwork are the most common reason EDDM drops get rejected at the counter. Handling this in-house eliminates that risk and removes the logistics burden from your team.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: eddmFaqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Every Door Direct Mail (EDDM)',
  provider: {
    '@type': 'Organization',
    '@id': 'https://crst.net/#organization',
    name: BUSINESS.name,
    telephone: BUSINESS.phone,
  },
  areaServed: [
    { '@type': 'County', name: 'Ulster County, New York' },
    { '@type': 'County', name: 'Dutchess County, New York' },
    { '@type': 'County', name: 'Orange County, New York' },
  ],
  url: 'https://crst.net/services/eddm',
};
---

<BaseLayout
  title="EDDM Services — Every Door Direct Mail | From $0.247"
  description="EDDM services — reach every household on selected postal routes without a mailing list. Design, print, and mail from $0.247/piece. New Paltz, NY."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <PageHero
    title="EDDM Services — Every Door Direct Mail"
    subtitle="EDDM lets you mail to every address on a carrier route without buying a list. We handle the route selection, design, printing, and postal paperwork."
    breadcrumbs={[
      { label: 'Services', href: '/services' },
      { label: 'EDDM' },
    ]}
  />

  <section class="py-14 lg:py-20">
    <div class="container-wide">
      <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">
        <div class="lg:col-span-2">
          <div class="section-divider mb-6"></div>
          <h2 class="text-2xl font-display text-crst-primary mb-4">How EDDM Works for Local Businesses</h2>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            Cornerstone Services, Inc. (CRST) offers Every Door Direct Mail (EDDM) services in the Hudson Valley, helping businesses and organizations reach local households without purchasing a traditional mailing list. Based in New Paltz, NY and established in 1998, CRST manages EDDM design, printing, postal prep, and delivery in-house for clients across Ulster, Dutchess, and Orange counties.
          </p>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            Here's the process. First, we identify the postal routes that cover your target area. The USPS EDDM tool shows route boundaries, residential vs. business counts, and demographic filters like household income and age. We pick the routes, you approve the coverage. Then we design the mail piece — typically an oversized postcard (6.5×9 or 8.5×11) since EDDM requires flat-size pieces. We print, bundle by route, attach facing slips, and deliver to the post office. Running EDDM campaigns for Hudson Valley businesses since the program launched.
          </p>

          <h3 class="text-xl font-display text-crst-primary mt-10 mb-4">How EDDM Works</h3>
          <div class="space-y-6">
            {[
              { step: '1', title: 'Choose Your Routes', desc: 'We use the USPS EDDM mapping tool to identify postal carrier routes that match your target area. You can filter by ZIP code, city, or radius and see delivery counts for each route before committing.' },
              { step: '2', title: 'Design Your Piece', desc: 'EDDM mail pieces must meet specific size requirements (see below). Our design team creates oversized postcards and flyers that maximize the format\'s impact while meeting all USPS specifications.' },
              { step: '3', title: 'Print & Prepare', desc: 'We print your mail pieces, bundle them in groups of 50–100 per carrier route, and prepare the required USPS facing slips and documentation.' },
              { step: '4', title: 'Post Office Delivery', desc: 'Bundled mail is delivered to the local post office(s) serving your selected routes. Letter carriers deliver your piece along with regular mail — typically within 3–7 business days of drop-off.' },
            ].map((item) => (
              <div class="flex items-start gap-4">
                <div class="shrink-0 w-9 h-9 rounded-full bg-crst-primary flex items-center justify-center text-white font-heading font-bold text-sm">
                  {item.step}
                </div>
                <div>
                  <h4 class="font-heading font-bold text-navy-800 mb-1">{item.title}</h4>
                  <p class="text-sm text-navy-600/70 leading-relaxed">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <h3 class="text-xl font-display text-crst-primary mt-10 mb-4">EDDM Size Requirements</h3>
          <p class="text-navy-600/80 leading-relaxed mb-4">
            EDDM mail pieces must exceed standard letter dimensions to qualify. The USPS requires at least one of these conditions: longer than 11.5", taller than 6.125", or thicker than 0.25". Popular EDDM sizes include:
          </p>
          <div class="grid sm:grid-cols-3 gap-3 mb-6">
            {[
              { size: '6.5" × 9"', note: 'Standard oversized postcard' },
              { size: '8.5" × 11"', note: 'Full-page flyer or menu' },
              { size: '6.5" × 12"', note: 'Panoramic postcard' },
            ].map((item) => (
              <div class="p-4 bg-navy-50/40 rounded-lg text-center">
                <div class="font-heading font-bold text-crst-primary text-lg">{item.size}</div>
                <div class="text-xs text-navy-600/60 mt-1">{item.note}</div>
              </div>
            ))}
          </div>

          <div class="bg-crst-primary/5 border border-crst-primary/15 rounded-xl p-6 mt-10 text-center">
            <p class="font-heading font-bold text-crst-primary text-lg mb-2">Ready to Reach Every Door?</p>
            <p class="text-navy-600/70 text-sm mb-4">Tell us your target area and we'll provide route counts and a complete campaign quote.</p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
              <a href="/estimate" class="btn-primary text-sm">Get a Free Estimate</a>
              <a href={`tel:${BUSINESS.phoneClean}`} class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-crst-primary hover:text-crst-accent transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Call {BUSINESS.phone}
              </a>
            </div>
          </div>

          <h3 class="text-xl font-display text-crst-primary mt-10 mb-4">EDDM vs. Targeted Direct Mail</h3>
          <div class="overflow-x-auto mb-6">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="border-b-2 border-navy-200">
                  <th class="text-left py-3 px-4 font-heading font-bold text-navy-800"></th>
                  <th class="text-left py-3 px-4 font-heading font-bold text-crst-primary">EDDM</th>
                  <th class="text-left py-3 px-4 font-heading font-bold text-crst-primary">Targeted Mail</th>
                </tr>
              </thead>
              <tbody class="text-navy-600/70">
                <tr class="border-b border-navy-100">
                  <td class="py-2.5 px-4 font-heading font-semibold text-navy-800">Mailing List</td>
                  <td class="py-2.5 px-4">Not required</td>
                  <td class="py-2.5 px-4">Required (purchased or provided)</td>
                </tr>
                <tr class="border-b border-navy-100">
                  <td class="py-2.5 px-4 font-heading font-semibold text-navy-800">Postage</td>
                  <td class="py-2.5 px-4">$0.247/piece (Retail)</td>
                  <td class="py-2.5 px-4">Varies by class and presort level</td>
                </tr>
                <tr class="border-b border-navy-100">
                  <td class="py-2.5 px-4 font-heading font-semibold text-navy-800">Targeting</td>
                  <td class="py-2.5 px-4">Geographic (carrier routes)</td>
                  <td class="py-2.5 px-4">Demographic + geographic</td>
                </tr>
                <tr class="border-b border-navy-100">
                  <td class="py-2.5 px-4 font-heading font-semibold text-navy-800">Personalization</td>
                  <td class="py-2.5 px-4">No (unaddressed)</td>
                  <td class="py-2.5 px-4">Yes (name, address, variable data)</td>
                </tr>
                <tr class="border-b border-navy-100">
                  <td class="py-2.5 px-4 font-heading font-semibold text-navy-800">Best For</td>
                  <td class="py-2.5 px-4">Local awareness, grand openings, menus</td>
                  <td class="py-2.5 px-4">Lead generation, retention, fundraising</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="text-navy-600/80 leading-relaxed">
            Not sure which approach is right for your campaign? <a href="/contact" class="text-crst-accent hover:text-crst-primary underline">Contact us</a> and we'll help you decide based on your goals and budget.
          </p>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="sticky top-24 space-y-5">
            <div class="bg-crst-primary rounded-xl p-6 text-white">
              <h3 class="font-display text-lg mb-2">Get an EDDM Quote</h3>
              <p class="text-white/60 text-sm leading-relaxed mb-4">
                Tell us your target area and we'll provide route counts and a complete campaign quote.
              </p>
              <a href="/estimate" class="btn-accent w-full text-center text-sm">
                Request Quote
              </a>
              <div class="mt-4 pt-4 border-t border-white/10 text-center">
                <a href={`tel:${BUSINESS.phoneClean}`} class="text-white/70 text-sm font-heading hover:text-white transition-colors">
                  or call {BUSINESS.phone}
                </a>
              </div>
            </div>

            <div class="bg-navy-50/50 rounded-xl p-5 border border-navy-100">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-3">Related Services</h3>
              <div class="space-y-2">
                {[
                  { label: 'Direct Mail Campaigns', href: '/services/direct-mail' },
                  { label: 'Data Lists', href: '/services/data-lists' },
                  { label: 'Printing Services', href: '/services/printing' },
                  { label: 'Graphic Design', href: '/services/graphic-design' },
                ].map((link) => (
                  <a href={link.href} class="flex items-center justify-between px-3 py-2 text-sm text-navy-700 hover:text-crst-primary hover:bg-white rounded-md transition-colors font-heading">
                    {link.label}
                    <svg class="w-3.5 h-3.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </div>

            <div class="bg-crst-gold/10 rounded-xl p-5 border border-crst-gold/20">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-2">EDDM Quick Facts</h3>
              <div class="space-y-2 text-sm text-navy-600/70">
                <p>Postage: <strong class="text-navy-800">$0.247/piece</strong> (Retail)</p>
                <p>No mailing list needed</p>
                <p>Minimum: <strong class="text-navy-800">200 pieces</strong> per route</p>
                <p>Maximum: <strong class="text-navy-800">5,000 pieces/day</strong> per ZIP (Retail)</p>
                <p>Delivery: <strong class="text-navy-800">3–7 business days</strong></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 lg:py-10">
    <div class="container-narrow">
      <div class="section-divider mb-6"></div>
      <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-6">EDDM Frequently Asked Questions</h2>
      <div class="space-y-4">
        {eddmFaqs.map((item) => (
          <details class="group bg-navy-50/40 rounded-xl border border-navy-100 overflow-hidden">
            <summary class="flex items-center justify-between p-5 cursor-pointer font-heading font-semibold text-navy-800 text-sm hover:bg-navy-50 transition-colors">
              {item.q}
              <svg class="w-5 h-5 text-navy-400 shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-navy-600/70 leading-relaxed">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
    <AuthorByline compact />
  </div>

  <section class="py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-display font-bold text-crst-primary mb-3">EDDM by Industry</h2>
        <p class="text-navy-600/80 text-sm leading-relaxed mb-6">Every Door Direct Mail works differently depending on your industry. We've put together guides for the verticals we work with most across the Hudson Valley:</p>
        <div class="grid sm:grid-cols-2 gap-4 mb-12">
          {[
            { title: 'EDDM for Dentists', url: 'https://blog.crst.net/eddm-for-dentists/', desc: 'Target new patients in your neighborhood' },
            { title: 'EDDM for Restaurants', url: 'https://blog.crst.net/eddm-for-restaurants-2/', desc: 'Drive foot traffic with menu mailers and seasonal promos' },
            { title: 'EDDM for Real Estate Agents', url: 'https://blog.crst.net/eddm-for-real-estate/', desc: 'Farm neighborhoods with just-listed and market update cards' },
            { title: 'EDDM for Salons', url: 'https://blog.crst.net/eddm-for-salons/', desc: 'Reach new clients within walking distance of your shop' },
            { title: 'EDDM for Gyms & Fitness', url: 'https://blog.crst.net/eddm-for-gyms/', desc: 'Promote memberships and class schedules to nearby households' },
            { title: 'EDDM for Auto Dealers', url: 'https://blog.crst.net/eddm-for-auto-dealers/', desc: 'Saturate your market with service specials and inventory promos' },
            { title: 'EDDM for Political Campaigns', url: 'https://blog.crst.net/eddm-political-campaigns/', desc: 'Reach every voter on targeted carrier routes' },
          ].map((item) => (
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="flex items-start gap-3 p-4 bg-navy-50 rounded-lg border border-navy-100 hover:border-crst-primary/30 hover:shadow-sm transition-all group">
              <svg class="w-5 h-5 text-crst-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
              <div>
                <span class="font-heading font-semibold text-gray-800 group-hover:text-crst-primary transition-colors text-sm">{item.title}</span>
                <p class="text-xs text-navy-600/60 mt-0.5">{item.desc}</p>
              </div>
            </a>
          ))}
        </div>

        <h2 class="text-2xl font-display font-bold text-crst-primary mb-3">EDDM Guides &amp; Resources</h2>
        <p class="text-navy-600/80 text-sm leading-relaxed mb-6">Planning your first campaign or optimizing an existing one? These guides cover pricing, design, tracking, and strategy:</p>
        <div class="space-y-4">
          {[
            { title: 'EDDM Cost and Pricing Guide', url: 'https://blog.crst.net/eddm-cost-pricing/' },
            { title: 'EDDM Postcard Sizes Explained', url: 'https://blog.crst.net/eddm-postcard-sizes/' },
            { title: 'EDDM Postcard Templates', url: 'https://blog.crst.net/eddm-postcard-templates/' },
            { title: 'Your First EDDM Campaign: A Step-by-Step Guide', url: 'https://blog.crst.net/eddm-first-campaign-guide/' },
            { title: 'EDDM Postcard Printing Cost Guide', url: 'https://blog.crst.net/eddm-postcard-printing-cost/' },
            { title: 'EDDM Design Tips', url: 'https://blog.crst.net/eddm-design-tips-2/' },
            { title: 'How to Track EDDM Results', url: 'https://blog.crst.net/eddm-tracking-results/' },
            { title: 'EDDM vs. Informed Delivery', url: 'https://blog.crst.net/eddm-vs-informed-delivery/' },
            { title: 'EDDM Bulk Mailing Guide', url: 'https://blog.crst.net/eddm-bulk-mailing/' },
          ].map((item) => (
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-4 bg-navy-50 rounded-lg border border-navy-100 hover:border-crst-primary/30 hover:shadow-sm transition-all group">
              <svg class="w-5 h-5 text-crst-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              <span class="font-heading font-semibold text-gray-800 group-hover:text-crst-primary transition-colors">{item.title}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-10 bg-crst-primary/5 border-y border-crst-primary/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h3 class="text-xl font-display font-bold text-crst-primary mb-3">Ready to Reach Every Door?</h3>
      <p class="text-gray-600 mb-6 max-w-2xl mx-auto">Tell us your target area and we'll provide route counts and a complete campaign quote.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-primary inline-flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call {BUSINESS.phone}
        </a>
        <a href="/estimate" class="btn-accent inline-flex items-center gap-2">
          Get a Free Estimate
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 bg-navy-50/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-display font-bold text-crst-primary">Service Areas</h2>
        <p class="text-gray-600 mt-2">We serve businesses and organizations across three Hudson Valley counties.</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-4 max-w-3xl mx-auto">
        {Object.values(COUNTIES).map((county) => (
          <a href={`/service-areas/${county.slug}`} class="flex items-center justify-center gap-2 p-4 bg-white rounded-lg border border-gray-200 hover:border-crst-primary/30 hover:shadow-sm transition-all group">
            <svg class="w-5 h-5 text-crst-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="font-heading font-semibold text-gray-800 group-hover:text-crst-primary transition-colors">{county.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-display font-bold text-crst-primary mb-3">EDDM Guides &amp; Resources</h2>
        <p class="text-navy-600/70 max-w-2xl mx-auto">In-depth guides on EDDM postcard sizes, postage costs, retail vs. BMEU, design specs, and how to set up a campaign — written by Sean Griffin, MDP, owner of Cornerstone Services since 1998.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {clusterArticles.map((a) => (
          <a href={`/services/eddm/${a.slug}`} class="block p-5 bg-navy-50/40 rounded-xl border border-navy-100 hover:border-crst-primary/30 hover:shadow-sm transition-all group">
            <h3 class="font-heading font-semibold text-navy-800 text-sm group-hover:text-crst-primary transition-colors leading-snug mb-2">{a.data.title}</h3>
            <p class="text-xs text-navy-600/60 line-clamp-2 leading-relaxed">{a.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
