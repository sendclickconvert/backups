---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import { BUSINESS } from '../../data/site';

const mailClasses = [
  {
    name: 'Postcards',
    icon: '📮',
    description: 'The most cost-effective mail format. No envelope needed — your message is immediately visible.',
    sizes: [
      { label: 'Minimum', dimensions: '3.5" × 5"', notes: 'Smallest USPS-accepted postcard size' },
      { label: 'Standard (4×6)', dimensions: '4.25" × 6"', notes: 'Most common — qualifies for letter-rate postage' },
      { label: 'Jumbo (6×9)', dimensions: '6" × 9"', notes: 'Higher visibility; still qualifies as letter if ≤ 0.016" thick' },
      { label: 'Jumbo (6×11)', dimensions: '6" × 11"', notes: 'Maximum postcard size before flat rate applies. Popular for EDDM.' },
      { label: 'Maximum', dimensions: '6.125" × 11.5"', notes: 'Beyond this requires flat-size postage' },
    ],
    rules: [
      'Minimum thickness: 0.007" (7pt cardstock)',
      'Maximum thickness for letter rate: 0.016"',
      'Must be rectangular — aspect ratio between 1.3:1 and 2.5:1',
      'Postcards larger than 6.125" × 11.5" are classified as flats',
    ],
  },
  {
    name: 'Letters',
    icon: '✉️',
    description: 'Standard business mail in envelopes. Letters qualify for the lowest automated rates when properly formatted.',
    sizes: [
      { label: '#10 Envelope', dimensions: '4.125" × 9.5"', notes: 'Standard business envelope — most common for letters' },
      { label: '#9 Envelope', dimensions: '3.875" × 8.875"', notes: 'Reply envelope that fits inside a #10' },
      { label: '6×9 Envelope', dimensions: '6" × 9"', notes: 'Booklet style — fits 8.5×11 folded in half' },
      { label: 'Minimum', dimensions: '3.5" × 5"', notes: 'Smallest USPS letter size' },
      { label: 'Maximum', dimensions: '6.125" × 11.5"', notes: 'Beyond this = flat-size postage' },
    ],
    rules: [
      'Must be at least 0.007" thick',
      'Maximum thickness: 0.25" (1/4 inch)',
      'Maximum weight for First-Class letter: 3.5 oz',
      'Must be flexible (not rigid) unless ≤ 0.25" thick',
      'Aspect ratio must be between 1.3:1 and 2.5:1',
      'Address must be parallel to the longest dimension',
    ],
  },
  {
    name: 'Flats (Large Envelopes)',
    icon: '📦',
    description: 'Larger mail pieces like catalogs, magazines, and oversized envelopes. Higher postage but more real estate for your message.',
    sizes: [
      { label: '9×12 Envelope', dimensions: '9" × 12"', notes: 'Fits 8.5×11 unfolded — very common for flats' },
      { label: '10×13 Envelope', dimensions: '10" × 13"', notes: 'Common catalog envelope with extra room' },
      { label: 'Minimum', dimensions: '6.125" × 11.5" (or taller than 6.125")', notes: 'Anything exceeding letter dimensions' },
      { label: 'Maximum', dimensions: '12" × 15"', notes: 'Largest flat before parcel pricing' },
    ],
    rules: [
      'Maximum thickness: 0.75" (3/4 inch)',
      'Must be rectangular and flexible',
      'Cannot be more than 12" high × 15" long × 0.75" thick',
      'Heavier postage than letters — plan accordingly',
      'Non-machinable surcharge may apply for unusual shapes',
    ],
  },
  {
    name: 'Self-Mailers',
    icon: '📄',
    description: 'Folded pieces that mail without an envelope. Great for newsletters, menus, and promotional pieces.',
    sizes: [
      { label: 'Bi-fold (8.5×11)', dimensions: '5.5" × 8.5" (folded)', notes: 'Standard letter sheet folded in half' },
      { label: 'Tri-fold (8.5×11)', dimensions: '3.67" × 8.5" (folded)', notes: 'Fits in standard letter trays' },
      { label: 'Bi-fold (11×17)', dimensions: '8.5" × 11" (folded)', notes: 'Large format — counts as a flat' },
      { label: 'Z-fold / Accordion', dimensions: 'Varies', notes: 'Multiple panels — check thickness limits' },
    ],
    rules: [
      'Must be tabbed or sealed per USPS DMM 201.3 standards',
      'Letter-size self-mailers: 1 tab minimum (2 recommended)',
      'Flat-size self-mailers: 2 tabs minimum',
      'Tabs must be at least 1" long and placed on the top edge',
      'Address panel must be on the outside after folding',
      'Open edge must be at the top (not the leading/trailing edge)',
    ],
  },
];

const surcharges = [
  { condition: 'Non-machinable letter', surcharge: '$0.22', reason: 'Square, too rigid, poly-wrapped, or has clasps/buttons' },
  { condition: 'Non-standard aspect ratio', surcharge: '$0.22', reason: 'Length ÷ width is not between 1.3 and 2.5' },
  { condition: 'Barcode not readable', surcharge: 'Loss of automation discount', reason: 'Up to $0.10+ per piece vs. automation rate' },
  { condition: 'Underweight postcard', surcharge: 'Rejected', reason: 'Below 0.007" thickness or smaller than 3.5×5' },
  { condition: 'Oversize letter', surcharge: 'Flat-rate pricing', reason: 'Exceeds 6.125×11.5 or 0.25" thick — jumps to flat rate' },
];
---

<BaseLayout
  title="USPS Envelope & Mail Piece Sizes: #10, 6x9, A2, Postcards & Flats"
  description="Every USPS mail piece size in one place — #10 envelopes, 6×9, A2, postcards, flats, and self-mailers. Includes exact dimensions, weight limits, surcharge thresholds, and automation rules. Updated 2025."
  canonical="https://crst.net/direct-mail-tools/envelope-sizes/"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What size is a #10 envelope?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A #10 envelope measures 4.125 inches × 9.5 inches. It is the standard business envelope used for letters, invoices, and direct mail. It qualifies for USPS First-Class letter-rate postage when properly addressed and within weight limits (under 3.5 oz)."
        }
      },
      {
        "@type": "Question",
        "name": "What is the maximum postcard size for USPS letter-rate postage?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The maximum postcard size that qualifies for USPS letter-rate postage is 6.125 inches × 11.5 inches with a maximum thickness of 0.016 inches. Anything larger is classified as a flat and carries a higher postage rate. The 6×11 postcard (popular for EDDM campaigns) is the largest commonly used size that stays within letter-rate pricing."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between a letter and a flat in USPS mail?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A USPS letter is a mail piece between 3.5×5 inches and 6.125×11.5 inches, no more than 0.25 inches thick and 3.5 oz. A flat (large envelope) exceeds those dimensions — typically 9×12 or 10×13 envelopes — and carries higher postage rates. The practical cost difference can be significant at scale: flats cost roughly double letter-rate postage per piece."
        }
      },
      {
        "@type": "Question",
        "name": "What causes a non-machinable surcharge on a letter?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "USPS adds a $0.22 non-machinable surcharge to letters that are square, too rigid, poly-wrapped, have clasps or buttons, or fall outside the 1.3:1 to 2.5:1 aspect ratio requirement. The most common mistake we see is square invitation-style envelopes — they look professional but automatically trigger the surcharge on every piece."
        }
      },
      {
        "@type": "Question",
        "name": "What size envelopes qualify for bulk mail automation rates?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "To qualify for USPS bulk mail automation discounts, letters must be between 3.5×5 inches and 6.125×11.5 inches, no more than 0.25 inches thick, flexible, and rectangular with an aspect ratio between 1.3:1 and 2.5:1. The address must be machine-readable with a valid barcode. Meeting these specs can reduce postage by $0.10 or more per piece compared to non-automation rates."
        }
      },
      {
        "@type": "Question",
        "name": "What is the minimum size for a USPS postcard?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The USPS minimum postcard size is 3.5 inches × 5 inches with a minimum thickness of 0.007 inches (7pt cardstock). Pieces smaller than this are not accepted for mailing. The most commonly mailed postcard size is 4.25×6 inches (standard 4×6), which qualifies for letter-rate postage."
        }
      },
      {
        "@type": "Question",
        "name": "What are the USPS size requirements for self-mailers?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "USPS self-mailers must be tabbed or sealed per DMM 201.3 standards. Letter-size self-mailers require at least 1 tab (2 recommended), flat-size self-mailers require 2 tabs minimum. Tabs must be at least 1 inch long placed on the top edge. The address panel must face outward and the open edge must be at the top after folding. Common sizes include bi-fold 8.5×11 (folds to 5.5×8.5) and tri-fold 8.5×11 (folds to 3.67×8.5)."
        }
      }
    ]
  })} />

  <PageHero
    title="Envelope & Mail Piece Sizes"
    subtitle="Exact USPS dimensions for every mail format — postcards, #10 envelopes, 6×9, flats, and self-mailers. Avoid surcharges, qualify for automation rates, and mail with confidence."
    breadcrumbs={[
      { label: 'Direct Mail Tools', href: '/direct-mail-tools/' },
      { label: 'Envelope Sizes' },
    ]}
  />

  <section class="py-14 lg:py-20">
    <div class="container-wide">
      <div class="max-w-4xl mx-auto">
        <div class="section-divider mb-6"></div>
        <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">
          Why Mail Piece Size Matters
        </h2>
        <p class="text-navy-600/80 leading-relaxed mb-4">
          The USPS classifies every mail piece by size, shape, and weight. This classification directly determines your <a href="/direct-mail-tools/postage-rates/" class="text-crst-primary underline hover:text-crst-gold">postage rate</a>. A postcard that's slightly too large becomes a "flat" — and your postage rate can double. A letter that's too square gets a non-machinable surcharge. Understanding these boundaries saves real money on every mailing.
        </p>
        <p class="text-navy-600/80 leading-relaxed mb-10">
          At Cornerstone, we design and produce every mail piece to meet <a href="/direct-mail-tools/postal-dictionary/" class="text-crst-primary underline hover:text-crst-gold">USPS automation specifications</a>. That means maximum postage savings with zero risk of surcharges, returns, or delays. For a complete breakdown of postcard-specific requirements, see our guide to <a href="https://blog.crst.net/usps-postcard-printing-requirements/" class="text-crst-primary underline hover:text-crst-gold">USPS Postcard Printing Requirements</a>.
        </p>

        <div class="flex items-start gap-4 bg-navy-50 rounded-xl p-5 mb-10 border border-navy-100">
          <div class="shrink-0 w-12 h-12 rounded-full bg-crst-primary/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-crst-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          </div>
          <div>
            <p class="text-sm font-heading font-semibold text-navy-800">Written by Sean Griffen, Owner — Cornerstone Services, Inc.</p>
            <p class="text-xs text-navy-500 mt-1">Sean has managed direct mail production for Hudson Valley businesses since 1998. Over 2.3 million pieces mailed. This guide reflects the USPS size and postage rules we apply to every job we produce.</p>
            <p class="text-xs text-navy-400 mt-1">Last reviewed: January 2025 · Source: <a href="https://pe.usps.com/text/dmm300/dmm300_landing.htm" target="_blank" rel="noopener noreferrer" class="underline hover:text-crst-primary">USPS Domestic Mail Manual (DMM)</a></p>
          </div>
        </div>

        {mailClasses.map((mailClass) => (
          <div class="mb-12">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">{mailClass.icon}</span>
              <h3 class="text-xl font-display font-bold text-crst-primary">{mailClass.name}</h3>
            </div>
            <p class="text-navy-600/80 text-sm leading-relaxed mb-5">{mailClass.description}</p>

            <div class="overflow-x-auto mb-5">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b-2 border-crst-primary/20">
                    <th class="text-left py-2 pr-4 font-heading font-bold text-navy-800">Size</th>
                    <th class="text-left py-2 pr-4 font-heading font-bold text-navy-800">Dimensions</th>
                    <th class="text-left py-2 font-heading font-bold text-navy-800">Notes</th>
                  </tr>
                </thead>
                <tbody>
                  {mailClass.sizes.map((size) => (
                    <tr class="border-b border-gray-100">
                      <td class="py-2.5 pr-4 font-semibold text-navy-800 whitespace-nowrap">{size.label}</td>
                      <td class="py-2.5 pr-4 text-navy-600/80 font-mono text-xs whitespace-nowrap">{size.dimensions}</td>
                      <td class="py-2.5 text-navy-600/70">{size.notes}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="bg-navy-50 rounded-xl p-5">
              <h4 class="font-heading font-bold text-navy-800 mb-3 text-sm">USPS Rules for {mailClass.name}</h4>
              <div class="space-y-2">
                {mailClass.rules.map((rule) => (
                  <div class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-crst-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-sm text-navy-600/80">{rule}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}

        <div class="mb-12">
          <h3 class="text-xl font-display font-bold text-crst-primary mb-4">Common Surcharges & Penalties</h3>
          <p class="text-navy-600/80 text-sm leading-relaxed mb-5">
            Mail pieces that don't meet USPS standards get hit with surcharges — or rejected entirely. Starting from a correctly sized template is the easiest way to avoid these penalties. Our <a href="/usps-direct-mailer-templates/" class="text-crst-primary underline hover:text-crst-gold">USPS direct mailer templates</a> are pre-sized to spec for every format below. Here's what to watch for:
          </p>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b-2 border-red-200">
                  <th class="text-left py-2 pr-4 font-heading font-bold text-navy-800">Condition</th>
                  <th class="text-left py-2 pr-4 font-heading font-bold text-navy-800">Surcharge</th>
                  <th class="text-left py-2 font-heading font-bold text-navy-800">Why</th>
                </tr>
              </thead>
              <tbody>
                {surcharges.map((s) => (
                  <tr class="border-b border-gray-100">
                    <td class="py-2.5 pr-4 font-semibold text-navy-800">{s.condition}</td>
                    <td class="py-2.5 pr-4 text-red-600 font-semibold whitespace-nowrap">{s.surcharge}</td>
                    <td class="py-2.5 text-navy-600/70">{s.reason}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div class="bg-crst-primary/5 rounded-xl p-8 text-center">
          <h3 class="text-xl font-display font-bold text-crst-primary mb-3">Not Sure About Your Mail Piece Size?</h3>
          <p class="text-navy-600/80 text-sm mb-5 max-w-lg mx-auto">
            Send us your design or dimensions and we'll confirm USPS compatibility, suggest the best format for your budget, and handle the production. If you're mailing under a nonprofit or bulk permit, see how our <a href="/direct-mail-tools/cornerstone-mailing-permits/" class="text-crst-primary underline hover:text-crst-gold">mailing permit services</a> can reduce your per-piece cost further.
          </p>
          <a href="/estimate/" class="btn-primary inline-block">Get a Free Estimate</a>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
