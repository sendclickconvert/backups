---
import { BUSINESS, SERVICES, COUNTIES } from '../data/site';
const currentYear = new Date().getFullYear();
---

<footer class="bg-navy-800 text-white/80 relative overflow-hidden">
  <!-- Decorative grid -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 48px 48px;"></div>
  
  <div class="relative">
    <!-- Main footer -->
    <div class="container-wide py-14 lg:py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
        
        <!-- Company info -->
        <div class="lg:col-span-1">
          <a href="/" title={`${BUSINESS.name} — Home`} class="inline-block mb-4">
            <img src="/images/crst-logo-white.png" alt={BUSINESS.name} title={BUSINESS.name} class="h-9 w-auto" width="150" height="36" />
          </a>
          <p class="text-sm leading-relaxed text-white/60 mb-5">
            Hudson Valley's trusted direct mail, printing, and data services partner since {BUSINESS.founded}.
          </p>
          <div class="space-y-2.5 text-sm">
            <a href={`tel:${BUSINESS.phoneClean}`} title={`Call ${BUSINESS.name}`} class="flex items-center gap-2 hover:text-white transition-colors">
              <svg class="w-4 h-4 text-crst-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              {BUSINESS.phone}
            </a>
            <a href={`mailto:${BUSINESS.email}`} title={`Email ${BUSINESS.name}`} class="flex items-center gap-2 hover:text-white transition-colors">
              <svg class="w-4 h-4 text-crst-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              {BUSINESS.email}
            </a>
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-crst-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span>{BUSINESS.address.full}</span>
            </div>
          </div>
        </div>

        <!-- Services -->
        <div>
          <h3 class="text-white font-heading font-semibold text-sm uppercase tracking-wider mb-4">Services</h3>
          <ul class="space-y-2">
            {SERVICES.map((service) => (
              <li>
                <a href={`/services/${service.slug}`} title={service.title} class="text-sm hover:text-white transition-colors">
                  {service.title}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Service Areas -->
        <div>
          <h3 class="text-white font-heading font-semibold text-sm uppercase tracking-wider mb-4">Service Areas</h3>
          <ul class="space-y-2">
            {Object.values(COUNTIES).map((county) => (
              <li>
                <a href={`/service-areas/${county.slug}`} title={county.name} class="text-sm hover:text-white transition-colors">
                  {county.name}
                </a>
              </li>
            ))}
          </ul>
          <h3 class="text-white font-heading font-semibold text-sm uppercase tracking-wider mb-4 mt-6">Company</h3>
          <ul class="space-y-2">
            <li><a href="/about" title="About Cornerstone Services" class="text-sm hover:text-white transition-colors">About Us</a></li>
            <li><a href="/case-studies" title="Direct Mail Case Studies" class="text-sm hover:text-white transition-colors">Case Studies</a></li>
            <li><a href="/contact" title="Contact Cornerstone Services" class="text-sm hover:text-white transition-colors">Contact</a></li>
            <li><a href="/faq" title="Frequently Asked Questions" class="text-sm hover:text-white transition-colors">FAQ</a></li>
            <li><a href="https://blog.crst.net/" title="Cornerstone Services Blog" class="text-sm hover:text-white transition-colors">Blog</a></li>
          </ul>
        </div>

        <!-- Resources + CTA -->
        <div>
          <h3 class="text-white font-heading font-semibold text-sm uppercase tracking-wider mb-4">Resources</h3>
          <ul class="space-y-2 mb-6">
            <li><a href="/direct-mail-tools/cornerstone-mailing-permits" title="Mailing Permits Guide" class="text-sm hover:text-white transition-colors">Mailing Permits Guide</a></li>
            <li><a href="/direct-mail-tools/postage-rates" title="USPS Postage Rates" class="text-sm hover:text-white transition-colors">Postage Rates</a></li>
            <li><a href="/usps-direct-mailer-templates" title="USPS Direct Mailer Templates" class="text-sm hover:text-white transition-colors">USPS Templates</a></li>
            <li><a href="/non-profit-mailing-application" title="Non-Profit Mailing Application" class="text-sm hover:text-white transition-colors">Non-Profit Mailing Tool</a></li>
            <li><a href="/direct-mail-tools/postal-dictionary" title="USPS Postal Dictionary" class="text-sm hover:text-white transition-colors">Postal Dictionary</a></li>
          </ul>
          <div class="bg-white/5 rounded-lg p-4 border border-white/10">
            <p class="text-white font-heading font-semibold text-sm mb-2">Ready to get started?</p>
            <p class="text-xs text-white/50 mb-3">Get a free estimate for your next mailing project.</p>
            <a href="/estimate" title="Get Free Estimate" class="btn-accent w-full text-center text-xs py-2">
              Get Free Estimate
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10">
      <div class="container-wide flex flex-col sm:flex-row items-center justify-between py-5 gap-3 text-xs text-white/40">
        <p>&copy; {currentYear} {BUSINESS.name}. All rights reserved.</p>
        <div class="flex items-center gap-4">
          <a href="/privacy" title="Privacy Policy" class="hover:text-white/70 transition-colors">Privacy Policy</a>
          <span class="text-white/20">|</span>
          <a href="/terms" title="Terms and Conditions" class="hover:text-white/70 transition-colors">Terms & Conditions</a>
          <span class="text-white/20">|</span>
          <a href="/resources/payments" title="Pay Online" class="hover:text-white/70 transition-colors">Pay Online</a>
        </div>
      </div>
    </div>
  </div>
</footer>
