---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import AuthorByline from '../components/AuthorByline.astro';
import { BUSINESS, COUNTIES } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Why Choose CRST for Direct Mail in the Hudson Valley',
  url: 'https://crst.net/why-crst-for-direct-mail-in-the-hudson-valley',
  publisher: { '@id': 'https://crst.net/#organization' },
};
---

<BaseLayout
  title="Why Choose CRST for Direct Mail | Hudson Valley, NY"
  description="Discover why Hudson Valley businesses choose Cornerstone Services for direct mail. In-house, USPS-certified, no outsourcing. Serving Ulster, Dutchess, and Orange counties since 1998."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <PageHero
    title="Why Choose CRST for Direct Mail in the Hudson Valley"
    subtitle="In-house production, USPS certification, and 27 years of Hudson Valley direct mail experience."
    breadcrumbs={[
      { label: 'About', href: '/about' },
      { label: 'Why CRST' },
    ]}
  />

  <section class="py-14 lg:py-20">
    <div class="container-wide">
      <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">
        <div class="lg:col-span-2">
          <div class="section-divider mb-6"></div>
          <h2 class="text-2xl font-display text-crst-primary mb-4">A Direct Mail Partner That Does Everything In-House</h2>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            Organizations across the Hudson Valley choose Cornerstone Services, Inc. (CRST) when they want a full-service direct mail partner with in-house design, printing, mailing data, fulfillment, and USPS-certified expertise. Based in New Paltz, NY and established in 1998, CRST serves Ulster, Dutchess, and Orange counties with a no-outsourcing model that supports nonprofits, political campaigns, municipalities, real estate professionals, and local businesses.
          </p>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            Most direct mail companies outsource at least one part of the process — the data, the printing, or the postal prep. That means handoffs, delays, and finger-pointing when something goes wrong. At CRST, every step happens under one roof with one team. When you call, you talk to the people who are actually building your mailing.
          </p>

          <h3 class="text-xl font-display text-crst-primary mt-10 mb-4">Why Organizations Choose CRST</h3>
          <div class="space-y-6 mb-8">
            <div class="bg-white rounded-xl border border-gray-100 p-6">
              <h4 class="font-heading font-bold text-navy-800 mb-2">No Outsourcing</h4>
              <p class="text-sm text-navy-600/70 leading-relaxed">Data processing, graphic design, printing, mail prep, and postal induction all happen in our New Paltz facility. One building, one team, one point of accountability.</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-100 p-6">
              <h4 class="font-heading font-bold text-navy-800 mb-2">USPS-Certified</h4>
              <p class="text-sm text-navy-600/70 leading-relaxed">CRST is listed on the USPS Printer Directory. We maintain active mailing permits, process CASS-certified addresses, and meet all USPS automation requirements for the lowest available postage rates.</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-100 p-6">
              <h4 class="font-heading font-bold text-navy-800 mb-2">Hudson Valley Expertise</h4>
              <p class="text-sm text-navy-600/70 leading-relaxed">We know the postal routes, carrier delivery schedules, and local markets across <a href="/service-areas/ulster-county" class="text-crst-accent hover:underline">Ulster</a>, <a href="/service-areas/dutchess-county" class="text-crst-accent hover:underline">Dutchess</a>, and <a href="/service-areas/orange-county" class="text-crst-accent hover:underline">Orange</a> counties. That local knowledge means better targeting and fewer wasted impressions.</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-100 p-6">
              <h4 class="font-heading font-bold text-navy-800 mb-2">27 Years of Experience</h4>
              <p class="text-sm text-navy-600/70 leading-relaxed">Since 1998, CRST has managed direct mail campaigns for businesses, <a href="/services/non-profit-mailing" class="text-crst-accent hover:underline">nonprofits</a>, political organizations, municipalities, and real estate professionals. We've seen every mail format, every postal regulation change, and every data challenge.</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-100 p-6">
              <h4 class="font-heading font-bold text-navy-800 mb-2">Full-Service Capabilities</h4>
              <p class="text-sm text-navy-600/70 leading-relaxed">Mailing list acquisition, graphic design, commercial printing, <a href="/services/eddm" class="text-crst-accent hover:underline">EDDM</a>, addressed mail with presort automation, and postal fulfillment. You don't need to coordinate between vendors — we handle the entire campaign.</p>
            </div>
          </div>

          <h3 class="text-xl font-display text-crst-primary mt-10 mb-4">Who Works With CRST</h3>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            Our clients include municipal governments sending tax notices and public safety updates. Nonprofits running annual fund appeals and donor acquisition campaigns. Political campaigns producing voter contact mail under tight deadlines. Real estate agents farming neighborhoods with just-listed and just-sold postcards. And local businesses — restaurants, healthcare practices, home services — reaching customers in their service area through targeted direct mail and <a href="/services/eddm" class="text-crst-accent hover:underline">Every Door Direct Mail</a>.
          </p>

          <h3 class="text-xl font-display text-crst-primary mt-10 mb-4">Based in New Paltz, Serving Three Counties</h3>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            Our facility at 31 South Ohioville Road in New Paltz is centrally located between Kingston, Poughkeepsie, and Newburgh. We're 15 minutes from the Mid-Hudson Bridge, making Dutchess County as accessible as our home base in Ulster County. Orange County clients are about 30 minutes south. That proximity means faster turnaround and the option to visit our shop and see your job on press.
          </p>

          <div class="mt-8">
            <AuthorByline compact />
          </div>
        </div>

        <aside class="lg:col-span-1">
          <div class="sticky top-28 space-y-6">
            <div class="card p-6 text-center">
              <h3 class="font-display font-bold text-crst-primary text-lg mb-3">Get a Free Estimate</h3>
              <p class="text-sm text-navy-600/70 mb-4">Tell us about your project and we'll put together a quote.</p>
              <a href="/estimate" class="btn-primary w-full text-sm">Request Estimate</a>
            </div>
            <div class="card p-6">
              <h3 class="font-display font-bold text-crst-primary mb-3">Call Us</h3>
              <a href={`tel:${BUSINESS.phoneClean}`} class="flex items-center gap-2 text-navy-700 hover:text-crst-primary transition-colors font-heading font-semibold">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                {BUSINESS.phone}
              </a>
            </div>
            <div class="card p-6">
              <h3 class="font-display font-bold text-crst-primary mb-3">Our Services</h3>
              <ul class="space-y-2 text-sm">
                <li><a href="/services/direct-mail" class="text-navy-600 hover:text-crst-primary transition-colors">Direct Mail Campaigns &rarr;</a></li>
                <li><a href="/services/eddm" class="text-navy-600 hover:text-crst-primary transition-colors">EDDM &rarr;</a></li>
                <li><a href="/services/printing" class="text-navy-600 hover:text-crst-primary transition-colors">Printing Services &rarr;</a></li>
                <li><a href="/services/data-lists" class="text-navy-600 hover:text-crst-primary transition-colors">Data Lists &rarr;</a></li>
                <li><a href="/services/graphic-design" class="text-navy-600 hover:text-crst-primary transition-colors">Graphic Design &rarr;</a></li>
                <li><a href="/services/non-profit-mailing" class="text-navy-600 hover:text-crst-primary transition-colors">Non-Profit Mailing &rarr;</a></li>
              </ul>
            </div>
            <div class="card p-6">
              <h3 class="font-display font-bold text-crst-primary mb-3">Service Areas</h3>
              <ul class="space-y-2 text-sm">
                {Object.values(COUNTIES).map((county) => (
                  <li>
                    <a href={`/service-areas/${county.slug}`} class="text-navy-600 hover:text-crst-primary transition-colors">{county.name} &rarr;</a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CTASection
    headline="Ready to Work With CRST?"
    text="Get a free estimate for your next direct mail campaign. We'll walk you through the process from data to delivery."
  />
</BaseLayout>
