---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import { BUSINESS } from '../../data/site';
---

<BaseLayout
  title="Current USPS Postage Rates for Direct Mail"
  description="Current USPS postage rates for Marketing Mail, First-Class, Non-Profit, and EDDM. Compare rates and find the best option for your direct mail campaign."
>
  <PageHero
    title="Current USPS Postage Rates"
    subtitle="Compare rates across mail classes to find the most cost-effective option for your campaign."
    breadcrumbs={[
      { label: 'Resources', href: '/resources/' },
      { label: 'Postage Rates' },
    ]}
  />

  <section class="py-14 lg:py-20">
    <div class="container-wide">
      <div class="max-w-4xl mx-auto">
        <div class="section-divider mb-6"></div>
        <p class="text-navy-600/80 leading-relaxed mb-8">
          USPS postage rates change periodically — typically in January and July. The rates below reflect the most common categories for direct mail. Always confirm current rates with Cornerstone or the USPS before planning your budget. We automatically apply the lowest qualifying rate to every campaign we process.
        </p>

        <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-10 text-sm text-amber-800">
          <strong>Note:</strong> Rates shown are approximate and subject to change. Actual rates depend on mail piece size, weight, presort level, and entry point. Contact us for an exact quote for your specific campaign.
        </div>

        <!-- Marketing Mail -->
        <h3 class="text-xl font-display text-crst-primary mb-4">USPS Marketing Mail (Bulk Mail)</h3>
        <p class="text-navy-600/80 text-sm leading-relaxed mb-4">
          Marketing Mail (formerly Standard Mail) is the most common class for direct mail advertising. Requires a minimum of 200 pieces or 50 lbs per mailing. Delivery is typically 3–10 business days.
        </p>
        <div class="overflow-x-auto mb-10">
          <table class="w-full text-sm border border-navy-200 rounded-lg overflow-hidden">
            <thead>
              <tr class="bg-crst-primary text-white">
                <th class="text-left p-3 font-heading">Mail Piece Type</th>
                <th class="text-left p-3 font-heading">Presort Rate</th>
                <th class="text-left p-3 font-heading">Automation Rate</th>
                <th class="text-left p-3 font-heading">Notes</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-navy-100">
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Letters (up to 3.5 oz)</td>
                <td class="p-3 text-navy-600">$0.357</td>
                <td class="p-3 text-navy-600">$0.308</td>
                <td class="p-3 text-navy-500">Automation requires IMb barcode</td>
              </tr>
              <tr class="bg-navy-50/50">
                <td class="p-3 font-semibold text-navy-800">Postcards</td>
                <td class="p-3 text-navy-600">$0.322</td>
                <td class="p-3 text-navy-600">$0.276</td>
                <td class="p-3 text-navy-500">Must meet postcard size requirements</td>
              </tr>
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Flats / Self-Mailers</td>
                <td class="p-3 text-navy-600">$0.542</td>
                <td class="p-3 text-navy-600">$0.488</td>
                <td class="p-3 text-navy-500">Larger pieces, catalogs, booklets</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- EDDM -->
        <h3 class="text-xl font-display text-crst-primary mb-4">EDDM (Every Door Direct Mail)</h3>
        <p class="text-navy-600/80 text-sm leading-relaxed mb-4">
          EDDM delivers to every address on selected carrier routes — no mailing list needed. Ideal for local businesses wanting blanket coverage of their area.
        </p>
        <div class="overflow-x-auto mb-10">
          <table class="w-full text-sm border border-navy-200 rounded-lg overflow-hidden">
            <thead>
              <tr class="bg-crst-primary text-white">
                <th class="text-left p-3 font-heading">EDDM Type</th>
                <th class="text-left p-3 font-heading">Rate per Piece</th>
                <th class="text-left p-3 font-heading">Permit Required?</th>
                <th class="text-left p-3 font-heading">Daily Limit</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-navy-100">
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">EDDM Retail</td>
                <td class="p-3 text-navy-600">$0.223</td>
                <td class="p-3 text-navy-600">No</td>
                <td class="p-3 text-navy-500">5,000/day per ZIP</td>
              </tr>
              <tr class="bg-navy-50/50">
                <td class="p-3 font-semibold text-navy-800">EDDM BMEU</td>
                <td class="p-3 text-navy-600">$0.210</td>
                <td class="p-3 text-navy-600">Yes</td>
                <td class="p-3 text-navy-500">No daily limit</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- First-Class -->
        <h3 class="text-xl font-display text-crst-primary mb-4">First-Class Mail</h3>
        <p class="text-navy-600/80 text-sm leading-relaxed mb-4">
          First-Class is faster (1–3 days) and includes forwarding and return service. Used for invoices, statements, and time-sensitive communications. Presort discounts are available for 500+ pieces.
        </p>
        <div class="overflow-x-auto mb-10">
          <table class="w-full text-sm border border-navy-200 rounded-lg overflow-hidden">
            <thead>
              <tr class="bg-crst-primary text-white">
                <th class="text-left p-3 font-heading">Mail Piece Type</th>
                <th class="text-left p-3 font-heading">Single Piece</th>
                <th class="text-left p-3 font-heading">Presort/Automation</th>
                <th class="text-left p-3 font-heading">Min. Quantity</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-navy-100">
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Letters (1 oz)</td>
                <td class="p-3 text-navy-600">$0.73</td>
                <td class="p-3 text-navy-600">$0.485</td>
                <td class="p-3 text-navy-500">500 pieces</td>
              </tr>
              <tr class="bg-navy-50/50">
                <td class="p-3 font-semibold text-navy-800">Postcards</td>
                <td class="p-3 text-navy-600">$0.56</td>
                <td class="p-3 text-navy-600">$0.405</td>
                <td class="p-3 text-navy-500">500 pieces</td>
              </tr>
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Flats</td>
                <td class="p-3 text-navy-600">$1.35</td>
                <td class="p-3 text-navy-600">$0.80</td>
                <td class="p-3 text-navy-500">500 pieces</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Non-Profit -->
        <h3 class="text-xl font-display text-crst-primary mb-4">Non-Profit Mail Rates</h3>
        <p class="text-navy-600/80 text-sm leading-relaxed mb-4">
          Qualifying 501(c)(3) organizations receive the lowest USPS rates — typically 40–60% less than commercial Marketing Mail. Requires USPS authorization via PS Form 3624.
        </p>
        <div class="overflow-x-auto mb-10">
          <table class="w-full text-sm border border-navy-200 rounded-lg overflow-hidden">
            <thead>
              <tr class="bg-crst-primary text-white">
                <th class="text-left p-3 font-heading">Mail Piece Type</th>
                <th class="text-left p-3 font-heading">Non-Profit Rate</th>
                <th class="text-left p-3 font-heading">vs. Commercial</th>
                <th class="text-left p-3 font-heading">Savings</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-navy-100">
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Letters (automation)</td>
                <td class="p-3 text-navy-600">$0.154</td>
                <td class="p-3 text-navy-600">$0.308</td>
                <td class="p-3 text-green-600 font-semibold">~50%</td>
              </tr>
              <tr class="bg-navy-50/50">
                <td class="p-3 font-semibold text-navy-800">Flats (automation)</td>
                <td class="p-3 text-navy-600">$0.243</td>
                <td class="p-3 text-navy-600">$0.488</td>
                <td class="p-3 text-green-600 font-semibold">~50%</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="bg-crst-primary/5 border border-crst-primary/20 rounded-xl p-6 mt-8">
          <h4 class="font-heading font-bold text-crst-primary mb-2">Get an Exact Quote</h4>
          <p class="text-navy-600/80 text-sm leading-relaxed mb-4">
            Actual postage depends on your specific mail piece size, weight, presort level, and entry point. Let us analyze your campaign and provide an exact postage cost.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/estimate/" class="btn-primary text-sm">Request Estimate</a>
            <a href="/resources/envelope-sizes/" class="btn-secondary text-sm">Mail Piece Sizes →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
