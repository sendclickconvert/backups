---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTASection from '../../../components/CTASection.astro';
import { BUSINESS, COUNTIES } from '../../../data/site';
import { COUNTIES_DATA } from '../../../data/locations';
import type { Location, County } from '../../../data/locations';
import { SERVICE_CONFIGS, ENABLED_COUNTIES } from '../../../data/service-location';

export function getStaticPaths() {
  const paths: { params: { service: string; town: string }; props: { serviceSlug: string; location: Location; county: County } }[] = [];

  for (const svc of SERVICE_CONFIGS) {
    for (const county of COUNTIES_DATA) {
      if (!ENABLED_COUNTIES.includes(county.countyKey as typeof ENABLED_COUNTIES[number])) continue;
      for (const loc of county.locations) {
        paths.push({
          params: { service: svc.slug, town: loc.slug },
          props: { serviceSlug: svc.slug, location: loc, county },
        });
      }
    }
  }

  return paths;
}

const { serviceSlug, location, county } = Astro.props as { serviceSlug: string; location: Location; county: County };

const svc = SERVICE_CONFIGS.find(s => s.slug === serviceSlug)!;

const pageTitle = svc.metaTitleTemplate(location.name);
const metaDesc = svc.metaDescTemplate(location.name);
const h1 = svc.h1Template(location.name);
const canonical = `https://crst.net/services/${svc.slug}/${location.slug}`;

const localIntroSentence = location.intro.split('. ').slice(0, 2).join('. ') + '.';
const introText = svc.introTemplate(location.name, county.name, localIntroSentence);

const townPageHref = `/service-areas/${county.slug}/${location.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${svc.schemaServiceName} in ${location.name}, NY`,
  provider: {
    '@type': 'LocalBusiness',
    '@id': 'https://crst.net/#organization',
    name: 'Cornerstone Services, Inc.',
    url: 'https://crst.net',
    telephone: '+18452555722',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '31 S Ohioville Rd',
      addressLocality: 'New Paltz',
      addressRegion: 'NY',
      postalCode: '12561',
    },
  },
  areaServed: {
    '@type': 'City',
    name: `${location.name}, NY`,
  },
  description: svc.schemaDescription,
  url: canonical,
};
---

<BaseLayout
  title={pageTitle.replace(' | Cornerstone Services', '').replace(' | Cornerstone', '')}
  description={metaDesc}
  canonical={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <PageHero
    title={h1}
    subtitle={`${svc.name} services for businesses and organizations in ${location.name}, ${county.name}. In-house from our New Paltz facility since 1998.`}
    breadcrumbs={[
      { label: 'Services', href: '/services' },
      { label: svc.name, href: svc.pillarHref },
      { label: location.name },
    ]}
  />

  <section class="py-14 lg:py-20">
    <div class="container-wide">
      <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">
        <div class="lg:col-span-2">

          <div class="section-divider mb-6"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">{svc.name} Services for {location.name}</h2>
          <p class="text-navy-600/80 leading-relaxed mb-6">{introText}</p>

          {location.notableOrgs.length > 0 && (
            <p class="text-navy-600/80 leading-relaxed mb-6">
              {location.name} is home to organizations like {location.notableOrgs.slice(0, 3).join(', ')}{location.notableOrgs.length > 3 ? `, and ${location.notableOrgs[3]}` : ''} — the types of businesses and institutions that rely on professional {svc.name.toLowerCase()} services.
            </p>
          )}

          <div class="section-divider mb-6 mt-14"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-6">What's Included</h2>
          <div class="grid sm:grid-cols-2 gap-4 mb-8">
            {svc.features.map((feat) => (
              <div class="bg-navy-50/40 rounded-xl border border-navy-100 p-5">
                <h3 class="font-heading font-semibold text-navy-800 text-sm mb-2">{feat.title}</h3>
                <p class="text-sm text-navy-600/70 leading-relaxed">{feat.desc}</p>
              </div>
            ))}
          </div>

          {location.clientTypes.length > 0 && (
            <>
              <div class="section-divider mb-6 mt-14"></div>
              <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">Who We Serve in {location.name}</h2>
              <div class="grid sm:grid-cols-2 gap-3 mb-8">
                {location.clientTypes.map((ct) => (
                  <div class="flex items-start gap-3 p-3 bg-navy-50/40 rounded-lg">
                    <svg class="w-4 h-4 text-crst-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span class="text-sm text-navy-700">{ct}</span>
                  </div>
                ))}
              </div>
            </>
          )}

          <div class="bg-crst-primary/5 border border-crst-primary/15 rounded-xl p-6 mt-10 text-center">
            <p class="font-heading font-bold text-crst-primary text-lg mb-2">Ready to Get Started?</p>
            <p class="text-navy-600/70 text-sm mb-4">Get a free estimate for {svc.name.toLowerCase()} services in {location.name}, NY.</p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
              <a href="/estimate" class="btn-primary text-sm">Get a Free Estimate</a>
              <a href={`tel:${BUSINESS.phoneClean}`} class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-crst-primary hover:text-crst-accent transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Call {BUSINESS.phone}
              </a>
            </div>
          </div>

          <div class="section-divider mb-6 mt-14"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">Learn More</h2>
          <div class="space-y-3">
            <a href={svc.pillarHref} class="flex items-center gap-3 p-4 bg-navy-50/40 rounded-lg border border-navy-100 hover:border-crst-primary/30 hover:shadow-sm transition-all group">
              <svg class="w-5 h-5 text-crst-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
              <div>
                <span class="font-heading font-semibold text-navy-800 text-sm group-hover:text-crst-primary transition-colors">{svc.name} Services Overview</span>
                <p class="text-xs text-navy-600/60">Full details on our {svc.name.toLowerCase()} capabilities</p>
              </div>
            </a>
            <a href={townPageHref} class="flex items-center gap-3 p-4 bg-navy-50/40 rounded-lg border border-navy-100 hover:border-crst-primary/30 hover:shadow-sm transition-all group">
              <svg class="w-5 h-5 text-crst-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <div>
                <span class="font-heading font-semibold text-navy-800 text-sm group-hover:text-crst-primary transition-colors">All Services in {location.name}</span>
                <p class="text-xs text-navy-600/60">Direct mail, printing, data, and more for {location.name}</p>
              </div>
            </a>
          </div>
        </div>

        <aside class="lg:col-span-1">
          <div class="sticky top-28 space-y-6">
            <div class="bg-crst-primary rounded-xl p-6 text-white">
              <h3 class="font-display text-lg mb-2">Free Estimate</h3>
              <p class="text-white/60 text-sm leading-relaxed mb-4">
                Get a quote for {svc.name.toLowerCase()} in {location.name}, NY.
              </p>
              <a href="/estimate" class="btn-accent w-full text-center text-sm">
                Request Estimate
              </a>
              <div class="mt-4 pt-4 border-t border-white/10 text-center">
                <a href={`tel:${BUSINESS.phoneClean}`} class="text-white/70 text-sm font-heading hover:text-white transition-colors">
                  or call {BUSINESS.phone}
                </a>
              </div>
            </div>

            <div class="bg-navy-50/50 rounded-xl p-5 border border-navy-100">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-3">Services</h3>
              <div class="space-y-2">
                {SERVICE_CONFIGS.map((s) => (
                  <a href={s.pillarHref} class={`flex items-center justify-between px-3 py-2 text-sm rounded-md transition-colors font-heading ${s.slug === svc.slug ? 'text-crst-primary bg-white font-semibold' : 'text-navy-700 hover:text-crst-primary hover:bg-white'}`}>
                    {s.name}
                    <svg class="w-3.5 h-3.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </div>

            <div class="bg-navy-50/50 rounded-xl p-5 border border-navy-100">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-3">Location</h3>
              <div class="space-y-1 text-sm text-navy-600/80">
                <p><strong>{location.name}</strong>, {county.name}</p>
                <p>ZIP: {location.zip.join(', ')}</p>
                <p>Pop: {location.population}</p>
              </div>
              <a href={townPageHref} class="mt-3 inline-block text-xs text-crst-accent hover:underline font-heading">
                View all {location.name} services &rarr;
              </a>
            </div>

            <div class="bg-navy-50/50 rounded-xl p-5 border border-navy-100">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-3">Service Areas</h3>
              <div class="space-y-2">
                {Object.values(COUNTIES).map((c) => (
                  <a href={`/service-areas/${c.slug}`} class="flex items-center justify-between px-3 py-2 text-sm text-navy-700 hover:text-crst-primary hover:bg-white rounded-md transition-colors font-heading">
                    {c.name}
                    <svg class="w-3.5 h-3.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CTASection
    headline={`Need ${svc.name} in ${location.name}?`}
    text={`Contact Cornerstone Services for a free estimate on your next ${svc.name.toLowerCase()} project.`}
  />
</BaseLayout>
