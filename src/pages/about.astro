---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import { BUSINESS } from '../data/site';
---

<BaseLayout
  title="About Us"
  description={`Learn about ${BUSINESS.name} — Hudson Valley's trusted direct mail and printing partner since ${BUSINESS.founded}. BBB A+ rated, serving ${BUSINESS.stats.municipalities} municipalities.`}
>
  <PageHero
    title="About Cornerstone Services"
    subtitle={`Delivering results through direct mail since ${BUSINESS.founded}.`}
    breadcrumbs={[{ label: 'About' }]}
  />

  <section class="py-14 lg:py-20">
    <div class="container-narrow">
      <!-- Story -->
      <div class="prose prose-lg max-w-none">
        <div class="section-divider mb-6"></div>
        <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">Our Story</h2>
        <div class="flex flex-col md:flex-row gap-8 items-start">
          <div class="md:w-1/3 shrink-0">
            <img
              src="/images/wp/sean2.png"
              alt="Sean H. Griffin, President of Cornerstone Services"
              class="w-full max-w-xs mx-auto rounded-xl"
              loading="lazy"
            />
            <p class="text-center mt-3" style="font-family: 'Dancing Script', cursive; font-size: 1.65rem; color: #1a365d; letter-spacing: 0.5px;">Sean H. Griffin</p>
          </div>
          <div class="md:w-2/3">
            <p class="text-navy-600/80 leading-relaxed mb-6">
              Founded in {BUSINESS.founded} by {BUSINESS.owner}, Cornerstone Services has grown from a small mailing operation in New Paltz, New York, into the Hudson Valley's most trusted full-service direct mail company. For over {BUSINESS.stats.years} years, we've helped businesses, non-profits, municipalities, and political organizations reach their audiences through targeted, high-quality direct mail campaigns.
            </p>
            <p class="text-navy-600/80 leading-relaxed mb-6">
              We've mailed over {BUSINESS.stats.piecesMailed} pieces for clients across {BUSINESS.stats.municipalities} municipalities in Ulster, Dutchess, and Orange Counties — and beyond. Every campaign is handled in-house from data targeting through postal delivery, with a {BUSINESS.stats.onTime} on-time delivery rate.
            </p>
            <p class="text-navy-600/80 leading-relaxed">
              Cornerstone isn't just a printer or a mail house. We're a full-service marketing partner. We help you identify the right audience, design a mail piece that gets noticed, print it at commercial quality, and deliver it to the USPS at the lowest possible postage rate. That's the Cornerstone difference.
            </p>
          </div>
        </div>
      </div>

      <!-- Stats grid -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-12">
        {[
          { value: BUSINESS.stats.years, label: 'Years in Business' },
          { value: BUSINESS.stats.piecesMailed, label: 'Pieces Mailed' },
          { value: BUSINESS.stats.municipalities, label: 'Municipalities' },
          { value: BUSINESS.stats.onTime, label: 'On-Time Delivery' },
        ].map((stat) => (
          <div class="bg-navy-50/60 rounded-xl p-5 text-center border border-navy-100">
            <div class="text-2xl lg:text-3xl font-display text-crst-primary mb-1">{stat.value}</div>
            <div class="text-xs font-heading text-navy-500 uppercase tracking-wider">{stat.label}</div>
          </div>
        ))}
      </div>

      <!-- What we do -->
      <div class="mt-14">
        <div class="section-divider mb-6"></div>
        <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">What We Do</h2>
        <p class="text-navy-600/80 leading-relaxed mb-6">
          Cornerstone Services provides end-to-end direct mail marketing, commercial printing, data list management, and graphic design. We specialize in EDDM (Every Door Direct Mail), non-profit mailing, political mailers, and municipal notifications. Whether you need 500 postcards or 500,000, we deliver.
        </p>

        <div class="grid sm:grid-cols-2 gap-4 mt-6">
          {[
            { title: 'Direct Mail Campaigns', desc: 'Complete campaigns from data to delivery' },
            { title: 'Commercial Printing', desc: 'Postcards, letters, brochures, newsletters' },
            { title: 'Data List Services', desc: 'Targeted lists, saturation data, NCOA processing' },
            { title: 'EDDM', desc: 'Every Door Direct Mail — no list needed' },
            { title: 'Non-Profit Mailing', desc: 'Discounted rates and PS Form 3624 guidance' },
            { title: 'Graphic Design', desc: 'USPS-compliant mail piece design' },
          ].map((item) => (
            <div class="flex items-start gap-3 p-4 bg-navy-50/40 rounded-lg">
              <svg class="w-5 h-5 text-crst-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <div>
                <div class="font-heading font-semibold text-navy-800 text-sm">{item.title}</div>
                <div class="text-xs text-navy-600/60">{item.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Memberships -->
      <div class="mt-14">
        <div class="section-divider mb-6"></div>
        <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">Memberships & Ratings</h2>
        <p class="text-navy-600/80 leading-relaxed mb-6">
          Cornerstone Services maintains a BBB A+ rating and is a member of several industry organizations. Our commitment to quality and customer service has earned us the trust of hundreds of clients across the Hudson Valley.
        </p>
        <div class="flex flex-wrap items-center gap-6">
          <div class="flex items-center gap-2 px-4 py-2 bg-navy-50/60 rounded-lg border border-navy-100">
            <svg class="w-5 h-5 text-crst-gold" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <span class="font-heading font-semibold text-sm text-navy-700">BBB A+ Rating</span>
          </div>
          <!-- Add more membership badges as logos become available -->
        </div>
        <p class="mt-6">
          <a href="/about/profiles" class="inline-flex items-center gap-1.5 font-heading font-semibold text-sm text-crst-primary hover:text-crst-gold transition-colors">
            See our full list of memberships, verified profiles &amp; credentials
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </p>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
