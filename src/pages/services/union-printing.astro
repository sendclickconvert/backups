---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { BUSINESS, COUNTIES } from '../../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Union Printing Services',
  provider: {
    '@type': 'LocalBusiness',
    '@id': 'https://crst.net/#organization',
    name: BUSINESS.name,
    telephone: BUSINESS.phone,
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: BUSINESS.rating.ratingValue,
      reviewCount: BUSINESS.rating.reviewCount,
      bestRating: BUSINESS.rating.bestRating,
      worstRating: BUSINESS.rating.worstRating,
    },
  },
  areaServed: [
    { '@type': 'County', name: 'Ulster County, New York' },
    { '@type': 'County', name: 'Dutchess County, New York' },
    { '@type': 'County', name: 'Orange County, New York' },
  ],
  url: 'https://crst.net/services/union-printing/',
};
---

<BaseLayout
  title="Union Printing"
  description="Union label printing for political campaigns, labor organizations, and government entities in the Hudson Valley. Allied Printing Trades Council bug on all materials. Postcards, letters, brochures, and more."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <PageHero
    title="Union Printing Services"
    subtitle="Allied Printing Trades Council label on every piece."
    breadcrumbs={[
      { label: 'Services', href: '/services/' },
      { label: 'Union Printing' },
    ]}
  />

  <section class="py-14 lg:py-20">
    <div class="container-narrow">
      <div class="section-divider mb-6"></div>
      <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">Print with the Union Label</h2>
      <p class="text-navy-600/80 leading-relaxed mb-6">
        For political campaigns, labor organizations, government offices, and any entity that requires union-printed materials, Cornerstone Services provides full commercial printing with the Allied Printing Trades Council union bug. Every piece we produce under our union label meets the quality and compliance standards your organization expects.
      </p>
      <p class="text-navy-600/80 leading-relaxed mb-6">
        Union printing isn't just a label — it's a commitment. It signals to voters, members, and stakeholders that your materials were produced by skilled union workers under fair labor conditions. In politically active regions like the Hudson Valley, that distinction matters.
      </p>

      <!-- What We Print -->
      <div class="section-divider mb-6 mt-14"></div>
      <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">Union-Printed Materials</h2>
      <div class="grid sm:grid-cols-2 gap-3 mb-6">
        {[
          'Political campaign postcards and palm cards',
          'Campaign literature and brochures',
          'Fundraising letters and appeal envelopes',
          'Caucus and electoral notification cards',
          'Labor union newsletters and flyers',
          'Government notification letters',
          'Municipal meeting notices',
          'Committee and organization stationery',
        ].map((item) => (
          <div class="flex items-start gap-3 p-3 bg-navy-50/40 rounded-lg">
            <svg class="w-4 h-4 text-crst-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span class="text-sm text-navy-700">{item}</span>
          </div>
        ))}
      </div>

      <div class="bg-crst-primary/5 border border-crst-primary/15 rounded-xl p-6 mt-10 text-center">
        <p class="font-heading font-bold text-crst-primary text-lg mb-2">Need Union-Printed Materials?</p>
        <p class="text-navy-600/70 text-sm mb-4">Get a free estimate for your next political campaign, labor organization, or government mailing.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/estimate/" class="btn-primary text-sm">Get a Free Estimate</a>
          <a href={`tel:${BUSINESS.phoneClean}`} class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-crst-primary hover:text-crst-accent transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call {BUSINESS.phone}
          </a>
        </div>
      </div>

      <!-- Political Campaigns -->
      <div class="section-divider mb-6 mt-14"></div>
      <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">Political Campaign Printing & Mailing</h2>
      <p class="text-navy-600/80 leading-relaxed mb-6">
        Cornerstone has printed and mailed materials for Republican and Democratic campaigns, town committees, county legislatures, and independent candidates throughout the Hudson Valley. We understand the tight timelines, compliance requirements, and targeting precision that political mail demands.
      </p>
      <p class="text-navy-600/80 leading-relaxed mb-6">
        Our political mailing services include voter file targeting, district-level saturation mailing, EDDM for local races, and personalized variable data printing. Every piece carries the union bug and meets USPS automation requirements for maximum postage savings.
      </p>

      <!-- Full Service -->
      <div class="bg-navy-50/60 rounded-xl border border-navy-100 p-6 lg:p-8 my-10">
        <h3 class="font-heading font-bold text-navy-800 text-lg mb-4">Full-Service Union Print + Mail</h3>
        <p class="text-sm text-navy-600/70 leading-relaxed mb-4">
          Cornerstone handles your entire campaign under one roof — no need to coordinate between a printer, a mail house, and a data vendor. We provide:
        </p>
        <div class="grid sm:grid-cols-2 gap-3">
          {[
            { title: 'Voter Data & Targeting', desc: 'District-level voter files, party affiliation filtering, turnout modeling' },
            { title: 'Design & Layout', desc: 'USPS-compliant mail piece design with union bug placement' },
            { title: 'Commercial Printing', desc: 'Offset and digital printing on premium stock' },
            { title: 'Presort & Delivery', desc: 'CASS/DPV processing, presort, and USPS drop with tracking' },
          ].map((item) => (
            <div class="p-3 bg-white rounded-lg border border-navy-100">
              <div class="font-heading font-semibold text-navy-800 text-sm mb-1">{item.title}</div>
              <div class="text-xs text-navy-600/60">{item.desc}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
    <AuthorByline compact />
  </div>

  <section class="py-14 bg-navy-50/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-display font-bold text-crst-primary">Service Areas</h2>
        <p class="text-gray-600 mt-2">We serve businesses and organizations across three Hudson Valley counties.</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-4 max-w-3xl mx-auto">
        {Object.values(COUNTIES).map((county) => (
          <a href={`/service-areas/${county.slug}/`} class="flex items-center justify-center gap-2 p-4 bg-white rounded-lg border border-gray-200 hover:border-crst-primary/30 hover:shadow-sm transition-all group">
            <svg class="w-5 h-5 text-crst-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="font-heading font-semibold text-gray-800 group-hover:text-crst-primary transition-colors">{county.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    headline="Need Union-Printed Materials?"
    text="Get a free estimate for your next political campaign, labor organization, or government mailing."
  />
</BaseLayout>
