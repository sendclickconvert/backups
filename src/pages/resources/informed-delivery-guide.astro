<!-- ════════════════════════════════════════════════════════════════════
     SCRIPTS
     ════════════════════════════════════════════════════════════════════ -->
<script define:vars={{ FORM_ENDPOINT }}>
  /* ── Closing CTA scroll ── */
  document.getElementById('cta-scroll-btn')?.addEventListener('click', () => {
    const firstField = document.getElementById('g-first-name');
    const form = document.getElementById('guide-form');
    if (!form || !firstField) return;
    const top = form.getBoundingClientRect().top + window.scrollY - 120;
    window.scrollTo({ top, behavior: 'smooth' });
    setTimeout(() => firstField.focus(), 350);
  });

  /* ── Form ── */
  const form       = document.getElementById('guide-form');
  const submitBtn  = document.getElementById('guide-submit');
  const submitTxt  = document.getElementById('guide-submit-text');
  const spinner    = document.getElementById('guide-spinner');
  const success    = document.getElementById('guide-success');
  const errorMsg   = document.getElementById('guide-error');
  const loadField  = document.getElementById('guide-loadtime');

  if (loadField) loadField.value = Date.now().toString();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    /* honeypot */
    const hp = form.querySelector('input[name="website"]');
    if (hp?.value) return;

    /* time check — must be at least 3 s after page load */
    const loadTime = parseInt(loadField?.value || '0', 10);
    if (loadTime && Date.now() - loadTime < 3000) return;

    submitBtn.disabled = true;
    submitTxt.textContent = 'Sending\u2026';
    spinner.style.display = 'inline-block';
    success.style.display = 'none';
    errorMsg.style.display = 'none';

    const fd = new FormData(form);
    const payload = {
      first_name: fd.get('first_name') ?? '',
      email:      fd.get('email') ?? '',
      company:    fd.get('company') ?? '',
    };

    try {
      const res = await fetch(FORM_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error('non-2xx');
      form.style.display = 'none';
      success.style.display = 'block';
    } catch {
      errorMsg.style.display = 'block';
    } finally {
      submitBtn.disabled = false;
      submitTxt.textContent = 'Send me the guide';
      spinner.style.display = 'none';
    }
  });
</script>

