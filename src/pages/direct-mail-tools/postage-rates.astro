---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import { BUSINESS } from '../../data/site';
---

<BaseLayout
  title="2026 USPS Postage Rates: First Class, EDDM, Bulk Mail & Nonprofit"
  description="2026 USPS postage rates for every mail class — Marketing Mail from $0.276/pc, EDDM from $0.242/pc, First-Class from $0.485/pc, and Non-Profit from $0.154/pc. Updated for 2026 rate changes."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the 2026 USPS postage rate for a standard letter?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The 2026 USPS First-Class rate for a single 1 oz letter is $0.73. For bulk presort First-Class mailings of 500+ pieces, the rate drops to $0.485 per piece. For Marketing Mail (bulk advertising), automation rates start at $0.308 per letter with an Intelligent Mail barcode. USPS rates typically change in January and July each year."
        }
      },
      {
        "@type": "Question",
        "name": "How much does EDDM postage cost in 2026?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "EDDM (Every Door Direct Mail) postage in 2026 costs $0.247 per piece for EDDM Retail (no permit required, limit 5,000 pieces per day per ZIP) and $0.242 per piece for EDDM BMEU (Business Mail Entry Unit), which requires a permit but has no daily volume limit. EDDM is one of the most cost-effective options for local businesses targeting every address in a neighborhood."
        }
      },
      {
        "@type": "Question",
        "name": "What is the cheapest way to mail postcards in bulk?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The cheapest bulk postcard rate is EDDM at $0.242–$0.247 per piece, which requires no mailing list. If you need to target a specific list, Marketing Mail automation rate for postcards is $0.276 per piece with a minimum of 200 pieces. For comparison, a single First-Class postcard costs $0.56. The right choice depends on whether you need targeted addressing or blanket neighborhood coverage."
        }
      },
      {
        "@type": "Question",
        "name": "What are the USPS Non-Profit postage rates for 2026?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Qualifying 501(c)(3) organizations can mail at $0.154 per piece for automation letters and $0.243 per piece for flats — roughly 50% less than standard commercial Marketing Mail rates. Non-profit mailing authorization requires submitting USPS PS Form 3624. Once approved, the authorization is permanent and applies to all future mailings. Cornerstone helps non-profits apply and manage their mailing permit."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between Marketing Mail and First-Class Mail?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Marketing Mail (formerly Standard Mail) is designed for advertising and bulk mailings — it costs less ($0.276–$0.357 per piece) but delivers in 3–10 business days and does not include forwarding or return service. First-Class Mail costs more ($0.485–$0.73 per piece) but delivers in 1–3 days and includes address forwarding and return to sender. First-Class is best for invoices, statements, and time-sensitive mail. Marketing Mail is best for advertising campaigns, coupons, and newsletters."
        }
      },
      {
        "@type": "Question",
        "name": "What is the minimum quantity for bulk mail postage rates?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "USPS Marketing Mail (bulk mail) requires a minimum of 200 pieces or 50 lbs per mailing, whichever comes first. First-Class presort discounts require a minimum of 500 pieces. EDDM Retail has a minimum of 200 pieces per mailing per ZIP code. To access bulk rates, you also need a valid USPS mailing permit, which Cornerstone can provide on your behalf."
        }
      },
      {
        "@type": "Question",
        "name": "How much does a mailing permit cost from USPS?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A USPS bulk mail permit (Permit Imprint) has an annual fee of $250 for a permit imprint account. There is also a one-time application fee. Many direct mail companies, including Cornerstone Services, mail under their own permit on behalf of clients — meaning clients can access bulk rates without obtaining their own permit. This is typically the most cost-effective approach for businesses that mail periodically rather than continuously."
        }
      }
    ]
  })} />

  <PageHero
    title="Current USPS Postage Rates"
    subtitle="2026 rates for Marketing Mail, EDDM, First-Class, and Non-Profit mail — with automation discounts, minimum quantities, and permit requirements explained."
    breadcrumbs={[
      { label: 'Direct Mail Tools', href: '/direct-mail-tools/' },
      { label: 'Postage Rates' },
    ]}
  />

  <section class="py-14 lg:py-20">
    <div class="container-wide">
      <div class="max-w-4xl mx-auto">
        <div class="section-divider mb-6"></div>
        <p class="text-navy-600/80 leading-relaxed mb-8">
          USPS postage rates change periodically — typically in January and July. The rates below reflect the most common categories for direct mail. For details on the latest adjustment, read about the <a href="https://blog.crst.net/postage-rate-hike-coming-in-july-2025/" class="text-crst-primary underline hover:text-crst-gold">2025 USPS Postage Rate Changes</a>. Always confirm current rates with Cornerstone or the USPS before planning your budget. We automatically apply the lowest qualifying rate to every campaign we process.
        </p>

        <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-10 text-sm text-amber-800">
          <strong>Note:</strong> Rates shown are approximate and subject to change. Actual rates depend on mail piece size, weight, presort level, and entry point. Contact us for an exact quote for your specific campaign.
        </div>

        <div class="flex items-start gap-4 bg-navy-50 rounded-xl p-5 mb-10 border border-navy-100">
          <div class="shrink-0 w-12 h-12 rounded-full bg-crst-primary/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-crst-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          </div>
          <div>
            <p class="text-sm font-heading font-semibold text-navy-800">Compiled by Sean Griffen, Owner — Cornerstone Services, Inc.</p>
            <p class="text-xs text-navy-500 mt-1">Sean has processed bulk mail campaigns for Hudson Valley businesses since 1998. The rates on this page are applied to every campaign Cornerstone produces. We update this guide every time USPS announces a rate change.</p>
            <p class="text-xs text-navy-400 mt-1">Last reviewed: January 2026 · Source: <a href="https://pe.usps.com/text/dmm300/dmm300_landing.htm" target="_blank" rel="noopener noreferrer" class="underline hover:text-crst-primary">USPS Domestic Mail Manual</a> & <a href="https://www.usps.com/business/prices.htm" target="_blank" rel="noopener noreferrer" class="underline hover:text-crst-primary">USPS Business Prices</a></p>
          </div>
        </div>

        <!-- Marketing Mail -->
        <h3 class="text-xl font-display text-crst-primary mb-4">USPS Marketing Mail (Bulk Mail)</h3>
        <p class="text-navy-600/80 text-sm leading-relaxed mb-4">
          Marketing Mail (formerly Standard Mail) is the most common class for <a href="/direct-mail-marketing/" class="text-crst-primary underline hover:text-crst-gold">direct mail advertising</a>. Requires a minimum of 200 pieces or 50 lbs per mailing. Delivery is typically 3–10 business days.
        </p>
        <div class="overflow-x-auto mb-10">
          <table class="w-full text-sm border border-navy-200 rounded-lg overflow-hidden">
            <thead>
              <tr class="bg-crst-primary text-white">
                <th class="text-left p-3 font-heading">Mail Piece Type</th>
                <th class="text-left p-3 font-heading">Presort Rate</th>
                <th class="text-left p-3 font-heading">Automation Rate</th>
                <th class="text-left p-3 font-heading">Notes</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-navy-100">
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Letters (up to 3.5 oz)</td>
                <td class="p-3 text-navy-600">$0.357</td>
                <td class="p-3 text-navy-600">$0.308</td>
                <td class="p-3 text-navy-500">Automation requires <a href="/direct-mail-tools/postal-dictionary/" class="text-crst-primary underline hover:text-crst-gold">Intelligent Mail barcode (IMb)</a></td>
              </tr>
              <tr class="bg-navy-50/50">
                <td class="p-3 font-semibold text-navy-800">Postcards</td>
                <td class="p-3 text-navy-600">$0.322</td>
                <td class="p-3 text-navy-600">$0.276</td>
                <td class="p-3 text-navy-500">Must meet postcard size requirements</td>
              </tr>
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Flats / Self-Mailers</td>
                <td class="p-3 text-navy-600">$0.542</td>
                <td class="p-3 text-navy-600">$0.488</td>
                <td class="p-3 text-navy-500">Larger pieces, catalogs, booklets</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- EDDM -->
        <h3 class="text-xl font-display text-crst-primary mb-4">EDDM (Every Door Direct Mail)</h3>
        <p class="text-navy-600/80 text-sm leading-relaxed mb-4">
          EDDM delivers to every address on selected <a href="/direct-mail-tools/eddm-guide/" class="text-crst-primary underline hover:text-crst-gold">carrier routes</a> — no mailing list needed. Ideal for local businesses wanting blanket coverage of their area.
        </p>
        <div class="overflow-x-auto mb-10">
          <table class="w-full text-sm border border-navy-200 rounded-lg overflow-hidden">
            <thead>
              <tr class="bg-crst-primary text-white">
                <th class="text-left p-3 font-heading">EDDM Type</th>
                <th class="text-left p-3 font-heading">Rate per Piece</th>
                <th class="text-left p-3 font-heading">Permit Required?</th>
                <th class="text-left p-3 font-heading">Daily Limit</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-navy-100">
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">EDDM Retail</td>
                <td class="p-3 text-navy-600">$0.247</td>
                <td class="p-3 text-navy-600">No</td>
                <td class="p-3 text-navy-500">5,000/day per ZIP</td>
              </tr>
              <tr class="bg-navy-50/50">
                <td class="p-3 font-semibold text-navy-800">EDDM BMEU</td>
                <td class="p-3 text-navy-600">$0.242</td>
                <td class="p-3 text-navy-600">Yes</td>
                <td class="p-3 text-navy-500">No daily limit</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- First-Class -->
        <h3 class="text-xl font-display text-crst-primary mb-4">First-Class Mail</h3>
        <p class="text-navy-600/80 text-sm leading-relaxed mb-4">
          First-Class is faster (1–3 days) and includes forwarding and return service. Used for invoices, statements, and time-sensitive communications. Presort discounts are available for 500+ pieces.
        </p>
        <div class="overflow-x-auto mb-10">
          <table class="w-full text-sm border border-navy-200 rounded-lg overflow-hidden">
            <thead>
              <tr class="bg-crst-primary text-white">
                <th class="text-left p-3 font-heading">Mail Piece Type</th>
                <th class="text-left p-3 font-heading">Single Piece</th>
                <th class="text-left p-3 font-heading">Presort/Automation</th>
                <th class="text-left p-3 font-heading">Min. Quantity</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-navy-100">
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Letters (1 oz)</td>
                <td class="p-3 text-navy-600">$0.73</td>
                <td class="p-3 text-navy-600">$0.485</td>
                <td class="p-3 text-navy-500">500 pieces</td>
              </tr>
              <tr class="bg-navy-50/50">
                <td class="p-3 font-semibold text-navy-800">Postcards</td>
                <td class="p-3 text-navy-600">$0.56</td>
                <td class="p-3 text-navy-600">$0.405</td>
                <td class="p-3 text-navy-500">500 pieces</td>
              </tr>
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Flats</td>
                <td class="p-3 text-navy-600">$1.35</td>
                <td class="p-3 text-navy-600">$0.80</td>
                <td class="p-3 text-navy-500">500 pieces</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Non-Profit -->
        <h3 class="text-xl font-display text-crst-primary mb-4">Non-Profit Mail Rates</h3>
        <p class="text-navy-600/80 text-sm leading-relaxed mb-4">
          Qualifying 501(c)(3) organizations receive the lowest USPS rates — typically 40–60% less than commercial Marketing Mail. Requires USPS authorization via <a href="/non-profit-mailing-application/" class="text-crst-primary underline hover:text-crst-gold">PS Form 3624</a>.
        </p>
        <div class="overflow-x-auto mb-10">
          <table class="w-full text-sm border border-navy-200 rounded-lg overflow-hidden">
            <thead>
              <tr class="bg-crst-primary text-white">
                <th class="text-left p-3 font-heading">Mail Piece Type</th>
                <th class="text-left p-3 font-heading">Non-Profit Rate</th>
                <th class="text-left p-3 font-heading">vs. Commercial</th>
                <th class="text-left p-3 font-heading">Savings</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-navy-100">
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Letters (automation)</td>
                <td class="p-3 text-navy-600">$0.154</td>
                <td class="p-3 text-navy-600">$0.308</td>
                <td class="p-3 text-green-600 font-semibold">~50%</td>
              </tr>
              <tr class="bg-navy-50/50">
                <td class="p-3 font-semibold text-navy-800">Flats (automation)</td>
                <td class="p-3 text-navy-600">$0.243</td>
                <td class="p-3 text-navy-600">$0.488</td>
                <td class="p-3 text-green-600 font-semibold">~50%</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="bg-crst-primary/5 border border-crst-primary/20 rounded-xl p-6 mt-8">
          <h4 class="font-heading font-bold text-crst-primary mb-2">Get an Exact Quote</h4>
          <p class="text-navy-600/80 text-sm leading-relaxed mb-4">
            Actual postage depends on your specific mail piece size, weight, presort level, and entry point. Let us analyze your campaign and provide an exact postage cost.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/estimate/" class="btn-primary text-sm">Request Estimate</a>
            <a href="/direct-mail-tools/envelope-sizes/" class="btn-secondary text-sm">Mail Piece Sizes →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
