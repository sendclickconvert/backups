---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { BUSINESS, COUNTIES } from '../../data/site';
import { getCollection } from 'astro:content';

const clusterArticles = await getCollection('nonprofit-articles');

const npFaqs = [
  { q: 'How long does the PS Form 3624 approval take?', a: 'USPS typically processes non-profit authorization requests within 30–60 days. We recommend applying well in advance of your first planned mailing.' },
  { q: 'Can we use our non-profit permit at any post office?', a: 'Your non-profit authorization is tied to the post office where your mailing permit is held. If you need to mail from multiple locations, additional authorizations may be required.' },
  { q: 'What\'s the minimum quantity for non-profit mail?', a: 'USPS Marketing Mail (including non-profit) requires a minimum of 200 pieces or 50 pounds per mailing. EDDM mailings require a minimum of 200 pieces per carrier route selected.' },
  { q: 'Does Cornerstone have its own mailing permit we can use?', a: 'Yes. If your organization doesn\'t have its own mailing permit, you can mail under our permit. We can also help you establish your own permit if preferred.' },
];

const graphSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Non-Profit Mailing Services',
      provider: { '@id': 'https://crst.net/#organization' },
      areaServed: [
        { '@type': 'County', name: 'Ulster County, New York' },
        { '@type': 'County', name: 'Dutchess County, New York' },
        { '@type': 'County', name: 'Orange County, New York' },
      ],
      url: 'https://crst.net/services/non-profit-mailing',
    },
    {
      '@type': 'FAQPage',
      mainEntity: npFaqs.map(faq => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://crst.net' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://crst.net/services' },
        { '@type': 'ListItem', position: 3, name: 'Non-Profit Mailing', item: 'https://crst.net/services/non-profit-mailing' },
      ],
    },
    {
      '@type': 'WebPage',
      '@id': 'https://crst.net/services/non-profit-mailing',
      name: 'Nonprofit Mailing Services — Discounted USPS Rates',
      url: 'https://crst.net/services/non-profit-mailing',
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', 'h2'],
      },
    },
  ],
};
---

<BaseLayout
  title="Nonprofit Mailing Services — Discounted USPS Rates"
  description="Nonprofit mailing services with discounted USPS postage rates. Permit setup, design, printing, and postal prep for fundraisers and appeals."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(graphSchema)} />
  </Fragment>

  <PageHero
    title="Nonprofit Mailing Services"
    subtitle="Nonprofits qualify for the lowest USPS postage rates. We handle the permit paperwork, print the appeal, and prep the mailing — all in-house."
    breadcrumbs={[
      { label: 'Services', href: '/services' },
      { label: 'Non-Profit Mailing' },
    ]}
  />

  <section class="py-14 lg:py-20">
    <div class="container-narrow">
      <div class="section-divider mb-6"></div>
      <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">How Nonprofit Postage Rates Work</h2>
      <p class="text-navy-600/80 leading-relaxed mb-6">
        Cornerstone handles USPS nonprofit mailing end-to-end for organizations across the Hudson Valley — Form 3624 application support, authorization tracking, BMEU presort, and full campaign execution at the discounted nonprofit rate. Nonprofit mail is a USPS mail class that lets qualifying 501(c)(3), 501(c)(4), and similar organizations send Marketing Mail at significantly lower postage rates than commercial bulk mail. We've processed nonprofit mailings under permit since 1998 and know every step of the application and mailing process.
      </p>
      <p class="text-navy-600/80 leading-relaxed mb-6">
        The savings add up fast on high-volume campaigns. We handle the permit application and every mailing after that — in-house design, print, and mail for Hudson Valley nonprofits, churches, civic organizations, and charitable foundations.
      </p>

      <!-- Rate Comparison -->
      <div class="bg-navy-50/60 rounded-xl border border-navy-100 p-6 lg:p-8 my-10">
        <h3 class="font-heading font-bold text-navy-800 text-lg mb-4">Why Non-Profit Rates Matter</h3>
        <div class="grid sm:grid-cols-3 gap-4">
          <div class="text-center p-4 bg-white rounded-lg border border-navy-100">
            <div class="text-2xl font-display text-navy-400 mb-1">~$0.50+</div>
            <div class="text-xs font-heading text-navy-500 uppercase tracking-wider">First-Class Rate</div>
          </div>
          <div class="text-center p-4 bg-white rounded-lg border border-navy-100">
            <div class="text-2xl font-display text-crst-secondary mb-1">~$0.21</div>
            <div class="text-xs font-heading text-navy-500 uppercase tracking-wider">Standard Non-Profit</div>
          </div>
          <div class="text-center p-4 bg-crst-primary rounded-lg">
            <div class="text-2xl font-display text-crst-gold mb-1">~$0.14</div>
            <div class="text-xs font-heading text-white/70 uppercase tracking-wider">Non-Profit EDDM/Saturation</div>
          </div>
        </div>
        <p class="text-xs text-navy-500 mt-4 text-center">Rates are approximate and vary by mail piece size, weight, and sortation level. Contact us for a precise quote.</p>
      </div>

      <!-- PS Form 3624 -->
      <div class="section-divider mb-6 mt-14"></div>
      <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">PS Form 3624 Application</h2>
      <p class="text-navy-600/80 leading-relaxed mb-6">
        To mail at non-profit rates, your organization must submit USPS PS Form 3624 (Application to Mail at Nonprofit USPS Marketing Mail Prices) at the post office where you hold your mailing permit. The application requires documentation of your non-profit status, including articles of incorporation, IRS determination letters, and organizational bylaws.
      </p>
      <p class="text-navy-600/80 leading-relaxed mb-6">
        Cornerstone Services provides a free interactive tool that walks you through the entire PS Form 3624 process step by step, collecting the information you need and helping you prepare a complete application package.
      </p>
      <a href="/non-profit-mailing-application" class="btn-primary text-sm">
        Use Our Free PS Form 3624 Tool
        <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>

      <div class="bg-crst-primary/5 border border-crst-primary/15 rounded-xl p-6 mt-10 text-center">
        <p class="font-heading font-bold text-crst-primary text-lg mb-2">Find Out If Your Organization Qualifies</p>
        <p class="text-navy-600/70 text-sm mb-4">We'll review your eligibility and help you apply for non-profit mailing rates.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/estimate" class="btn-primary text-sm">Get a Free Estimate</a>
          <a href={`tel:${BUSINESS.phoneClean}`} class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-crst-primary hover:text-crst-accent transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call {BUSINESS.phone}
          </a>
        </div>
      </div>

      <!-- Who Qualifies -->
      <div class="section-divider mb-6 mt-14"></div>
      <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">Who Qualifies?</h2>
      <p class="text-navy-600/80 leading-relaxed mb-6">
        The USPS authorizes non-profit mailing rates for organizations that fall into specific categories. Common qualifying organizations in the Hudson Valley include:
      </p>
      <div class="grid sm:grid-cols-2 gap-3 mb-6">
        {[
          'Religious organizations (churches, synagogues, mosques)',
          'Educational institutions and PTAs',
          'Scientific and research organizations',
          'Philanthropic and charitable foundations',
          'Veterans\' organizations',
          'Fraternal organizations',
          'Agricultural and labor organizations',
          'Volunteer fire departments and EMS',
        ].map((item) => (
          <div class="flex items-start gap-3 p-3 bg-navy-50/40 rounded-lg">
            <svg class="w-4 h-4 text-crst-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span class="text-sm text-navy-700">{item}</span>
          </div>
        ))}
      </div>

      <!-- Our Process -->
      <div class="section-divider mb-6 mt-14"></div>
      <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">How We Help</h2>
      <div class="space-y-6">
        {[
          { step: '01', title: 'Eligibility Review', desc: 'We review your organization\'s documentation to confirm you qualify for non-profit mailing rates under USPS guidelines.' },
          { step: '02', title: 'Application Preparation', desc: 'We prepare your PS Form 3624 application package with all required supporting documents — articles of incorporation, IRS determination letter, bylaws, and more.' },
          { step: '03', title: 'Campaign Planning', desc: 'We design your mailing strategy to maximize postage savings — choosing the right mail class, piece size, and sortation level for your budget.' },
          { step: '04', title: 'Print & Mail', desc: 'We handle graphic design, printing, CASS/DPV address processing, presort, and USPS delivery — all at your discounted non-profit rate.' },
        ].map((item) => (
          <div class="flex items-start gap-5 p-5 bg-navy-50/40 rounded-xl border border-navy-100">
            <div class="text-3xl font-display text-crst-gold/30 shrink-0">{item.step}</div>
            <div>
              <h3 class="font-heading font-bold text-navy-800 mb-1">{item.title}</h3>
              <p class="text-sm text-navy-600/70 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- FAQ -->
      <div class="section-divider mb-6 mt-14"></div>
      <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-6">Non-Profit Mailing FAQ</h2>
      <div class="space-y-4">
        {npFaqs.map((item) => (
          <div class="bg-navy-50/40 rounded-xl border border-navy-100 p-5">
            <h3 class="font-heading font-semibold text-navy-800 text-sm mb-2">{item.q}</h3>
            <p class="text-sm text-navy-600/70 leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
    <AuthorByline />
  </div>

  <section class="py-10 bg-crst-primary/5 border-y border-crst-primary/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h3 class="text-xl font-display font-bold text-crst-primary mb-3">Find Out If Your Organization Qualifies</h3>
      <p class="text-gray-600 mb-6 max-w-2xl mx-auto">We'll review your eligibility and help you apply for non-profit mailing rates.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-primary inline-flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call {BUSINESS.phone}
        </a>
        <a href="/estimate" class="btn-accent inline-flex items-center gap-2">
          Get a Free Estimate
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 bg-navy-50/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-display font-bold text-crst-primary">Service Areas</h2>
        <p class="text-gray-600 mt-2">We serve businesses and organizations across three Hudson Valley counties.</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-4 max-w-3xl mx-auto">
        {Object.values(COUNTIES).map((county) => (
          <a href={`/service-areas/${county.slug}`} class="flex items-center justify-center gap-2 p-4 bg-white rounded-lg border border-gray-200 hover:border-crst-primary/30 hover:shadow-sm transition-all group">
            <svg class="w-5 h-5 text-crst-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="font-heading font-semibold text-gray-800 group-hover:text-crst-primary transition-colors">{county.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-display font-bold text-crst-primary mb-3">Non-Profit Mailing Guides</h2>
        <p class="text-navy-600/70 max-w-2xl mx-auto">In-depth guides on non-profit postage rates, qualifying for bulk mail authorization, donor acquisition by mail, writing fundraising letters, and EDDM vs. targeted mail for nonprofits — written by Sean Griffin, MDP, owner of Cornerstone Services since 1998.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {clusterArticles.map((a) => (
          <a href={`/services/non-profit-mailing/${a.slug}`} class="block p-5 bg-navy-50/40 rounded-xl border border-navy-100 hover:border-crst-primary/30 hover:shadow-sm transition-all group">
            <h3 class="font-heading font-semibold text-navy-800 text-sm group-hover:text-crst-primary transition-colors leading-snug mb-2">{a.data.title}</h3>
            <p class="text-xs text-navy-600/60 line-clamp-2 leading-relaxed">{a.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    headline="Ready to Save on Your Non-Profit Mailings?"
    text="Get a free estimate and find out how much your organization can save with non-profit postage rates."
  />
</BaseLayout>
