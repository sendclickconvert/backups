---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import CaseStudyCallout from '../../components/CaseStudyCallout.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { BUSINESS, COUNTIES } from '../../data/site';
import { getCollection } from 'astro:content';

const clusterArticles = await getCollection('union-articles');

const faqs = [
  { q: 'Does union printing cost more than standard printing?', a: 'Union printing may carry a slight premium depending on run size and material, but Cornerstone works with union print partners throughout the Hudson Valley to keep costs competitive. Request a quote for your specific job.' },
  { q: 'What is the union bug and is it required on my mail piece?', a: 'The union bug is a small mark identifying the printing union that produced the piece. For union-labeled work, it is required and appears automatically on CRST-produced union print jobs. Its placement follows union printing regulations.' },
  { q: 'Can I use union printing for EDDM campaigns?', a: 'Yes. Union-printed EDDM flat cards and postcards are among our most common union print jobs. We handle design, printing, postal prep, and delivery in-house.' },
  { q: 'Do you work with political campaigns for union printing?', a: 'Yes. Union printing is frequently requested for political mailers, particularly in labor-heavy districts. CRST manages political direct mail from data through delivery.' },
];

const graphSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Union Printing for Direct Mail',
      provider: { '@id': 'https://crst.net/#organization' },
      description: 'Union-printed direct mail materials including postcards, envelopes, letterhead, and brochures for political campaigns, nonprofits, and labor organizations in the Hudson Valley.',
      areaServed: [
        { '@type': 'County', name: 'Ulster County, New York' },
        { '@type': 'County', name: 'Dutchess County, New York' },
        { '@type': 'County', name: 'Orange County, New York' },
      ],
      url: 'https://crst.net/services/union-printing',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(faq => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://crst.net' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://crst.net/services' },
        { '@type': 'ListItem', position: 3, name: 'Union Printing', item: 'https://crst.net/services/union-printing' },
      ],
    },
    {
      '@type': 'WebPage',
      '@id': 'https://crst.net/services/union-printing',
      name: 'Union Printing for Direct Mail Materials',
      url: 'https://crst.net/services/union-printing',
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', 'h2'],
      },
    },
  ],
};
---

<BaseLayout
  title="Union Printing for Direct Mail"
  description="Cornerstone Services provides union-printed direct mail materials including postcards, envelopes, letterhead, and brochures. CWA partner. Saugerties, NY. Est. 1998."
  canonical="https://crst.net/services/union-printing"
  schema={null}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(graphSchema)} />
  </Fragment>

  <PageHero
    title="Union Printing for Direct Mail Materials"
    subtitle="Certified union printing with CWA partnership. Postcards, envelopes, letterhead, and brochures — all with the union bug. In-house in Saugerties since 1998."
    breadcrumbs={[
      { label: 'Services', href: '/services' },
      { label: 'Union Printing' },
    ]}
    noSchema={true}
  />

  <section class="py-14 lg:py-20">
    <div class="container-wide">
      <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">
        <div class="lg:col-span-2">

          <AuthorByline />

          <div class="section-divider mb-6"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">What Is Union Printing?</h2>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            Union printing means your printed materials are produced under a collective bargaining agreement by workers represented by a recognized labor union. Every piece carries the union bug — a small printed mark that certifies the work was done in a union shop. For <a href="/services/direct-mail" class="text-crst-accent hover:underline">direct mail</a> campaigns run by political candidates, labor organizations, government agencies, and <a href="/services/non-profit-mailing" class="text-crst-accent hover:underline">nonprofits</a>, the union bug is often a requirement, not an option.
          </p>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            Cornerstone is a proud union printing partner through the Communications Workers of America (CWA). Our CWA partnership covers all printed materials we produce — postcards, letterhead, envelopes, brochures, and campaign literature. When you order union printing from CRST, the union bug appears on every piece automatically. No separate vendor, no coordination — it is built into our production workflow.
          </p>

          <div class="section-divider mb-6 mt-14"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">Union Printing Materials We Offer</h2>

          <div class="space-y-8 mb-8">
            <div>
              <h3 class="text-xl font-display text-crst-primary mb-3">Letterhead</h3>
              <p class="text-navy-600/80 leading-relaxed mb-2">
                Union-printed letterhead on standard 8.5" × 11" stock. Includes your organization's name, logo, contact information, and the union bug. Used for official correspondence, endorsement letters, campaign communications, and organizational stationery. Printed on premium paper stock with consistent color reproduction.
              </p>
              <p class="text-sm text-navy-600/60"><strong>Size:</strong> 8.5" × 11" (standard)</p>
            </div>

            <div>
              <h3 class="text-xl font-display text-crst-primary mb-3">Postcards</h3>
              <p class="text-navy-600/80 leading-relaxed mb-2">
                Postcards are one of the most common union print jobs we handle. Political campaigns, labor unions, and municipal agencies use postcards for voter contact, event announcements, and public notices. All postcards are printed with the union bug and designed to meet USPS automation standards for the lowest <a href="/direct-mail-tools/postage-rates" class="text-crst-accent hover:underline">postage rates</a>. Available in multiple sizes for both addressed mail and <a href="/services/eddm" class="text-crst-accent hover:underline">EDDM</a> campaigns.
              </p>
              <p class="text-sm text-navy-600/60"><strong>Sizes:</strong> 5.5" × 8.5" | 4" × 6" | 4" × 9" | 6" × 9" | 6" × 11"</p>
            </div>

            <div>
              <h3 class="text-xl font-display text-crst-primary mb-3">Envelopes</h3>
              <p class="text-navy-600/80 leading-relaxed mb-2">
                Union-printed envelopes for campaign letters, fundraising appeals, and official correspondence. Custom return address printing with organization branding and union bug. Standard #10 envelopes and other sizes available. See our full <a href="/guides/envelope-sizes" class="text-crst-accent hover:underline">envelope sizes reference</a> for specifications.
              </p>
              <p class="text-sm text-navy-600/60"><strong>Standard size:</strong> <a href="/shop/up-envelope" class="text-crst-accent hover:underline">#10 Regular Envelope</a> (4⅛" × 9½")</p>
            </div>

            <div>
              <h3 class="text-xl font-display text-crst-primary mb-3">Brochures and Self-Mailers</h3>
              <p class="text-navy-600/80 leading-relaxed mb-2">
                We produce union-printed brochures and self-mailers in standard direct mail sizes. All pieces meet USPS&reg; automation standards and include the union bug as required. Brochures are commonly used for campaign literature, organizational overviews, and voter guides.
              </p>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-3 mb-6">
            {[
              'Political campaign postcards and palm cards',
              'Campaign literature and brochures',
              'Fundraising letters and appeal envelopes',
              'Caucus and electoral notification cards',
              'Labor union newsletters and flyers',
              'Government notification letters',
              'Municipal meeting notices',
              'Committee and organization stationery',
            ].map((item) => (
              <div class="flex items-start gap-3 p-3 bg-navy-50/40 rounded-lg">
                <svg class="w-4 h-4 text-crst-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span class="text-sm text-navy-700">{item}</span>
              </div>
            ))}
          </div>

          <div class="section-divider mb-6 mt-14"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">The Union Bug — What It Means and Where It Goes</h2>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            The union bug is a small printed mark — typically a logo or emblem — that identifies the labor union whose members produced the printed piece. It certifies that the work was performed under fair labor conditions in a union-affiliated shop. The bug is usually placed in a bottom corner of the printed piece, though placement can vary depending on the design and the union's guidelines.
          </p>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            At CRST, union bug placement is handled automatically during production. When you order union printing, the bug is included in the final design file before press. You do not need to supply artwork for the bug or specify its location — our production team places it in the standard position according to CWA printing regulations. If your organization or campaign has a specific placement preference, we accommodate that as well.
          </p>

          <div class="section-divider mb-6 mt-14"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">Who Uses Union Printing?</h2>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            <strong>Political campaigns.</strong> Candidates running for local, county, and state office in the Hudson Valley frequently require union-printed materials to maintain labor endorsements. In labor-heavy districts, mailing without the union bug can cost a campaign union support. CRST handles <a href="/services/direct-mail" class="text-crst-accent hover:underline">political direct mail</a> from voter data targeting through postal delivery — all union-printed.
          </p>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            <strong>Labor organizations.</strong> Unions, trade councils, and worker advocacy groups use union-printed materials for member communications, organizing campaigns, meeting notices, and legislative action alerts. The union bug on these materials signals solidarity and consistency with the organization's mission.
          </p>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            <strong>Municipalities and government agencies.</strong> Town boards, county legislatures, and government offices that operate under labor agreements or serve union-represented workforces often specify union printing for public notices, budget documents, and community mailings.
          </p>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            <strong>Nonprofits and civic organizations.</strong> Nonprofits with union affiliations or those seeking labor endorsements use union-printed fundraising appeals, event invitations, and newsletters to demonstrate alignment with organized labor values.
          </p>

          <div class="section-divider mb-6 mt-14"></div>
          <h2 class="text-2xl font-display text-crst-primary mb-3">Recent Campaigns</h2>
          <p class="text-navy-600/80 leading-relaxed mb-6">A recent example of union-printed direct mail work from our facility:</p>
          <div class="mb-4">
            <CaseStudyCallout
              href="/case-studies/republican-town-committee"
              client="Hudson Valley Republican Town Committee"
              summary="A contested local election required union-printed palm cards and full slate mailers produced and delivered within a 3-week window. All pieces carried the Allied Printing Trades Council label, satisfying party labor requirements."
              anchor="union-printed political palm cards and slate mailers"
            />
          </div>

          <div class="section-divider mb-6 mt-14"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-6">Frequently Asked Questions</h2>
          <div class="space-y-6">
            {faqs.map((item) => (
              <div class="bg-navy-50/40 rounded-xl border border-navy-100 p-5">
                <h3 class="font-heading font-semibold text-navy-800 text-sm mb-2">{item.q}</h3>
                <p class="text-sm text-navy-600/70 leading-relaxed">{item.a}</p>
              </div>
            ))}
          </div>

          <div class="bg-crst-primary/5 border border-crst-primary/15 rounded-xl p-6 text-center mt-10">
            <p class="font-heading font-bold text-crst-primary text-lg mb-2">Request a Union Printing Quote</p>
            <p class="text-navy-600/70 text-sm mb-4">Tell us what you need — piece type, quantity, and whether you need mailing services — and we'll confirm union bug availability and pricing.</p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
              <a href="/estimate" class="btn-primary text-sm">Request a Quote</a>
              <a href={`tel:${BUSINESS.phoneClean}`} class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-crst-primary hover:text-crst-accent transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Call {BUSINESS.phone}
              </a>
            </div>
          </div>
        </div>

        <aside class="lg:col-span-1">
          <div class="sticky top-28 space-y-6">
            <div class="bg-crst-primary rounded-xl p-6 text-white">
              <h3 class="font-display text-lg mb-2">Union Printing Quote</h3>
              <p class="text-white/60 text-sm leading-relaxed mb-4">
                Request a union printing quote — we'll provide pricing for your specific job.
              </p>
              <a href="/estimate" class="btn-accent w-full text-center text-sm">
                Request Quote
              </a>
              <div class="mt-4 pt-4 border-t border-white/10 text-center">
                <a href={`tel:${BUSINESS.phoneClean}`} class="text-white/70 text-sm font-heading hover:text-white transition-colors">
                  or call {BUSINESS.phone}
                </a>
              </div>
            </div>

            <div class="bg-navy-50/50 rounded-xl p-5 border border-navy-100">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-3">Related Services</h3>
              <div class="space-y-2">
                {[
                  { label: 'EDDM', href: '/services/eddm' },
                  { label: 'Non-Profit Mailing', href: '/services/non-profit-mailing' },
                  { label: 'Political Mailers', href: '/services/direct-mail' },
                  { label: 'Direct Mail', href: '/services/direct-mail' },
                  { label: 'Printing Services', href: '/services/printing' },
                ].map((link) => (
                  <a href={link.href} class="flex items-center justify-between px-3 py-2 text-sm text-navy-700 hover:text-crst-primary hover:bg-white rounded-md transition-colors font-heading">
                    {link.label}
                    <svg class="w-3.5 h-3.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </div>

            <div class="bg-navy-50/50 rounded-xl p-5 border border-navy-100">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-3">Service Areas</h3>
              <div class="space-y-2">
                {Object.values(COUNTIES).map((county) => (
                  <a href={`/service-areas/${county.slug}`} class="flex items-center justify-between px-3 py-2 text-sm text-navy-700 hover:text-crst-primary hover:bg-white rounded-md transition-colors font-heading">
                    {county.name}
                    <svg class="w-3.5 h-3.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-display font-bold text-crst-primary mb-3">Union Printing Guides</h2>
        <p class="text-navy-600/70 max-w-2xl mx-auto">In-depth guides on what the union bug is, why to choose a union print shop, and union printing for political campaigns in the Hudson Valley — written by Sean Griffin, owner of Cornerstone Services since 1998.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {clusterArticles.map((a) => (
          <a href={`/services/union-printing/${a.slug}`} class="block p-5 bg-navy-50/40 rounded-xl border border-navy-100 hover:border-crst-primary/30 hover:shadow-sm transition-all group">
            <h3 class="font-heading font-semibold text-navy-800 text-sm group-hover:text-crst-primary transition-colors leading-snug mb-2">{a.data.title}</h3>
            <p class="text-xs text-navy-600/60 line-clamp-2 leading-relaxed">{a.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    headline="Need Union-Printed Materials?"
    text="Get a free estimate for your next political campaign, labor organization, or government mailing."
  />
</BaseLayout>
