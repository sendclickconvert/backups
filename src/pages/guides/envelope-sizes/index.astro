---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EnvelopeHubNav from '../../../components/guides/EnvelopeHubNav.astro';
import CTASection from '../../../components/CTASection.astro';
import AuthorByline from '../../../components/AuthorByline.astro';
import { BUSINESS } from '../../../data/site';
import { HUB_NAV_ITEMS, ENVELOPE_SPOKES } from '../../../data/envelope-spokes';

const canonical = 'https://crst.net/guides/envelope-sizes';
const title = 'Envelope Sizes Chart: All Standard Sizes (2026 Guide)';
const description = 'Every standard envelope size with exact dimensions, USPS rates, and use cases. Compare #10, A-series, 6×9, 9×12, legal, and window envelopes in one chart.';
const lastUpdated = '2026-05-04';

const seanGriffin = {
  '@type': 'Person',
  '@id': 'https://crst.net/about#sean-griffin',
  name: 'Sean Griffin',
  jobTitle: 'Owner & Mailpiece Design Professional',
  description: 'Sean Griffin founded Cornerstone Services in 1998. He holds the USPS Mailpiece Design Professional (MDP) certification and has managed direct mail, printing, and mailing campaigns for businesses across Ulster, Dutchess, and Orange counties for over 28 years.',
  url: 'https://crst.net/about',
  image: 'https://crst.net/images/sean-griffin.png',
  sameAs: ['https://crst.net/about'],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    name: 'Mailpiece Design Professional (MDP)',
    credentialCategory: 'Professional Certification',
    recognizedBy: { '@type': 'Organization', name: 'United States Postal Service' },
  },
  worksFor: {
    '@type': 'Organization',
    '@id': 'https://crst.net/#organization',
    name: 'Cornerstone Services, Inc.',
    url: 'https://crst.net',
    telephone: '+1-845-255-5722',
    foundingDate: '1998',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '31 S Ohioville Rd',
      addressLocality: 'New Paltz',
      addressRegion: 'NY',
      postalCode: '12561',
      addressCountry: 'US',
    },
  },
};

const hubFaqs = [
  { q: 'What is the standard size for a business envelope?', a: 'The #10 envelope (4.125" × 9.5") is the standard business envelope in the United States. It\'s used for letters, invoices, statements, and most general business correspondence. See our <a href="/guides/envelope-sizes/no-10">#10 envelope page</a> for the full breakdown.' },
  { q: "What's the difference between a letter and a large envelope?", a: 'USPS classifies any envelope at or under 6.125" high × 11.5" long × 0.25" thick as a letter, with First-Class postage starting at $0.82. Anything larger — including 9×12 and 10×13 — is a flat (also called a large envelope), with postage starting at $1.63 for the first ounce.' },
  { q: 'What is the smallest envelope you can mail?', a: 'The minimum mailable envelope size is 3.5" high × 5" long × 0.007" thick. Anything smaller is not accepted by USPS.' },
  { q: 'What is the largest first-class letter envelope?', a: 'The maximum letter-rate envelope is 6.125" high × 11.5" long × 0.25" thick, weighing no more than 3.5 oz. Beyond any of those limits, the piece is rated as a flat.' },
  { q: 'Why is a square envelope more expensive to mail?', a: 'A square envelope has an aspect ratio of 1.0, which falls outside the USPS machinable range of 1.3 to 2.5. That makes it nonmachinable and triggers a surcharge on top of the standard letter rate. If postage cost matters, choose a rectangular envelope.' },
  { q: 'What postage do I need for a 9×12 envelope?', a: 'A 9×12 envelope is a flat. First-Class postage starts at $1.63 for the first ounce in 2026, with $0.20 added per additional ounce. The piece must be flexible and no thicker than 0.75". The full breakdown is on our <a href="/guides/envelope-sizes/9x12">9×12 envelope page</a>.' },
  { q: 'How do I choose between an A7 and a #10 for an invitation mailing?', a: 'A7 envelopes (5.25" × 7.25") fit standard card-size invitations and announcements without folding. #10 envelopes are designed for trifolded 8.5×11" letters. For invitations, the A-series is the correct choice; for letters with reply slips and inserts, the #10 is standard.' },
  { q: 'Are there USPS rules about envelope thickness?', a: 'Yes. Letter-size pieces must be no more than 0.25" thick. They must also be flexible — bending easily without breaking — and uniformly thick. Coins, keys, and similar contents cause uneven thickness and disqualify the piece from machine processing.' },
];

const graphItems: object[] = [
  {
    '@type': 'Article',
    headline: title,
    description,
    url: canonical,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    datePublished: lastUpdated,
    dateModified: lastUpdated,
    inLanguage: 'en-US',
    author: seanGriffin,
    publisher: {
      '@type': 'Organization',
      '@id': 'https://crst.net/#organization',
      name: 'Cornerstone Services, Inc.',
      url: 'https://crst.net',
      logo: { '@type': 'ImageObject', url: 'https://crst.net/images/crst-logo.png', width: 200, height: 60 },
    },
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.article-lead', '.prose h2'] },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://crst.net' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://crst.net/guides' },
      { '@type': 'ListItem', position: 3, name: 'Envelope Sizes', item: canonical },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: hubFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const comparisonRows = [
  { name: '#9', inches: '3⅞ × 8⅞"', mm: '98.4 × 225.4', postage: 'Letter', use: 'Reply / BRE envelope', slug: 'no-9' },
  { name: '#10', inches: '4⅛ × 9½"', mm: '104.8 × 241.3', postage: 'Letter', use: 'Standard business envelope', slug: 'no-10' },
  { name: 'A6', inches: '4¾ × 6½"', mm: '120.7 × 165.1', postage: 'Letter', use: 'Invitations, greeting cards', slug: 'a6' },
  { name: 'A7', inches: '5¼ × 7¼"', mm: '133.4 × 184.2', postage: 'Letter', use: '5×7 invitations, photos', slug: 'a7' },
  { name: 'A9', inches: '5¾ × 8¾"', mm: '146.0 × 222.3', postage: 'Letter', use: 'Oversized invitations', slug: 'a9' },
  { name: 'A10', inches: '6 × 9½"', mm: '152.4 × 241.3', postage: 'Letter or Flat*', use: 'Large cards — verify orientation', slug: 'a10' },
  { name: '6×9', inches: '6 × 9"', mm: '152.4 × 228.6', postage: 'Flat', use: 'Newsletters, catalogs', slug: '6x9' },
  { name: '9×12', inches: '9 × 12"', mm: '228.6 × 304.8', postage: 'Flat', use: 'Unfolded 8.5×11 documents', slug: '9x12' },
  { name: 'Legal (#14)', inches: '5 × 11.5"', mm: '127 × 292.1', postage: 'Letter', use: 'Legal-size document mailing', slug: 'legal' },
  { name: 'Window #10', inches: '4⅛ × 9½"', mm: '104.8 × 241.3', postage: 'Letter', use: 'Bills, statements, invoices', slug: 'window' },
];
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graphItems })} />
  </Fragment>

  <!-- Hero -->
  <section class="bg-crst-primary text-white py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-white/50 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white/80 transition-colors">Home</a><span class="mx-2">›</span>
        <a href="/guides" class="hover:text-white/80 transition-colors">Guides</a><span class="mx-2">›</span>
        <span class="text-white/70">Envelope Sizes</span>
      </nav>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold leading-tight text-white mb-4">
        Envelope Sizes Chart: All Standard Sizes
      </h1>
      <p class="article-lead text-white/70 text-lg max-w-2xl leading-relaxed">
        Every standard envelope size — dimensions in inches and mm, USPS postage class, weight limits, and use cases — in one reference guide. Written by Sean Griffin, MDP, owner of Cornerstone Services since 1998.
      </p>
    </div>
  </section>

  <section class="py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">

        <!-- Main content -->
        <div class="lg:col-span-2">

          <!-- RETRIEVAL_PARAGRAPH:start -->
          <div class="bg-navy-50/60 border border-navy-100 rounded-xl p-5 mb-8 text-navy-700 leading-relaxed">
            Standard envelope sizes range from the #10 business envelope (4.125" × 9.5") used for letters and invoices to large flats like 9×12 used for unfolded documents. USPS classifies envelopes as either letters (up to 6.125" × 11.5" × 0.25" thick, weighing no more than 3.5 oz) or flats. First-Class letter postage starts at $0.82 in 2026; large envelope postage starts at $1.63. The right size depends on contents, postage class, and automation eligibility.
          </div>
          <!-- RETRIEVAL_PARAGRAPH:end -->

          <!-- Master comparison table -->
          <h2 class="text-2xl font-display font-bold text-crst-primary mb-4">Standard Envelope Sizes at a Glance</h2>
          <div class="overflow-x-auto rounded-xl border border-navy-100 mb-10">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-crst-primary text-white">
                  <th class="px-4 py-3 text-left font-heading font-semibold">Size</th>
                  <th class="px-4 py-3 text-left font-heading font-semibold">Inches</th>
                  <th class="px-4 py-3 text-left font-heading font-semibold hidden sm:table-cell">mm</th>
                  <th class="px-4 py-3 text-left font-heading font-semibold">Postage</th>
                  <th class="px-4 py-3 text-left font-heading font-semibold hidden md:table-cell">Common Use</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-navy-100">
                {comparisonRows.map((row, i) => (
                  <tr class={`hover:bg-navy-50/40 transition-colors ${i % 2 === 0 ? 'bg-white' : 'bg-navy-50/20'}`}>
                    <td class="px-4 py-3">
                      <a href={`/guides/envelope-sizes/${row.slug}`} class="font-heading font-semibold text-crst-accent hover:text-crst-primary transition-colors hover:underline">
                        {row.name}
                      </a>
                    </td>
                    <td class="px-4 py-3 font-mono text-xs text-navy-600">{row.inches}</td>
                    <td class="px-4 py-3 font-mono text-xs text-navy-600 hidden sm:table-cell">{row.mm}</td>
                    <td class="px-4 py-3">
                      <span class={`inline-flex px-2 py-0.5 rounded text-xs font-heading font-semibold ${row.postage === 'Letter' ? 'bg-green-100 text-green-800' : row.postage === 'Flat' ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800'}`}>
                        {row.postage}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-navy-600/80 text-xs hidden md:table-cell">{row.use}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-xs text-navy-600/50 -mt-8 mb-10">* A10 postage class depends on mailing orientation — verify with Cornerstone before ordering.</p>

          <div class="prose prose-navy max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent hover:prose-a:text-crst-primary prose-strong:text-navy-800 prose-p:text-navy-600/80 prose-li:text-navy-600/80">

            <h2>Why envelope size matters</h2>
            <p>Envelope size determines three things on every mailing: which postage class applies, whether the piece qualifies for automation discounts, and whether the contents fit without folding. Get any of them wrong and the cost shows up either at the post office or weeks later — wrinkled inserts, surcharged pieces, or returns.</p>
            <p>This page is the comparison reference we use at Cornerstone Services when setting up direct mail and printing jobs. Every standard envelope size is listed below with exact dimensions in inches and millimeters, the postage class it falls under, and what it's typically used for. Each entry links to a deeper page with paper weights, window options, USPS rules, and design specs for that specific size.</p>
            <p>If you already know the size you need, jump to it from the comparison table. If you're not sure, the next section covers the three questions that decide it.</p>

            <h2>How to choose the right envelope size</h2>
            <p>Three questions decide it:</p>

            <h3>1. What's going inside?</h3>
            <p>A single trifolded 8.5×11" letter fits a #10. A flat 8.5×11" page that has to stay unfolded needs a 9×12 or larger. Wedding invitations and announcements use the A-series (A6, A7, A9) because the proportions match standard card sizes. Match the contents to the envelope, not the other way around.</p>

            <h3>2. Letter rate or flat rate?</h3>
            <p>USPS classifies any envelope at or under 6.125" × 11.5" and 0.25" thick as a letter. Anything larger is a flat — and flat-rate postage starts at $1.63 versus $0.82 for a letter. For most direct mail, staying inside the letter envelope is the cheaper play. For documents that can't fold, the flat rate is unavoidable.</p>

            <h3>3. Will the piece qualify for automation discounts?</h3>
            <p>Bulk and presort discounts require the envelope to be machinable: rectangular, flexible, no clasps or strings, and within the 1.3-to-2.5 aspect ratio (length divided by height). A square envelope has an aspect ratio of 1.0 and is automatically nonmachinable — the surcharge adds up fast on a 5,000-piece campaign. The full rules are in the next section.</p>
            <p>Once those three are answered, the size choice is usually narrow. The comparison table above shows every standard option side by side.</p>

            <h2>USPS rules for letter-size envelopes</h2>
            <p>Every letter-size envelope has to clear a short list of physical standards before it qualifies for First-Class or Marketing Mail rates. These come from the USPS Domestic Mail Manual (DMM 201) and apply nationwide:</p>
            <ul>
              <li><strong>Minimum dimensions:</strong> 3.5" high × 5" long × 0.007" thick. Anything smaller is not accepted for mailing.</li>
              <li><strong>Maximum dimensions:</strong> 6.125" high × 11.5" long × 0.25" thick. Beyond any of these, the piece is rated as a flat.</li>
              <li><strong>Aspect ratio:</strong> length divided by height must fall between 1.3 and 2.5. A square envelope falls outside this range and is nonmachinable by rule.</li>
              <li><strong>Maximum weight:</strong> 3.5 oz for First-Class letters. Heavier pieces are rated as flats.</li>
              <li><strong>Shape:</strong> rectangular, with four square corners and parallel opposite sides.</li>
              <li><strong>Construction:</strong> flexible, uniformly thick, no clasps, strings, buttons, or rigid contents that create uneven thickness.</li>
            </ul>
            <p>Pieces that meet every standard above qualify for machinable letter rates. Pieces that fail one or more criteria are still mailable in most cases but are charged the nonmachinable surcharge.</p>

            <h3>2026 First-Class postage rates</h3>
            <p>USPS implemented a rate change effective July 12, 2026. The following rates are now in effect.</p>
            <ul>
              <li>1-oz letter, Forever stamp: <strong>$0.82</strong></li>
              <li>1-oz letter, metered postage: <strong>$0.78</strong></li>
              <li>Each additional ounce, up to 3.5 oz: <strong>$0.29</strong></li>
              <li>Postcard: <strong>$0.65</strong></li>
              <li>Large envelope (flat), 1 oz: <strong>$1.63</strong></li>
              <li>Each additional flat ounce: <strong>$0.20</strong></li>
            </ul>
            <p>Metered postage saves $0.04 per piece versus stamps — small per piece, meaningful at volume. Presort and automation discounts take per-piece costs significantly lower than retail rates; we cover those on our <a href="/services/direct-mail">direct mail services page</a>.</p>
            <p class="text-sm text-navy-600/50 not-italic"><em>Last verified: July 2026. Source: USPS Domestic Mail Manual 201; USPS rate announcements.</em></p>

          </div>

          <div class="not-prose mt-8">
            <AuthorByline />
          </div>

          <!-- FAQ_BLOCK:start -->
          <div class="mt-12">
            <div class="section-divider mb-6"></div>
            <h2 class="text-2xl font-display text-crst-primary mb-6">Frequently Asked Questions</h2>
            <div class="space-y-4">
              {hubFaqs.map((item) => (
                <div class="bg-navy-50/40 rounded-xl border border-navy-100 p-5">
                  <h3 class="font-heading font-semibold text-navy-800 text-sm mb-2">{item.q}</h3>
                  <p class="text-sm text-navy-600/70 leading-relaxed" set:html={item.a} />
                </div>
              ))}
            </div>
          </div>
          <!-- FAQ_BLOCK:end -->

          <!-- CTA bar -->
          <div class="bg-crst-primary/5 border border-crst-primary/15 rounded-xl p-6 text-center mt-10">
            <p class="font-heading font-bold text-crst-primary text-lg mb-2">Not sure which envelope is right for your campaign?</p>
            <p class="text-navy-600/70 text-sm mb-4">We help Hudson Valley businesses choose the right format — then print, address, and mail it. One facility, one team, one turnaround commitment.</p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
              <a href="/estimate" class="btn-primary text-sm">Get a Free Estimate →</a>
              <a href={`tel:${BUSINESS.phoneClean}`} class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-crst-primary hover:text-crst-accent transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Call {BUSINESS.phone}
              </a>
            </div>
          </div>

          <!-- Spoke grid -->
          <div class="mt-14">
            <div class="section-divider mb-6"></div>
            <h2 class="text-xl font-display text-crst-primary mb-2">Detailed Guides by Envelope Size</h2>
            <p class="text-navy-600/70 text-sm mb-6">Each guide covers dimensions in inches and mm, USPS postage class, weight limits, and specific use cases.</p>
            <div class="grid sm:grid-cols-2 gap-4">
              {HUB_NAV_ITEMS.map((item) => {
                const spoke = ENVELOPE_SPOKES[item.slug];
                return (
                  <a href={`/guides/envelope-sizes/${item.slug}`} class="block p-4 bg-navy-50/40 rounded-xl border border-navy-100 hover:border-crst-primary/30 hover:shadow-sm transition-all group">
                    <h3 class="font-heading font-semibold text-navy-800 text-sm group-hover:text-crst-primary transition-colors leading-snug mb-1">{spoke.title}</h3>
                    <p class="text-xs text-navy-600/60 font-mono">{spoke.dimensionsInches} · {spoke.postageClass.split('/')[0].trim()}</p>
                  </a>
                );
              })}
            </div>
          </div>

        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-1">
          <div class="sticky top-28 space-y-6">
            <div class="bg-crst-primary rounded-xl p-6 text-white">
              <h3 class="font-display text-lg mb-2">Get a Print & Mail Quote</h3>
              <p class="text-white/60 text-sm leading-relaxed mb-4">Tell us your format, quantity, and in-home date. We'll send a detailed quote within one business day.</p>
              <a href="/estimate" class="btn-accent w-full text-center text-sm">Request a Quote</a>
              <div class="mt-4 pt-4 border-t border-white/10 text-center">
                <a href={`tel:${BUSINESS.phoneClean}`} class="text-white/70 text-sm font-heading hover:text-white transition-colors">or call {BUSINESS.phone}</a>
              </div>
            </div>

            <EnvelopeHubNav />

            <div class="bg-navy-50/50 rounded-xl p-5 border border-navy-100">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-3">Related Resources</h3>
              <div class="space-y-2">
                {[
                  { label: 'USPS Postage Rates', href: '/direct-mail-tools/postage-rates' },
                  { label: 'Direct Mail Services', href: '/services/direct-mail' },
                  { label: 'Printing Services', href: '/services/printing' },
                  { label: 'USPS Min/Max Rules', href: '/guides/envelope-sizes/usps-minimum-maximum' },
                  { label: 'Mailing Services', href: '/services/mailing' },
                ].map((link) => (
                  <a href={link.href} class="flex items-center justify-between px-3 py-2 text-sm text-navy-700 hover:text-crst-primary hover:bg-white rounded-md transition-colors font-heading">
                    {link.label}
                    <svg class="w-3.5 h-3.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
