---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { storefrontFetch, ALL_PRODUCTS_QUERY } from '../../lib/shopify';

interface ProductNode {
  title: string;
  handle: string;
  featuredImage: { url: string; altText: string | null } | null;
  priceRange: { minVariantPrice: { amount: string; currencyCode: string } };
  availableForSale: boolean;
}

const token: string | undefined = import.meta.env.SHOPIFY_STOREFRONT_TOKEN ?? process.env.SHOPIFY_STOREFRONT_TOKEN;
let products: ProductNode[] = [];
let fetchError = '';

if (!token) {
  fetchError = 'Store not configured. Set SHOPIFY_STOREFRONT_TOKEN.';
} else {
  try {
    const data = await storefrontFetch<{ products: { edges: { node: ProductNode }[] } }>(
      ALL_PRODUCTS_QUERY,
      {},
      token
    );
    products = data.products.edges.map(e => e.node);
  } catch (err) {
    fetchError = 'Failed to load products from Shopify.';
  }
}

const GRID_PLACEHOLDERS: Record<string, string> = {
  'plastic-postcard': '/images/shop/plastic-postcard-placeholder.png',
  'magnet-postcard':  '/images/shop/magnet-postcard-placeholder.png',
};

function formatPrice(amount: string, currency: string) {
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency,
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  }).format(parseFloat(amount));
}
---

<BaseLayout
  title="Shop — Print & Mail Products | Cornerstone Services"
  description="Order direct mail products online from Cornerstone Services. Postcards, letters, and specialty print — choose your options and go straight to checkout."
  schema={null}
>
  <div class="min-h-[70vh] bg-gray-50 py-14">
    <div class="container-wide max-w-5xl">

      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-sm font-heading text-navy-400">
          <li><a href="/" class="hover:text-crst-primary transition-colors">Home</a></li>
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
            <span class="text-navy-600">Shop</span>
          </li>
        </ol>
      </nav>

      <div class="mb-10">
        <h1 class="text-3xl sm:text-4xl font-display text-crst-primary mb-2">Print & Mail Products</h1>
        <p class="text-navy-600/70 text-lg">Choose your product, configure your options, and go straight to checkout.</p>
      </div>

      {fetchError ? (
        <div class="bg-red-50 border border-red-200 text-red-700 px-6 py-4 rounded-xl font-heading text-sm">
          <strong>Error:</strong> {fetchError}
        </div>
      ) : products.length === 0 ? (
        <div class="bg-navy-50 border border-navy-100 text-navy-500 px-6 py-8 rounded-xl font-heading text-sm text-center">
          No products available yet. Check back soon.
        </div>
      ) : (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {products.map(product => (
            <a
              href={`/shop/${product.handle}`}
              class="group bg-white rounded-2xl border border-navy-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col"
            >
              <div class="aspect-[4/3] bg-navy-50 overflow-hidden">
                {product.featuredImage ? (
                  <img
                    src={product.featuredImage.url}
                    alt={product.featuredImage.altText ?? product.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                ) : GRID_PLACEHOLDERS[product.handle] ? (
                  <img
                    src={GRID_PLACEHOLDERS[product.handle]}
                    alt={product.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center">
                    <svg class="w-12 h-12 text-navy-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                  </div>
                )}
              </div>
              <div class="p-5 flex flex-col flex-1">
                <h2 class="font-display text-navy-800 text-lg leading-snug mb-1 group-hover:text-crst-primary transition-colors">
                  {product.title}
                </h2>
                <p class="text-sm text-navy-500 font-heading mt-auto pt-3">
                  {product.availableForSale ? (
                    <>from <span class="font-semibold text-crst-primary">{formatPrice(product.priceRange.minVariantPrice.amount, product.priceRange.minVariantPrice.currencyCode)}</span></>
                  ) : (
                    <span class="text-navy-400">Currently unavailable</span>
                  )}
                </p>
              </div>
            </a>
          ))}
        </div>
      )}

    </div>
  </div>
</BaseLayout>
