---
import { GHL } from '../data/site';
---

<form id="estimate-form" class="space-y-5" novalidate>
  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label for="firstName" class="block text-sm font-heading font-medium text-navy-700 mb-1.5">First Name *</label>
      <input
        type="text"
        id="firstName"
        name="firstName"
        required
        class="w-full px-4 py-2.5 text-sm rounded-lg border border-navy-200 
               focus:border-crst-accent focus:ring-2 focus:ring-crst-accent/20 
               outline-none transition-all font-body placeholder:text-navy-400"
        placeholder="John"
      />
    </div>
    <div>
      <label for="lastName" class="block text-sm font-heading font-medium text-navy-700 mb-1.5">Last Name *</label>
      <input
        type="text"
        id="lastName"
        name="lastName"
        required
        class="w-full px-4 py-2.5 text-sm rounded-lg border border-navy-200 
               focus:border-crst-accent focus:ring-2 focus:ring-crst-accent/20 
               outline-none transition-all font-body placeholder:text-navy-400"
        placeholder="Smith"
      />
    </div>
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label for="email" class="block text-sm font-heading font-medium text-navy-700 mb-1.5">Email *</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="w-full px-4 py-2.5 text-sm rounded-lg border border-navy-200 
               focus:border-crst-accent focus:ring-2 focus:ring-crst-accent/20 
               outline-none transition-all font-body placeholder:text-navy-400"
        placeholder="john@company.com"
      />
    </div>
    <div>
      <label for="phone" class="block text-sm font-heading font-medium text-navy-700 mb-1.5">Phone</label>
      <input
        type="tel"
        id="phone"
        name="phone"
        class="w-full px-4 py-2.5 text-sm rounded-lg border border-navy-200 
               focus:border-crst-accent focus:ring-2 focus:ring-crst-accent/20 
               outline-none transition-all font-body placeholder:text-navy-400"
        placeholder="(845) 555-0100"
      />
    </div>
  </div>

  <div>
    <label for="company" class="block text-sm font-heading font-medium text-navy-700 mb-1.5">Company / Organization</label>
    <input
      type="text"
      id="company"
      name="company"
      class="w-full px-4 py-2.5 text-sm rounded-lg border border-navy-200 
             focus:border-crst-accent focus:ring-2 focus:ring-crst-accent/20 
             outline-none transition-all font-body placeholder:text-navy-400"
      placeholder="Acme Corp"
    />
  </div>

  <div>
    <label for="message" class="block text-sm font-heading font-medium text-navy-700 mb-1.5">Tell us about your project *</label>
    <textarea
      id="message"
      name="message"
      required
      rows="4"
      class="w-full px-4 py-2.5 text-sm rounded-lg border border-navy-200 
             focus:border-crst-accent focus:ring-2 focus:ring-crst-accent/20 
             outline-none transition-all font-body placeholder:text-navy-400 resize-y"
      placeholder="Describe your mailing project — quantity, mail piece type, target area, timeline, etc."
    ></textarea>
  </div>

  <!-- Attribution (hidden) -->
  <input type="hidden" name="utm_source" id="utm_source" />
  <input type="hidden" name="utm_medium" id="utm_medium" />
  <input type="hidden" name="utm_campaign" id="utm_campaign" />
  <input type="hidden" name="utm_term" id="utm_term" />
  <input type="hidden" name="utm_content" id="utm_content" />
  <input type="hidden" name="referrer" id="referrer" />
  <input type="hidden" name="landing_page" id="landing_page" />
  <input type="hidden" name="page_url" id="page_url" />

  <!-- Honeypot -->
  <div class="hidden" aria-hidden="true">
    <input type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <button
    type="submit"
    class="btn-primary w-full sm:w-auto text-sm px-8 py-3"
    id="estimate-submit"
  >
    <span id="submit-text">Get Free Estimate</span>
    <svg id="submit-spinner" class="hidden w-4 h-4 ml-2 animate-spin" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
  </button>

  <!-- Status messages -->
  <div id="form-success" class="hidden p-4 bg-green-50 border border-green-200 rounded-lg text-sm text-green-800 font-heading">
    <strong>Thank you!</strong> We've received your request and will be in touch within one business day.
  </div>
  <div id="form-error" class="hidden p-4 bg-red-50 border border-red-200 rounded-lg text-sm text-red-800 font-heading">
    Something went wrong. Please call us at <a href="tel:8453936770" class="underline font-semibold">(845) 255-5722</a> or email <a href="mailto:info@crst.net" class="underline font-semibold">info@crst.net</a>.
  </div>
</form>

<script define:vars={{ webhookUrl: GHL.webhookUrl }}>
  const form = document.getElementById('estimate-form');
  const submitBtn = document.getElementById('estimate-submit');
  const submitText = document.getElementById('submit-text');
  const spinner = document.getElementById('submit-spinner');
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');

  function ssGet(key) { try { return sessionStorage.getItem(key); } catch(e) { return null; } }
  function ssSet(key, val) { try { sessionStorage.setItem(key, val); } catch(e) {} }

  function populateAttribution() {
    const params = new URLSearchParams(window.location.search);
    const utmFields = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
    utmFields.forEach(function(field) {
      var el = document.getElementById(field);
      if (el) {
        var stored = ssGet(field);
        var param = params.get(field);
        if (param) {
          el.value = param;
          ssSet(field, param);
        } else if (stored) {
          el.value = stored;
        }
      }
    });

    var refEl = document.getElementById('referrer');
    if (refEl) {
      var storedRef = ssGet('crst_referrer');
      if (storedRef) {
        refEl.value = storedRef;
      } else if (document.referrer && !document.referrer.includes(window.location.hostname)) {
        refEl.value = document.referrer;
        ssSet('crst_referrer', document.referrer);
      }
    }

    var landingEl = document.getElementById('landing_page');
    if (landingEl) {
      var storedLanding = ssGet('crst_landing_page');
      if (storedLanding) {
        landingEl.value = storedLanding;
      } else {
        var lp = window.location.origin + window.location.pathname;
        landingEl.value = lp;
        ssSet('crst_landing_page', lp);
      }
    }

    var pageEl = document.getElementById('page_url');
    if (pageEl) {
      pageEl.value = window.location.href;
    }
  }

  populateAttribution();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const honeypot = form.querySelector('input[name="website"]');
    if (honeypot && honeypot.value) return;

    submitBtn.disabled = true;
    submitText.textContent = 'Sending...';
    spinner.classList.remove('hidden');
    successMsg.classList.add('hidden');
    errorMsg.classList.add('hidden');

    populateAttribution();

    const formData = new FormData(form);
    const payload = {
      firstName: formData.get('firstName'),
      lastName: formData.get('lastName'),
      email: formData.get('email'),
      phone: formData.get('phone') || '',
      company: formData.get('company') || '',
      message: formData.get('message'),
      source: 'website',
      utm_source: formData.get('utm_source') || '',
      utm_medium: formData.get('utm_medium') || '',
      utm_campaign: formData.get('utm_campaign') || '',
      utm_term: formData.get('utm_term') || '',
      utm_content: formData.get('utm_content') || '',
      referrer: formData.get('referrer') || '',
      landing_page: formData.get('landing_page') || '',
      page_url: formData.get('page_url') || '',
    };

    try {
      const response = await fetch(webhookUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (response.ok) {
        successMsg.classList.remove('hidden');
        form.reset();
      } else {
        throw new Error('Webhook failed');
      }
    } catch (err) {
      errorMsg.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitText.textContent = 'Get Free Estimate';
      spinner.classList.add('hidden');
    }
  });
</script>
