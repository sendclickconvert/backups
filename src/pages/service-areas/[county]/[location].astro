---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTASection from '../../../components/CTASection.astro';
import AuthorByline from '../../../components/AuthorByline.astro';
import EstimateForm from '../../../components/EstimateForm.astro';
import { BUSINESS, SERVICES } from '../../../data/site';
import { COUNTIES_DATA, getAllLocations } from '../../../data/locations';
import type { Location, County } from '../../../data/locations';

export function getStaticPaths() {
  const paths: { params: { county: string; location: string }; props: { location: Location; county: County } }[] = [];

  COUNTIES_DATA.forEach((county) => {
    county.locations.forEach((location) => {
      paths.push({
        params: { county: county.slug, location: location.slug },
        props: { location, county },
      });
    });
  });

  return paths;
}

const { location, county } = Astro.props as { location: Location; county: County };

// Get nearby locations (same county, different location)
const nearbyLocations = county.locations
  .filter(l => l.slug !== location.slug)
  .slice(0, 8);

const title = `Direct Mail Services in ${location.name}, ${county.name}`;
const description = `Professional direct mail, printing, and mailing services in ${location.name}, NY. ZIP ${location.zip.join(', ')} — EDDM, data lists, commercial printing. Free estimates from ${BUSINESS.name}.`;

// FAQPage schema
const faqSchema = location.faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: location.faqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
} : null;

const townSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: `Cornerstone Services — Direct Mail ${location.name} NY`,
  url: `https://crst.net/service-areas/${county.slug}/${location.slug}/`,
  areaServed: {
    '@type': 'City',
    name: `${location.name}, New York`,
  },
  provider: { '@id': 'https://crst.net/#organization' },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: location.lat,
    longitude: location.lng,
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: BUSINESS.rating.ratingValue,
    bestRating: BUSINESS.rating.bestRating,
    worstRating: BUSINESS.rating.worstRating,
    ratingCount: '1',
  },
};

const typeLabel = location.type.charAt(0).toUpperCase() + location.type.slice(1);

const neighborMap: Record<string, string[]> = {
  'New Paltz': ['Highland', 'Gardiner', 'Wallkill', 'Rosendale'],
  'Kingston': ['Hurley', 'Saugerties', 'Connelly', 'Port Ewen'],
  'Saugerties': ['Kingston', 'Woodstock', 'West Hurley', 'Cottekill'],
  'Woodstock': ['Saugerties', 'West Hurley', 'Phoenicia', 'Hurley'],
  'Hurley': ['Kingston', 'Woodstock', 'Stone Ridge', 'Marbletown'],
  'Highland': ['New Paltz', 'Lloyd', 'Milton', 'Marlboro'],
  'Ellenville': ['Wawarsing', 'Napanoch', 'Wawarsing (Kerhonkson)', 'Accord'],
  'Stone Ridge': ['Marbletown', 'High Falls', 'Rosendale', 'Hurley'],
  'High Falls': ['Stone Ridge', 'Rosendale', 'Accord', 'Wawarsing (Kerhonkson)'],
  'Phoenicia': ['Woodstock', 'Shandaken', 'West Hurley', 'Shokan'],
  'Shokan': ['Phoenicia', 'Olive', 'West Hurley', 'Woodstock'],
  'Marlboro': ['Highland', 'Milton', 'Wallkill', 'Lloyd'],
  'Rosendale': ['New Paltz', 'Stone Ridge', 'High Falls', 'Tillson'],
  'Tillson': ['Rosendale', 'New Paltz', 'Highland', 'Wallkill'],
  'Port Ewen': ['Kingston', 'Connelly', 'Esopus', 'Highland'],
  'Connelly': ['Kingston', 'Port Ewen', 'Esopus', 'Highland'],
  'Esopus': ['Port Ewen', 'Connelly', 'Highland', 'Lloyd'],
  'Lloyd': ['Highland', 'Marlboro', 'Esopus', 'New Paltz'],
  'Olive': ['Shokan', 'Shandaken', 'West Hurley', 'Woodstock'],
  'Shandaken': ['Phoenicia', 'Olive', 'Shokan', 'Woodstock'],
  'West Hurley': ['Woodstock', 'Saugerties', 'Hurley', 'Shokan'],
  'Marbletown': ['Stone Ridge', 'Hurley', 'High Falls', 'Rosendale'],
  'Hardenburgh': ['Shandaken', 'Olive', 'Denning', 'Woodstock'],
  'Denning': ['Hardenburgh', 'Shandaken', 'Ellenville', 'Wawarsing'],
  'Wawarsing': ['Ellenville', 'Napanoch', 'Wawarsing (Kerhonkson)', 'Denning'],
  'Napanoch': ['Ellenville', 'Wawarsing', 'Wawarsing (Kerhonkson)', 'Accord'],
  'Wawarsing (Kerhonkson)': ['Napanoch', 'Wawarsing', 'Accord', 'Stone Ridge'],
  'Cottekill': ['Rosendale', 'Stone Ridge', 'High Falls', 'Saugerties'],
  'Wallkill': ['New Paltz', 'Marlboro', 'Tillson', 'Gardiner'],
  'Gardiner': ['New Paltz', 'Wallkill', 'Highland', 'Rosendale'],
  'Poughkeepsie': ['Wappingers Falls', 'LaGrange', 'Hyde Park', 'Fishkill'],
  'Wappingers Falls': ['Poughkeepsie', 'Fishkill', 'East Fishkill', 'Hopewell Junction'],
  'Fishkill': ['Wappingers Falls', 'East Fishkill', 'Beacon', 'Hopewell Junction'],
  'Beacon': ['Fishkill', 'Wappingers Falls', 'East Fishkill', 'Hopewell Junction'],
  'East Fishkill': ['Fishkill', 'Hopewell Junction', 'Wappingers Falls', 'Beacon'],
  'Hopewell Junction': ['East Fishkill', 'Wappingers Falls', 'LaGrange', 'Fishkill'],
  'LaGrange': ['Poughkeepsie', 'Hopewell Junction', 'Stanford', 'Pleasant Valley'],
  'Pleasant Valley': ['LaGrange', 'Stanford', 'Rhinebeck', 'Milan'],
  'Rhinebeck': ['Pleasant Valley', 'Red Hook', 'Milan', 'Stanford'],
  'Red Hook': ['Rhinebeck', 'Tivoli', 'Rhinecliff', 'Milan'],
  'Tivoli': ['Red Hook', 'Rhinecliff', 'Rhinebeck', 'Milan'],
  'Rhinecliff': ['Red Hook', 'Tivoli', 'Rhinebeck', 'Kingston'],
  'Milan': ['Rhinebeck', 'Red Hook', 'Pleasant Valley', 'Stanford'],
  'Stanford': ['LaGrange', 'Pleasant Valley', 'Millbrook', 'Milan'],
  'Millbrook': ['Stanford', 'Amenia', 'Dover', 'Washington'],
  'Amenia': ['Millbrook', 'Dover', 'Pine Plains', 'Washington'],
  'Dover': ['Amenia', 'Millbrook', 'Pawling', 'Washington'],
  'Pawling': ['Dover', 'Amenia', 'East Fishkill', 'Wappinger'],
  'Wappinger': ['Wappingers Falls', 'Fishkill', 'Pawling', 'East Fishkill'],
  'Pine Plains': ['Amenia', 'Millbrook', 'Milan', 'Stanford'],
  'Washington': ['Millbrook', 'Stanford', 'Amenia', 'Dover'],
  'Clinton': ['LaGrange', 'Pleasant Valley', 'Stanford', 'Rhinebeck'],
  'Union Vale': ['Dover', 'Pawling', 'East Fishkill', 'LaGrange'],
  'Newburgh': ['New Windsor', 'Montgomery', 'Wallkill (Orange)', 'Cornwall'],
  'New Windsor': ['Newburgh', 'Cornwall', 'Highlands', 'Mountainville'],
  'Cornwall': ['New Windsor', 'Newburgh', 'Highland Falls', 'Tuxedo'],
  'Highland Falls': ['Cornwall', 'Highlands', 'Tuxedo', 'Monroe'],
  'Highlands': ['Highland Falls', 'New Windsor', 'Cornwall', 'Tuxedo'],
  'Wallkill (Orange)': ['Middletown', 'Montgomery', 'Goshen', 'Crawford'],
  'Middletown': ['Wallkill (Orange)', 'Montgomery', 'Goshen', 'Wawayanda'],
  'Goshen': ['Middletown', 'Montgomery', 'Chester', 'Minisink'],
  'Montgomery': ['Newburgh', 'Middletown', 'Goshen', 'Wallkill (Orange)'],
  'Chester': ['Goshen', 'Monroe', 'Blooming Grove', 'Minisink'],
  'Monroe': ['Chester', 'Highland Falls', 'Tuxedo', 'Blooming Grove'],
  'Tuxedo': ['Monroe', 'Highland Falls', 'Cornwall', 'Chester'],
  'Blooming Grove': ['Chester', 'Monroe', 'Washingtonville', 'Crawford'],
  'Crawford': ['Wallkill (Orange)', 'Montgomery', 'Blooming Grove', 'Washingtonville'],
  'Washingtonville': ['Blooming Grove', 'Crawford', 'Montgomery', 'Chester'],
  'Port Jervis': ['Deerpark', 'Minisink', 'Wawayanda', 'Greenville'],
  'Deerpark': ['Port Jervis', 'Minisink', 'Wawayanda', 'Greenville'],
  'Minisink': ['Goshen', 'Chester', 'Deerpark', 'Port Jervis'],
  'Wawayanda': ['Middletown', 'Minisink', 'Deerpark', 'Goshen'],
  'Greenville': ['Port Jervis', 'Deerpark', 'Hamptonburgh', 'Florida'],
  'Hamptonburgh': ['Goshen', 'Chester', 'Greenville', 'Florida'],
  'Florida': ['Hamptonburgh', 'Goshen', 'Greenville', 'Wallkill (Orange)'],
  'Harriman': ['Monroe', 'Chester', 'Tuxedo', 'Blooming Grove'],
  'Walden': ['Montgomery', 'Wallkill (Orange)', 'Crawford', 'Goshen'],
  'Mount Hope': ['Wallkill (Orange)', 'Middletown', 'Wawayanda', 'Goshen'],
  'Millerton': ['North East', 'Amenia', 'Pine Plains', 'Stanford'],
  'Staatsburg': ['Hyde Park', 'Rhinebeck', 'Red Hook', 'Pleasant Valley'],
  'Pine Bush': ['Crawford', 'Montgomery', 'Walden', 'Wallkill (Orange)'],
};

const neighborNames = neighborMap[location.name] || [];
const allCountyLocations = county.locations;
const nearbyAreas = neighborNames
  .map(name => allCountyLocations.find(l => l.name === name))
  .filter((l): l is Location => l !== undefined);
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(townSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <PageHero
    title={`Direct Mail Services in ${location.name}`}
    subtitle={`${typeLabel} in ${county.name} · ZIP ${location.zip.join(', ')} · Population ${location.population}`}
    breadcrumbs={[
      { label: 'Service Areas', href: '/service-areas/' },
      { label: county.name, href: `/service-areas/${county.slug}/` },
      { label: location.name },
    ]}
  />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <a href={`/service-areas/${county.slug}/`} class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-crst-primary transition-colors">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Back to {county.name}
    </a>
  </div>

  <!-- Location Intro -->
  <section class="py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Main Content -->
        <div class="lg:col-span-2">
          <div class="section-divider mb-6"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-6">
            Direct Mail & Printing for {location.name} Businesses
          </h2>
          <p class="text-gray-700 leading-relaxed mb-8">
            {location.intro}
          </p>

          <div class="rounded-xl overflow-hidden shadow-md mb-10">
            <iframe
              src={`https://www.google.com/maps?q=${location.lat},${location.lng}&z=13&output=embed`}
              width="100%"
              height="300"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={`Map of ${location.name}, NY`}
            ></iframe>
          </div>

          <!-- Services for this area -->
          <h3 class="text-xl font-display font-bold text-crst-primary mb-4">
            Services Available in {location.name}
          </h3>
          <div class="grid sm:grid-cols-2 gap-4 mb-10">
            {SERVICES.map((service) => (
              <a
                href={`/services/${service.slug}/`}
                class="flex items-start gap-3 p-4 rounded-lg border border-gray-200 hover:border-crst-primary/30 hover:bg-gray-50 transition-all group"
              >
                <div class="w-2 h-2 rounded-full bg-crst-gold mt-2 shrink-0"></div>
                <div>
                  <div class="font-semibold text-sm text-gray-800 group-hover:text-crst-primary transition-colors">
                    {service.title}
                  </div>
                  <div class="text-xs text-gray-500 mt-1">{service.summary}</div>
                </div>
              </a>
            ))}
          </div>

          <!-- Client Types -->
          {location.clientTypes.length > 0 && (
            <div class="mb-10">
              <h3 class="text-xl font-display font-bold text-crst-primary mb-4">
                Who We Serve in {location.name}
              </h3>
              <p class="text-gray-600 mb-4">
                We work with a wide range of {location.name} businesses and organizations, including:
              </p>
              <div class="grid sm:grid-cols-2 gap-3">
                {location.clientTypes.map((clientType) => (
                  <div class="flex items-center gap-3 p-3 bg-crst-light/50 rounded-lg">
                    <svg class="w-5 h-5 text-crst-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-sm text-gray-700">{clientType}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Notable Organizations -->
          {location.notableOrgs.length > 0 && (
            <div class="mb-10">
              <h3 class="text-xl font-display font-bold text-crst-primary mb-4">
                Notable {location.name} Organizations
              </h3>
              <p class="text-gray-600 mb-4">
                {location.name} is home to many recognized organizations and institutions we're proud to serve:
              </p>
              <div class="flex flex-wrap gap-2">
                {location.notableOrgs.map((org) => (
                  <span class="text-sm bg-white border border-gray-200 text-gray-700 px-3 py-1.5 rounded-full">{org}</span>
                ))}
              </div>
            </div>
          )}

          <div class="bg-crst-primary rounded-xl p-6 mb-10 text-center">
            <h3 class="text-xl font-display font-bold text-white mb-3">
              Ready to Reach {location.name} Customers?
            </h3>
            <p class="text-crst-light/80 text-sm mb-5">
              Get a free estimate for your next direct mail campaign targeting {location.name} and {county.name}.
            </p>
            <div class="flex flex-col sm:flex-row gap-3 justify-center">
              <a href={`tel:${BUSINESS.phoneClean}`} class="inline-flex items-center justify-center gap-2 bg-white text-crst-primary font-semibold px-6 py-3 rounded-lg hover:bg-gray-100 transition-colors text-sm">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Call {BUSINESS.phone}
              </a>
              <a href="/estimate/" class="inline-flex items-center justify-center gap-2 bg-crst-gold text-white font-semibold px-6 py-3 rounded-lg hover:bg-crst-gold/90 transition-colors text-sm">
                Get a Free Estimate
              </a>
            </div>
          </div>

          <!-- FAQs -->
          {location.faqs.length > 0 && (
            <div class="mb-10">
              <h3 class="text-xl font-display font-bold text-crst-primary mb-6">
                {location.name} Direct Mail FAQ
              </h3>
              <div class="space-y-4">
                {location.faqs.map((faq, i) => (
                  <details class="group bg-white border border-gray-200 rounded-lg" open={i === 0}>
                    <summary class="flex items-center justify-between p-5 cursor-pointer hover:bg-gray-50 transition-colors rounded-lg">
                      <h4 class="font-semibold text-gray-800 text-sm pr-4">{faq.q}</h4>
                      <svg class="w-5 h-5 text-gray-400 shrink-0 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    </summary>
                    <div class="px-5 pb-5 text-sm text-gray-600 leading-relaxed border-t border-gray-100 pt-4">
                      {faq.a}
                    </div>
                  </details>
                ))}
              </div>
            </div>
          )}

          <AuthorByline compact />
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <!-- Quick Facts -->
          <div class="bg-crst-light rounded-xl p-6 mb-6 sticky top-24">
            <h3 class="font-display font-bold text-crst-primary mb-4">{location.name} Quick Facts</h3>
            <div class="space-y-3 text-sm">
              <div class="flex justify-between border-b border-crst-primary/10 pb-2">
                <span class="text-gray-600">Type</span>
                <span class="font-semibold text-gray-800">{typeLabel}</span>
              </div>
              <div class="flex justify-between border-b border-crst-primary/10 pb-2">
                <span class="text-gray-600">County</span>
                <span class="font-semibold text-gray-800">{county.name}</span>
              </div>
              <div class="flex justify-between border-b border-crst-primary/10 pb-2">
                <span class="text-gray-600">Population</span>
                <span class="font-semibold text-gray-800">{location.population}</span>
              </div>
              <div class="flex justify-between border-b border-crst-primary/10 pb-2">
                <span class="text-gray-600">ZIP Code{location.zip.length > 1 ? 's' : ''}</span>
                <span class="font-semibold text-gray-800">{location.zip.join(', ')}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">Distance</span>
                <span class="font-semibold text-gray-800">
                  {county.countyKey === 'ulster' ? 'Our home county' : county.countyKey === 'dutchess' ? '~20 min via bridge' : '~30 min via I-87'}
                </span>
              </div>
            </div>

            <div class="mt-6 space-y-3">
              <a href="/estimate/" class="btn-primary w-full text-center text-sm block">
                Get a Free Estimate
              </a>
              <a href={`tel:${BUSINESS.phoneClean}`} class="btn-secondary w-full text-center text-sm block">
                Call {BUSINESS.phone}
              </a>
            </div>
          </div>

          <!-- Nearby Locations -->
          <div class="bg-white border border-gray-200 rounded-xl p-6">
            <h3 class="font-display font-bold text-crst-primary mb-4">Nearby Service Areas</h3>
            <div class="space-y-2">
              {nearbyLocations.map((nearby) => (
                <a
                  href={`/service-areas/${county.slug}/${nearby.slug}/`}
                  class="flex items-center justify-between p-2 rounded hover:bg-gray-50 transition-colors group"
                >
                  <span class="text-sm text-gray-700 group-hover:text-crst-primary transition-colors">{nearby.name}</span>
                  <svg class="w-3.5 h-3.5 text-gray-300 group-hover:text-crst-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </a>
              ))}
            </div>
            <a href={`/service-areas/${county.slug}/`} class="mt-4 text-sm text-crst-accent font-semibold hover:underline block">
              View All {county.name} Areas →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Cornerstone -->
  <section class="py-14 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-display font-bold text-crst-primary mb-10 text-center">
        Why {location.name} Businesses Choose Cornerstone
      </h2>
      <div class="grid md:grid-cols-4 gap-6">
        <div class="text-center p-6">
          <div class="text-3xl font-display font-bold text-crst-accent mb-2">{BUSINESS.stats.years}</div>
          <div class="text-sm text-gray-600">Years of Hudson Valley Experience</div>
        </div>
        <div class="text-center p-6">
          <div class="text-3xl font-display font-bold text-crst-accent mb-2">{BUSINESS.stats.piecesMailed}</div>
          <div class="text-sm text-gray-600">Pieces Mailed</div>
        </div>
        <div class="text-center p-6">
          <div class="text-3xl font-display font-bold text-crst-accent mb-2">{BUSINESS.stats.onTime}</div>
          <div class="text-sm text-gray-600">On-Time Delivery Rate</div>
        </div>
        <div class="text-center p-6">
          <div class="text-3xl font-display font-bold text-crst-accent mb-2">BBB A+</div>
          <div class="text-sm text-gray-600">Rated Since 1998</div>
        </div>
      </div>
    </div>
  </section>

  {nearbyAreas.length > 0 && (
    <section class="py-14 bg-navy-50/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-display font-bold text-crst-primary mb-8 text-center">Nearby Areas We Serve</h2>
        <div class="grid sm:grid-cols-2 gap-3 max-w-2xl mx-auto">
          {nearbyAreas.map((area) => (
            <a
              href={`/service-areas/${county.slug}/${area.slug}/`}
              class="flex items-center gap-3 p-4 bg-white rounded-lg border border-gray-200 hover:border-crst-primary/30 hover:shadow-sm transition-all group"
            >
              <svg class="w-5 h-5 text-crst-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span class="font-heading font-semibold text-gray-800 group-hover:text-crst-primary transition-colors">Direct Mail in {area.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTASection
    headline={`Start Your ${location.name} Direct Mail Campaign`}
    text={`Contact us today for a free estimate. We'll help you reach the right audience in ${location.name} and across ${county.name}.`}
  />
</BaseLayout>
