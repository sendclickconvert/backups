---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EnvelopeHubNav from '../../../components/guides/EnvelopeHubNav.astro';
import SpecTable from '../../../components/guides/SpecTable.astro';
import AuthorByline from '../../../components/AuthorByline.astro';
import CTASection from '../../../components/CTASection.astro';
import { BUSINESS } from '../../../data/site';
import { ENVELOPE_SPOKES, SPOKE_SLUGS, HUB_NAV_ITEMS } from '../../../data/envelope-spokes';

export function getStaticPaths() {
  return SPOKE_SLUGS.map((slug) => ({
    params: { slug },
    props: { spoke: ENVELOPE_SPOKES[slug] },
  }));
}

const { spoke } = Astro.props;
const { slug } = Astro.params;
const canonical = `https://crst.net/guides/envelope-sizes/${slug}`;
const pubDate = spoke.lastUpdated;

const seanGriffin = {
  '@type': 'Person',
  '@id': 'https://crst.net/about#sean-griffin',
  name: 'Sean Griffin',
  jobTitle: 'Owner & Mailpiece Design Professional',
  description: 'Sean Griffin founded Cornerstone Services in 1998. He holds the USPS Mailpiece Design Professional (MDP) certification and has managed direct mail, printing, and mailing campaigns for businesses across Ulster, Dutchess, and Orange counties for over 28 years.',
  url: 'https://crst.net/about',
  image: 'https://crst.net/images/sean-griffin.png',
  sameAs: ['https://crst.net/about'],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    name: 'Mailpiece Design Professional (MDP)',
    credentialCategory: 'Professional Certification',
    recognizedBy: { '@type': 'Organization', name: 'United States Postal Service' },
  },
  worksFor: {
    '@type': 'Organization',
    '@id': 'https://crst.net/#organization',
    name: 'Cornerstone Services, Inc.',
    url: 'https://crst.net',
    telephone: '+1-845-255-5722',
    foundingDate: '1998',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '387 Malden Turnpike',
      addressLocality: 'Saugerties',
      addressRegion: 'NY',
      postalCode: '12477',
      addressCountry: 'US',
    },
  },
};

const graphItems: object[] = [
  {
    '@type': 'Article',
    headline: spoke.title,
    description: spoke.metaDescription,
    url: canonical,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    datePublished: pubDate,
    dateModified: pubDate,
    inLanguage: 'en-US',
    author: seanGriffin,
    publisher: {
      '@type': 'Organization',
      '@id': 'https://crst.net/#organization',
      name: 'Cornerstone Services, Inc.',
      url: 'https://crst.net',
      logo: { '@type': 'ImageObject', url: 'https://crst.net/images/crst-logo.png', width: 200, height: 60 },
    },
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.article-lead', '.prose h2'] },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://crst.net' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://crst.net/guides' },
      { '@type': 'ListItem', position: 3, name: 'Envelope Sizes', item: 'https://crst.net/guides/envelope-sizes' },
      { '@type': 'ListItem', position: 4, name: spoke.h1, item: canonical },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: spoke.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const relatedSpokes = HUB_NAV_ITEMS.filter((item) => item.slug !== slug).slice(0, 4);
---

<BaseLayout title={spoke.title} description={spoke.metaDescription} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graphItems })} />
  </Fragment>

  <!-- Hero -->
  <section class="bg-crst-primary text-white py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-white/50 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white/80 transition-colors">Home</a><span class="mx-2">›</span>
        <a href="/guides" class="hover:text-white/80 transition-colors">Guides</a><span class="mx-2">›</span>
        <a href="/guides/envelope-sizes" class="hover:text-white/80 transition-colors">Envelope Sizes</a><span class="mx-2">›</span>
        <span class="text-white/70">{spoke.h1}</span>
      </nav>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold leading-tight text-white mb-4">{spoke.h1}</h1>
      <p class="article-lead text-white/70 text-base max-w-2xl leading-relaxed">
        {spoke.metaDescription}
      </p>
    </div>
  </section>

  <section class="py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">

        <!-- Main content -->
        <div class="lg:col-span-2">

          <!-- RETRIEVAL_PARAGRAPH:start -->
          <div class="bg-navy-50/60 border border-navy-100 rounded-xl p-5 mb-8 text-sm text-navy-700 leading-relaxed">
            {spoke.retrievalParagraph}
          </div>
          <!-- RETRIEVAL_PARAGRAPH:end -->

          <!-- Spec table — renders real data, do not placeholder -->
          <SpecTable
            dimensionsInches={spoke.dimensionsInches}
            dimensionsMm={spoke.dimensionsMm}
            weightLimitOz={spoke.weightLimitOz}
            postageClass={spoke.postageClass}
            primaryUseCases={spoke.primaryUseCases}
          />

          <!-- Body content — reads from data file; placeholders render nothing until content lands -->
          <div class="prose prose-navy max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent hover:prose-a:text-crst-primary prose-strong:text-navy-800 prose-p:text-navy-600/80 prose-li:text-navy-600/80">

            <!-- BODY_INTRO:start -->
            {spoke.bodyIntro && <Fragment set:html={spoke.bodyIntro} />}
            <!-- BODY_INTRO:end -->

            <!-- USE_CASES:start -->
            {spoke.useCases && <Fragment set:html={spoke.useCases} />}
            <!-- USE_CASES:end -->

            <!-- POSTAGE_NOTES:start -->
            {spoke.postageNotes && <Fragment set:html={spoke.postageNotes} />}
            <!-- POSTAGE_NOTES:end -->

          </div>

          <div class="not-prose mt-8">
            <AuthorByline />
          </div>

          <!-- FAQ_BLOCK:start -->
          <div class="mt-12">
            <div class="section-divider mb-6"></div>
            <h2 class="text-2xl font-display text-crst-primary mb-6">Frequently Asked Questions</h2>
            <div class="space-y-4">
              {spoke.faqs.map((item) => (
                <div class="bg-navy-50/40 rounded-xl border border-navy-100 p-5">
                  <h3 class="font-heading font-semibold text-navy-800 text-sm mb-2">{item.q}</h3>
                  <p class="text-sm text-navy-600/70 leading-relaxed" set:html={item.a} />
                </div>
              ))}
            </div>
          </div>
          <!-- FAQ_BLOCK:end -->

          <!-- Compare CTA -->
          <div class="bg-crst-primary/5 border border-crst-primary/15 rounded-xl p-6 text-center mt-10">
            <p class="font-heading font-bold text-crst-primary text-lg mb-2">Not sure this is the right size?</p>
            <p class="text-navy-600/70 text-sm mb-4">Compare all standard envelope sizes side-by-side, then call us. We help Hudson Valley businesses choose, print, and mail the right format every day.</p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
              <a href="/guides/envelope-sizes" class="btn-primary text-sm">Compare All Envelope Sizes →</a>
              <a href="/estimate" class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-crst-primary hover:text-crst-accent border border-crst-primary/30 hover:border-crst-accent/40 rounded-lg px-4 py-2 transition-colors">
                Get a Free Quote
              </a>
            </div>
          </div>

          <!-- Related spokes -->
          <div class="mt-14">
            <div class="section-divider mb-6"></div>
            <h2 class="text-xl font-display text-crst-primary mb-6">Other Envelope Sizes</h2>
            <div class="grid sm:grid-cols-2 gap-4">
              {relatedSpokes.map((item) => {
                const rel = ENVELOPE_SPOKES[item.slug];
                return (
                  <a href={`/guides/envelope-sizes/${item.slug}`} class="block p-4 bg-navy-50/40 rounded-xl border border-navy-100 hover:border-crst-primary/30 hover:shadow-sm transition-all group">
                    <h3 class="font-heading font-semibold text-navy-800 text-sm group-hover:text-crst-primary transition-colors leading-snug mb-1">{rel.h1}</h3>
                    <p class="text-xs text-navy-600/60 font-mono">{rel.dimensionsInches}</p>
                  </a>
                );
              })}
            </div>
          </div>

        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-1">
          <div class="sticky top-28 space-y-6">
            <div class="bg-crst-primary rounded-xl p-6 text-white">
              <h3 class="font-display text-lg mb-2">Print & Mail This Envelope</h3>
              <p class="text-white/60 text-sm leading-relaxed mb-4">We print and mail all standard envelope formats from our Saugerties, NY facility. Get a quote within one business day.</p>
              <a href="/estimate" class="btn-accent w-full text-center text-sm">Request a Quote</a>
              <div class="mt-4 pt-4 border-t border-white/10 text-center">
                <a href={`tel:${BUSINESS.phoneClean}`} class="text-white/70 text-sm font-heading hover:text-white transition-colors">or call {BUSINESS.phone}</a>
              </div>
            </div>

            <EnvelopeHubNav currentSlug={slug} />

            <div class="bg-navy-50/50 rounded-xl p-5 border border-navy-100">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-3">Related Services</h3>
              <div class="space-y-2">
                {[
                  { label: 'Direct Mail Campaigns', href: '/services/direct-mail' },
                  { label: 'Printing Services', href: '/services/printing' },
                  { label: 'Mailing Services', href: '/services/mailing' },
                  { label: 'USPS Postage Rates', href: '/direct-mail-tools/postage-rates' },
                  { label: 'Graphic Design', href: '/services/graphic-design' },
                ].map((link) => (
                  <a href={link.href} class="flex items-center justify-between px-3 py-2 text-sm text-navy-700 hover:text-crst-primary hover:bg-white rounded-md transition-colors font-heading">
                    {link.label}
                    <svg class="w-3.5 h-3.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </div>

            <a href="/guides/envelope-sizes" class="block p-4 bg-crst-primary/5 rounded-xl border border-crst-primary/15 hover:border-crst-primary/30 transition-all group">
              <p class="font-heading font-semibold text-crst-primary text-sm group-hover:text-crst-accent transition-colors">← Compare All Envelope Sizes</p>
              <p class="text-xs text-navy-600/60 mt-1">Full chart with dimensions, postage class, and use cases</p>
            </a>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
