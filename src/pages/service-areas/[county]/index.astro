---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTASection from '../../../components/CTASection.astro';
import AuthorByline from '../../../components/AuthorByline.astro';
import { BUSINESS, SERVICES } from '../../../data/site';
import { COUNTIES_DATA } from '../../../data/locations';
import type { County } from '../../../data/locations';

export function getStaticPaths() {
  return COUNTIES_DATA.map((county) => ({
    params: { county: county.slug },
    props: { county },
  }));
}

const { county } = Astro.props as { county: County };
const anchorLocations = county.locations.filter(l => l.isAnchor);
const cities = county.locations.filter(l => l.type === 'city');
const towns = county.locations.filter(l => l.type === 'town');
const villages = county.locations.filter(l => l.type === 'village');
const hamlets = county.locations.filter(l => l.type === 'hamlet' || l.type === 'cdp');

const countyMeta: Record<string, { title: string; description: string; featuredTowns: string[]; blogLink: string }> = {
  'ulster-county': {
    title: 'Direct Mail Services in Ulster County NY',
    description: `CRST provides direct mail, EDDM, and commercial printing services across Ulster County NY including New Paltz, Kingston, and Saugerties. Get a free estimate.`,
    featuredTowns: ['New Paltz', 'Kingston', 'Saugerties', 'Woodstock', 'Highland', 'Marlboro'],
    blogLink: 'https://blog.crst.net/direct-mail-services-hudson-valley-ny',
  },
  'dutchess-county': {
    title: 'Direct Mail Services in Dutchess County NY',
    description: `Direct mail, printing, and mailing services across Dutchess County NY including Poughkeepsie, Beacon, and Hyde Park. CRST — Hudson Valley's print shop since 1998.`,
    featuredTowns: ['Poughkeepsie', 'Beacon', 'Hyde Park', 'Rhinebeck', 'Wappingers Falls', 'Fishkill'],
    blogLink: 'https://blog.crst.net/direct-mail-marketing-poughkeepsie-ny',
  },
  'orange-county': {
    title: 'Direct Mail Services in Orange County NY',
    description: `CRST delivers direct mail, EDDM, and commercial printing services across Orange County NY including Newburgh, Middletown, and Warwick. Request a free quote.`,
    featuredTowns: ['Newburgh', 'Middletown', 'Warwick', 'Goshen', 'Monroe', 'Cornwall'],
    blogLink: 'https://blog.crst.net/direct-mail-services-hudson-valley-ny',
  },
};

const meta = countyMeta[county.slug] || {
  title: `Direct Mail Services in ${county.name}, NY`,
  description: `Professional direct mail, printing, and mailing services for businesses and organizations across ${county.name}, NY. Serving ${county.locations.length} communities from our ${BUSINESS.address.city} facility.`,
  featuredTowns: county.locations.slice(0, 6).map(l => l.name),
  blogLink: 'https://blog.crst.net/direct-mail-services-hudson-valley-ny',
};

const townAreaServed = meta.featuredTowns.map(town => ({
  '@type': 'City',
  name: `${town}, New York`,
}));

const countySchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: `Cornerstone Services, Inc. — ${county.name}`,
  url: `https://crst.net/service-areas/${county.slug}`,
  provider: { '@id': 'https://crst.net/#organization' },
  areaServed: [
    { '@type': 'County', name: `${county.name}, New York` },
    ...townAreaServed,
  ],
  telephone: BUSINESS.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: BUSINESS.address.street,
    addressLocality: BUSINESS.address.city,
    addressRegion: BUSINESS.address.state,
    postalCode: BUSINESS.address.zip,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: county.lat,
    longitude: county.lng,
  },
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Direct Mail & Printing Services — ${county.name}`,
  provider: { '@id': 'https://crst.net/#organization' },
  areaServed: [
    { '@type': 'County', name: `${county.name}, New York` },
    ...townAreaServed,
  ],
  serviceType: ['Direct Mail Marketing', 'EDDM', 'Commercial Printing', 'Graphic Design', 'Data Lists', 'Mailing Services'],
  url: `https://crst.net/service-areas/${county.slug}`,
};
---

<BaseLayout title={meta.title} description={meta.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(countySchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <PageHero
    title={`Direct Mail Services in ${county.name}`}
    subtitle={`Serving ${county.locations.length} communities across ${county.name} from our ${BUSINESS.address.city} headquarters`}
    breadcrumbs={[
      { label: 'Service Areas', href: '/service-areas' },
      { label: county.name },
    ]}
  />

  <!-- County Intro -->
  <section class="py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-14">
        <div class="section-divider mb-6"></div>
        <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-4">
          Direct Mail Services Across {county.name}
        </h2>
        <p class="text-gray-700 leading-relaxed">
          {county.intro}
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-14">
        <div class="text-center p-5 bg-crst-light rounded-lg">
          <div class="text-3xl font-display font-bold text-crst-primary">{county.locations.length}</div>
          <div class="text-sm text-gray-600 mt-1">Communities Served</div>
        </div>
        <div class="text-center p-5 bg-crst-light rounded-lg">
          <div class="text-3xl font-display font-bold text-crst-primary">{county.population}</div>
          <div class="text-sm text-gray-600 mt-1">Population</div>
        </div>
        <div class="text-center p-5 bg-crst-light rounded-lg">
          <div class="text-3xl font-display font-bold text-crst-primary">{BUSINESS.stats.years}</div>
          <div class="text-sm text-gray-600 mt-1">Years of Service</div>
        </div>
        <div class="text-center p-5 bg-crst-light rounded-lg">
          <div class="text-3xl font-display font-bold text-crst-primary">{BUSINESS.stats.piecesMailed}</div>
          <div class="text-sm text-gray-600 mt-1">Pieces Mailed</div>
        </div>
      </div>

      <!-- Google Map -->
      <div class="mb-14 rounded-xl overflow-hidden shadow-sm border border-gray-100">
        <iframe
          src={`https://www.google.com/maps?q=${county.lat},${county.lng}&z=11&output=embed`}
          width="100%"
          height="400"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Map of ${county.name}, NY service area`}
        ></iframe>
      </div>

      <!-- Anchor Cities -->
      {anchorLocations.length > 0 && (
        <div class="mb-14">
          <h3 class="text-2xl font-display font-bold text-crst-primary mb-8">
            Major {county.name} Service Areas
          </h3>
          <div class="grid md:grid-cols-2 gap-8">
            {anchorLocations.map((location) => (
              <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8 hover:shadow-md transition-shadow">
                <h4 class="text-xl font-display font-bold text-crst-primary mb-3">
                  <a href={`/service-areas/${county.slug}/${location.slug}`} class="hover:text-crst-accent transition-colors">
                    Direct Mail in {location.name}
                  </a>
                </h4>
                <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 mb-4">
                  <span>Pop. {location.population}</span>
                  <span>&bull;</span>
                  <span>ZIP: {location.zip.join(', ')}</span>
                </div>
                <p class="text-gray-600 text-sm mb-6 line-clamp-3">{location.intro}</p>
                <div class="mb-6">
                  <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Key Organizations</div>
                  <div class="flex flex-wrap gap-2">
                    {location.notableOrgs.slice(0, 4).map((org) => (
                      <span class="text-xs bg-crst-light text-crst-primary px-2 py-1 rounded">{org}</span>
                    ))}
                  </div>
                </div>
                <a href={`/service-areas/${county.slug}/${location.slug}`} class="btn-primary text-sm inline-block">
                  View {location.name} Services &rarr;
                </a>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Mid-Page CTA -->
      <div class="mb-14 bg-crst-primary/5 border border-crst-primary/10 rounded-xl p-8 text-center">
        <h3 class="text-xl font-display font-bold text-crst-primary mb-3">
          Ready to Reach {county.name} Customers?
        </h3>
        <p class="text-gray-600 mb-6 max-w-2xl mx-auto">
          Get a free estimate &mdash; we'll build your campaign from list to mailbox.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href={`tel:${BUSINESS.phoneClean}`} class="btn-primary inline-flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call {BUSINESS.phone}
          </a>
          <a href="/estimate" class="btn-secondary inline-flex items-center gap-2">
            Get a Free Estimate &rarr;
          </a>
        </div>
      </div>

      <!-- Towns We Serve -->
      <div class="mb-14">
        <h3 class="text-2xl font-display font-bold text-crst-primary mb-8">
          Towns We Serve in {county.name}
        </h3>

        <!-- Cities -->
        {cities.filter(c => !c.isAnchor).length > 0 && (
          <div class="mb-10">
            <h4 class="font-semibold text-gray-800 text-lg mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-crst-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
              Cities
            </h4>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {cities.filter(c => !c.isAnchor).map((location) => (
                <a href={`/service-areas/${county.slug}/${location.slug}`} class="card group block">
                  <div class="font-semibold text-gray-800 group-hover:text-crst-primary transition-colors mb-1">{location.name}</div>
                  <div class="flex items-center gap-3 text-xs text-gray-500 mb-2">
                    <span>ZIP: {location.zip.join(', ')}</span>
                    <span>Pop: {location.population}</span>
                  </div>
                  <p class="text-sm text-gray-500 leading-relaxed line-clamp-2">{location.intro}</p>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Towns -->
        {towns.length > 0 && (
          <div class="mb-10">
            <h4 class="font-semibold text-gray-800 text-lg mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-crst-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
              Towns
            </h4>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
              {towns.map((location) => (
                <a
                  href={`/service-areas/${county.slug}/${location.slug}`}
                  class="flex items-center justify-between p-3.5 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 hover:border-crst-primary/30 transition-all group"
                >
                  <div>
                    <div class="font-semibold text-gray-800 text-sm group-hover:text-crst-primary transition-colors">{location.name}</div>
                    <div class="text-xs text-gray-400">ZIP: {location.zip[0]} &middot; Pop. {location.population}</div>
                  </div>
                  <svg class="w-4 h-4 text-gray-300 group-hover:text-crst-primary group-hover:translate-x-0.5 transition-all shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Villages -->
        {villages.length > 0 && (
          <div class="mb-10">
            <h4 class="font-semibold text-gray-800 text-lg mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-crst-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              Villages
            </h4>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
              {villages.map((location) => (
                <a
                  href={`/service-areas/${county.slug}/${location.slug}`}
                  class="flex items-center justify-between p-3.5 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 hover:border-crst-primary/30 transition-all group"
                >
                  <div>
                    <div class="font-semibold text-gray-800 text-sm group-hover:text-crst-primary transition-colors">{location.name}</div>
                    <div class="text-xs text-gray-400">ZIP: {location.zip[0]} &middot; Pop. {location.population}</div>
                  </div>
                  <svg class="w-4 h-4 text-gray-300 group-hover:text-crst-primary group-hover:translate-x-0.5 transition-all shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Hamlets -->
        {hamlets.length > 0 && (
          <div class="mb-10">
            <h4 class="font-semibold text-gray-800 text-lg mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-crst-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
              Hamlets &amp; CDPs
            </h4>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
              {hamlets.map((location) => (
                <a
                  href={`/service-areas/${county.slug}/${location.slug}`}
                  class="flex items-center justify-between p-3.5 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 hover:border-crst-primary/30 transition-all group"
                >
                  <div>
                    <div class="font-semibold text-gray-800 text-sm group-hover:text-crst-primary transition-colors">{location.name}</div>
                    <div class="text-xs text-gray-400">ZIP: {location.zip[0]} &middot; Pop. {location.population}</div>
                  </div>
                  <svg class="w-4 h-4 text-gray-300 group-hover:text-crst-primary group-hover:translate-x-0.5 transition-all shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="mt-8">
        <AuthorByline compact />
      </div>
    </div>
  </section>

  <!-- Services Available -->
  <section class="py-14 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-display font-bold text-crst-primary mb-10 text-center">
        Services Available in {county.name}
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        {SERVICES.slice(0, 6).map((service) => (
          <div class="bg-white rounded-xl p-6 shadow-sm">
            <h3 class="text-lg font-display font-bold text-crst-primary mb-2">{service.title}</h3>
            <p class="text-gray-600 text-sm mb-4">{service.summary}</p>
            <a href={`/services/${service.slug}`} class="text-crst-accent text-sm font-semibold hover:underline">Learn More &rarr;</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Resources -->
  <section class="py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-display font-bold text-crst-primary mb-8 text-center">
        Learn More About Direct Mail in {county.name}
      </h2>
      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <a href={meta.blogLink} class="card group block text-center p-6" target="_blank" rel="noopener">
          <div class="text-crst-primary font-display font-bold mb-2 group-hover:text-crst-accent transition-colors">Direct Mail Guide</div>
          <p class="text-gray-500 text-sm">Read our in-depth guide to direct mail services in the Hudson Valley.</p>
        </a>
        <a href="/services/direct-mail" class="card group block text-center p-6">
          <div class="text-crst-primary font-display font-bold mb-2 group-hover:text-crst-accent transition-colors">Our Services</div>
          <p class="text-gray-500 text-sm">Explore CRST's full range of direct mail, printing, and design services.</p>
        </a>
        <a href="/case-studies" class="card group block text-center p-6">
          <div class="text-crst-primary font-display font-bold mb-2 group-hover:text-crst-accent transition-colors">Case Studies</div>
          <p class="text-gray-500 text-sm">See how Hudson Valley businesses have grown with direct mail campaigns.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Nearby Counties -->
  <section class="py-14 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-display font-bold text-crst-primary mb-6">We Also Serve</h2>
      <div class="flex flex-wrap justify-center gap-4">
        {COUNTIES_DATA.filter(c => c.slug !== county.slug).map((otherCounty) => (
          <a href={`/service-areas/${otherCounty.slug}`} class="btn-secondary text-sm">
            {otherCounty.name} &rarr;
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    headline={`Ready to Reach ${county.name} Customers?`}
    text={`Get a free quote for your ${county.name} direct mail campaign. We'll help you target the right communities with the right message.`}
  />
</BaseLayout>
