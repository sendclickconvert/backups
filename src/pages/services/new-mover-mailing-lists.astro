---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import { BUSINESS } from '../../data/site';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'New Mover Mailing Lists',
  provider: {
    '@type': 'LocalBusiness',
    '@id': 'https://crst.net/#organization',
    name: BUSINESS.name,
    telephone: BUSINESS.phone,
  },
  url: 'https://crst.net/services/new-mover-mailing-lists',
};
---

<BaseLayout
  title="New Mover Mailing Lists — High-Intent Household Data"
  description="Target recent movers in the Hudson Valley. People who just moved need everything. New movers convert 3-5x higher than standard consumer lists."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>
  <PageHero
    title="New Mover Mailing Lists"
    subtitle="People who just moved need everything. Here's how to reach them before your competitors do."
    breadcrumbs={[
      { label: 'Services', href: '/services' },
      { label: 'New Mover Lists' },
    ]}
  />

  <section class="py-14 lg:py-20">
    <div class="container-wide">
      <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">
        <div class="lg:col-span-2 prose prose-lg max-w-none">
          <div class="section-divider mb-6"></div>

          <p class="text-lg text-navy-700 leading-relaxed font-semibold mb-6">
            Someone who's been in the same house for 10 years doesn't need a new dentist, new landscaper, new HVAC contractor, or new insurance agent. They already have those relationships locked in.
          </p>

          <p class="text-navy-600/80 leading-relaxed mb-8">
            Someone who moved 30 days ago needs all of them. Their entire service network just broke. They're actively looking for local providers in every category. New movers are the highest-intent audience in direct mail. They're not thinking about buying someday — they're buying this month. They open every piece of mail because they're looking for exactly what you're offering.
          </p>

          <p class="text-navy-600/80 leading-relaxed mb-8">
            The window is short. If you reach them in the first 90 days, you're competing for their business. If you wait six months, they've already chosen someone else. We've been building new mover campaigns for Hudson Valley businesses since 1998. We know exactly when to mail, what to offer, and how to convert recent movers into long-term customers.
          </p>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-4">What Is a New Mover Mailing List?</h2>

          <p class="text-navy-600/80 leading-relaxed mb-6">
            A new mover mailing list targets households that recently filed a change of address with USPS. These are people who physically moved to a new residence within a specific time frame — typically the last 30, 60, or 90 days.
          </p>

          <p class="text-navy-600/80 leading-relaxed mb-6">
            <strong class="text-navy-800">Data source:</strong> USPS National Change of Address (NCOA) database. When someone files a change of address form, that information feeds into the NCOA system. Data compilers license this data and sell it as new mover lists.
          </p>

          <p class="text-navy-600/80 leading-relaxed mb-8">
            <strong class="text-navy-800">What's included:</strong> Full name, new mailing address, old address, move date, move type, and available household demographics (age, income, presence of children).
          </p>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-4">Why New Movers Are Valuable</h2>

          <p class="text-navy-600/80 leading-relaxed mb-6">
            New movers spend <strong class="text-navy-800">$9,000+ on goods and services in the first three months</strong> after moving, according to USPS market research. They need:
          </p>

          <ul class="list-disc list-inside text-navy-600/80 space-y-2 mb-8">
            <li>Home services (HVAC, plumbing, electrical, landscaping, pest control)</li>
            <li>Retail (furniture, appliances, home décor, automotive)</li>
            <li>Healthcare (dentist, doctor, veterinarian, chiropractor)</li>
            <li>Financial services (insurance, mortgage, banking)</li>
            <li>Professional services (legal, accounting, real estate)</li>
            <li>Utilities and subscriptions (internet, cable, security, cleaning)</li>
          </ul>

          <p class="text-navy-600/80 leading-relaxed mb-8">
            They're not browsing. They're buying. Now.
          </p>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-4">New Movers vs. Standard Consumer Lists</h2>

          <div class="grid sm:grid-cols-2 gap-6 mb-8">
            <div class="p-4 bg-navy-50/40 rounded-lg border border-navy-100">
              <h4 class="font-heading font-bold text-navy-800 mb-2">Standard Consumer List</h4>
              <p class="text-sm text-navy-600/70 leading-relaxed mb-3">You're mailing people who already have a dentist, landscaper, HVAC contractor, and insurance agent. Your mail is competing against inertia. Most people don't switch unless there's a problem.</p>
              <p class="text-sm text-navy-800 font-semibold">Typical response: 1–2%</p>
            </div>

            <div class="p-4 bg-navy-50/40 rounded-lg border border-navy-100">
              <h4 class="font-heading font-bold text-navy-800 mb-2">New Mover List</h4>
              <p class="text-sm text-navy-600/70 leading-relaxed mb-3">You're mailing people who need to find all those providers right now. They don't have relationships yet. Your mail isn't competing against loyalty — it's competing against other new mover mailers.</p>
              <p class="text-sm text-navy-800 font-semibold">Typical response: 3–7%</p>
            </div>
          </div>

          <p class="text-navy-600/80 leading-relaxed mb-8">
            The difference: Timing + intent. New movers convert 3–5x higher than standard lists because they're actively looking for providers, not passively considering switching.
          </p>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-6">Best Industries for New Mover Campaigns</h2>

          <div class="space-y-6 mb-8">
            <div>
              <h3 class="font-heading font-bold text-navy-800 mb-2">Home Services</h3>
              <p class="text-navy-600/70 leading-relaxed">HVAC, plumbing, electrical, landscaping, pest control, cleaning, remodeling. Why it works: systems break, lawns need mowing, pests invade. Best offer: seasonal tune-up, first-time discount, free inspection, service plan enrollment.</p>
            </div>

            <div>
              <h3 class="font-heading font-bold text-navy-800 mb-2">Healthcare Practices</h3>
              <p class="text-navy-600/70 leading-relaxed">Dental, chiropractic, vision care, pediatric, veterinary. Why it works: new movers need healthcare providers, especially families with children or pet owners. Best offer: new patient special, free consultation, pediatric checkup package.</p>
            </div>

            <div>
              <h3 class="font-heading font-bold text-navy-800 mb-2">Retail & Automotive</h3>
              <p class="text-navy-600/70 leading-relaxed">Furniture, appliances, home improvement, auto dealers. Why it works: new movers are furnishing homes, replacing appliances, often buying vehicles for new commutes. Best offer: first-purchase discount, delivery included, financing promotions.</p>
            </div>

            <div>
              <h3 class="font-heading font-bold text-navy-800 mb-2">Financial Services</h3>
              <p class="text-navy-600/70 leading-relaxed">Insurance (home, auto, life), mortgage brokers, banking. Why it works: new movers need to update policies, establish banking relationships, refinance after purchase. Best offer: free quote, policy review, rate comparison, new customer bonus.</p>
            </div>

            <div>
              <h3 class="font-heading font-bold text-navy-800 mb-2">Utilities & Subscriptions</h3>
              <p class="text-navy-600/70 leading-relaxed">Internet/cable, security systems, lawn care, cleaning, water, propane. Why it works: new movers need to set up home services. They're actively shopping. Best offer: free installation, first month free, trial periods, bundling discounts.</p>
            </div>
          </div>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-4">Timing & Data Freshness</h2>

          <p class="text-navy-600/80 leading-relaxed mb-4">
            New mover lists are time-sensitive. The data is only valuable when it's fresh.
          </p>

          <div class="space-y-4 mb-8">
            <div>
              <h4 class="font-heading font-bold text-navy-800 mb-2">30-day new movers</h4>
              <p class="text-navy-600/70 leading-relaxed">Moved within the last 30 days. Still unpacking, setting up utilities. Highest intent, highest response. This is the hottest window.</p>
            </div>

            <div>
              <h4 class="font-heading font-bold text-navy-800 mb-2">60-day new movers</h4>
              <p class="text-navy-600/70 leading-relaxed">Moved 31–60 days ago. Settled in, still establishing providers. High intent, solid response.</p>
            </div>

            <div>
              <h4 class="font-heading font-bold text-navy-800 mb-2">90-day new movers</h4>
              <p class="text-navy-600/70 leading-relaxed">Moved 61–90 days ago. Mostly settled, but some services still needed. Moderate intent.</p>
            </div>
          </div>

          <p class="text-navy-600/80 leading-relaxed mb-8">
            <strong class="text-navy-800">Recommendation:</strong> Mail 30-day new movers every month for maximum freshness. For seasonal services, mail 30–60 day movers to align with when they'll need the service.
          </p>

          <hr class="my-8 border-navy-200" />

          <h2 class="text-2xl font-display text-crst-primary mb-4">New Mover List Pricing</h2>

          <ul class="list-none text-navy-600/80 space-y-2 mb-8">
            <li><strong class="text-navy-800">New mover lists (basic):</strong> $150–$200 per 1,000 names</li>
            <li><strong class="text-navy-800">Enhanced new movers (demographics):</strong> $175–$225 per 1,000 names</li>
          </ul>

          <p class="text-navy-600/80 leading-relaxed mb-8">
            What's included: Monthly or weekly data pulls, NCOA processing, CASS certification, deduplication, presort, file formatting. Minimums: We don't have them. If your market only generates 50–100 new movers per month, we'll pull 50–100.
          </p>

          <div class="bg-crst-primary/5 border border-crst-primary/15 rounded-xl p-6 mt-10 text-center">
            <p class="font-heading font-bold text-crst-primary text-lg mb-2">Reach New Movers in the Hudson Valley</p>
            <p class="text-navy-600/70 text-sm mb-4">Tell us your target audience and geography. We'll provide a count and quote.</p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
              <a href="/estimate" class="btn-primary text-sm">Get a Free Estimate</a>
              <a href={`tel:${BUSINESS.phoneClean}`} class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-crst-primary hover:text-crst-accent transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Call {BUSINESS.phone}
              </a>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="sticky top-24 space-y-5">
            <div class="bg-crst-primary rounded-xl p-6 text-white">
              <h3 class="font-display text-lg mb-2">Reach Recent Movers</h3>
              <p class="text-white/60 text-sm leading-relaxed mb-4">Tell us your service and geography. We'll provide a count and quote — usually within a few hours.</p>
              <a href="/estimate" class="btn-accent w-full text-center text-sm">Request a List Quote</a>
              <div class="mt-4 pt-4 border-t border-white/10 text-center">
                <a href={`tel:${BUSINESS.phoneClean}`} class="text-white/70 text-sm font-heading hover:text-white transition-colors">
                  or call {BUSINESS.phone}
                </a>
              </div>
            </div>

            <div class="bg-navy-50/50 rounded-xl p-5 border border-navy-100">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-3">Related Services</h3>
              <div class="space-y-2">
                {[
                  { label: 'Mailing Lists & Data Services', href: '/services/data-lists' },
                  { label: 'Consumer Mailing Lists', href: '/services/consumer-mailing-lists' },
                  { label: 'Direct Mail Lists', href: '/services/direct-mail-lists' },
                  { label: 'Direct Mail Campaigns', href: '/services/direct-mail' },
                ].map((link) => (
                  <a href={link.href} class="flex items-center justify-between px-3 py-2 text-sm text-navy-700 hover:text-crst-primary hover:bg-white rounded-md transition-colors font-heading">
                    {link.label}
                    <svg class="w-3.5 h-3.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </div>

            <div class="bg-navy-50/50 rounded-xl p-5 border border-navy-100">
              <h3 class="font-heading font-bold text-navy-800 text-sm mb-3">Key Facts</h3>
              <div class="space-y-3 text-sm text-navy-600/70">
                <p><strong class="text-navy-800">3–5x higher response</strong> than standard consumer lists</p>
                <p><strong class="text-navy-800">$9,000+ in spending</strong> in first 90 days after move</p>
                <p><strong class="text-navy-800">Mail within 30 days</strong> for best response rates</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
