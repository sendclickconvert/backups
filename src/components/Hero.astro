---
import { BUSINESS } from '../data/site';
---

<section class="relative bg-crst-primary overflow-hidden">
  <!-- Background layers -->
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-900 via-crst-primary to-navy-700"></div>
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 56px 56px;"></div>
    <!-- Geometric accents -->
    <div class="absolute top-20 right-0 w-96 h-96 rounded-full bg-crst-accent/10 blur-3xl"></div>
    <div class="absolute -bottom-20 -left-20 w-72 h-72 rounded-full bg-crst-gold/8 blur-3xl"></div>
  </div>

  <div class="relative container-wide py-20 lg:py-28">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Text -->
      <div>
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-1.5 mb-6 text-xs font-heading font-medium text-white/80 border border-white/10">
          <span class="w-2 h-2 rounded-full bg-crst-gold animate-pulse"></span>
          Serving the Hudson Valley since {BUSINESS.founded}
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display text-white leading-[1.08] mb-6">
          Direct Mail That <br class="hidden sm:block" />
          <span class="text-crst-gold">Delivers Results</span>
        </h1>

        <p class="text-lg text-white/70 font-heading leading-relaxed max-w-xl mb-8">
          From targeted data lists to print-ready design and USPS-compliant mailing — Cornerstone Services handles every step of your direct mail campaign. {BUSINESS.stats.piecesMailed} pieces mailed and counting.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="/estimate/" class="btn-accent text-sm px-7 py-3.5">
            Get Free Estimate
            <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
          <a href="/services/" class="inline-flex items-center justify-center px-7 py-3.5 border-2 border-white/20 text-white font-heading font-semibold text-sm rounded-lg transition-all duration-300 hover:bg-white/10 hover:border-white/30">
            Our Services
          </a>
        </div>

        <!-- Trust signals -->
        <div class="flex items-center gap-6 mt-10 pt-8 border-t border-white/10">
          <div class="flex items-center gap-2 text-xs text-white/50 font-heading">
            <svg class="w-4 h-4 text-crst-gold" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            BBB A+ Rated
          </div>
          <div class="flex items-center gap-2 text-xs text-white/50 font-heading">
            <svg class="w-4 h-4 text-crst-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            {BUSINESS.stats.onTime} On-Time
          </div>
          <div class="flex items-center gap-2 text-xs text-white/50 font-heading">
            <svg class="w-4 h-4 text-crst-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            {BUSINESS.stats.municipalities} Municipalities
          </div>
        </div>
      </div>

      <!-- Hero video -->
      <div class="hidden lg:block">
        <div class="relative rounded-xl overflow-hidden shadow-2xl shadow-black/30 border border-white/10">
          <video
            class="w-full h-auto"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
          >
            <source src="/videos/hero-video.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom wave -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 48" fill="none" class="w-full h-auto">
      <path d="M0 48h1440V24c-240 16-480 24-720 24S240 40 0 24v24z" fill="white"/>
    </svg>
  </div>
</section>
