---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import CaseStudyCallout from '../../components/CaseStudyCallout.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { BUSINESS, COUNTIES } from '../../data/site';

const clusterArticles = await getCollection('dm-articles');

const canonical = 'https://crst.net/services/direct-mail';

const graphSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How much does a direct mail campaign cost?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'A 6x9 postcard campaign at 5,000 pieces runs $0.65–$0.90 per piece all-in, including design, printing, list processing, and postage. Letters run $0.80–$1.10 at the same quantity. Larger quantities lower the per-piece cost — 10,000 pieces typically runs 20–25% less than 1,000 pieces.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the difference between EDDM and targeted direct mail?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'EDDM delivers to every address on a USPS carrier route — no list needed, postage $0.22–$0.23 per piece. Targeted direct mail uses a list filtered by demographics or geography — higher cost per piece but higher response rates.',
          },
        },
        {
          '@type': 'Question',
          name: 'How long does a direct mail campaign take?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Standard turnaround is 7–10 business days from approved proof to USPS induction. USPS Marketing Mail then delivers in 3–5 business days for local Hudson Valley mailings. Plan 15–20 business days total from kick-off to in-home.',
          },
        },
        {
          '@type': 'Question',
          name: 'What response rate should I expect from direct mail?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The DMA reports 4.4% average for house lists and 2.9% for prospect lists. For a first campaign to a cold list, 1–2% is a realistic baseline. Rates improve with list quality, offer testing, and repeated mailings.',
          },
        },
        {
          '@type': 'Question',
          name: 'Do you outsource any part of the job?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. Data, design, printing, addressing, presorting, and USPS induction all happen at our facility in Saugerties, NY. One team, one building, no handoffs.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the minimum quantity for a direct mail campaign?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'There is no hard minimum. Presort automation discounts start at 200 pieces. Most campaigns run 1,000+ pieces for meaningful response data and cost-efficient presort rates.',
          },
        },
        {
          '@type': 'Question',
          name: 'Do you offer USPS Informed Delivery coordination?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Informed Delivery sends subscribers a digital email preview of your mail piece the morning it arrives — average open rate 63%. We handle coordinated campaign setup. Available for targeted direct mail only, not EDDM.',
          },
        },
        {
          '@type': 'Question',
          name: 'Do you offer nonprofit mailing rates?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Qualifying organizations can mail at Nonprofit Marketing Mail rates, which are significantly lower than standard Marketing Mail. Cornerstone holds a nonprofit mailing authorization. Contact us to confirm eligibility.',
          },
        },
      ],
    },
    {
      '@type': 'Service',
      name: 'Direct Mail Services Hudson Valley',
      provider: { '@id': 'https://crst.net/#organization' },
      areaServed: [
        { '@type': 'County', name: 'Ulster County' },
        { '@type': 'County', name: 'Dutchess County' },
        { '@type': 'County', name: 'Orange County' },
      ],
      description: 'Full-service direct mail campaigns: mailing list targeting, mail piece design, commercial printing, USPS presort, and post office induction. Saugerties, NY since 1998.',
    },
    {
      '@type': 'Person',
      '@id': 'https://crst.net/#sean-griffin',
      name: 'Sean Griffin',
      jobTitle: 'Owner',
      worksFor: { '@id': 'https://crst.net/#organization' },
      image: 'https://crst.net/images/sean-griffin.png',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://crst.net' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://crst.net/services' },
        { '@type': 'ListItem', position: 3, name: 'Direct Mail Services', item: 'https://crst.net/services/direct-mail' },
      ],
    },
    {
      '@type': 'WebPage',
      '@id': 'https://crst.net/services/direct-mail',
      name: 'Direct Mail Services Hudson Valley, NY',
      url: 'https://crst.net/services/direct-mail',
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', 'h2'],
      },
    },
  ],
};

const formats = [
  { format: '4×6 Postcard', postage: 'Letter-class Marketing Mail ($0.22–$0.27)', best: 'Appointment reminders, simple one-offer promos' },
  { format: '6×9 Postcard', postage: 'Letter-class Marketing Mail ($0.22–$0.27)', best: 'Most local business campaigns — best balance of cost and impact' },
  { format: '6×11 Postcard', postage: 'Letter-class Marketing Mail ($0.22–$0.27)', best: 'High-visibility campaigns — 20–30% higher response than 4×6 in A/B tests' },
  { format: 'Letter + Envelope', postage: 'Marketing Mail or First Class ($0.78+)', best: 'Financial, healthcare, legal, nonprofit — complex or sensitive messages' },
  { format: 'Self-Mailer', postage: 'Flat-class Marketing Mail', best: 'EDDM campaigns, nonprofit program updates, event promotions' },
  { format: 'Newsletter', postage: 'Marketing Mail or First Class', best: 'Municipal communications, donor newsletters, multi-page content' },
];

const faqs = [
  { q: 'How much does a direct mail campaign cost?', a: 'A 6×9 postcard campaign at 5,000 pieces runs $0.65–$0.90 per piece all-in, including design, printing, list processing, and postage. Letters run $0.80–$1.10 at the same quantity. Larger quantities lower the per-piece cost significantly — 10,000 pieces typically runs 20–25% less per piece than 1,000 pieces. <a href="/estimate" class="text-crst-accent hover:underline">Get a free itemized estimate</a> within one business day.' },
  { q: 'What is the difference between EDDM and targeted direct mail?', a: 'Every Door Direct Mail (EDDM) delivers to every address on a USPS carrier route — no list needed, postage runs $0.22–$0.23 per piece. Targeted direct mail uses a purchased or house list filtered by demographics or geography — higher cost per piece, typically $0.65–$0.90 all-in, but higher response rates because you are mailing to people who match your buyer profile. We run both and will recommend the right approach for your campaign goals.' },
  { q: 'How long does a direct mail campaign take?', a: 'Standard turnaround at Cornerstone is 7–10 business days from approved proof to post office induction. USPS Marketing Mail then delivers in 3–5 business days for local Hudson Valley mailings. Total time from kick-off to in-home: plan for 15–20 business days if starting from scratch. Rush production is available for established clients — call to confirm availability.' },
  { q: 'What response rate should I expect?', a: 'The Data & Marketing Association reports a 4.4% average response rate for house lists and 2.9% for prospect lists. For a first campaign to a cold list, 1–2% is a realistic baseline. Rates improve with list quality, offer testing, and repeated mailings to the same list. Direct mail consistently outperforms email (0.12% average response) for local response.' },
  { q: 'Do you outsource any part of the job?', a: 'No. Data, design, printing, addressing, presorting, and USPS induction all happen at our facility in Saugerties, NY. One team, one building, no handoffs. When we give you a turnaround commitment, we own it.' },
  { q: 'What is the minimum quantity for a direct mail campaign?', a: 'There is no hard minimum. Presort automation discounts start at 200 pieces. Most campaigns run 1,000+ pieces to achieve meaningful response data and cost-efficient presort rates. Very small quantities — under 200 pieces — mail at First Class rates without presort discounts.' },
  { q: 'Do you offer USPS Informed Delivery coordination?', a: 'Yes. Informed Delivery sends subscribers a digital email preview of your mail piece the morning it arrives — average open rate 63%, versus 20% for typical email marketing. We handle coordinated campaign setup including ride-along image creation and USPS Business Portal submission. Available for targeted direct mail; not available for EDDM campaigns. Ask about it when you request your estimate.' },
  { q: 'Do you offer nonprofit mailing rates?', a: 'Yes. Organizations that qualify for Nonprofit Marketing Mail rates can mail at significantly lower postage rates than standard Marketing Mail. Cornerstone holds a nonprofit mailing authorization and can process qualifying mailings at the nonprofit rate. <a href="/contact" class="text-crst-accent hover:underline">Contact us</a> to confirm eligibility — we will review your organization type and help with the authorization if needed.' },
];

const countyTowns = [
  { name: 'Ulster County', href: '/service-areas/ulster-county', towns: ['Kingston', 'New Paltz', 'Saugerties', 'Woodstock', 'Highland', 'Ellenville', 'Marlborough', 'Gardiner', 'Hurley'] },
  { name: 'Dutchess County', href: '/service-areas/dutchess-county', towns: ['Poughkeepsie', 'Beacon', 'Rhinebeck', 'Hyde Park', 'Red Hook', 'Millbrook', 'Wappingers Falls', 'Fishkill', 'Dover'] },
  { name: 'Orange County', href: '/service-areas/orange-county', towns: ['Newburgh', 'Middletown', 'Goshen', 'Monroe', 'Warwick', 'Tuxedo', 'Cornwall', 'Port Jervis', 'Chester'] },
];
---

<BaseLayout
  title="Direct Mail Services Hudson Valley, NY"
  description="Full-service direct mail campaigns in Hudson Valley — list, design, print, presort, and USPS delivery from our Saugerties, NY facility since 1998. Free estimate in one business day."
  canonical={canonical}
  schema={null}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(graphSchema)} />
  </Fragment>

  <section class="bg-crst-primary text-white py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 text-sm">
        <img src="/images/sean-griffin.png" alt="Sean Griffin" class="w-8 h-8 rounded-full object-cover border-2 border-white/30" loading="eager" />
        <span class="text-white/80">By <strong class="text-white">Sean Griffin</strong> · Owner, Cornerstone Services · Saugerties, NY · Since 1998</span>
      </div>
    </div>
  </section>

  <PageHero
    title="Direct Mail Services in Hudson Valley, NY"
    subtitle="Full-service direct mail campaigns for businesses, nonprofits, and organizations across Ulster, Dutchess, and Orange counties."
    breadcrumbs={[
      { label: 'Services', href: '/services' },
      { label: 'Direct Mail' },
    ]}
    noSchema={true}
  />

  <section class="py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">
        <div class="lg:col-span-2">

          <p class="text-navy-600/80 leading-relaxed text-lg mb-8">
            Cornerstone Services runs full-service direct mail campaigns for Hudson Valley businesses, nonprofits, and organizations across Ulster, Dutchess, and Orange counties. We handle every step in-house at our Saugerties facility: mailing list targeting and hygiene, mail piece design, commercial printing, CASS/DPV address verification, USPS presort, Intelligent Mail barcoding, and post office induction. Tell us who you want to reach and what you want to say. We build the list, print the piece, prep it to USPS automation standards, and deliver it to the post office. One facility, one team, one turnaround commitment.
          </p>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
            <div class="text-center p-4 bg-crst-primary/5 rounded-xl border border-crst-primary/10">
              <div class="text-2xl font-display font-bold text-crst-primary">{BUSINESS.stats.piecesMailed}</div>
              <div class="text-xs text-navy-600/60 font-heading mt-1">Pieces Mailed</div>
            </div>
            <div class="text-center p-4 bg-crst-primary/5 rounded-xl border border-crst-primary/10">
              <div class="text-2xl font-display font-bold text-crst-primary">{BUSINESS.stats.onTime}</div>
              <div class="text-xs text-navy-600/60 font-heading mt-1">On-Time Delivery</div>
            </div>
            <div class="text-center p-4 bg-crst-primary/5 rounded-xl border border-crst-primary/10">
              <div class="text-2xl font-display font-bold text-crst-primary">Since 1998</div>
              <div class="text-xs text-navy-600/60 font-heading mt-1">Saugerties, NY</div>
            </div>
            <div class="text-center p-4 bg-crst-primary/5 rounded-xl border border-crst-primary/10">
              <div class="text-2xl font-display font-bold text-crst-primary">{BUSINESS.stats.municipalities}</div>
              <div class="text-xs text-navy-600/60 font-heading mt-1">Municipalities Served</div>
            </div>
          </div>

          <div class="bg-crst-primary/5 border border-crst-primary/15 rounded-xl p-6 text-center mb-10">
            <p class="font-heading font-bold text-crst-primary text-lg mb-2">Ready to launch your campaign?</p>
            <p class="text-navy-600/70 text-sm mb-4">We'll have a quote back to you in one business day.</p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
              <a href="/estimate" class="btn-primary text-sm">Get a Free Estimate →</a>
              <a href={`tel:${BUSINESS.phoneClean}`} class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-crst-primary hover:text-crst-accent transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Call {BUSINESS.phone}
              </a>
            </div>
          </div>

          <div class="bg-amber-50 border border-amber-200 rounded-xl p-6 mb-10">
            <p class="font-heading font-bold text-navy-800 text-sm mb-2">Key Takeaway</p>
            <p class="text-navy-600/80 text-sm leading-relaxed">
              A full-service direct mail campaign from Cornerstone includes everything: mailing list targeting, mail piece design, commercial printing, address verification, USPS presort, and post office delivery — all from one facility in Saugerties, NY. No vendors, no handoffs. A typical 5,000-piece postcard campaign runs $0.65–$0.90 per piece all-in and delivers in 7–10 business days.
            </p>
          </div>

          <div class="section-divider mb-6"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-6">What's Included in a Full Direct Mail Campaign</h2>
          <p class="text-navy-600/80 leading-relaxed mb-8">
            A direct mail campaign with Cornerstone starts with your mailing list and ends at the mailbox. Every step happens at our Saugerties, NY production facility — no outsourcing, no third-party vendors, no handoffs. Here is what is included in every full-service campaign:
          </p>

          <h3 class="text-xl font-display text-crst-primary mt-8 mb-3">Mailing List Targeting and Data Hygiene</h3>
          <p class="text-navy-600/80 leading-relaxed mb-4">
            Consumer and business lists filtered by geography, demographics, homeownership, income, SIC code, length of residence, or any combination of selects relevant to your audience. We pull from compiled data sources covering 140+ million US households. Every list — whether you provide it or we build it — runs through CASS/DPV address verification and NCOA processing before a single piece prints. CASS corrects and standardizes addresses. DPV confirms each address actually receives mail. NCOA catches anyone who has filed a change of address in the past 48 months. The result is a clean, deliverable list that qualifies for the lowest USPS automation postage rates.
          </p>

          <h3 class="text-xl font-display text-crst-primary mt-8 mb-3">Mail Piece Design</h3>
          <p class="text-navy-600/80 leading-relaxed mb-4">
            USPS-compliant design for every format we produce: postcards (4×6, 6×9, 6×11), letters with window or closed-face envelopes, self-mailers, brochures, and newsletters. Our design team builds mail pieces for response — readable headline in three seconds, clear call to action, correct USPS indicia placement, and Intelligent Mail barcode formatting. If you supply print-ready artwork, we go straight to production. If you need design, we handle it in-house.
          </p>

          <h3 class="text-xl font-display text-crst-primary mt-8 mb-3">Commercial Printing</h3>
          <p class="text-navy-600/80 leading-relaxed mb-4">
            In-house production presses for postcards, letters, self-mailers, and newsletters. We print full-color on both sides, run inkjet addressing directly on the piece, and apply Intelligent Mail barcodes for USPS automation compatibility. Print-to-induction turnaround for a standard postcard is 3–5 business days from approved proof. Letters and self-mailers run 4–7 business days. No print broker, no gang-run wait times — we control the press schedule. If you want an upgraded format, order a <a href="/shop/plastic-postcard" class="text-crst-primary underline hover:text-crst-gold">plastic postcard</a>, <a href="/shop/magnet-postcard" class="text-crst-primary underline hover:text-crst-gold">magnet postcard</a>, or <a href="/shop/scratchoff-postcard" class="text-crst-primary underline hover:text-crst-gold">scratch-off postcard</a> directly from our shop.
          </p>

          <h3 class="text-xl font-display text-crst-primary mt-8 mb-3">Presort and USPS Preparation</h3>
          <p class="text-navy-600/80 leading-relaxed mb-4">
            Every mailing is sorted to USPS automation standards and presented for the lowest applicable postage rate. Marketing Mail presort runs $0.22–$0.30 per piece depending on piece size and sortation level. We hold a <a href="/direct-mail-tools/bmeu" class="text-crst-accent hover:underline">USPS Business Mail Entry Unit</a> permit — you do not need your own. Presort discounts kick in at 200 pieces. Most campaigns run 1,000+ pieces, which qualifies for full automation pricing.
          </p>

          <h3 class="text-xl font-display text-crst-primary mt-8 mb-3">USPS Induction and Delivery Tracking</h3>
          <p class="text-navy-600/80 leading-relaxed mb-4">
            We truck finished mailings directly to the post office and induct at the Business Mail Entry Unit. No drops at retail counters, no postage meter delays. You receive USPS Informed Visibility tracking data confirming when your mail entered the postal stream and when it arrived at the destination Sectional Center Facility. For targeted direct mail campaigns, we can also set up <a href="/resources/informed-delivery-guide" class="text-crst-accent hover:underline">USPS Informed Delivery coordination</a> — adding a digital email preview of your piece to subscribers' morning inbox the day it arrives. Informed Delivery averages a 63% open rate, compared to 20% for typical email marketing.
          </p>

          <div class="section-divider mb-6 mt-14"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-6">EDDM vs. Targeted Direct Mail: Which Fits Your Campaign?</h2>
          <p class="text-navy-600/80 leading-relaxed mb-4">
            <a href="/services/eddm" class="text-crst-accent hover:underline">Every Door Direct Mail (EDDM)</a> saturates every address on a USPS carrier route. No list required, no permit needed for retail EDDM, and postage runs $0.22–$0.23 per piece — the lowest available rate. It's the right tool when geographic reach matters more than demographic precision: a restaurant opening, a home services company blanketing a new service area, a political campaign covering a precinct.
          </p>
          <p class="text-navy-600/80 leading-relaxed mb-4">
            Targeted direct mail uses a purchased or house list filtered by demographics, geography, purchase behavior, or any combination of selects that narrows the audience to likely buyers. Higher cost per piece — typically $0.65–$0.90 all-in — but higher response rates because you are mailing to people who already match your buyer profile. It's the right tool for customer acquisition, reactivation, and high-value offer campaigns.
          </p>
          <p class="text-navy-600/80 leading-relaxed mb-4">
            Cornerstone runs both. We recommend the right approach based on your campaign goals, budget, and target geography. Many clients run a combination — EDDM for broad awareness and targeted mail for customer acquisition. Read our <a href="/services/eddm" class="text-crst-accent hover:underline">complete EDDM guide</a> for a detailed breakdown of how EDDM campaigns work.
          </p>

          <div class="section-divider mb-6 mt-14"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-6">What to Expect: Direct Mail Response Rates</h2>
          <p class="text-navy-600/80 leading-relaxed mb-4">
            The Data & Marketing Association puts the average direct mail response rate at 4.4% for house lists and 2.9% for prospect lists — compared to 0.12% for email. For a 5,000-piece campaign at 2% response, that is 100 leads. At a $300 average transaction and a 25% close rate, those 100 leads become $7,500 in revenue from a $4,000 campaign. The metric that matters is not cost-per-piece — it is cost-per-response.
          </p>
          <p class="text-navy-600/80 leading-relaxed mb-6">
            Five factors drive response rate more than anything else: list quality (who you are mailing to), offer strength (what you are offering), mail piece format (postcard vs. letter), timing (when it arrives), and frequency (how many times you mail). We help you optimize all five. For more on how direct mail stacks up against digital channels, see our <a href="/resources/direct-mail-vs-email-marketing" class="text-crst-accent hover:underline">direct mail vs. email marketing comparison</a>.
          </p>

          <div class="section-divider mb-6 mt-14"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-6">Direct Mail Formats We Produce</h2>
          <div class="overflow-x-auto mb-8">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="bg-crst-primary/5">
                  <th class="text-left p-3 font-heading font-semibold text-navy-800 border-b border-navy-100">Format</th>
                  <th class="text-left p-3 font-heading font-semibold text-navy-800 border-b border-navy-100">Postage Class</th>
                  <th class="text-left p-3 font-heading font-semibold text-navy-800 border-b border-navy-100">Best For</th>
                </tr>
              </thead>
              <tbody>
                {formats.map((f, i) => (
                  <tr class={i % 2 === 0 ? 'bg-white' : 'bg-navy-50/30'}>
                    <td class="p-3 text-navy-800 font-heading font-medium border-b border-navy-100/50">{f.format}</td>
                    <td class="p-3 text-navy-600/70 border-b border-navy-100/50">{f.postage}</td>
                    <td class="p-3 text-navy-600/70 border-b border-navy-100/50">{f.best}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-sm text-navy-600/70 mt-3">Choosing the right envelope for a letter campaign affects both presentation and postage. See our <a href="/guides/envelope-sizes" class="text-crst-accent hover:text-crst-primary underline">complete envelope sizes guide</a> — dimensions, postage class, and USPS rules for every standard format.</p>

          <div class="section-divider mb-6 mt-14"></div>
          <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-6">How a Cornerstone Direct Mail Campaign Works</h2>
          <div class="space-y-6 mb-8">
            {[
              { step: '1', title: 'Consultation', desc: 'We discuss your goals, target audience, budget, and in-home date. We recommend the right format, data strategy, and postage class. No obligation. We will tell you honestly what we think will work and what it will cost.' },
              { step: '2', title: 'Data and Design', desc: 'We build or process your mailing list — CASS, DPV, and NCOA included on every job. Our design team creates a USPS-compliant mail piece. You review and approve a proof before anything prints.' },
              { step: '3', title: 'Print and Prep', desc: 'Your mail piece prints on our in-house commercial presses. We run inkjet addressing, apply Intelligent Mail barcodes, and presort to USPS automation standards for the lowest applicable postage rate.' },
              { step: '4', title: 'Mail and Track', desc: 'We induct directly at the post office. You receive USPS Informed Visibility delivery tracking. For campaigns with Informed Delivery coordination, you also receive email open rate and click-through data after delivery.' },
            ].map((item) => (
              <div class="flex items-start gap-4">
                <div class="shrink-0 w-9 h-9 rounded-full bg-crst-primary flex items-center justify-center text-white font-heading font-bold text-sm">
                  {item.step}
                </div>
                <div>
                  <h3 class="font-heading font-bold text-navy-800 mb-1">{item.title}</h3>
                  <p class="text-sm text-navy-600/70 leading-relaxed">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="bg-crst-primary/5 border border-crst-primary/15 rounded-xl p-6 text-center mb-10">
            <p class="font-heading font-bold text-crst-primary text-lg mb-2">Ready to start?</p>
            <p class="text-navy-600/70 text-sm mb-4">Get a free estimate and we'll have a detailed quote back to you in one business day.</p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
              <a href="/estimate" class="btn-primary text-sm">Get a Free Estimate →</a>
              <a href={`tel:${BUSINESS.phoneClean}`} class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-crst-primary hover:text-crst-accent transition-colors">
