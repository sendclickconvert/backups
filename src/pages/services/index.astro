---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTASection from '../../components/CTASection.astro';
import { SERVICES } from '../../data/site';
---

<BaseLayout
  title="Services"
  description="Cornerstone Services offers direct mail campaigns, commercial printing, data lists, EDDM, graphic design, non-profit mailing, and web design for Hudson Valley businesses."
>
  <PageHero
    title="Our Services"
    subtitle="Everything you need for a successful direct mail campaign — under one roof."
    breadcrumbs={[{ label: 'Services' }]}
  />

  <section class="py-14 lg:py-20">
    <div class="container-wide">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {SERVICES.map((service) => (
          <ServiceCard
            title={service.title}
            slug={service.slug}
            summary={service.description}
            icon={service.icon}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-14 lg:py-18 bg-navy-50/50 bg-grid">
    <div class="container-wide">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-3">Why Choose Cornerstone?</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 max-w-5xl mx-auto">
        {[
          { title: 'One-Stop Shop', desc: 'Data, design, print, and mail — all handled in-house with a single point of contact.' },
          { title: 'Postal Expertise', desc: 'Over 25 years of USPS experience means maximum postage discounts and compliance.' },
          { title: 'Local Knowledge', desc: 'We know Hudson Valley carrier routes, ZIP codes, and communities inside and out.' },
          { title: 'Proven Track Record', desc: '2.3M+ pieces mailed with a 98% on-time delivery rate for 47 municipalities.' },
        ].map((item) => (
          <div class="text-center">
            <div class="w-12 h-12 rounded-full bg-crst-primary/10 flex items-center justify-center mx-auto mb-3">
              <svg class="w-5 h-5 text-crst-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </div>
            <h3 class="font-heading font-bold text-navy-800 mb-1.5">{item.title}</h3>
            <p class="text-sm text-navy-600/70 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
