---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import AuthorByline from '../components/AuthorByline.astro';
import { BUSINESS } from '../data/site';

const bbbUrl = 'https://www.bbb.org/us/ny/new-paltz/profile/direct-mail-advertising/cornerstone-services-inc-0121-87170789';
const linkedInUrl = 'https://www.linkedin.com/company/cornerstone-services-inc';

const faqs = [
  {
    q: 'What does BBB A+ accreditation mean for a direct mail company?',
    a: 'BBB A+ is the highest rating the Better Business Bureau issues. It means the business has met all BBB standards for trust including licensing, transparent practices, responsive complaint resolution, and consistent ethical conduct.',
  },
  {
    q: 'How long has Cornerstone Services been BBB accredited?',
    a: 'Cornerstone Services has held continuous BBB accreditation since its founding in 1998, making it one of the longest-standing BBB accredited direct mail companies in New York State.',
  },
  {
    q: 'Does BBB accreditation affect the quality of a direct mail campaign?',
    a: 'BBB accreditation reflects the business practices behind the campaign — ethical pricing, accurate delivery, responsive service. At CRST these standards are built into every project through a formal project management process.',
  },
  {
    q: 'How can I verify Cornerstone Services\' BBB rating?',
    a: 'You can verify the rating directly on the BBB website at bbb.org by searching for Cornerstone Services Inc in New Paltz, NY or by visiting the direct profile link provided on this page.',
  },
  {
    q: 'What happens if I have a complaint about my mailing project?',
    a: 'Complaints are addressed directly by Sean Griffin, President of Cornerstone Services. Unresolved issues can also be filed with the BBB. CRST has maintained an A+ rating with no unresolved complaints since 1998.',
  },
];

const testimonials = [
  {
    text: "Our agency uses Cornerstone for all our direct mail projects. They are super-responsive and meticulous in their work. Highly recommend.",
    author: "Agency Client",
  },
  {
    text: "I'm always impressed with Sean and his team. They stay on top of the latest technology in mailing and data management. True professionals.",
    author: "Business Client",
  },
  {
    text: "I needed postcards printed and mailed fast. Cornerstone was knowledgeable, friendly, reliable, and delivered on time. Will use again.",
    author: "Postcard Client",
  },
];

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://crst.net/#organization',
  name: BUSINESS.name,
  alternateName: BUSINESS.shortName,
  url: BUSINESS.url,
  logo: `${BUSINESS.url}/images/crst-logo.webp`,
  foundingDate: '1998',
  telephone: BUSINESS.phone,
  email: BUSINESS.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: BUSINESS.address.street,
    addressLocality: BUSINESS.address.city,
    addressRegion: BUSINESS.address.state,
    postalCode: BUSINESS.address.zip,
    addressCountry: 'US',
  },
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    name: 'BBB A+ Accreditation',
    credentialCategory: 'Business Accreditation',
    recognizedBy: {
      '@type': 'Organization',
      name: 'Better Business Bureau',
      url: 'https://www.bbb.org',
    },
    url: bbbUrl,
  },
  sameAs: [bbbUrl, linkedInUrl, BUSINESS.url],
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://crst.net/#localbusiness',
  name: BUSINESS.name,
  image: `${BUSINESS.url}/images/crst-logo.webp`,
  url: BUSINESS.url,
  telephone: BUSINESS.phone,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: BUSINESS.address.street,
    addressLocality: BUSINESS.address.city,
    addressRegion: BUSINESS.address.state,
    postalCode: BUSINESS.address.zip,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 41.7476,
    longitude: -74.0871,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:30',
    closes: '17:00',
  },
  areaServed: [
    { '@type': 'County', name: 'Ulster County, New York' },
    { '@type': 'County', name: 'Dutchess County, New York' },
    { '@type': 'County', name: 'Orange County, New York' },
  ],
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://crst.net/#sean-griffin',
  name: 'Sean Griffin',
  jobTitle: 'President',
  worksFor: { '@id': 'https://crst.net/#organization' },
  url: 'https://crst.net/about',
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://crst.net/#direct-mail-service',
  name: 'Direct Mail Marketing Services',
  provider: { '@id': 'https://crst.net/#organization' },
  areaServed: [
    { '@type': 'County', name: 'Ulster County, New York' },
    { '@type': 'County', name: 'Dutchess County, New York' },
    { '@type': 'County', name: 'Orange County, New York' },
  ],
  url: 'https://crst.net/services/direct-mail',
};


const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': 'https://crst.net/crst-better-business-bureau-a-direct-mailer/',
  url: 'https://crst.net/crst-better-business-bureau-a-direct-mailer',
  name: 'BBB A+ Accredited Direct Mail Company | Cornerstone Services | CRST',
  description: 'Cornerstone Services is a BBB A+ accredited direct mail company serving Hudson Valley since 1998.',
  isPartOf: { '@id': 'https://crst.net/#website' },
  about: { '@id': 'https://crst.net/#organization' },
  author: { '@id': 'https://crst.net/#sean-griffin' },
  publisher: { '@id': 'https://crst.net/#organization' },
  datePublished: '2026-02-27',
  dateModified: '2026-02-27',
  inLanguage: 'en-US',
  breadcrumb: { '@id': 'https://crst.net/crst-better-business-bureau-a-direct-mailer/#breadcrumb' },
};
---

<BaseLayout
  title="BBB A+ Rated Direct Mail Company | Since 1998"
  description="Cornerstone Services holds a BBB A+ rating with zero unresolved complaints since 1998. Direct mail, printing, and mailing services in New Paltz, NY."
  canonical="https://crst.net/crst-better-business-bureau-a-direct-mailer"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  </Fragment>

  <PageHero
    title="BBB A+ Accredited Direct Mail Company in New Paltz, NY"
    subtitle="Trusted by nonprofits, contractors, and local businesses across the Hudson Valley since 1998."
    breadcrumbs={[
      { label: 'About', href: '/about' },
      { label: 'BBB A+ Rating' },
    ]}
  />

  <section class="py-14 lg:py-20">
    <div class="container-wide">
      <div class="max-w-3xl mx-auto">

        <div class="bg-navy-50 border border-navy-100 rounded-xl p-6 sm:p-8 mb-10 flex flex-col sm:flex-row items-center gap-6">
          <div class="shrink-0 text-center">
            <div class="w-20 h-20 rounded-full bg-crst-primary flex items-center justify-center">
              <span class="text-white font-display text-2xl font-bold">A+</span>
            </div>
            <p class="text-xs text-navy-500 font-heading mt-2">BBB Rating</p>
          </div>
          <div class="flex-1">
            <h2 class="text-xl font-display text-crst-primary mb-2">Cornerstone Services holds the highest BBB rating</h2>
            <p class="text-navy-600/80 text-sm leading-relaxed mb-3">
              The Better Business Bureau's A+ rating is the highest rating they issue. Cornerstone Services has maintained this rating since 1998, making it one of the longest-standing BBB accredited direct mail companies in New York's Hudson Valley.
            </p>
            <div class="flex flex-wrap items-center gap-3 text-sm">
              <span class="inline-flex items-center gap-1.5 text-navy-600 font-heading">
                <svg class="w-4 h-4 text-crst-gold" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                A+ Since 1998
              </span>
              <span class="text-navy-300">|</span>
              <span class="text-navy-600 font-heading">Founded {BUSINESS.founded}</span>
              <span class="text-navy-300">|</span>
              <span class="text-navy-600 font-heading">0 Unresolved Complaints</span>
            </div>
          </div>
          <a href={bbbUrl} target="_blank" rel="noopener noreferrer" class="btn-primary text-sm whitespace-nowrap">
            View Our BBB Profile
          </a>
        </div>

        <div class="section-divider mb-6"></div>
        <h2 class="text-2xl sm:text-3xl font-display text-crst-primary mb-6">
          Why BBB Accreditation Matters for Direct Mail
        </h2>
        <p class="text-navy-600/80 leading-relaxed mb-4">
          When you hire a direct mail company, you're trusting them with your marketing budget, your customer data, and your brand reputation. A direct mail campaign involves handing over mailing lists with sensitive customer information, paying upfront for print runs that can't be undone, and relying on the mailer's postal compliance expertise to ensure your pieces actually reach their intended recipients at the correct postage rate.
        </p>
        <p class="text-navy-600/80 leading-relaxed mb-4">
          BBB A+ accreditation means a business has passed the Bureau's vetting process across multiple dimensions: licensing and government compliance, complaint history and resolution, transparency in advertising and business practices, and time in business. For a direct mail company specifically, this is meaningful because the stakes are tangible — a botched mailing costs real money in wasted print, wasted postage, and lost marketing opportunities.
        </p>
        <p class="text-navy-600/80 leading-relaxed mb-8">
          The BBB doesn't hand out A+ ratings automatically. Businesses must apply for accreditation, undergo review, and maintain their standing year after year. Cornerstone has done this every year since 1998 — through market downturns, postal rate changes, the shift from analog to digital data processing, and the evolving demands of clients ranging from local restaurants to statewide political campaigns. That continuity isn't something a fly-by-night print shop can replicate.
        </p>

        <h2 class="text-2xl font-display text-crst-primary mb-6">Four Trust Pillars</h2>
        <div class="grid sm:grid-cols-2 gap-4 mb-10">
          {[
            {
              title: 'Ethical Business Practices',
              desc: 'CRST follows BBB Standards for Trust across all client engagements, from accurate estimates to transparent invoicing. Every project is scoped honestly — we don\'t pad quotes or surprise clients with hidden fees after the job is running.',
            },
            {
              title: 'Responsive Issue Resolution',
              desc: 'No unresolved complaints. If an issue arises with a mailing — a data error, a print quality concern, a delivery question — it gets addressed directly and promptly by Sean Griffin, not routed through a support queue or ignored.',
            },
            {
              title: 'Transparent Pricing',
              desc: 'Every estimate is itemized. Data, design, print, and postage are quoted separately so clients know exactly what they\'re paying for. Postage is billed at-cost with no markup — you can verify it against published USPS rate tables.',
            },
            {
              title: 'Licensed & Compliant Operations',
              desc: 'USPS Full-Service Certified Mailer. Fully licensed in New York State. Union printing certified. Every mailing meets USPS postal regulations for automation compatibility, presort accuracy, and move-update compliance.',
            },
          ].map((card) => (
            <div class="bg-navy-50 rounded-xl p-6">
              <h3 class="font-heading font-bold text-navy-800 mb-2">{card.title}</h3>
              <p class="text-navy-600/80 text-sm leading-relaxed">{card.desc}</p>
            </div>
          ))}
        </div>

        <div class="bg-crst-primary/5 border border-crst-primary/15 rounded-xl p-6 text-center mb-10">
          <p class="font-heading font-bold text-crst-primary text-lg mb-2">Ready to Work With a Trusted Mail House?</p>
          <p class="text-navy-600/70 text-sm mb-4">Get a free estimate for your next direct mail campaign.</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href="/estimate" class="btn-primary text-sm">Get a Free Estimate</a>
            <a href={`tel:${BUSINESS.phoneClean}`} class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-crst-primary hover:text-crst-accent transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Call {BUSINESS.phone}
            </a>
          </div>
        </div>

        <div class="section-divider mb-6"></div>
        <h2 class="text-2xl font-display text-crst-primary mb-6">About Sean Griffin</h2>
        <div class="flex flex-col sm:flex-row gap-6 items-start mb-10">
          <div class="sm:w-1/4 shrink-0">
            <img
              src="/images/wp/sean2.png"
              alt="Sean H. Griffin, President of Cornerstone Services"
              class="w-full max-w-[160px] mx-auto rounded-xl"
              loading="lazy"
            />
          </div>
          <div class="sm:w-3/4">
            <p class="text-navy-600/80 leading-relaxed mb-4">
              Sean Griffin has served as President of Cornerstone Services since its founding in 1998. Under his leadership, CRST has mailed over {BUSINESS.stats.piecesMailed} pieces for nonprofits, contractors, political campaigns, school districts, and local businesses throughout the Hudson Valley.
            </p>
            <p class="text-navy-600/80 leading-relaxed mb-4">
              Sean's hands-on involvement in every project — from data strategy to postal compliance — is what has kept CRST's BBB rating unblemished for over 25 years. He personally oversees campaign accuracy, responds to client concerns directly, and maintains the relationships with USPS Business Mail Entry Units that ensure smooth induction and delivery.
            </p>
            <p class="text-navy-600/80 leading-relaxed">
              Unlike large national print brokers, Sean works directly with every client. When you call Cornerstone, you're talking to the person who will manage your campaign from start to finish. That level of accountability is rare in this industry — and it's the foundation of CRST's spotless BBB record.
            </p>
          </div>
        </div>

        <div class="bg-navy-50 border border-navy-100 rounded-lg p-4 flex items-start gap-3 mb-10">
          <svg class="w-5 h-5 text-crst-primary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
          <div class="text-sm">
            <p class="font-semibold text-crst-primary">Sean Griffin</p>
            <p class="text-gray-600">President, Cornerstone Services · BBB A+ accredited since 1998 · {BUSINESS.stats.piecesMailed} pieces mailed</p>
          </div>
        </div>

        <div class="section-divider mb-6"></div>
        <h2 class="text-2xl font-display text-crst-primary mb-6">Frequently Asked Questions</h2>
        <div class="space-y-4 mb-10">
          {faqs.map((faq) => (
            <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
              <summary class="flex items-center justify-between p-5 cursor-pointer hover:bg-navy-50/30 transition-colors">
                <span class="font-heading font-bold text-navy-800 text-sm pr-4">{faq.q}</span>
                <svg class="w-5 h-5 text-navy-400 shrink-0 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <div class="px-5 pb-5 text-sm text-navy-600/80 leading-relaxed border-t border-gray-100 pt-4">
                {faq.a}
              </div>
            </details>
          ))}
        </div>

        <div class="section-divider mb-6"></div>
        <h2 class="text-2xl font-display text-crst-primary mb-6">What Our Clients Say</h2>
        <div class="grid sm:grid-cols-3 gap-4 mb-10">
          {testimonials.map((t) => (
            <div class="bg-navy-50/60 rounded-xl p-5 border border-navy-100">
              <div class="flex gap-0.5 mb-3">
                {[1,2,3,4,5].map(() => (
                  <svg class="w-4 h-4 text-crst-gold" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                ))}
              </div>
              <p class="text-sm text-navy-600/80 leading-relaxed mb-3 italic">"{t.text}"</p>
              <p class="text-xs font-heading font-semibold text-navy-800">— {t.author}</p>
            </div>
          ))}
        </div>

        <div class="bg-crst-primary/5 border border-crst-primary/20 rounded-xl p-6 sm:p-8">
          <h3 class="text-xl font-display font-bold text-crst-primary mb-3">Ready to work with a direct mail company you can trust?</h3>
          <p class="text-navy-600/80 text-sm leading-relaxed mb-4">
            Cornerstone Services has been earning trust in the Hudson Valley since 1998 — one campaign at a time. Whether you need postcards, EDDM, nonprofit mailings, or a full direct mail campaign, we'll handle it with the care and accuracy that earned us our A+ rating.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/estimate" class="btn-primary text-sm">Get a Free Estimate</a>
            <a href="/contact" class="btn-secondary text-sm">Contact Us</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
