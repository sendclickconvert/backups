---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import PostageCalculator from '../../components/calculators/PostageCalculator';
import { BUSINESS } from '../../data/site';

const YEAR = 2026;
const lastUpdated = '2026-05-07';
const lastUpdatedDisplay = 'May 2026';
const canonical = 'https://crst.net/direct-mail-tools/postage-rates';

const org = {
  '@type': 'Organization',
  '@id': 'https://crst.net/#organization',
  name: 'Cornerstone Services, Inc.',
  url: 'https://crst.net',
  telephone: '+1-845-255-5722',
  foundingDate: '1998',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '31 S Ohioville Rd',
    addressLocality: 'New Paltz',
    addressRegion: 'NY',
    postalCode: '12561',
    addressCountry: 'US',
  },
};

const faqs = [
  {
    q: `What is the ${YEAR} USPS postage rate for a standard letter?`,
    a: `The ${YEAR} USPS First-Class rate for a 1 oz metered letter is $0.74. Using a Forever stamp (stamped letter) costs $0.78. USPS raised First-Class retail rates on April 26, ${YEAR} — up from $0.73 (metered) and $0.73 (stamped). For bulk presorted First-Class mailings of 500+ pieces, automation rates start at $0.593 per piece at the 5-digit sort level.`,
  },
  {
    q: `How much does EDDM postage cost in ${YEAR}?`,
    a: `EDDM (Every Door Direct Mail) postage in ${YEAR} costs $0.247 per piece for EDDM Retail — no permit required, limit 5,000 pieces per day per ZIP. EDDM BMEU (Business Mail Entry Unit) at DDU entry costs $0.242 per piece; it requires a permit but removes the daily volume cap. EDDM postage was not affected by the April 26, ${YEAR} rate change and is unchanged from 2025.`,
  },
  {
    q: `What is the cheapest way to mail postcards in bulk?`,
    a: `The cheapest bulk postcard option is EDDM at $0.242–$0.247 per piece, which requires no mailing list. For targeted list mailings, Marketing Mail carrier route saturation rates start at $0.244 per piece (200-piece minimum). A single First-Class postcard costs $0.61 at retail in ${YEAR}. The right choice depends on whether you need targeted addressing or blanket neighborhood coverage.`,
  },
  {
    q: `What are the USPS Nonprofit postage rates for ${YEAR}?`,
    a: `Qualifying 501(c)(3) organizations can mail Marketing Mail at carrier route saturation rates starting at $0.155 per piece for letters and $0.180 per piece for flats — roughly 40–50% less than standard commercial Marketing Mail rates. Automation 5-digit rates for nonprofit letters are $0.178 per piece. Nonprofit mailing authorization requires USPS PS Form 3624. Cornerstone helps nonprofits apply for and maintain their authorization.`,
  },
  {
    q: `What is the difference between Marketing Mail and First-Class Mail?`,
    a: `Marketing Mail (formerly Standard Mail) is designed for advertising and bulk mailings. It starts at $0.244 per piece for carrier route saturation letters but delivers in 3–10 business days with no forwarding or return service. First-Class Mail costs more — $0.593+ per piece in bulk or $0.74 at retail — but delivers in 1–3 days and includes address forwarding and return to sender. First-Class is best for invoices, statements, and time-sensitive mail. Marketing Mail is best for advertising campaigns, coupons, and newsletters.`,
  },
  {
    q: `What is the minimum quantity for bulk mail postage rates?`,
    a: `USPS Marketing Mail requires a minimum of 200 pieces or 50 lbs per mailing, whichever comes first. First-Class presort discounts require a minimum of 500 pieces. EDDM Retail has a minimum of 200 pieces per mailing per ZIP code. To access bulk rates you need a valid USPS mailing permit — Cornerstone can mail under our permit on your behalf, so most clients never need to obtain their own.`,
  },
  {
    q: `Did USPS raise postage rates in ${YEAR}?`,
    a: `Yes. USPS implemented a rate change effective April 26, ${YEAR}. Key increases for direct mail senders: First-Class metered letter rose from $0.73 to $0.74; the Forever stamp rose from $0.73 to $0.78; First-Class postcards rose from $0.56 to $0.61; First-Class large envelopes rose from $1.35 to $1.63 for the first ounce. Marketing Mail automation rates also increased. EDDM postage was not changed — it remains $0.247 (Retail) and $0.242 (BMEU DDU).`,
  },
  {
    q: `How much does a USPS mailing permit cost?`,
    a: `A USPS bulk mail Permit Imprint requires an annual fee that varies by mail class and post office of mailing. Many businesses mail under a direct mail company's existing permit rather than obtaining their own — this is the standard arrangement for periodic mailers. Cornerstone Services mails under our own permit on behalf of clients, so you get access to bulk rates with no permit application required. Contact us for details on permit costs if you need your own account.`,
  },
];

const graphItems = [
  {
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: `USPS Postage Rates ${YEAR}: Complete Rate Chart`,
    description: `Current ${YEAR} USPS postage rates for First-Class Mail, postcards, large envelopes, EDDM, and Marketing Mail. Verified against USPS Notice 123, effective April 26, ${YEAR}.`,
    datePublished: lastUpdated,
    dateModified: lastUpdated,
    inLanguage: 'en-US',
    author: {
      '@type': 'Person',
      '@id': 'https://crst.net/about#sean-griffin',
      name: 'Sean Griffin',
    },
    publisher: org,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://crst.net' },
      { '@type': 'ListItem', position: 2, name: 'Direct Mail Tools', item: 'https://crst.net/direct-mail-tools' },
      { '@type': 'ListItem', position: 3, name: `USPS Postage Rates ${YEAR}`, item: canonical },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---

<BaseLayout
  title={`${YEAR} USPS Postage Rates: First Class, Marketing Mail & EDDM`}
  description={`Current ${YEAR} USPS postage rates for First-Class, EDDM, Marketing Mail, and Nonprofit mail. Verified ${lastUpdatedDisplay} against USPS Notice 123 by CRST, certified direct mail experts.`}
  canonical={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': graphItems,
    })} />
  </Fragment>

  <PageHero
    title={`${YEAR} USPS Postage Rates`}
    subtitle={`Current rates for Marketing Mail, EDDM, First-Class presort, and Nonprofit mail — plus automation discounts, presort minimums, and permit requirements. Verified ${lastUpdatedDisplay}.`}
    breadcrumbs={[
      { label: 'Direct Mail Tools', href: '/direct-mail-tools' },
      { label: 'Postage Rates' },
    ]}
  />

  <section class="py-14 lg:py-20">
    <div class="container-wide">
      <div class="max-w-4xl mx-auto">

        <div class="section-divider mb-6"></div>

        <!-- Last Updated + Source -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-8">
          <p class="text-navy-600/80 leading-relaxed">
            USPS postage rates change periodically — verify current rates before planning your budget. Cornerstone automatically applies the lowest qualifying rate to every campaign we process.
          </p>
          <p class="text-xs text-navy-400 shrink-0">
            Last updated: <time itemprop="dateModified" datetime={lastUpdated}>{lastUpdatedDisplay}</time> ·
            Source: <a href="https://pe.usps.com/cpim/ftp/manuals/dmm300/notice123.pdf" target="_blank" rel="noopener noreferrer" class="underline hover:text-crst-primary">USPS Notice 123 (eff. Apr 26, {YEAR})</a>
          </p>
        </div>

        <!-- Quick Answer Box -->
        <div id="quick-answer" class="bg-crst-primary/5 border-l-4 border-crst-primary rounded-r-xl p-6 mb-10">
          <h2 class="font-display text-lg text-crst-primary mb-4">Quick Answer — Top {YEAR} USPS Rates</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-crst-primary/20">
                  <th class="text-left pb-2 font-heading text-navy-700">Mail Type</th>
                  <th class="text-left pb-2 font-heading text-navy-700">Rate</th>
                  <th class="text-left pb-2 font-heading text-navy-700 hidden sm:table-cell">Notes</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-navy-100">
                <tr>
                  <td class="py-2 font-semibold text-navy-800">Forever stamp (1 oz letter)</td>
                  <td class="py-2 text-crst-primary font-bold">$0.78</td>
                  <td class="py-2 text-navy-500 hidden sm:table-cell">Single piece, stamped retail</td>
                </tr>
                <tr>
                  <td class="py-2 font-semibold text-navy-800">First-Class postcard</td>
                  <td class="py-2 text-crst-primary font-bold">$0.61</td>
                  <td class="py-2 text-navy-500 hidden sm:table-cell">Single piece, retail</td>
                </tr>
                <tr>
                  <td class="py-2 font-semibold text-navy-800">Large envelope / flat (≤1 oz)</td>
                  <td class="py-2 text-crst-primary font-bold">$1.63</td>
                  <td class="py-2 text-navy-500 hidden sm:table-cell">First-Class, single piece</td>
                </tr>
                <tr>
                  <td class="py-2 font-semibold text-navy-800">EDDM Retail (no permit)</td>
                  <td class="py-2 text-crst-primary font-bold">$0.247/pc</td>
                  <td class="py-2 text-navy-500 hidden sm:table-cell">Bulk, 200 min, no mailing list needed</td>
                </tr>
                <tr>
                  <td class="py-2 font-semibold text-navy-800">Marketing Mail letter (bulk)</td>
                  <td class="py-2 text-crst-primary font-bold">from $0.244/pc</td>
                  <td class="py-2 text-navy-500 hidden sm:table-cell">Carrier route saturation, 200 min</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Author / Byline -->
        <div class="flex items-start gap-4 bg-navy-50 rounded-xl p-5 mb-10 border border-navy-100">
          <img src="/images/sean-griffin.png" alt="Sean Griffin, Owner of Cornerstone Services" class="shrink-0 w-12 h-12 rounded-full object-cover" width="48" height="48" />
          <div>
            <p class="text-sm font-heading font-semibold text-navy-800">Compiled by Sean Griffin, Owner — Cornerstone Services, Inc.</p>
            <p class="text-xs text-navy-500 mt-1">Sean has processed bulk mail campaigns for Hudson Valley businesses since 1998. The rates on this page are applied to every campaign Cornerstone produces. We update this guide every time USPS announces a rate change.</p>
            <p class="text-xs text-navy-400 mt-1">Last reviewed: {lastUpdatedDisplay} · Source: <a href="https://pe.usps.com/cpim/ftp/manuals/dmm300/notice123.pdf" target="_blank" rel="noopener noreferrer" class="underline hover:text-crst-primary">USPS Notice 123 (eff. Apr 26, {YEAR})</a></p>
          </div>
        </div>

        <!-- Calculator -->
        <div class="not-prose mb-12">
          <PostageCalculator client:visible />
        </div>

        <!-- What Changed in 2026 -->
        <div id="what-changed" class="bg-amber-50 border border-amber-200 rounded-xl p-6 mb-12">
          <h2 class="font-display text-xl text-amber-900 mb-3">What Changed in {YEAR}</h2>
          <p class="text-sm text-amber-800 mb-4">USPS implemented a rate change <strong>effective April 26, {YEAR}</strong>. EDDM rates were not changed. Key increases for direct mail:</p>
          <ul class="space-y-1.5 text-sm text-amber-800">
            <li class="flex gap-2"><span class="text-amber-600 font-bold shrink-0">↑</span> <span><strong>Forever stamp (stamped letter):</strong> $0.73 → $0.78 (+$0.05, +7%)</span></li>
            <li class="flex gap-2"><span class="text-amber-600 font-bold shrink-0">↑</span> <span><strong>First-Class letter (metered):</strong> $0.73 → $0.74 (+$0.01)</span></li>
            <li class="flex gap-2"><span class="text-amber-600 font-bold shrink-0">↑</span> <span><strong>First-Class postcard:</strong> $0.56 → $0.61 (+$0.05, +9%)</span></li>
            <li class="flex gap-2"><span class="text-amber-600 font-bold shrink-0">↑</span> <span><strong>First-Class large envelope (≤1 oz):</strong> $1.35 → $1.63 (+$0.28, +21%)</span></li>
            <li class="flex gap-2"><span class="text-amber-600 font-bold shrink-0">↑</span> <span><strong>Marketing Mail letters (automation 5-digit):</strong> $0.308 → $0.372</span></li>
            <li class="flex gap-2"><span class="text-amber-600 font-bold shrink-0">↑</span> <span><strong>Marketing Mail letters (automation AADC):</strong> $0.357 → $0.407</span></li>
            <li class="flex gap-2"><span class="text-green-700 font-bold shrink-0">✓</span> <span><strong>EDDM Retail:</strong> unchanged at $0.247/piece</span></li>
            <li class="flex gap-2"><span class="text-green-700 font-bold shrink-0">✓</span> <span><strong>EDDM BMEU (DDU entry):</strong> unchanged at $0.242/piece</span></li>
          </ul>
        </div>

        <!-- Marketing Mail -->
        <h2 id="marketing-mail" class="text-2xl font-display text-crst-primary mb-3">Marketing Mail Rates {YEAR}</h2>
        <p class="text-navy-600/80 text-sm leading-relaxed mb-4">
          Marketing Mail (formerly Standard Mail) is the most common class for <a href="/services/direct-mail" class="text-crst-primary underline hover:text-crst-gold">direct mail advertising</a>. Requires a minimum of 200 pieces or 50 lbs per mailing. Delivery is typically 3–10 business days. Cornerstone's <a href="/services/mailing" class="text-crst-primary underline hover:text-crst-gold">full-service mailing</a> automatically qualifies your campaign for the lowest applicable rate.
        </p>

        <h3 class="text-base font-heading font-semibold text-navy-700 mb-2 mt-6">Marketing Mail — Letters (≤3.5 oz)</h3>
        <div class="overflow-x-auto mb-6">
          <table class="w-full text-sm border border-navy-200 rounded-lg overflow-hidden">
            <thead>
              <tr class="bg-crst-primary text-white">
                <th class="text-left p-3 font-heading">Sort / Entry Level</th>
                <th class="text-left p-3 font-heading">Rate per Piece</th>
                <th class="text-left p-3 font-heading">Best For</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-navy-100">
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Carrier Route Saturation</td>
                <td class="p-3 text-navy-600 font-bold">$0.244</td>
                <td class="p-3 text-navy-500">Neighborhood coverage, EDDM-adjacent campaigns</td>
              </tr>
              <tr class="bg-navy-50/50">
                <td class="p-3 font-semibold text-navy-800">Carrier Route High Density Plus</td>
                <td class="p-3 text-navy-600">$0.275</td>
                <td class="p-3 text-navy-500">Dense residential routes</td>
              </tr>
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Automation 5-Digit</td>
                <td class="p-3 text-navy-600">$0.372</td>
                <td class="p-3 text-navy-500">Targeted lists, IMb required</td>
              </tr>
              <tr class="bg-navy-50/50">
                <td class="p-3 font-semibold text-navy-800">Automation AADC</td>
                <td class="p-3 text-navy-600">$0.407</td>
                <td class="p-3 text-navy-500">Broader geographic lists</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3 class="text-base font-heading font-semibold text-navy-700 mb-2">Marketing Mail — Flats / Self-Mailers (≤4 oz)</h3>
        <p class="text-navy-600/80 text-xs leading-relaxed mb-3">Flats include catalogs, booklets, oversized postcards, and self-mailers that exceed letter dimensions. Carrier route rates apply to saturation mailings; automation-sorted targeted flat campaigns are significantly higher.</p>
        <div class="overflow-x-auto mb-10">
          <table class="w-full text-sm border border-navy-200 rounded-lg overflow-hidden">
            <thead>
              <tr class="bg-crst-primary text-white">
                <th class="text-left p-3 font-heading">Sort / Entry Level</th>
                <th class="text-left p-3 font-heading">Rate per Piece</th>
                <th class="text-left p-3 font-heading">Notes</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-navy-100">
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Carrier Route Saturation</td>
                <td class="p-3 text-navy-600 font-bold">$0.290</td>
                <td class="p-3 text-navy-500">Neighborhood saturation campaigns</td>
              </tr>
              <tr class="bg-navy-50/50">
                <td class="p-3 font-semibold text-navy-800">EDDM (carrier route)</td>
                <td class="p-3 text-navy-600">$0.291</td>
                <td class="p-3 text-navy-500">Every Door Direct Mail flats</td>
              </tr>
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Carrier Route High Density Plus</td>
                <td class="p-3 text-navy-600">$0.351</td>
                <td class="p-3 text-navy-500">Dense residential routes</td>
              </tr>
              <tr class="bg-navy-50/50">
                <td class="p-3 font-semibold text-navy-800">Carrier Route Basic</td>
                <td class="p-3 text-navy-600">$0.501</td>
                <td class="p-3 text-navy-500">Lower-density carrier routes</td>
              </tr>
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Automation 5-Digit (sorted flat)</td>
                <td class="p-3 text-navy-600">$0.770</td>
                <td class="p-3 text-navy-500">Targeted list + full automation sort</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- EDDM -->
        <h2 id="eddm" class="text-2xl font-display text-crst-primary mb-3">EDDM Postage Rates {YEAR}</h2>
        <p class="text-navy-600/80 text-sm leading-relaxed mb-4">
          EDDM delivers to every address on selected <a href="/resources/eddm-guide" class="text-crst-primary underline hover:text-crst-gold">carrier routes</a> — no mailing list needed. Ideal for local businesses wanting blanket coverage. EDDM postage rates were <strong>not changed</strong> in the April 26, {YEAR} rate update.
          See <a href="/services/eddm" class="text-crst-primary underline hover:text-crst-gold">our EDDM service page</a> for the full breakdown, or <a href="/services/eddm/how-much-does-eddm-cost" class="text-crst-primary underline hover:text-crst-gold">estimate your EDDM campaign cost</a>.
        </p>
        <div class="overflow-x-auto mb-10">
          <table class="w-full text-sm border border-navy-200 rounded-lg overflow-hidden">
            <thead>
              <tr class="bg-crst-primary text-white">
                <th class="text-left p-3 font-heading">EDDM Type</th>
                <th class="text-left p-3 font-heading">Rate per Piece</th>
                <th class="text-left p-3 font-heading">Permit Required?</th>
                <th class="text-left p-3 font-heading">Daily Limit</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-navy-100">
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">EDDM Retail</td>
                <td class="p-3 text-navy-600 font-bold">$0.247</td>
                <td class="p-3 text-navy-600">No</td>
                <td class="p-3 text-navy-500">5,000/day per ZIP</td>
              </tr>
              <tr class="bg-navy-50/50">
                <td class="p-3 font-semibold text-navy-800">EDDM BMEU — DDU entry</td>
                <td class="p-3 text-navy-600 font-bold">$0.242</td>
                <td class="p-3 text-navy-600">Yes</td>
                <td class="p-3 text-navy-500">No limit</td>
              </tr>
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">EDDM BMEU — DSCF entry</td>
                <td class="p-3 text-navy-600">$0.253</td>
                <td class="p-3 text-navy-600">Yes</td>
                <td class="p-3 text-navy-500">No limit</td>
              </tr>
              <tr class="bg-navy-50/50">
                <td class="p-3 font-semibold text-navy-800">EDDM BMEU — Origin entry</td>
                <td class="p-3 text-navy-600">$0.291</td>
                <td class="p-3 text-navy-600">Yes</td>
                <td class="p-3 text-navy-500">No limit</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- First-Class Mail -->
        <h2 id="first-class" class="text-2xl font-display text-crst-primary mb-3">First-Class Mail Rates {YEAR}</h2>
        <p class="text-navy-600/80 text-sm leading-relaxed mb-4">
          First-Class is faster (1–3 days) and includes forwarding and return service. Used for invoices, statements, and time-sensitive communications. Presort discounts are available for 500+ pieces with an <a href="/direct-mail-tools/postal-dictionary" class="text-crst-primary underline hover:text-crst-gold">Intelligent Mail barcode (IMb)</a>.
        </p>

        <h3 class="text-base font-heading font-semibold text-navy-700 mb-2 mt-6">Single Piece — Retail</h3>
        <div class="overflow-x-auto mb-6">
          <table class="w-full text-sm border border-navy-200 rounded-lg overflow-hidden">
            <thead>
              <tr class="bg-crst-primary text-white">
                <th class="text-left p-3 font-heading">Piece Type</th>
                <th class="text-left p-3 font-heading">Rate</th>
                <th class="text-left p-3 font-heading">Notes</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-navy-100">
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Letter, 1 oz — metered</td>
                <td class="p-3 text-navy-600 font-bold">$0.74</td>
                <td class="p-3 text-navy-500">Standard window envelope</td>
              </tr>
              <tr class="bg-navy-50/50">
                <td class="p-3 font-semibold text-navy-800">Letter, 1 oz — stamped (Forever)</td>
                <td class="p-3 text-navy-600 font-bold">$0.78</td>
                <td class="p-3 text-navy-500">Forever stamp price</td>
              </tr>
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Letter, 2 oz</td>
                <td class="p-3 text-navy-600">$1.03</td>
                <td class="p-3 text-navy-500">Metered</td>
              </tr>
              <tr class="bg-navy-50/50">
                <td class="p-3 font-semibold text-navy-800">Letter, 3 oz</td>
                <td class="p-3 text-navy-600">$1.32</td>
                <td class="p-3 text-navy-500">Metered</td>
              </tr>
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Postcard</td>
                <td class="p-3 text-navy-600 font-bold">$0.61</td>
                <td class="p-3 text-navy-500">Min 3.5″×5″, max 4.25″×6″</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3 class="text-base font-heading font-semibold text-navy-700 mb-2">Presorted / Bulk (500+ pieces)</h3>
        <div class="overflow-x-auto mb-10">
          <table class="w-full text-sm border border-navy-200 rounded-lg overflow-hidden">
            <thead>
              <tr class="bg-crst-primary text-white">
                <th class="text-left p-3 font-heading">Sort Level</th>
                <th class="text-left p-3 font-heading">Rate per Piece</th>
                <th class="text-left p-3 font-heading">Min. Quantity</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-navy-100">
              <tr class="bg-white">
                <td class="p-3 font-semibold text-navy-800">Letters — Automation 5-Digit</td>
                <td class="p-3 text-navy-600 font-bold">$0.593</td>
                <td class="p-3 text-navy-500">500 pieces</td>
              </tr>
              <tr class="bg-navy-50/50">
                <td class="p-3 font-semibold text-navy-800">Letters — Automation AADC</td>
                <td class="p-3 text-navy-600">$0.641</td>
